----- Panic and API -----

local panicFlags = {
	"AutoRoll",
	"AutoEquip",
	"AutoSell",
	"GameAutosell",
	"AutoUpgrade",
	"AutoUpkeep",
	"AutoClaimSold",
	"WebhookEnabled",
}

local api = {}

function api.Panic()
	State.Paused = true
	State.AutoRoll = false
	State.AutoEquip = false
	State.SellEnabled = false
	State.AutoUpgrade = false
	State.AutoUpkeep = false
	State.AutoClaimSold = false
	State.WebhookEnabled = false
	for _, name in ipairs(panicFlags) do
		local flag = Airflow.Flags[name]
		if flag and type(flag.Set) == "function" then
			pcall(function()
				flag:Set(false, true)
			end)
		end
	end
	pushLog("<Warning>Panic</Warning> everything stopped", "Warning")
	Window:Notify({ Title = "Panic", Content = "All automation stopped", Type = "Warning" })
	if Session.panicThread then
		pcall(task.cancel, Session.panicThread)
	end
	Session.panicThread = task.delay(1.5, function()
		State.Paused = false
	end)
end

function api.Destroy()
	pcall(api.Panic)
	for _, connection in ipairs(Session.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	Session.connections = {}
	if Session.schedulerThread then
		pcall(task.cancel, Session.schedulerThread)
	end
	if Session.historyThread then
		pcall(task.cancel, Session.historyThread)
	end
	if Session.webhookThread then
		pcall(task.cancel, Session.webhookThread)
	end
	pcall(function()
		Window:Destroy()
	end)
	getgenv().RobScriptNumbers = nil
end

function api.Roll(count)
	return remote("Roll"):InvokeServer(selectedRegionId(), count or 1, nil)
end

function api.SellMatching()
	task.spawn(sellStep)
end

function api.EquipBest()
	task.spawn(equipStep)
end

function api.BuyNextUpgrade()
	task.spawn(upgradeStep)
end

function api.RefreshState()
	return refreshState()
end

function api.SetFlag(name, value)
	local flag = Airflow.Flags[name]
	if flag and type(flag.Set) == "function" then
		flag:Set(value)
		return true
	end
	return false
end

