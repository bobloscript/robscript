local sellStep

local function applyRollResults(response, cost)
	if type(response) ~= "table" then
		return 0
	end
	if response.cost then
		cost = response.cost
	end
	local count = 0
	for _, result in ipairs(response.results or {}) do
		count = count + 1
		local tier = result.rarity or "COMMON"
		local entry = {
			uid = result.uid,
			text = result.text or "?",
			codeText = result.codeText,
			region = result.regionName,
			rarity = tier,
			quality = result.qualityName,
			price = tonumber(result.price) or platePrice(result.plate),
			notable = result.notable == true,
			autosold = result.autosold == true,
			iso = os.date("!%Y-%m-%dT%H:%M:%SZ"),
			clock = clockText(),
			event = result.byEvent == true,
		}
		Session.counts[tier] = (Session.counts[tier] or 0) + 1
		if entry.price > Session.bestPrice then
			Session.bestPrice = entry.price
			Session.best = entry
		end
		table.insert(Session.history, 1, entry)
		if #Session.history > 400 then
			table.remove(Session.history)
		end
		Session.historyDirty = true
		queueWebhook(entry)
		if entry.notable and tier ~= "COMMON" then
			pushLog(string.format("<Accent>%s</Accent> %s %s · %s", rarityLabel(tier), escapeRich(entry.text), escapeRich(entry.codeText or ""), formatMoney(entry.price)))
		end
	end
	Session.rolls = Session.rolls + count
	Session.spent = Session.spent + (tonumber(cost) or 0)
	return count
end

local function garageStatus(state)
	local slots = tonumber(state and state.slots) or 5
	local stored = #((state and state.inventory) or {})
	return stored, slots, stored >= slots
end

-- Decision for the next roll: "paid", "free" (ticket) or "wait".
-- The ticket roll is only granted by the server while the balance is below the
-- cheapest roll, so the plan mirrors exactly that rule.
local function rollPlan(state, mode)
	local money = tonumber(state and state.money) or 0
	local quote = rollCost(state)
	local threshold = tonumber(state and state.cheapestRoll) or quote
	local freeAt = tonumber(state and state.freeRollAt) or 0
	local freeIn = math.max(0, freeAt - serverNow())
	local freeReady = freeAt <= serverNow()
	local plan = { money = money, cost = quote, freeIn = freeIn, action = "paid" }
	if mode ~= nil then
		return plan
	end
	if State.RollPayment ~= "Paid only" and freeReady and money < threshold then
		plan.action = "free"
		plan.cost = 0
		return plan
	end
	if money < quote then
		plan.action = "wait"
		if money < threshold then
			plan.reason = freeReady and "ticket" or "money"
		else
			plan.reason = "region"
		end
	end
	return plan
end

local function rollStep()
	if Session.rolling then
		return
	end
	local state = GameState or refreshState()
	if not state then
		return
	end
	local stored, slots, full = garageStatus(state)
	if full then
		if State.SellEnabled and State.SellScript then
			sellStep(State.FreeSlot)
		end
		if os.clock() - (Session.lastGarageWarn or 0) > 6 then
			Session.lastGarageWarn = os.clock()
			pushLog(string.format("<Warning>Garage is full</Warning> %d of %d slots — enable auto sell, free a slot or buy more space", stored, slots), "Warning")
		end
		Session.nextRollAt = os.clock() + 1
		return
	end
	local count = math.clamp(math.floor(State.RollBatch), 1, math.max(1, state.maxBatch or 1))
	local mode = nil
	local inventory = state.inv or {}
	if State.RollMode == "Lucky roll" and inventory.lucky then
		mode = "lucky"
	elseif State.RollMode == "Coupon" and inventory.next then
		mode = "coupon"
	end
	local plan = rollPlan(state, mode)
	local money = plan.money
	local quote = plan.cost
	local regionId = selectedRegionId()
	local useFree = plan.action == "free"
	local freeIn = plan.freeIn
	if plan.action == "wait" then
		-- Nothing to pay with: wait for the ticket instead of poking the server.
		Session.nextRollAt = os.clock() + math.clamp(freeIn + 0.5, 0.5, 10)
		if os.clock() - (Session.lastBrokeLog or 0) > 12 then
			Session.lastBrokeLog = os.clock()
			if plan.reason == "ticket" then
				pushLog("<Warning>Free roll is ready</Warning> switch Payment to Auto to use it", "Warning")
			elseif plan.reason == "region" then
				pushLog(string.format("<Warning>Not enough for this region</Warning> needs %s", formatMoney(quote)), "Warning")
			else
				pushLog(string.format("<Warning>Not enough money</Warning> free roll in %d s", math.ceil(freeIn)), "Warning")
			end
		end
		return
	end
	if State.RollMoneyGuard > 0 and not useFree and money - quote < State.RollMoneyGuard then
		Session.nextRollAt = os.clock() + 1
		return
	end
	if useFree then
		-- The ticket always rolls one plate in a random region.
		count = 1
		mode = true
		regionId = nil
	end
	Session.rolling = true
	local ok, response = pcall(function()
		return remote("Roll"):InvokeServer(regionId, count, mode)
	end)
	Session.rolling = false
	if not ok then
		pushLog("<Error>Roll failed</Error> " .. escapeRich(response), "Error")
		task.wait(0.5)
		return
	end
	if type(response) ~= "table" or response.ok ~= true then
		local message = tostring(type(response) == "table" and response.err or response or "unknown")
		if message:find("рано") then
			-- Server cooldown is still running: stretch the pace and retry soon.
			Session.rollPenalty = math.min((Session.rollPenalty or 0) + 0.35, 5)
			Session.rejects = (Session.rejects or 0) + 1
			Session.nextRollAt = os.clock() + 0.4
			if Session.rejects % 6 == 1 then
				pushLog(string.format("<Warning>Server cooldown</Warning> pacing at %.2f s", rollCooldown(state) + Session.rollPenalty))
			end
			return
		elseif message:find("гараж") then
			if State.SellEnabled and State.SellScript then
				sellStep()
			end
			Session.nextRollAt = os.clock() + 0.8
			return
		elseif message:find("денег") or message:find("money") or message:find("бесплатн") then
			-- Balance too low for a paid roll: retry when the ticket is up.
			Session.nextRollAt = os.clock() + math.clamp(freeIn + 0.5, 0.5, 10)
			if os.clock() - (Session.lastBrokeLog or 0) > 12 then
				Session.lastBrokeLog = os.clock()
				pushLog("<Warning>Roll needs money</Warning> " .. escapeRich(message), "Warning")
			end
			return
		end
		pushLog("<Error>Roll rejected</Error> " .. escapeRich(message), "Error")
		Session.nextRollAt = os.clock() + 0.8
		return
	end
	local rolled = applyRollResults(response, rollCost(state))
	if rolled > 0 and GameState then
		GameState.money = (tonumber(GameState.money) or 0) - (tonumber(response.cost) or 0)
	end
	if (tonumber(response.cost) or 0) == 0 then
		Session.freeRolls = (Session.freeRolls or 0) + 1
		pushLog("<Success>Free roll used</Success> no money spent")
	end
	Session.rejects = 0
	Session.lastRollAt = os.clock()
	local animation = revealSeconds(state, response.results)
	local pace = math.max(rollCooldown(state), animation + 0.15) + State.RollExtraDelay + (Session.rollPenalty or 0)
	Session.nextRollAt = Session.lastRollAt + pace
	Session.lastPace = pace
	if Session.rollPenalty and Session.rollPenalty > 0.4 then
		Session.rollPenalty = Session.rollPenalty - 0.1
	end
	if State.EquipAfterRoll and State.AutoEquip then
		pcall(function()
			remote("EquipBest"):InvokeServer()
		end)
	end
	if State.RollStopRare > 0 then
		for _, result in ipairs(response.results or {}) do
			if rarityOrder(result.rarity) >= State.RollStopRare then
				State.AutoRoll = false
				local flag = Airflow.Flags.AutoRoll
				if flag then
					pcall(function()
						flag:Set(false, true)
					end)
				end
				pushLog("<Warning>Auto roll stopped</Warning> rare plate found", "Warning")
				break
			end
		end
	end
end

local function plateNumber(uid)
	local text = tostring(uid or "")
	return tonumber(text:match("_(%d+)$"))
end

local function equippedUids(state)
	local set = {}
	local function add(slot)
		if type(slot) == "table" then
			if slot.uid then
				set[slot.uid] = true
				local number = plateNumber(slot.uid)
				if number then
					set[number] = true
				end
			end
		elseif type(slot) == "number" then
			set[slot] = true
		elseif type(slot) == "string" then
			set[slot] = true
			local number = plateNumber(slot)
			if number then
				set[number] = true
			end
		end
	end
	for _, slot in pairs(state and state.wall or {}) do
		add(slot)
	end
	if state then
		add(state.hand)
	end
	return set
end

function sellStep(force)
	local state = GameState or refreshState()
	if not state then
		return
	end
	if not State.SellScript then
		return
	end
	local inventory = {}
	for _, item in ipairs(state.inventory or {}) do
		table.insert(inventory, item)
	end
	if #inventory == 0 then
		return
	end
	table.sort(inventory, function(a, b)
		return (tonumber(a.price) or 0) > (tonumber(b.price) or 0)
	end)
	local wanted = {}
	for _, tier in ipairs(State.SellRarities or {}) do
		wanted[tier] = true
	end
	local protected = State.ProtectEquipped and equippedUids(state) or {}
	local keep = math.max(0, math.floor(State.KeepBest))
	local forced = force == true
	for index, item in ipairs(inventory) do
		local isProtected = protected[item.uid] == true or protected[plateNumber(item.uid)] == true
		if index > keep and not isProtected then
			local price = tonumber(item.price) or 0
			local byRarity = wanted[item.rarity] == true
			local byPrice = State.SellBelow > 0 and price <= State.SellBelow
			if byRarity or byPrice or forced then
				local ok, response = pcall(function()
					return remote("SellFromInventory"):InvokeServer(item.uid)
				end)
				if ok and type(response) == "table" and response.ok then
					Session.sold = Session.sold + 1
					Session.earned = Session.earned + price
					if GameState then
						GameState.money = (tonumber(GameState.money) or 0) + price
					end
					pushLog(string.format("Sold <Accent>%s</Accent> for %s", escapeRich(item.text or "?"), formatMoney(price)))
				elseif ok then
					pushLog("<Error>Sale rejected</Error> " .. escapeRich(type(response) == "table" and (response.err or "unknown") or "unknown"))
				end
				return
			end
		end
	end
end

local UPGRADE_PRIORITY = {
	luck = 100,
	speed = 90,
	multi = 85,
	autosell = 80,
	autoroll = 78,
	garage = 75,
	slots = 70,
	wall = 65,
	tasks = 55,
	polish = 50,
	stall = 45,
	phone = 40,
	car = 35,
	craft = 30,
}
local STRATEGY_FEATURES = { autosell = 1, autoroll = 1, garage = 1, phone = 1, tasks = 1, polish = 1, car = 1, craft = 1, stall = 1 }

local function upgradeCandidates(state)
	local list = {}
	if not Upgrades then
		return list
	end
	local upgrades = state and state.upgrades or {}
	local budget = (tonumber(state and state.money) or 0) - State.UpgradeReserve
	if budget <= 0 then
		return list
	end
	for _, node in ipairs(Upgrades.list or {}) do
		local level = Upgrades.level(upgrades, node.id)
		local cost = Upgrades.cost(node.id, level)
		if cost and cost <= budget and cost <= State.UpgradeMaxPrice then
			local unlocked = Upgrades.unlocked(upgrades, node.id)
			if unlocked then
				table.insert(list, { node = node, cost = cost, level = level })
			end
		end
	end
	return list
end

local function upgradeScore(candidate)
	local node = candidate.node
	if State.UpgradeStrategy == "Cheapest first" then
		return -candidate.cost
	elseif State.UpgradeStrategy == "Features first" then
		local feature = node.feature or (node.kind == "feature" and node.id or nil)
		local bonus = feature and 1 or 0
		return bonus * 1e9 - candidate.cost
	elseif State.UpgradeStrategy == "Luck first" then
		local priority = 0
		if node.kind == "special" then
			priority = 110
		elseif node.stat and UPGRADE_PRIORITY[node.stat] then
			priority = UPGRADE_PRIORITY[node.stat]
		elseif STRATEGY_FEATURES[node.feature or node.id] then
			priority = 60
		end
		return priority * 1e9 - candidate.cost
	end
	return -candidate.cost
end

local function upgradeStep()
	local state = GameState or refreshState()
	if not state then
		return
	end
	if #upgradeCandidates(state) == 0 then
		return
	end
	local candidates = upgradeCandidates(state)
	table.sort(candidates, function(a, b)
		return upgradeScore(a) > upgradeScore(b)
	end)
	local pick = candidates[1]
	if not pick then
		return
	end
	local ok, response = pcall(function()
		return remote("BuyUpgrade"):InvokeServer(pick.node.id)
	end)
	if ok and type(response) == "table" and response.ok then
		Session.upgradesBought = Session.upgradesBought + 1
		if GameState then
			GameState.money = (tonumber(GameState.money) or 0) - pick.cost
			GameState.upgrades = GameState.upgrades or {}
			GameState.upgrades[pick.node.id] = (GameState.upgrades[pick.node.id] or 0) + 1
		end
		pushLog(string.format("Upgrade <Accent>%s</Accent> for %s", escapeRich(pick.node.short or pick.node.name or pick.node.id), formatMoney(pick.cost)))
	elseif ok and type(response) == "table" then
		local message = tostring(response.err or "unknown")
		if message:find("уже максимум") then
			if GameState then
				GameState.upgrades = GameState.upgrades or {}
				GameState.upgrades[pick.node.id] = 1
			end
		else
			pushLog("<Error>Upgrade rejected</Error> " .. escapeRich(message))
			task.wait(0.5)
		end
	end
end

local function equipStep()
	local ok, response = pcall(function()
		return remote("EquipBest"):InvokeServer()
	end)
	if not ok then
		return
	end
	if type(response) == "table" and response.ok == false then
		pushLog("<Error>Equip best failed</Error> " .. escapeRich(tostring(response.err or "unknown")))
	end
end

local function upkeepStep()
	pcall(function()
		return remote("PayAllUpkeep"):InvokeServer()
	end)
end

local function claimStep()
	local state = GameState
	if not state or type(state.sold) ~= "table" then
		return
	end
	for _, entry in ipairs(state.sold) do
		local id = entry.id or entry.uid
		if id ~= nil then
			pcall(function()
				return remote("ClaimSold"):InvokeServer(id)
			end)
		end
	end
end

----- Scheduler -----

-- Flags are the source of truth: config loading and LoadAutoload can change them
-- without firing every callback, so the runtime state mirrors them every tick.
local function flagValue(name, current)
	local flag = Airflow.Flags[name]
	if not flag or type(flag.Get) ~= "function" then
		return current
	end
	local ok, value = pcall(flag.Get, flag)
	if ok and value ~= nil then
		return value
	end
	return current
end

local function syncFlags()
	State.AutoRoll = flagValue("AutoRoll", State.AutoRoll) == true
	State.RollPayment = tostring(flagValue("RollPayment", State.RollPayment))
	State.AutoEquip = flagValue("AutoEquip", State.AutoEquip) == true
	State.EquipAfterRoll = flagValue("EquipAfterRoll", State.EquipAfterRoll) == true
	State.SellEnabled = flagValue("AutoSell", State.SellEnabled) == true
	State.SellScript = flagValue("SellScript", State.SellScript) == true
	State.ProtectEquipped = flagValue("ProtectEquipped", State.ProtectEquipped) == true
	State.FreeSlot = flagValue("FreeSlot", State.FreeSlot) == true
	State.AutoUpgrade = flagValue("AutoUpgrade", State.AutoUpgrade) == true
	State.AutoUpkeep = flagValue("AutoUpkeep", State.AutoUpkeep) == true
	State.AutoClaimSold = flagValue("AutoClaimSold", State.AutoClaimSold) == true
	State.WebhookEnabled = flagValue("WebhookEnabled", State.WebhookEnabled) == true
	State.WebhookNotable = flagValue("WebhookNotable", State.WebhookNotable) == true
	State.RollMoneyGuard = tonumber(flagValue("RollMoneyGuard", State.RollMoneyGuard)) or State.RollMoneyGuard
	State.RollExtraDelay = tonumber(flagValue("RollExtraDelay", State.RollExtraDelay)) or State.RollExtraDelay
	State.EquipInterval = tonumber(flagValue("EquipInterval", State.EquipInterval)) or State.EquipInterval
	State.KeepBest = tonumber(flagValue("KeepBest", State.KeepBest)) or State.KeepBest
	State.SellBelow = tonumber(flagValue("SellBelow", State.SellBelow)) or State.SellBelow
	State.SellInterval = tonumber(flagValue("SellInterval", State.SellInterval)) or State.SellInterval
	State.UpgradeReserve = tonumber(flagValue("UpgradeReserve", State.UpgradeReserve)) or State.UpgradeReserve
	State.UpgradeMaxPrice = tonumber(flagValue("UpgradeMaxPrice", State.UpgradeMaxPrice)) or State.UpgradeMaxPrice
	State.UpgradeInterval = tonumber(flagValue("UpgradeInterval", State.UpgradeInterval)) or State.UpgradeInterval
end

local function scheduler()
	while true do
		task.wait(0.15)
		Session.ticks = (Session.ticks or 0) + 1
		local now = os.clock()
		local ok, err = pcall(function()
			syncFlags()
			if State.Paused then
				return
			end
			if State.AutoRoll and now >= Session.nextRollAt then
				rollStep()
			end
			if State.AutoEquip and now - Session.lastEquipAt >= State.EquipInterval then
				Session.lastEquipAt = now
				equipStep()
			end
			if State.SellEnabled and now - Session.lastSellAt >= State.SellInterval then
				Session.lastSellAt = now
				sellStep()
			end
			if State.AutoUpgrade and now - Session.lastUpgradeAt >= State.UpgradeInterval then
				Session.lastUpgradeAt = now
				upgradeStep()
			end
			if State.AutoUpkeep and now - Session.lastUpkeepAt >= 30 then
				Session.lastUpkeepAt = now
				upkeepStep()
			end
			if State.AutoClaimSold and now - Session.lastClaimAt >= State.ClaimInterval then
				Session.lastClaimAt = now
				claimStep()
			end
		end)
		if not ok then
			warn("[RobScript Numbers] scheduler: " .. tostring(err))
		end
	end
end

