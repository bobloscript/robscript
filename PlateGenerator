local function historyToText()
	local lines = { "time\tplate\tregion\trarity\tvalue" }
	for index = #Session.history, 1, -1 do
		local entry = Session.history[index]
		table.insert(lines, table.concat({
			entry.clock,
			entry.text .. " " .. tostring(entry.codeText or ""),
			tostring(entry.region or "-"),
			rarityLabel(entry.rarity),
			tostring(math.floor(tonumber(entry.price) or 0)),
		}, "\t"))
	end
	return table.concat(lines, "\n")
end

