local function buildWebhookPayload(entry)
	local color = rarityColor(entry.rarity)
	local colorInt = math.floor(color.R * 255) * 65536 + math.floor(color.G * 255) * 256 + math.floor(color.B * 255)
	local fields = {
		{ name = "Region", value = escapeRich(entry.region or "-"), inline = true },
		{ name = "Rarity", value = rarityLabel(entry.rarity), inline = true },
		{ name = "Condition", value = escapeRich(entry.quality or "-"), inline = true },
		{ name = "Value", value = formatMoney(entry.price), inline = true },
		{ name = "Rolls", value = tostring(Session.rolls), inline = true },
		{ name = "Money", value = formatMoney(GameState and GameState.money or 0), inline = true },
	}
	return {
		username = "Robscript Team",
		embeds = {
			{
				title = "New " .. rarityLabel(entry.rarity) .. " plate",
				description = "**" .. escapeRich(entry.text) .. " " .. escapeRich(entry.codeText or "") .. "**",
				color = colorInt,
				fields = fields,
				footer = { text = "Robscript Numbers · " .. tostring(LocalPlayer.Name) },
				timestamp = entry.iso,
			},
		},
	}
end

-- Executor request wrapper: returns success, http code and the transport message,
-- so the UI can tell "no network to this host" from "webhook deleted".
local function postJson(url, payload)
	local encoded, body = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not encoded then
		return false, 0, "json encode failed"
	end
	local ok, response = pcall(function()
		return request({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})
	end)
	if not ok then
		return false, 0, tostring(response)
	end
	local code = 0
	local message = ""
	local success = false
	if type(response) == "table" then
		code = tonumber(response.StatusCode) or 0
		message = tostring(response.StatusMessage or "")
		success = response.Success == true
	end
	local delivered = success and code >= 200 and code < 300
	return delivered, code, message
end

local function runWebhookLoop()
	while true do
		task.wait(1.2)
		Session.webhookQueue = #webhookQueue
		if #webhookQueue == 0 then
			continue
		end
		if not State.WebhookEnabled or State.WebhookUrl == "" then
			webhookQueue = {}
			continue
		end
		local entry = table.remove(webhookQueue, 1)
		local delivered, code, message = postJson(State.WebhookUrl, buildWebhookPayload(entry))
		if delivered then
			Session.lastWebhookAt = clockText()
			Session.webhookFails = 0
		else
			Session.webhookFails = (Session.webhookFails or 0) + 1
			Session.lastWebhookError = string.format("HTTP %d %s", code, message)
			if Session.webhookFails == 1 or Session.webhookFails % 10 == 0 then
				pushLog("<Error>Webhook failed</Error> " .. escapeRich(Session.lastWebhookError), "Error")
			end
		end
	end
end

