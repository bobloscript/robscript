----- Formatting -----

local function formatMoney(value)
	value = math.floor(tonumber(value) or 0)
	local digits = tostring(math.abs(value))
	local groups = {}
	while #digits > 3 do
		table.insert(groups, 1, digits:sub(-3))
		digits = digits:sub(1, #digits - 3)
	end
	table.insert(groups, 1, digits)
	return (value < 0 and "-" or "") .. table.concat(groups, " ") .. " ₽"
end

local function formatCompact(value)
	value = tonumber(value) or 0
	if value >= 1e9 then
		return string.format("%.2fB", value / 1e9)
	elseif value >= 1e6 then
		return string.format("%.2fM", value / 1e6)
	elseif value >= 1e3 then
		return string.format("%.1fK", value / 1e3)
	end
	return tostring(math.floor(value))
end

local function escapeRich(text)
	return (tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function clockText()
	return os.date("%H:%M:%S")
end

