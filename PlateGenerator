	if value and value > 0 then
		return value
	end
	local effects = Upgrades and state and Upgrades.effects(state.upgrades)
	if effects and effects.cooldown then
		return effects.cooldown
	end
	return 2
end

-- The server keeps the roll locked for the whole reveal animation, so the pace
-- is derived from the same schedule the game client plays.
local function revealSeconds(state, results)
	if not (Reveal and results) then
		return 0
	end
	local ratio = 1
	local configCooldown = Config and Config.Roll and Config.Roll.cooldownSeconds
	if configCooldown and configCooldown > 0 then
		ratio = math.max(0.2, rollCooldown(state) / configCooldown)
	end
	local okOrder, order = pcall(Reveal.order, results)
	if not okOrder or type(order) ~= "table" then
		return 0
	end
	local ordered = {}
	for index, position in ipairs(order) do
		ordered[index] = results[position]
	end
	local okSchedule, _, times = pcall(Reveal.schedule, ordered, ratio)
	if not okSchedule or type(times) ~= "table" then
		return 0
	end
	local longest = 0
	for _, value in ipairs(times) do
		longest = math.max(longest, tonumber(value) or 0)
	end
	return longest
end

local function platePrice(plate)
	if not plate then
		return 0
	end
	if Plate then
		local ok, price = pcall(Plate.price, plate)
		if ok and tonumber(price) then
			return math.floor(price)
		end
	end
	return 0
end

