			return "-"
		end
		local candidates = upgradeCandidates(state)
		if #candidates == 0 then
			return "<Muted>nothing affordable</Muted>"
		end
		table.sort(candidates, function(a, b)
			return upgradeScore(a) > upgradeScore(b)
		end)
		local pick = candidates[1]
		return string.format("%s · %s", escapeRich(pick.node.short or pick.node.id), formatMoney(pick.cost))
	end,
})

