local function sendTestWebhook()
	if State.WebhookUrl == "" then
		Window:Notify({ Title = "Webhook", Content = "Set the URL first", Type = "Warning" })
		return false, 0
	end
	local delivered, code, message = postJson(State.WebhookUrl, {
		username = "Robscript Team",
		embeds = {
			{
				title = "Webhook connected",
				description = "Robscript Numbers is ready to report plates",
				color = 16726815,
				footer = { text = "Robscript Numbers" },
			},
		},
	})
	Session.lastWebhookError = string.format("HTTP %d %s", code, message)
	if delivered then
		Window:Notify({ Title = "Webhook", Content = "Test message sent", Type = "Success" })
	elseif code == 0 then
		Window:Notify({
			Title = "Webhook",
			Content = "No connection to this host: " .. message .. ". Discord is blocked in some regions, use a relay or a VPN.",
			Type = "Error",
			Duration = 8,
		})
	else
		Window:Notify({ Title = "Webhook", Content = string.format("HTTP %d %s", code, message), Type = "Error" })
	end
	return delivered, code
end

