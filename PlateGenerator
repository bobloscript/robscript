	local list = {}
	for _, region in ipairs(state and state.regions or {}) do
		table.insert(list, region)
	end
	table.sort(list, function(a, b)
		local left = tonumber(a.regionMult) or 0
		local right = tonumber(b.regionMult) or 0
		if left == right then
			return tostring(a.name) < tostring(b.name)
		end
		return left > right
	end)
	for _, region in ipairs(list) do
		table.insert(options, tostring(region.name))
