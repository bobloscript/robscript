---Apply fullbright / no fog and restore anything turned off.
local function applyLighting()
	local wanted = {}
	if Settings.fullbright then
		for property, value in pairs(Const.FULLBRIGHT) do
			wanted[property] = value
		end
	end
	if Settings.noFog then
		wanted.FogEnd = 1e6
		wanted.FogStart = 1e6
	end

	for property, value in pairs(wanted) do
		if lightingCache[property] == nil then
			lightingCache[property] = lighting[property]
		end
		if lighting[property] ~= value then
			lighting[property] = value
		end
	end
	for property, original in pairs(lightingCache) do
		if wanted[property] == nil then
			lighting[property] = original
			lightingCache[property] = nil
		end
	end

	-- Atmosphere ignores FogEnd, so it needs thinning separately.
	if Settings.noFog then
		for _, atmosphere in ipairs(lighting:GetChildren()) do
			if not atmosphere:IsA("Atmosphere") then continue end
			if not atmosphereCache[atmosphere] then
				atmosphereCache[atmosphere] = { density = atmosphere.Density, haze = atmosphere.Haze }
			end
			atmosphere.Density = 0
			atmosphere.Haze = 0
		end
		return
	end

	for atmosphere, original in pairs(atmosphereCache) do
		if atmosphere.Parent then
			atmosphere.Density = original.density
			atmosphere.Haze = original.haze
		end
		atmosphereCache[atmosphere] = nil
	end
end

---Runs after the camera step so game FOV changes don't override ours.
local function updateCameraFov()
	if not currentCamera then return end
	if Settings.cameraFovEnabled then
		State.originalCameraFov = State.originalCameraFov or currentCamera.FieldOfView
		if currentCamera.FieldOfView ~= Settings.cameraFov then
			currentCamera.FieldOfView = Settings.cameraFov
		end
	elseif State.originalCameraFov then
		currentCamera.FieldOfView = State.originalCameraFov
		State.originalCameraFov = nil
	end
end

---Cursor position, or screen centre on touch-only devices.
---@return Vector2
local function getAimOrigin()
	if userInputService.TouchEnabled and not userInputService.MouseEnabled then
		return currentCamera.ViewportSize / 2
	end
	return userInputService:GetMouseLocation()
end

---Team check only applies when someone is actually on another team; FFA games often put everyone on one.
---@return boolean
local function teamsMatter()
	local now = os.clock()
	if now - State.teamCheckedAt < 1 then return State.teamsMatter end
	State.teamCheckedAt = now

	local myTeam = localPlayer.Team
	State.teamsMatter = false
	for _, player in ipairs(playersService:GetPlayers()) do
		if myTeam and player.Team ~= myTeam then
			State.teamsMatter = true
			break
		end
	end
	return State.teamsMatter
end

