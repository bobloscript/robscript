---Push the current settings into the menu controls.
local function refreshAll()
	for key, entry in pairs(FLAGS) do
		local value = Settings[key]
		if entry.toFlag then
			value = entry.toFlag(value)
		end
		if value ~= nil then
			pcall(function()
				entry.handle:Set(value, true)
			end)
		end
	end
end

---Copy what the menu shows back into Settings (config load, manual edits).
local function syncFromFlags()
	pcall(function()
		for key, entry in pairs(FLAGS) do
			local value = entry.handle.Value
			if value ~= nil then
				if entry.fromFlag then
					value = entry.fromFlag(value)
				end
				if value ~= nil then
					Settings[key] = value
				end
			end
		end
		for action, handle in pairs(BINDS) do
			local value = handle.Value
			if typeof(value) == "EnumItem" then
				value = value.Name
			end
			if type(value) == "string" and value ~= "" then
				Settings.binds[action] = value
			end
		end
	end)
end

