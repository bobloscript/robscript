local function gradient(colors, rotation)
	local keypoints = {}
	for index, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / (#colors - 1), color))
	end
	return create("UIGradient", { Color = ColorSequence.new(keypoints), Rotation = rotation or 0 })
end

---Stroke whose accent gradient spins forever.
local function animatedStroke(thickness)
	local stroke = create("UIStroke", { Color = Const.WHITE, Thickness = thickness or 1.5 })
	local strokeGradient = gradient({ Const.ACCENT, Const.ACCENT_ALT, Const.BACKGROUND, Const.ACCENT })
	strokeGradient.Parent = stroke
	addAnimator(stroke, function(_, deltaTime)
		strokeGradient.Rotation = (strokeGradient.Rotation + deltaTime * 60) % 360
	end)
	return stroke
end

