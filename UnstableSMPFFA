		---Register a control so settings can be pushed back into it.
		---@param key string
		---@param handle any
		---@param fromFlag function?
		---@param toFlag function?
		local function bind(key, handle, fromFlag, toFlag)
			if handle ~= nil then
				FLAGS[key] = { handle = handle, fromFlag = fromFlag, toFlag = toFlag }
			end
			return handle
		end

		local function optionIndex(options, option)
			for index, text in ipairs(options) do
				if text == option then
					return index
				end
			end
		end

		---A switch bound to a Settings key.
		local function toggle(parent, name, key, desc)
			return bind(key, parent:CreateToggle({
				Name = name,
				Desc = desc,
				Flag = "SMP_" .. key,
				CurrentValue = Settings[key] and true or false,
				Callback = function(state)
					Settings[key] = state
				end,
			}))
		end

		---A slider bound to a Settings key.
		local function slider(parent, name, key, minimum, maximum, increment, suffix, desc)
			return bind(key, parent:CreateSlider({
				Name = name,
				Desc = desc,
				Range = { minimum, maximum },
				Increment = increment,
				Suffix = suffix or "",
				Flag = "SMP_" .. key,
				CurrentValue = tonumber(Settings[key]) or minimum,
				Callback = function(value)
					Settings[key] = value
				end,
			}))
		end

		---A list bound to a Settings key that stores the option index.
		local function dropdown(parent, name, key, options, desc)
			return bind(key, parent:CreateDropdown({
				Name = name,
				Desc = desc,
				Options = options,
				Flag = "SMP_" .. key,
				CurrentOption = options[Settings[key]] or options[1],
				Callback = function(option)
					local index = optionIndex(options, option)
					if index then
						Settings[key] = index
					end
				end,
			}), function(option)
				return optionIndex(options, option)
			end, function(index)
				return options[index] or options[1]
			end)
		end

		---A key that runs an action while in game.
		local function keybind(parent, name, action, default, desc)
			local handle = parent:CreateKeybind({
				Name = name,
				Desc = desc,
				Flag = "SMPBind_" .. action,
				CurrentKeybind = Settings.binds[action] or default,
				Callback = function(key)
					if typeof(key) == "EnumItem" then
						key = key.Name
					end
					Settings.binds[action] = tostring(key)
				end,
			})
			BINDS[action] = handle
			return handle
		end

