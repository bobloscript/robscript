	---Load the Robly Airflow build the RobScript hubs use.
	---@return table?
	local function loadAirflow()
		local sources = {
			"https://raw.githubusercontent.com/bobloscript/Robly_Airflow/main/Source.luau",
			"https://raw.githubusercontent.com/PookiePepelsss/Airflow-UI/refs/heads/main/Source.luau",
		}
		for _, url in ipairs(sources) do
			local ok, library = pcall(function()
				return loadstring(game:HttpGet(url))()
			end)
			if ok and typeof(library) == "table" and typeof(library.CreateWindow) == "function" then
				return library
			end
		end
		return nil
	end

