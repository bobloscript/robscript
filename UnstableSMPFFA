		[Const.LOOK_BIND] = "X",
		["smash"] = "Q",
		["dash"] = "C",
		["fly"] = "G",
	}

	---Flip a module from a key and keep the menu in step with it.
	---@param key string
	---@param name string
	local function flip(key, name)
		Settings[key] = not Settings[key]
		refreshAll()
		notify(name .. (Settings[key] and " on" or " off"))
	end

	local keyActions = {
		[Const.AIM_BIND] = function()
			flip("aimbot", "Camera lock")
		end,
		[Const.AURA_BIND] = function()
			flip("killAura", "Kill aura")
		end,
		[Const.CAMERA_BIND] = function()
			flip("cameraFovEnabled", "Zoom")
		end,
		[Const.LOOK_BIND] = function()
			Settings.cameraMode = Settings.cameraMode % #Const.CAMERA_MODES + 1
			refreshAll()
			notify("Camera: " .. Const.CAMERA_MODES[Settings.cameraMode])
		end,
		["smash"] = function()
			comboSmash()
		end,
		["dash"] = function()
			windDash()
		end,
		["fly"] = function()
			flip("fly", "Flight")
		end,
	}

	track(userInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard or gameProcessed then return end
		local pressed = input.KeyCode.Name
		for action, default in pairs(BIND_DEFAULTS) do
			if keyActions[action] and (Settings.binds[action] or default) == pressed then
				keyActions[action]()
				return
			end
		end
	end))

	---FPS counter for the watermark.
	local function stepFps(deltaTime)
		State.fpsFrames += 1
		State.fpsTime += deltaTime
		if State.fpsTime >= 0.5 then
			State.fps = State.fpsFrames / State.fpsTime
			State.fpsFrames, State.fpsTime = 0, 0
		end
	end

	local lastRender = os.clock()

	---Aim and camera work: runs right after the game's own camera step.
	local function onRender()
		local now = os.clock()
		local deltaTime = math.min(now - lastRender, 0.1)
		lastRender = now

		if workspace.CurrentCamera ~= currentCamera then
			currentCamera = workspace.CurrentCamera
		end
		if not Unstable.running then return end

		stepCameraSync()
		updateAimbot(deltaTime)
		updateAuraCamera(deltaTime)
		updateLookOverride()
		updateCameraFov()
		stepFps(deltaTime)

		-- Spinning strokes and the rest of the menu animation.
		for index = #animators, 1, -1 do
			local entry = animators[index]
			if entry.owner.Parent then
				entry.fn(entry.owner, deltaTime)
			else
				table.remove(animators, index)
			end
		end
	end

	---Combat, items, ESP and the HUD.
	---@param deltaTime number
	local function onHeartbeat(deltaTime)
		if not Unstable.running then return end
		-- The menu owns the values; copy them back in case a config was loaded.
		syncFromFlags()
		applyLighting()
		stepCombat(deltaTime)
		updateWatermark()
	end

	---Keep the game from kicking an idle player.
	local function antiAfkLoop()
		while Unstable.running do
			task.wait(45)
			if Unstable.running and Settings.antiAfk and virtualUser then
				pcall(function()
					virtualUser:CaptureController()
					virtualUser:Button2Down(Vector2.zero, currentCamera.CFrame)
					task.wait(0.1)
					virtualUser:Button2Up(Vector2.zero, currentCamera.CFrame)
				end)
			end
		end
	end

	---Drop the reach ring when the script goes away.
	local function clearReach()
		if reachRing then
			reachRing:Destroy()
			reachRing = nil
		end
	end

	---Stop everything this script added and close the menu.
	function shutdown()
		if not Unstable.running then return end
		Unstable.running = false

		pcall(function()
			runService:UnbindFromRenderStep("UnstableAim")
		end)
		for _, connection in ipairs(connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end

		pcall(clearEsp)
		pcall(restoreHitboxes)
		pcall(clearReach)

		Settings.fullbright, Settings.noFog = false, false
		pcall(applyLighting)
		Settings.cameraFovEnabled = false
		pcall(updateCameraFov)

		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local flyBody = rootPart:FindFirstChild("UnstableFly")
			if flyBody then
				flyBody:Destroy()
			end
		end
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.WalkSpeed = State.baseSpeed or 16
			if State.baseJump and humanoid.UseJumpPower then
				humanoid.JumpPower = State.baseJump
			end
		end

		if Window then
			pcall(function()
				Window:Destroy()
			end)
			Window = nil
		end
		if hubGui then
			hubGui:Destroy()
			hubGui = nil
		end
		Environment.UnstableSMP = nil
		Environment.UnstableSMPWindow = nil
		Environment.UnstableSMPShutdown = nil
		print("[RobScript] Unstable SMP stopped")
	end

	local function start()
		Unstable.running = true
		Environment.UnstableSMPShutdown = shutdown

		local ok, err = pcall(buildHub)
		if not ok then
			shutdown()
			error("[" .. Const.HUB_NAME .. "] interface failed to build: " .. tostring(err))
		end

		Environment.UnstableSMP = {
			Airflow = Airflow,
			Window = Window,
			Flags = FLAGS,
			Settings = Settings,
			Shutdown = shutdown,
		}
		Environment.UnstableSMPWindow = Window

		runService:BindToRenderStep("UnstableAim", Enum.RenderPriority.Camera.Value + 1, onRender)
		track(runService.Heartbeat:Connect(onHeartbeat))

		track(localPlayer.CharacterAdded:Connect(function()
			State.baseSpeed, State.baseJump = nil, nil
			State.currentSlot, State.hotbarSlots, State.hotbarIcons = nil, nil, nil
			State.lastHealth, State.hudRatio = nil, nil
			State.auraTarget, State.maceTarget, State.maceArmed = nil, nil, false
			State.hotbarNames, State.missingItems = {}, {}
			State.safeCFrame, State.airJumps = nil, 0
			task.wait(0.5)
			if Unstable.running then
				restoreHitboxes()
			end
		end))

		track(playersService.PlayerRemoving:Connect(function(player)
			if player.Character then
				pcall(removeEsp, player.Character)
				alerted[player.Character] = nil
			end
		end))

		task.spawn(antiAfkLoop)
		notify("Ready  •  RightControl hides the menu")
	end

	start()
end
