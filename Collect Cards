				return a.price < b.price
			end)
			local labels = {}
			for _, entry in ipairs(entries) do
				table.insert(labels, entry.label)
			end
			PacksFilter:SetOptions(labels, { KeepSelection = true })
			return
		end
		task.wait(0.5)
	end
end)

