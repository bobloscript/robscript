DupesInfo:CreateStatusList({
	MaxRows = 8,
	UpdateRate = 5,
	Update = function()
		local cat = catalog()
		if not cat or not cat.cards then
			return {}
		end
		local counts, definitions = {}, {}
		for _, item in ipairs(allCards()) do
			if item.state == "Available" then
				local definition = cat.cards[item.definitionId]
				if definition then
					counts[item.definitionId] = (counts[item.definitionId] or 0) + 1
					definitions[item.definitionId] = definition
				end
			end
		end
		local list = {}
		for definitionId, count in pairs(counts) do
			if count > 1 then
				table.insert(list, { id = definitionId, count = count, definition = definitions[definitionId] })
			end
		end
		table.sort(list, function(a, b)
			return a.count > b.count
		end)
		local rows = {}
		for index = 1, math.min(8, #list) do
			local entry = list[index]
			table.insert(rows, {
				Text = (entry.definition.name or entry.id) .. " x" .. entry.count,
				Value = money((entry.definition.dealerValue or 0) * (entry.count - Settings.dupesKeep)),
				Tone = entry.count > 3 and "Warning" or "Muted",
			})
		end
		return rows
	end,
})

-- Rarity list comes from the card catalogue.
task.spawn(function()
	local deadline = os.clock() + 60
	while os.clock() < deadline do
		local cat = catalog()
		if cat and cat.cards then
			local seen = {}
			for _, definition in pairs(cat.cards) do
				if definition.rarity then
					seen[definition.rarity] = true
				end
			end
			local list = {}
			for rarity in pairs(seen) do
				table.insert(list, rarity)
			end
			table.sort(list)
			DupesRarityFilter:SetOptions(list, { KeepSelection = true })
			return
		end
		task.wait(0.5)
	end
end)

