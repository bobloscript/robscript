-- A switching element starts a loop, and stopping it (or running the script
-- again) ends that loop cleanly.
getgenv().__CollectCardsHubGen = (getgenv().__CollectCardsHubGen or 0) + 1
local SCRIPT_GENERATION = getgenv().__CollectCardsHubGen

local function scriptAlive()
	return getgenv().__CollectCardsHubGen == SCRIPT_GENERATION
end

local runners = {}
local function runner(name, step)
	runners[name] = runners[name] or { generation = 0 }
	local entry = runners[name]
	return function(enabled)
		entry.generation += 1
		local myGeneration = entry.generation
		if not enabled then
			return
		end
		task.spawn(function()
			while entry.generation == myGeneration and scriptAlive() do
				local ok, err = pcall(step)
				if not ok then
					log("<Error>" .. name .. " stopped: " .. tostring(err) .. "</Error>")
				end
				if entry.generation ~= myGeneration or not scriptAlive() then
					break
				end
				task.wait(0.25)
			end
		end)
	end
end

local function runOnce(name, step)
	task.spawn(function()
		local ok, err = pcall(step)
		if not ok then
			log("<Error>" .. name .. ": " .. tostring(err) .. "</Error>")
		end
	end)
end

----------------------------------------------------------------------
-- 1. TYCOON: buying upgrade pads
----------------------------------------------------------------------

local padCooldown = {}

local function myPads()
	local result = {}
	local lobby = workspace:FindFirstChild("Lobby")
	local plots = lobby and lobby:FindFirstChild("Plots")
	if not plots then
		return result
	end
	for _, plot in ipairs(plots:GetChildren()) do
		local tycoon = plot:FindFirstChild("Tycoon")
		if tycoon then
			for _, model in ipairs(tycoon:GetChildren()) do
				local button = model:FindFirstChild("Button", true)
				if
					button
					and button:IsA("BasePart")
					and button:GetAttribute("TycoonOwner") == LocalPlayer.UserId
					and button:GetAttribute("TycoonAvailable") == true
				then
					table.insert(result, {
						name = model.Name,
						button = button,
						id = button:GetAttribute("TycoonUpgrade"),
						price = tonumber(button:GetAttribute("TycoonPrice")) or 0,
						floor = tonumber(button:GetAttribute("TycoonFloor")) or 1,
					})
				end
			end
		end
	end
	return result
end

--- Standing on a pad is enough: the game buys it by itself. If it does not,
--- we ask for the upgrade directly. Returns "Bought" or a short reason.
local function usePad(pad)
	if busy() then
		waitIdle(8)
	end

	local deadline = os.clock() + 2
	while os.clock() < deadline do
		local button = pad.button
		if not button or not button.Parent or button:GetAttribute("TycoonAvailable") ~= true then
			return "Bought"
		end
		task.wait(0.1)
	end

	local answer, reason = runAction("BuyTycoonUpgrade", {
		upgradeId = pad.id,
		floor = pad.floor,
	}, 12)

	if answer and answer.status == "Completed" then
		return "Bought"
	end
	return tostring(reason)
end

--- One attempt to buy the next upgrade we can afford.
local function buyNextUpgrade()
	if not gameState() then
		return "Still loading your shop"
	end

	local pads = myPads()
	if #pads == 0 then
		return "No upgrades left to buy"
	end

	if Settings.tycoonOrder == "Cheapest" then
		table.sort(pads, function(a, b)
			return a.price < b.price
		end)
	end

	local affordable = 0
	local cheapest
	for _, pad in ipairs(pads) do
		if pad.price <= cash() - Settings.tycoonReserve then
			affordable += 1
			cheapest = cheapest or pad
		end
	end
	if affordable == 0 then
		table.sort(pads, function(a, b)
			return a.price < b.price
		end)
		return "Waiting for cash (next one costs " .. money(pads[1].price) .. ")"
	end

	for _, pad in ipairs(pads) do
		local blockedUntil = padCooldown[pad.id]
		if blockedUntil and os.clock() < blockedUntil then
			continue
		end
		if pad.price > cash() - Settings.tycoonReserve then
			continue
		end

		local reason

		if Settings.tycoonMethod ~= "Walk" then
			log("Going to <Accent>" .. tostring(pad.name) .. "</Accent> (" .. money(pad.price) .. ")")
			if jumpTo(pad.button.Position) then
				reason = usePad(pad)
				if reason == "Bought" then
					return "Bought " .. tostring(pad.name)
				end
				if Settings.tycoonMethod == "Teleport" then
					padCooldown[pad.id] = os.clock() + 10
					return "Could not buy " .. tostring(pad.name) .. " (" .. reason .. ")"
				end
				log("<Warning>" .. reason .. " - walking there instead</Warning>")
			elseif Settings.tycoonMethod == "Teleport" then
				padCooldown[pad.id] = os.clock() + 10
				return "Could not reach " .. tostring(pad.name)
			end
		else
			log("Walking to <Accent>" .. tostring(pad.name) .. "</Accent> (" .. money(pad.price) .. ")")
		end

		local reached, distance = walkTo(pad.button.Position, 22)
		if not reached then
			padCooldown[pad.id] = os.clock() + 20
			return "Could not walk to " .. tostring(pad.name) .. " (" .. string.format("%.1f", distance) .. " studs away)"
		end

		reason = usePad(pad)
		if reason == "Bought" then
			return "Bought " .. tostring(pad.name)
		end

		padCooldown[pad.id] = os.clock() + 15
		return "Could not buy " .. tostring(pad.name) .. " (" .. reason .. ")"
	end

	return "All affordable pads are cooling down"
end

local tycoonAutoStep
tycoonAutoStep = runner("Tycoon", function()
	if not Settings.tycoonAuto then
		return
	end
	local outcome = buyNextUpgrade()
	if string.find(outcome, "Waiting for cash", 1, true) then
		task.wait(2)
	elseif string.find(outcome, "cooling down", 1, true) then
		task.wait(2)
	elseif string.find(outcome, "Could not", 1, true) then
		log("<Warning>" .. outcome .. "</Warning>")
		task.wait(1.5)
	elseif string.find(outcome, "No upgrades", 1, true) then
		log("<Muted>" .. outcome .. "</Muted>")
		Settings.tycoonAuto = false
		tycoonAutoStep(false)
	else
		log("<Success>" .. outcome .. "</Success>")
		task.wait(Settings.tycoonDelay)
	end
end)

----------------------------------------------------------------------
-- 2. SHOP: packs and furniture
----------------------------------------------------------------------

local function packAllowed(id)
	if next(Settings.shopPackFilter) == nil then
		return true
	end
	return Settings.shopPackFilter[id] == true
end

local function furnitureAllowed(id)
	if next(Settings.shopFurnitureFilter) == nil then
		return true
	end
	return Settings.shopFurnitureFilter[id] == true
end

local function buyCheapestPack()
	local cat, ven, s = catalog(), vendor(), gameState()
	if not (cat and ven and s and cat.packs and ven.offers) then
		return false
	end
	if s.capacity and s.capacity.ownedPacks >= s.capacity.packs then
		log("<Warning>Pack storage is full</Warning>")
		return false
	end

	local best, bestPrice
	for id, offer in pairs(ven.offers) do
		local definition = cat.packs[id]
		if definition and packAllowed(id) and type(offer.price) == "number" and (offer.remaining or 0) >= 1 then
			if offer.price <= cash() - Settings.shopReserve then
				if not bestPrice or offer.price < bestPrice then
					best, bestPrice = id, offer.price
				end
			end
		end
	end
	if not best then
		return false
	end

	local answer, reason = runAction("BuyPack", {
		quantity = 1,
		skuId = best,
		offerId = ven.offers[best].offerId,
	}, 12)

	if answer and answer.status == "Completed" then
		local entry = cat.packs[best]
		local name = ((entry.definition or entry).name or best)
		log("<Success>Pack: " .. name .. " for " .. money(bestPrice) .. "</Success>")
		Game.Refresh()
		return true
	end
	log("<Warning>Pack " .. tostring(best) .. ": " .. tostring(reason) .. "</Warning>")
	return false
end

local function buyCheapestFurniture()
	local cat, ven = catalog(), vendor()
	if not (cat and ven and cat.furniture and ven.furniture) then
		return false
	end

	local placed = 0
	if gameState() and gameState().furniture then
		for _ in pairs(gameState().furniture) do
			placed += 1
		end
	end
	if placed >= (tonumber(cat.maxFurniture) or 400) then
		log("<Warning>You own the maximum amount of furniture</Warning>")
		return false
	end

	local best, bestPrice
	for id, offer in pairs(ven.furniture) do
		local definition = cat.furniture[id]
		if definition and furnitureAllowed(id) and type(offer.price) == "number" and (offer.remaining or 0) >= 1 then
			if offer.price <= cash() - Settings.shopReserve then
				if not bestPrice or offer.price < bestPrice then
					best, bestPrice = id, offer.price
				end
			end
		end
	end
	if not best then
		return false
	end

	local answer, reason = runAction("BuyFurniture", {
		definitionId = best,
		offerId = ven.furniture[best].offerId,
	}, 12)

	if answer and answer.status == "Completed" then
		local entry = cat.furniture[best]
		local name = ((entry.definition or entry).name or best)
		log("<Success>Furniture: " .. name .. " for " .. money(bestPrice) .. "</Success>")
		Game.Refresh()
		return true
	end
	log("<Warning>Furniture " .. tostring(best) .. ": " .. tostring(reason) .. "</Warning>")
	return false
end

local shopFlip = false
local shopAutoStep
shopAutoStep = runner("Shop", function()
	if not (Settings.shopBuyPacks or Settings.shopBuyFurniture) then
		return
	end

	local kinds = {}
	if Settings.shopBuyFurniture then
		table.insert(kinds, "Furniture")
	end
	if Settings.shopBuyPacks then
		table.insert(kinds, "Packs")
	end

	if #kinds == 2 then
		if Settings.shopPriority == "Packs" then
			kinds = { "Packs", "Furniture" }
		elseif Settings.shopPriority == "Balanced" then
			shopFlip = not shopFlip
			kinds = shopFlip and { "Furniture", "Packs" } or { "Packs", "Furniture" }
		end
	end

	for _, kind in ipairs(kinds) do
		if kind == "Furniture" then
			if buyCheapestFurniture() then
				task.wait(0.3)
				return
			end
		elseif kind == "Packs" then
			if buyCheapestPack() then
				task.wait(0.3)
				return
			end
		end
	end
end)

--- Keeps the shop loop running while at least one category is switched on.
local function syncShop()
	shopAutoStep(Settings.shopBuyPacks or Settings.shopBuyFurniture)
end

----------------------------------------------------------------------
-- 3. TOWER: auto battle
----------------------------------------------------------------------

local TOWERS = {
	{ id = "EmberOrigins", name = "Ember Origins" },
	{ id = "HydraAwakening", name = "Hydra Awakening" },
	{ id = "PocketPandemonium", name = "Pocket Pandemonium" },
	{ id = "RealmCollision", name = "Realm Collision" },
	{ id = "PrismaticWonders", name = "Prismic Wonders" },
}

local battleStats = {
	floor = 0,
	runs = 0,
	wins = 0,
	losses = 0,
	lastRunId = nil,
	stuckAttempts = 0,
	deckReady = false,
	deckAt = 0,
}

local function ensureDeck()
	local deck = ask("GetBattleDeck")
	if not deck or deck.status ~= "Completed" or not deck.battle then
		return false
	end
	if #(deck.battle.deck or {}) > 0 then
		return true
	end

	local cards = deck.cards or {}
	table.sort(cards, function(a, b)
		return (tonumber(a.score) or 0) > (tonumber(b.score) or 0)
	end)
	local ids = {}
	for index = 1, math.min(4, #cards) do
		ids[index] = cards[index].assetId
	end
	if #ids == 0 then
		return false
	end

	local answer = runAction("SaveBattleDeck", { assetIds = ids }, 10)
	if answer and answer.status == "Completed" then
		log("<Success>Deck filled with your best " .. #ids .. " cards</Success>")
		return true
	end
	return false
end

local function collectTowerRewards()
	local answer = runAction("ClaimBattlePacks", {}, 10)
	if answer and answer.status == "Completed" and answer.result and answer.result.packIds and #answer.result.packIds > 0 then
		log("<Success>Collected " .. #answer.result.packIds .. " tower reward pack(s)</Success>")
	end
end

local battleAutoStep
battleAutoStep = runner("Tower", function()
	if not Settings.battleAuto then
		return
	end

	if Settings.battleStopFloor > 0 and battleStats.floor >= Settings.battleStopFloor then
		log("<Warning>Reached floor " .. Settings.battleStopFloor .. ", battle stopped</Warning>")
		Settings.battleAuto = false
		battleAutoStep(false)
		return
	end

	if busy() then
		waitIdle(10)
	end

	if Settings.battleAutoDeck and (not battleStats.deckReady or (os.clock() - battleStats.deckAt) > 60) then
		battleStats.deckReady = ensureDeck()
		battleStats.deckAt = os.clock()
	end

	local run = ask("StartBattle", { towerId = Settings.battleTower, continue = true })
	if not run then
		log("<Error>No answer from the tower</Error>")
		return
	end

	if run.status ~= "Completed" or not run.runId then
		local code = tostring(run.code or run.status)

		if code == "BattleActive" then
			-- A battle is still open somewhere, usually left over from a reload.
			-- Cancel the one we know about; if that fails, respawn clears it.
			battleStats.stuckAttempts = (battleStats.stuckAttempts or 0) + 1

			if battleStats.lastRunId then
				ask("CancelBattle", { runId = battleStats.lastRunId })
				battleStats.lastRunId = nil
				log("<Warning>Cancelling the old battle</Warning>")
			elseif battleStats.stuckAttempts >= 3 then
				log("<Warning>Resetting the stuck battle</Warning>")
				local character = LocalPlayer.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
				battleStats.stuckAttempts = 0
			end

			task.wait(2)
			return
		end

		log("<Error>Tower said: " .. code .. "</Error>")
		Settings.battleAuto = false
		battleAutoStep(false)
		return
	end

	battleStats.stuckAttempts = 0
	battleStats.lastRunId = run.runId
	battleStats.floor = tonumber(run.floor) or battleStats.floor

	local waitTime = math.max(tonumber(run.minSeconds) or 1.8, 1.4) + Settings.battleDelay
	task.wait(waitTime)

	local answer, reason = runAction("FinishBattle", { runId = run.runId }, 15)
	battleStats.lastRunId = nil

	if not answer then
		log("<Warning>Battle did not finish: " .. tostring(reason) .. "</Warning>")
		ask("CancelBattle", { runId = run.runId })
		return
	end

	if answer.status ~= "Completed" then
		log("<Warning>Battle: " .. tostring(answer.code or answer.status) .. "</Warning>")
		return
	end

	local result = answer.result or {}
	battleStats.runs += 1
	local earned = tonumber(result.cash) or 0

	if result.winner == "Player" then
		battleStats.wins += 1
		battleStats.floor = tonumber(result.nextFloor) or battleStats.floor
		log("<Success>Floor " .. tostring(result.floor) .. " cleared, +" .. money(earned) .. "</Success>")
	else
		battleStats.losses += 1
		log("<Warning>Floor " .. tostring(result.floor) .. " lost</Warning>")
		if Settings.battleStopOnLoss then
			Settings.battleAuto = false
			battleAutoStep(false)
			notify("Auto battle", "Lost on floor " .. tostring(result.floor) .. ", stopped", "Warning")
			return
		end
	end

	if Settings.battleClaimPacks then
		if (result.packIds and #result.packIds > 0) or (result.winner == "Player" and battleStats.runs % 5 == 0) then
			collectTowerRewards()
		end
	end
end)

----------------------------------------------------------------------
-- 4. PACKS: opening
----------------------------------------------------------------------

local packStats = { opened = 0, cards = 0, duplicates = 0 }

local function packTypeAllowed(id)
	if next(Settings.packsFilter) == nil then
		return true
	end
	return Settings.packsFilter[id] == true
end

local packsAutoStep
packsAutoStep = runner("Packs", function()
	if not Settings.packsAuto then
		return
	end
	local s = gameState()
	if not s or not s.capacity then
		return
	end

	local inventory = ask("GetInventory", { kind = "Pack", limit = 100, offset = 0 })
	if not inventory or inventory.status ~= "Completed" or not inventory.result then
		return
	end

	local owned = {}
	for _, item in ipairs(inventory.result.items or {}) do
		if item.kind == "Pack" and packTypeAllowed(item.skuId) then
			table.insert(owned, item)
		end
	end
	if #owned == 0 then
		return
	end

	if s.capacity.ownedCards + 3 > s.capacity.cards then
		log("<Warning>Card storage is full, packs stay closed</Warning>")
		return
	end

	local batch = {}
	for index = 1, math.min(Settings.packsPerBatch, #owned) do
		batch[index] = owned[index].id
	end

	local answer, reason = runAction("OpenPack", (#batch == 1) and { assetId = batch[1] } or { assetIds = batch }, 20)
	if answer and answer.status == "Completed" then
		local cards = (answer.result and answer.result.cards) or {}
		packStats.opened += #batch
		packStats.cards += #cards

		local seen, duplicates = {}, 0
		for _, card in ipairs(cards) do
			local id = card.definitionId or card.id
			if seen[id] then
				duplicates += 1
			else
				seen[id] = true
			end
		end
		packStats.duplicates += duplicates

		log("<Success>Opened " .. #batch .. " pack(s): " .. #cards .. " cards"
			.. (duplicates > 0 and (", " .. duplicates .. " duplicates") or "") .. "</Success>")
		Game.Refresh()
	else
		log("<Warning>Could not open a pack: " .. tostring(reason) .. "</Warning>")
	end

	task.wait(Settings.packsDelay)
end)

----------------------------------------------------------------------
-- 5. DUPES: selling spare copies
----------------------------------------------------------------------

local dupeStats = { sold = 0, earned = 0, batches = 0 }

local function allCards()
	local all = {}
	local offset = 0
	for _ = 1, 40 do
		local answer = ask("GetInventory", { kind = "Card", limit = 100, offset = offset })
		if not answer or answer.status ~= "Completed" or not answer.result then
			break
		end
		for _, item in ipairs(answer.result.items or {}) do
			table.insert(all, item)
		end
		local nextOffset = answer.result.nextOffset
		if type(nextOffset) ~= "number" or nextOffset <= offset then
			break
		end
		offset = nextOffset
	end
	return all
end

local function rarityAllowed(rarity)
	if next(Settings.dupesRarities) == nil then
		return true
	end
	return Settings.dupesRarities[rarity] == true
end

local function spareCopies()
	local cat = catalog()
	if not cat or not cat.cards then
		return {}
	end

	local inDeck = {}
	if Settings.dupesSkipDeck and gameState() and gameState().battle and gameState().battle.deck then
		for _, assetId in ipairs(gameState().battle.deck) do
			inDeck[assetId] = true
		end
	end

	local groups = {}
	for _, item in ipairs(allCards()) do
		if item.kind == "Card" and item.state == "Available" and not item.favorite and item.grade == nil then
			groups[item.definitionId] = groups[item.definitionId] or {}
			table.insert(groups[item.definitionId], item)
		end
	end

	local candidates = {}
	for definitionId, items in pairs(groups) do
		local definition = cat.cards[definitionId]
		if
			#items > Settings.dupesKeep
			and definition
			and definition.dealerEnabled ~= false
			and type(definition.dealerValue) == "number"
			and definition.dealerValue >= Settings.dupesMinValue
			and rarityAllowed(definition.rarity)
		then
			table.sort(items, function(a, b)
				return tostring(a.id) < tostring(b.id)
			end)
			for index = Settings.dupesKeep + 1, #items do
				if not inDeck[items[index].id] then
					table.insert(candidates, items[index].id)
				end
				if #candidates >= 50 then
					break
				end
			end
		end
		if #candidates >= 50 then
			break
		end
	end
	return candidates
end

local function sellBatch()
	local ids = spareCopies()
	if #ids == 0 then
		return 0
	end

	local batch = {}
	for index = 1, math.min(25, #ids) do
		batch[index] = ids[index]
	end

	if Settings.dupesDryRun then
		log("[dry run] Would sell " .. #batch .. " spare card(s)")
		task.wait(1)
		return 0
	end

	local quote = ask("QuoteDealer", { assetIds = batch })
	if not quote or quote.status ~= "Completed" or type(quote.quoteId) ~= "string" then
		log("<Warning>The dealer is not buying right now</Warning>")
		return 0
	end

	local answer, reason = runAction("SellCards", { confirm = true, quoteId = quote.quoteId }, 15)
	if answer and answer.status == "Completed" then
		local received = tonumber(answer.result and answer.result.received) or 0
		dupeStats.sold += #batch
		dupeStats.earned += received
		dupeStats.batches += 1
		log("<Success>Sold " .. #batch .. " spare card(s) for " .. money(received) .. "</Success>")
		Game.Refresh()
		return #batch
	end

	log("<Warning>Could not sell: " .. tostring(reason) .. "</Warning>")
	return 0
end

local dupesAutoStep
dupesAutoStep = runner("Dupes", function()
	if not Settings.dupesAuto then
		return
	end
	sellBatch()
	task.wait(0.6)
end)

