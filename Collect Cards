----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function money(value)
	if type(value) ~= "number" then
		return "-"
	end
	local text = tostring(math.floor(value))
	local grouped = text:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (grouped:gsub("^%s+", ""))
end

local function gameState()
	return Game.State
end

local function catalog()
	return Game.Catalog
end

local function vendor()
	return Game.Vendor
end

local function cash()
	local s = gameState()
	return (s and tonumber(s.cash)) or 0
end

local function busy()
	local s = gameState()
	return Game.Busy == true or (s ~= nil and s.pending == true)
end

local function waitIdle(timeout)
	local deadline = os.clock() + (timeout or 10)
	while busy() and os.clock() < deadline do
		task.wait(0.05)
	end
	return not busy()
end

--- Sends one purchase/menu action and waits for the game to answer it.
--- Returns the answer and a short reason when it failed.
local function runAction(action, payload, timeout)
	if busy() then
		waitIdle(timeout)
	end
	if busy() then
		return nil, "The game is busy"
	end

	local answer
	local connection = Game.CommandFinished.Event:Connect(function(finishedAction, finishedAnswer)
		if finishedAction == action then
			answer = finishedAnswer
		end
	end)

	local sent = Game.Command(action, payload)
	if not sent then
		connection:Disconnect()
		return nil, "Not ready yet"
	end

	local deadline = os.clock() + (timeout or 10)
	while not answer and os.clock() < deadline do
		task.wait(0.05)
	end
	connection:Disconnect()

	if not answer then
		return nil, "No answer from the game"
	end
	return answer, answer.code or answer.status
end

local function ask(action, payload)
	local ok, answer = pcall(function()
		return Game.Query(action, payload)
	end)
	if not ok or type(answer) ~= "table" then
		return nil
	end
	return answer
end

local function flatDistance(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

----------------------------------------------------------------------
-- Moving to a pad
----------------------------------------------------------------------

--- Puts the character straight on the pad. Instant, no walking.
local function jumpTo(position)
	local character = LocalPlayer.Character
	if not character then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local ok = pcall(function()
		character:PivotTo(CFrame.new(position + Vector3.new(0, 4, 0)))
	end)
	if not ok then
		return false
	end
	task.wait(0.15)
	return flatDistance(root.Position, position) < 5
end

--- Walks the character to the pad along a path. Slower, but always allowed.
local function walkTo(targetPosition, timeout)
	timeout = timeout or 20
	local character = LocalPlayer.Character
	if not character then
		return false, -1
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then
		return false, -1
	end

	local waypoints
	local ok = pcall(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			WaypointSpacing = 5,
		})
		path:ComputeAsync(root.Position, targetPosition)
		if path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
		end
	end)
	if not ok or not waypoints then
		waypoints = { { Position = targetPosition, Action = Enum.PathWaypointAction.Walk } }
	end

	local deadline = os.clock() + timeout
	for index, waypoint in ipairs(waypoints) do
		if index > 1 then
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
			local stepDeadline = os.clock() + 3.5
			while os.clock() < stepDeadline and os.clock() < deadline do
				if flatDistance(root.Position, waypoint.Position) < 2.5 then
					break
				end
				task.wait(0.08)
			end
			if os.clock() >= deadline then
				break
			end
		end
	end

	local finishDeadline = os.clock() + 4
	while os.clock() < finishDeadline and os.clock() < deadline do
		if flatDistance(root.Position, targetPosition) < 1.6 then
			break
		end
		humanoid:MoveTo(targetPosition)
		task.wait(0.08)
	end
	humanoid:MoveTo(root.Position)

	local distance = flatDistance(root.Position, targetPosition)
	return distance < 3.5, distance
end

