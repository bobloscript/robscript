	Name = "Sell items under",
	Desc = "Item price in stars",
	Range = { 0, 2000000 },
	Increment = 25,
	Suffix = "⭐",
	CurrentValue = 0,
	Flag = "SellThreshold",
})

SellBox:CreateStatus({
	Name = "Will sell",
	Style = "Row",
	UpdateRate = 1,
	Update = function()
		local items = scanInventory()
		if not items then
			return "<Muted>loading</Muted>"
		end
		local threshold = ui.sellThreshold and ui.sellThreshold.Value or 0
		local quantity = 0
		local value = 0
		for _, entry in ipairs(items) do
			if entry.price > 0 and entry.price <= threshold then
				quantity = quantity + entry.quantity
				value = value + entry.price * entry.quantity
			end
		end
		if quantity == 0 then
			return "<Muted>nothing, raise the price</Muted>"
		end
		return string.format("%d items · ~%s⭐", quantity, formatNumber(value))
	end,
})

