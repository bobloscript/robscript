local EspFolder = createFolder("RobScriptEmpireEsp")

local function newHighlight(adornee, color, filled)
	local highlight = Instance.new("Highlight")
	highlight.Name = "RSEmpireHighlight"
	highlight.Adornee = adornee
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = color
	highlight.FillTransparency = filled and 0.35 or 0.75
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0.15
	highlight.Parent = EspFolder
	return highlight
end

local function newBillboard(adornee, height)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RSEmpireLabel"
	billboard.Adornee = adornee
	billboard.Size = UDim2.fromOffset(220, 44)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 2500
	billboard.LightInfluence = 0
	billboard.ResetOnSpawn = false
	billboard.Parent = EspFolder

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = THEME.Text
	label.TextStrokeTransparency = 0.4
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextWrapped = true
	label.RichText = true
	label.Text = ""
	label.Parent = billboard

	return billboard, label
end

local function ensureEsp(id, adornee, height, color)
	local entry = Session.esp[id]
	if entry and entry.adornee == adornee then
		return entry
	end
	if entry then
		if entry.highlight then
			entry.highlight:Destroy()
		end
		if entry.billboard then
			entry.billboard:Destroy()
		end
	end

	entry = {
		adornee = adornee,
		highlight = newHighlight(adornee, color, true),
		billboard = nil,
		label = nil,
	}
	entry.billboard, entry.label = newBillboard(adornee, height or 2.6)
	Session.esp[id] = entry
	return entry
end

local function dropEsp(id)
	local entry = Session.esp[id]
	if not entry then
		return
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
	if entry.billboard then
		entry.billboard:Destroy()
	end
	Session.esp[id] = nil
end

local function clearEsp()
	for id in pairs(Session.esp) do
		dropEsp(id)
	end
	for _, line in pairs(Session.tracers) do
		pcall(function()
			line:Remove()
		end)
	end
	Session.tracers = {}
end

local function tracerFor(id)
	if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
		return nil
	end
	local line = Session.tracers[id]
	if line then
		return line
	end
	local ok, created = pcall(function()
		local newLine = Drawing.new("Line")
		newLine.Thickness = 1.5
		newLine.Transparency = 0.65
		return newLine
	end)
	if ok and created then
		Session.tracers[id] = created
		return created
	end
	return nil
end

local function updateTracer(id, position, color, enabled)
	local line = tracerFor(id)
	if not line then
		return
	end
	if not enabled then
		line.Visible = false
		return
	end
	local screenPoint, onScreen = worldToScreen(position)
	if not onScreen then
		line.Visible = false
		return
	end
	local origin = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y)
	line.From = origin
	line.To = screenPoint
	line.Color = color
	line.Visible = true
end

local function formatDistance(distance)
	if distance >= 1000 then
		return string.format("%.1fk", distance / 1000)
	end
	return string.format("%dm", math.floor(distance))
end

local function updateEsp()
	if not (State.PlayerEsp or State.NpcEsp or State.VehicleEsp or State.LootEsp) then
		if Session.espActive then
			clearEsp()
			Session.espActive = false
		end
		return
	end
	Session.espActive = true

	local seen = {}

	if State.PlayerEsp then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and playerAlive(player) then
				local character = player.Character
				local root = character:FindFirstChild("HumanoidRootPart")
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local head = character:FindFirstChild("Head") or root
				if root and humanoid and head then
					local id = "player_" .. player.UserId
					seen[id] = true
					local teamName = player.Team and player.Team.Name or "Citizen"
					local color = TEAM_COLORS[teamName] or THEME.Accent
					local entry = ensureEsp(id, head, 2.8, color)
					local distance = distanceTo(root.Position)
					local lines = {}
					if State.Names then
						table.insert(lines, string.format("<b>%s</b>", player.Name))
					end
					if State.Health then
						table.insert(lines, string.format("%d hp", math.floor(humanoid.Health)))
					end
					if State.Distance then
						table.insert(lines, formatDistance(distance))
					end
					entry.label.Text = table.concat(lines, "  ·  ")
					entry.label.TextColor3 = color
					if entry.highlight then
						entry.highlight.Enabled = State.Chams
					end
					updateTracer(id, root.Position, color, State.Tracers)
				end
			end
		end
	end

	if State.NpcEsp then
		for _, npc in ipairs(Session.npcCache or {}) do
			local model = npc.model
			if model.Parent and npc.humanoid.Health > 0 then
				local id = "npc_" .. npc.humanoid:GetDebugId()
				seen[id] = true
				local anchor = npc.head or npc.root
				local entry = ensureEsp(id, anchor, 2.8, Color3.fromHex("#FFD166"))
				local distance = distanceTo(npc.root.Position)
				local lines = {}
				if State.Names then
					table.insert(lines, model.Name)
				end
				if State.Health then
					table.insert(lines, string.format("%d hp", math.floor(npc.humanoid.Health)))
				end
				if State.Distance then
					table.insert(lines, formatDistance(distance))
				end
				entry.label.Text = table.concat(lines, "  ·  ")
				entry.label.TextColor3 = Color3.fromHex("#FFD166")
				if entry.highlight then
					entry.highlight.Enabled = State.Chams
				end
			end
		end
	end

	if State.VehicleEsp then
		local vehicles = workspace:FindFirstChild("SpawnedVehicles")
		if vehicles then
			for _, vehicle in ipairs(vehicles:GetChildren()) do
				local seat = vehicle:FindFirstChild("DriveSeat") or vehicle:FindFirstChild("VehicleSeat") or vehicle:FindFirstChildWhichIsA("BasePart", true)
				if seat then
					local id = "veh_" .. vehicle:GetDebugId()
					seen[id] = true
					local entry = ensureEsp(id, seat, 4.5, Color3.fromHex("#5AA9FF"))
					local owner = vehicle:GetAttribute("OwnerName") or "?"
					local display = vehicle:GetAttribute("DisplayName") or vehicle.Name
					local distance = distanceTo(seat.Position)
					entry.label.Text = string.format("<b>%s</b>  ·  %s  ·  %s", display, owner, formatDistance(distance))
					entry.label.TextColor3 = Color3.fromHex("#5AA9FF")
					if entry.highlight then
						entry.highlight.Enabled = State.Chams
					end
				end
			end
		end
	end

	if State.LootEsp then
		local lootCount = 0
		for _, entry in ipairs(Session.lootCache or {}) do
			local part = entry.part
			if part.Parent and lootCount < 80 then
				lootCount += 1
				local id = "loot_" .. part:GetDebugId()
				seen[id] = true
				local label = ensureEsp(id, part, 1.4, Color3.fromHex("#7BE38B"))
				local distance = distanceTo(part.Position)
				label.label.Text = string.format("$%s  ·  %s", tostring(entry.value), formatDistance(distance))
				label.label.TextColor3 = Color3.fromHex("#7BE38B")
				if label.highlight then
					label.highlight.Enabled = false
				end
			end
		end
	end

	for id in pairs(Session.esp) do
		if not seen[id] then
			dropEsp(id)
			local line = Session.tracers[id]
			if line then
				pcall(function()
					line:Remove()
				end)
				Session.tracers[id] = nil
			end
		end
	end
end

----- Lighting / performance -----

local function setFullbright(enabled)
	if enabled then
		if not Session.fullbrightBackup then
			Session.fullbrightBackup = {
				Brightness = Lighting.Brightness,
				ClockTime = Lighting.ClockTime,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				FogEnd = Lighting.FogEnd,
				FogStart = Lighting.FogStart,
				GlobalShadows = Lighting.GlobalShadows,
				ExposureCompensation = Lighting.ExposureCompensation,
			}
			local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
			if atmosphere then
				Session.fullbrightBackup.AtmosphereDensity = atmosphere.Density
				atmosphere.Density = 0
			end
		end
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		Lighting.GlobalShadows = false
		Lighting.ExposureCompensation = 0
	elseif Session.fullbrightBackup then
		local backup = Session.fullbrightBackup
		Lighting.Brightness = backup.Brightness
		Lighting.ClockTime = backup.ClockTime
		Lighting.Ambient = backup.Ambient
		Lighting.OutdoorAmbient = backup.OutdoorAmbient
		Lighting.FogEnd = backup.FogEnd
		Lighting.FogStart = backup.FogStart
		Lighting.GlobalShadows = backup.GlobalShadows
		Lighting.ExposureCompensation = backup.ExposureCompensation
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere and backup.AtmosphereDensity then
			atmosphere.Density = backup.AtmosphereDensity
		end
		Session.fullbrightBackup = nil
	end
end

local function setFpsBoost(enabled)
	if enabled then
		for _, effect in ipairs(Lighting:GetChildren()) do
			if effect:IsA("PostEffect") then
				Session.fpsBackup[effect] = effect.Enabled
				effect.Enabled = false
			end
		end
		if workspace:FindFirstChildOfClass("Terrain") then
			pcall(function()
				local quality = settings().Rendering.QualityLevel
				Session.fpsBackup.QualityLevel = quality
				settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			end)
		end
	else
		for effect, value in pairs(Session.fpsBackup) do
			if typeof(effect) == "Instance" and effect.Parent then
				pcall(function()
					effect.Enabled = value
				end)
			end
		end
		if Session.fpsBackup.QualityLevel then
			pcall(function()
				settings().Rendering.QualityLevel = Session.fpsBackup.QualityLevel
			end)
		end
		Session.fpsBackup = {}
	end
end

-- The game keeps its own screen blur (EmpireInventoryBlur and friends). It stays
-- on after the inventory closes and is the blur players see behind a hidden hub,
-- so the switcher remembers every BlurEffect and turns them off.
local function setNoBlur(enabled)
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("BlurEffect") then
			if enabled then
				if Session.blurBackup[effect] == nil then
					Session.blurBackup[effect] = effect.Enabled
				end
				if effect.Enabled then
					Session.blurBackup[effect] = true
				end
				effect.Enabled = false
			else
				local previous = Session.blurBackup[effect]
				if previous ~= nil then
					effect.Enabled = previous
					Session.blurBackup[effect] = nil
				end
			end
		end
	end
end

----- Walking -----
local function walkTo(position)
	local humanoid = getHumanoid()
	if not humanoid or not position then
		return false
	end
	task.spawn(function()
		local guard = 0
		while guard < 20 do
			local root = getRoot()
			if not root then
				break
			end
			if (position - root.Position).Magnitude < 6 then
				break
			end
			humanoid:MoveTo(position)
			guard += 1
			task.wait(0.5)
		end
	end)
	return true
end

----- Farm -----

local function findNearestPrompt(keyword, radius)
	local root = getRoot()
	if not root then
		return nil
	end
	local best, bestDistance
	for _, entry in ipairs(Session.promptCache or {}) do
		local matches = keyword == "" or string.find(entry.text, keyword:lower(), 1, true) ~= nil
		if matches then
			local distance = (root.Position - entry.position).Magnitude
			if distance <= radius and (not bestDistance or distance < bestDistance) then
				best = entry.prompt
				bestDistance = distance
			end
		end
	end
	return best, bestDistance
end

local function triggerPrompt(prompt)
	if not prompt then
		return false
	end
	local ok = pcall(function()
		prompt:InputHoldBegin()
	end)
	if not ok then
		return false
	end
	task.delay(math.max(prompt.HoldDuration or 0.2, 0.2) + 0.1, function()
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end)
	return true
end

local function farmLoop(log)
	return task.spawn(function()
		while true do
			local active = State.AutoRobbery or State.AutoJewelry or State.AutoPrompt or State.AutoDaily
			if not active then
				task.wait(0.5)
				continue
			end

			if State.AutoRobbery then
				local prompt, distance = findNearestPrompt("Rob", State.FarmRadius)
				if prompt and distance then
					local anchor = prompt.Parent
					local position = anchor and (anchor:IsA("BasePart") and anchor.Position or (anchor.PrimaryPart or anchor:FindFirstChildWhichIsA("BasePart", true)) and (anchor.PrimaryPart or anchor:FindFirstChildWhichIsA("BasePart", true)).Position)
					if position and distance > 12 then
						walkTo(position)
						task.wait(1.2)
					end
					triggerPrompt(prompt)
					addLog(log, "<Accent>Robbery</Accent> prompt triggered at " .. string.format("%.0f", distance) .. "m")
					task.wait(2.5)
				end
			end

			if State.AutoJewelry then
				local prompt, distance = findNearestPrompt("Recover", State.FarmRadius)
				if prompt then
					triggerPrompt(prompt)
					addLog(log, "<Accent>Jewelry</Accent> recover triggered")
					task.wait(2)
				end
			end

			if State.AutoPrompt then
				local prompt, distance = findNearestPrompt("", 40)
				if prompt then
					triggerPrompt(prompt)
					task.wait(1.5)
				end
			end

			if State.AutoDaily then
				if Remotes then
					local request = Remotes:FindFirstChild("RequestDailyReward")
					local claim = Remotes:FindFirstChild("ClaimDailyReward")
					if request then
						pcall(function()
							request:InvokeServer()
						end)
					end
					if claim then
						pcall(function()
							claim:InvokeServer()
						end)
					end
				end
				task.wait(5)
			end

			task.wait(0.6)
		end
	end)
end

