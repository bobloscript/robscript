----- FOV circle -----

local fovCircle
local function updateFovCircle()
	if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then
		return
	end
	if State.DrawFov then
		if not fovCircle then
			local ok, circle = pcall(function()
				return Drawing.new("Circle")
			end)
			if not ok or not circle then
				return
			end
			circle.Thickness = 1.5
			circle.NumSides = 64
			circle.Transparency = 0.75
			circle.Color = THEME.Accent
			fovCircle = circle
		end
		local center = Camera.ViewportSize * 0.5
		fovCircle.Position = center
		fovCircle.Radius = State.Fov * 0.5
		fovCircle.Visible = true
	elseif fovCircle then
		pcall(function()
			fovCircle:Remove()
		end)
		fovCircle = nil
	end
end

----- Main loops -----

local aimRenderStep = function(deltaTime)
	if not State.Aimbot then
		Session.target = nil
		return
	end

	local target = resolveTarget()
	Session.target = target
	if not target then
		return
	end

	if State.SilentAim then
		return
	end

	local aimCFrame = CFrame.lookAt(Camera.CFrame.Position, target.point)
	local alpha = clamp(deltaTime * State.Smoothness * 6, 0, 1)
	Camera.CFrame = Camera.CFrame:Lerp(aimCFrame, alpha)
end

RunService:BindToRenderStep("RobScriptEmpireAim", Enum.RenderPriority.Camera.Value + 1, aimRenderStep)
table.insert(Session.renderSteps, "RobScriptEmpireAim")

local scanLoop = task.spawn(function()
	pcall(scanWorld)
	while true do
		task.wait(1)
		pcall(scanWorld)
	end
end)

local combatLoop = task.spawn(function()
	while true do
		task.wait(0.06)

		-- shot accounting from the client magazine, the attribute lags
		local mag = getLocalMag()
		if mag and Session.lastMag and mag < Session.lastMag then
			Session.shots += (Session.lastMag - mag)
		end
		Session.lastMag = mag

		if State.AutoShoot or State.Triggerbot then
			if not getCharacter() then
				continue
			end

			local target = resolveTarget()
			Session.target = target

			if target then
				local shouldFire = false

				if State.AutoShoot then
					shouldFire = true
				end

				if State.Triggerbot then
					local screenPoint = worldToScreen(target.point)
					local center = Camera.ViewportSize * 0.5
					if (screenPoint - center).Magnitude < 40 then
						shouldFire = true
					end
				end

				if shouldFire then
					if State.SilentAim then
						local root = getRoot()
						if root then
							local flat = Vector3.new(target.point.X, root.Position.Y, target.point.Z)
							if (flat - root.Position).Magnitude > 0.5 then
								root.CFrame = CFrame.lookAt(root.Position, flat)
							end
						end
					end

					local localMag = getLocalMag()
					local outOfAmmo = (localMag ~= nil and localMag <= 0) or (localMag == nil and getAmmo() <= 0)
					if outOfAmmo then
						if State.AutoReload then
							reloadWeapon()
						end
					else
						fireOnce()
					end
				end
			end
		end
	end
end)

local espLoop = task.spawn(function()
	while true do
		task.wait(UPDATE_RATE)
		local ok, err = pcall(updateEsp)
		if not ok then
			Session.lastEspError = tostring(err)
		end
		pcall(updateFovCircle)
	end
end)

local wantedLoop = task.spawn(function()
	while true do
		task.wait(0.5)
		local level = getWantedLevel()
		if level > Session.wantedPeak then
			Session.wantedPeak = level
		end
		if State.NoBlur then
			pcall(setNoBlur, true)
		end
	end
end)


local panicConnection = track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if State.PanicKey and input.KeyCode == Enum.KeyCode[State.PanicKey] then
		getgenv().RobScriptEmpire.Panic()
	end
end))

----- Public API -----

local api = {}

function api.Panic()
	local flags = Airflow.Flags
	for _, name in ipairs({ "Aimbot", "SilentAim", "AutoShoot", "Triggerbot", "PlayerEsp", "NpcEsp", "VehicleEsp", "LootEsp", "Tracers", "Fullbright", "FpsBoost", "NoBlur", "AutoRobbery", "AutoJewelry", "AutoPrompt", "AutoDaily" }) do
		local flag = flags[name]
		if flag and type(flag.Set) == "function" then
			pcall(function()
				flag:Set(false, true)
			end)
		end
	end
	State.Aimbot = false
	State.SilentAim = false
	State.AutoShoot = false
	State.Triggerbot = false
	State.PlayerEsp = false
	State.NpcEsp = false
	State.VehicleEsp = false
	State.LootEsp = false
	State.Tracers = false
	State.Fullbright = false
	State.FpsBoost = false
	State.NoBlur = false

	State.AutoRobbery = false
	State.AutoJewelry = false
	State.AutoPrompt = false
	State.AutoDaily = false
	pcall(setFullbright, false)
	pcall(setFpsBoost, false)
	pcall(setNoBlur, false)

	pcall(clearEsp)
	addLog(InfoLog, "<Warning>Panic</Warning> everything disabled", "Warning")
end

function api.Destroy()
	pcall(api.Panic)
	for _, name in ipairs(Session.renderSteps) do
		pcall(function()
			RunService:UnbindFromRenderStep(name)
		end)
	end
	for _, connection in ipairs(Session.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	if combatLoop then
		pcall(task.cancel, combatLoop)
	end
	if espLoop then
		pcall(task.cancel, espLoop)
	end
	if wantedLoop then
		pcall(task.cancel, wantedLoop)
	end
	if scanLoop then
		pcall(task.cancel, scanLoop)
	end
	pcall(clearEsp)
	if fovCircle then
		pcall(function()
			fovCircle:Remove()
		end)
		fovCircle = nil
	end
	if EspFolder then
		pcall(function()
			EspFolder:Destroy()
		end)
	end
	pcall(function()
		Window:Destroy()
	end)
	getgenv().RobScriptEmpire = nil
end

function api.SetFlag(name, value)
	local flag = Airflow.Flags[name]
	if flag and type(flag.Set) == "function" then
		flag:Set(value)
		return true
	end
	return false
end


getgenv().RobScriptEmpire = api
api.State = State
api.Session = Session
api.Window = Window
api.Airflow = Airflow


