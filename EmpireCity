----- Helpers -----

local function getCharacter()
	local character = LocalPlayer.Character
	if character and character.Parent then
		return character
	end
	return nil
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot()
	local character = getCharacter()
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function getTool()
	local character = getCharacter()
	if not character then
		return nil
	end
	local tool = character:FindFirstChildOfClass("Tool")
	if tool and tool.Name ~= "Glass Breaker" then
		return tool
	end
	return tool
end

local function getGunRemote()
	local tool = getTool()
	if not tool then
		return nil
	end
	local localScript = tool:FindFirstChild("GunScript_Local")
	return localScript and localScript:FindFirstChild("ToolRemoteEvent") or nil
end

local function getGuiLayer()
	local ok, layer = pcall(function()
		return gethui and gethui() or nil
	end)
	if ok and layer then
		return layer
	end
	return LocalPlayer:FindFirstChild("PlayerGui")
end

local function createFolder(name)
	local parent = getGuiLayer()
	local folder = parent and parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder
end

local function safeGetConnections(signal)
	if type(getconnections) ~= "function" then
		return nil
	end
	local ok, list = pcall(getconnections, signal)
	if ok and type(list) == "table" then
		return list
	end
	return nil
end

local function invokeConnections(signal)
	local list = safeGetConnections(signal)
	if not list then
		return 0
	end
	local called = 0
	for _, connection in ipairs(list) do
		if type(connection.Function) == "function" then
			local ok = pcall(connection.Function)
			if ok then
				called += 1
			end
		end
	end
	return called
end

local function getMouse()
	local ok, mouse = pcall(function()
		return LocalPlayer:GetMouse()
	end)
	if ok then
		return mouse
	end
	return nil
end

local function playerAlive(player)
	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	return character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function isNpcModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if Players:GetPlayerFromCharacter(model) then
		return false
	end
	if model.Name == "EmpireWeaponViewmodel" then
		return false
	end
	return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function distanceTo(position)
	local root = getRoot()
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

local function worldToScreen(position)
	local point, onScreen = Camera:WorldToViewportPoint(position)
	return Vector2.new(point.X, point.Y), onScreen and point.Z > 0, point.Z
end

local function hasLineOfSight(fromPosition, toPosition, ignored)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	for _, instance in ipairs(ignored or {}) do
		if instance then
			table.insert(filter, instance)
		end
	end
	params.FilterDescendantsInstances = filter

	local delta = toPosition - fromPosition
	local length = delta.Magnitude
	if length < 0.1 then
		return true
	end
	-- stop just short of the point so the target's own part is not the first hit
	local direction = delta.Unit * math.max(length - 0.35, 0.05)
	local result = workspace:Raycast(fromPosition, direction, params)
	return result == nil
end

local function clamp(value, minValue, maxValue)
	return math.clamp(value, minValue, maxValue)
end

----- Weapon control -----

local function getAmmo()
	local tool = getTool()
	if not tool then
		return 0
	end
	return tonumber(tool:GetAttribute("Ammo")) or 0
end

-- The client keeps its own magazine counter in GunGUI; it is the only reliable
-- "can I shoot right now" source, the tool attribute lags behind a reload.
local function getLocalMag()
	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	local gunGui = gui and gui:FindFirstChild("GunGUI")
	local frame = gunGui and gunGui:FindFirstChild("Frame")
	local mag = frame and frame:FindFirstChild("Mag")
	local current = mag and mag:FindFirstChild("Current")
	if not current then
		return nil
	end
	return tonumber(current.Text)
end

local function reloadWeapon()
	local now = os.clock()
	if now - Session.lastReload < 1 then
		return false
	end
	Session.lastReload = now

	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	local gunGui = gui and gui:FindFirstChild("GunGUI")
	local buttons = gunGui and gunGui:FindFirstChild("MobileButtons")
	local reloadButton = buttons and buttons:FindFirstChild("ReloadButton")
	if reloadButton then
		local called = invokeConnections(reloadButton.Activated)
		if called > 0 then
			return true
		end
	end

	local tool = getTool()
	local remote = getGunRemote()
	if tool and remote then
		pcall(function()
			remote:FireServer("Reload")
		end)
		return true
	end
	return false
end

local function fireOnce()
	local now = os.clock()
	if now - Session.lastFire < State.FireRate then
		return false
	end
	Session.lastFire = now

	local mouse = getMouse()
	local fired = false
	if mouse then
		local down = safeGetConnections(mouse.Button1Down)
		if down then
			for _, connection in ipairs(down) do
				if type(connection.Function) == "function" then
					local ok = pcall(connection.Function)
					if ok then
						fired = true
					end
				end
			end
			local up = safeGetConnections(mouse.Button1Up)
			if up then
				for _, connection in ipairs(up) do
					pcall(connection.Function)
				end
			end
		end
	end

	if not fired then
		local remote = getGunRemote()
		if remote then
			pcall(function()
				remote:FireServer("EjectShell")
				remote:FireServer("Fire")
			end)
			fired = true
		end
	end

	if fired then
		Session.lastFireAttempt = now
	end
	return fired
end

----- World scan (cached once a second, keeps the frame loops cheap) -----

local function scanWorld()
	local npcs, prompts, loot = {}, {}, {}

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Humanoid") then
			local model = descendant.Parent
			if descendant.Health > 0 and model and isNpcModel(model) then
				local npcRoot = model:FindFirstChild("HumanoidRootPart")
				if npcRoot then
					table.insert(npcs, {
						model = model,
						humanoid = descendant,
						root = npcRoot,
						head = model:FindFirstChild("Head"),
					})
				end
			end
		elseif descendant:IsA("ProximityPrompt") then
			local instance = descendant.Parent
			local position
			if instance then
				if instance:IsA("BasePart") then
					position = instance.Position
				elseif instance:IsA("Model") then
					local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
					position = primary and primary.Position
				end
			end
			if position then
				table.insert(prompts, {
					prompt = descendant,
					position = position,
					text = ((descendant.ActionText or "") .. " " .. (descendant.ObjectText or "")):lower(),
				})
			end
		elseif descendant:IsA("BasePart") then
			local value = descendant:GetAttribute("LootValue")
			if value then
				table.insert(loot, { part = descendant, value = value })
			end
		end
	end

	Session.npcCache = npcs
	Session.promptCache = prompts
	Session.lootCache = loot
end

----- Target selection -----

local AIM_PARTS = { "Head", "UpperTorso", "HumanoidRootPart" }

local function aimPointFor(character, partName)
	local part = character:FindFirstChild(partName)
	if not part then
		part = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
	end
	if not part then
		return nil
	end
	return part.Position
end

local function isValidTarget(character)
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if character == getCharacter() then
		return false
	end
	return true
end

local function collectCandidates()
	local candidates = {}
	local ignored = { getCharacter() }

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and playerAlive(player) then
			local character = player.Character
			if not (State.IgnoreTeammates and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) then
				local point = aimPointFor(character, State.AimPart)
				if point then
					table.insert(candidates, {
						character = character,
						point = point,
						player = player,
						npc = false,
						label = player.Name,
					})
				end
			end
		end
	end

	if State.TargetNpcs then
		for _, npc in ipairs(Session.npcCache or {}) do
			local model = npc.model
			if model.Parent then
				local point = aimPointFor(model, State.AimPart)
				if point then
					table.insert(candidates, {
						character = model,
						point = point,
						player = nil,
						npc = true,
						label = model.Name,
					})
				end
			end
		end
	end

	return candidates, ignored
end

local function resolveTarget()
	local candidates = collectCandidates()
	local best, bestScore
	for _, candidate in ipairs(candidates) do
		local screenPoint, onScreen, depth = worldToScreen(candidate.point)
		if depth > 0 then
			local center = Camera.ViewportSize * 0.5
			local radius = (screenPoint - center).Magnitude
			local distance = distanceTo(candidate.point)
			if radius <= State.Fov and distance <= 800 then
				local visible = true
				if State.VisibleOnly then
					visible = hasLineOfSight(Camera.CFrame.Position, candidate.point, { getCharacter(), candidate.character })
				end
				if visible or not State.VisibleOnly then
					local score = radius + distance * 0.05
					if not bestScore or score < bestScore then
						best = candidate
						bestScore = score
					end
				end
			end
		end
	end
	return best
end

