----- Helpers -----

local function flag(name, fallback)
	if not Airflow.Flags then
		return fallback
	end
	local handle = Airflow.Flags[name]
	if not handle then
		return fallback
	end
	local ok, value = pcall(function()
		if type(handle.Get) == "function" then
			return handle:Get()
		end
		return handle.Value
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function character()
	local current = LocalPlayer.Character
	if not current or not current.Parent then
		return nil
	end
	return current
end

local function rootPart()
	local current = character()
	if not current then
		return nil
	end
	return current:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
	local current = character()
	if not current then
		return nil
	end
	return current:FindFirstChildOfClass("Humanoid")
end

local function statsOf(model)
	if not model then
		return nil
	end
	local stats = model:FindFirstChild("CombatStats")
	if stats and stats:IsA("Configuration") then
		return stats
	end
	return nil
end

local function positionOf(model)
	if not model then
		return nil
	end
	local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	if part and part:IsA("BasePart") then
		return part.Position
	end
	return nil
end

local function nearest(position, list)
	local best, bestDistance = nil, math.huge
	for _, entry in ipairs(list) do
		if entry.position then
			local distance = (entry.position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = entry, distance
			end
		end
	end
	return best, bestDistance
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return tostring(math.floor(studs))
end

----- ESP engine -----

local ESP = {
	groups = {},
	connections = {},
}

local function ensureGroup(name, options)
	local group = ESP.groups[name]
	if not group then
		group = {
			options = options,
			entries = {},
		}
		ESP.groups[name] = group
	end
	return group
end

local function removeEntry(group, instance)
	local entry = group.entries[instance]
	if not entry then
		return
	end
	if entry.gui then
		entry.gui:Destroy()
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
	group.entries[instance] = nil
end

local function createEntry(group, instance)
	local options = group.options
	local gui = Instance.new("BillboardGui")
	gui.Name = "RT_ESP"
	gui.Adornee = instance
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Size = options.size or UDim2.fromOffset(150, 24)
	gui.StudsOffset = options.offset or Vector3.new(0, 2.2, 0)
	gui.MaxDistance = options.maxDistance or 600

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 0.45
	label.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
	label.BorderSizePixel = 0
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = options.textSize or 12
	label.TextColor3 = options.color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.65
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.Text = ""
	label.Parent = gui
	gui.Parent = instance

	local highlight
	if options.highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "RT_ESP_HL"
		highlight.Adornee = instance
		highlight.FillColor = options.color or Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.78
		highlight.OutlineColor = options.color or Color3.fromRGB(255, 255, 255)
		highlight.OutlineTransparency = 0.25
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = instance
	end

	local entry = { gui = gui, label = label, highlight = highlight }
	group.entries[instance] = entry
	return entry
end

local function syncGroup(name, wanted)
	local group = ensureGroup(name, ESP.groups[name] and ESP.groups[name].options or {
		color = Color3.fromRGB(255, 255, 255),
	})
	local seen = {}
	for instance, data in pairs(wanted) do
		if instance and instance.Parent then
			seen[instance] = true
			local entry = group.entries[instance]
			if not entry or entry.gui == nil or entry.gui.Adornee ~= instance or entry.gui.Parent == nil then
				removeEntry(group, instance)
				entry = createEntry(group, instance)
			end
			if entry and entry.label then
				entry.label.Text = data.text
				if data.color then
					entry.label.TextColor3 = data.color
				end
				if entry.highlight and data.color then
					entry.highlight.FillColor = data.color
					entry.highlight.OutlineColor = data.color
				end
			end
		end
	end
	for instance in pairs(group.entries) do
		if not seen[instance] then
			removeEntry(group, instance)
		end
	end
end

local function clearGroup(name)
	local group = ESP.groups[name]
	if not group then
		return
	end
	for instance in pairs(group.entries) do
		removeEntry(group, instance)
	end
end

