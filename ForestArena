local alive = true

local function destroy()
	if not alive then
		return
	end
	alive = false
	STOP = true
	for _, connection in ipairs(CONNECTIONS) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	CONNECTIONS = {}
	for _, name in ipairs({ "players", "loot", "animals", "water" }) do
		clearGroup(name)
	end
	if AIM.circle then
		pcall(function()
			AIM.circle:Remove()
		end)
		AIM.circle = nil
	end
	if CameraRig and originalAimPoint then
		pcall(function()
			CameraRig.aimPoint = originalAimPoint
		end)
	end
	pcall(function()
		Window:Destroy()
	end)
	if getgenv().RobScriptFA then
		getgenv().RobScriptFA = nil
	end
end

