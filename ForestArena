----- Scanners -----

local function playerStats(player)
	local current = player.Character
	if not current then
		return nil
	end
	return statsOf(current)
end

local function isAlive(player)
	local current = player.Character
	if not current then
		return false
	end
	local hp = current:FindFirstChildOfClass("Humanoid")
	if not hp then
		return false
	end
	if hp.Health <= 0 then
		return false
	end
	local stats = statsOf(current)
	if stats then
		local locked = stats:GetAttribute(ATTR.Locked)
		if locked == true then
			return false
		end
	end
	return true
end

local function readHealth(model)
	local humanoidInstance = model:FindFirstChildOfClass("Humanoid")
	local stats = statsOf(model)
	local health = stats and stats:GetAttribute("Health")
	local maxHealth = stats and stats:GetAttribute("MaxHealth")
	if typeof(health) ~= "number" then
		health = humanoidInstance and humanoidInstance.Health or 0
	end
	if typeof(maxHealth) ~= "number" then
		maxHealth = humanoidInstance and humanoidInstance.MaxHealth or 100
	end
	return health, maxHealth
end

local function scanPlayers(origin)
	local wanted = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isAlive(player) then
			local model = player.Character
			local target = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
			local targetPosition = positionOf(model)
			if target and targetPosition then
				local distance = (targetPosition - origin).Magnitude
				if distance <= espRange() then
					local health = readHealth(model)
					local stats = statsOf(model)
					local weapon = stats and stats:GetAttribute(ATTR.Equipped)
					local label = player.Name
					if flag("EspHealth", true) then
						label = label .. " " .. math.floor(health) .. "hp"
					end
					if flag("EspWeapon", false) and typeof(weapon) == "string" and weapon ~= "" then
						label = label .. " | " .. weapon
					end
					if flag("EspDistance", true) then
						label = label .. " | " .. formatDistance(distance) .. "m"
					end
					wanted[target] = {
						text = label,
						color = Color3.fromRGB(255, 96, 110),
					}
				end
			end
		end
	end
	return wanted
end

local function categoryOfItemId(itemId)
	if not Items or not Items.rows then
		return nil
	end
	local row = Items.rows[itemId]
	if not row then
		return nil
	end
	return row.kind
end

local LOOT_CACHE = {
	at = 0,
	prompts = {},
}

local function lootPrompts()
	local now = os.clock()
	if now - LOOT_CACHE.at < 1.5 and #LOOT_CACHE.prompts > 0 then
		return LOOT_CACHE.prompts
	end
	LOOT_CACHE.at = now
	local list = {}
	local lootFolder = Workspace:FindFirstChild("Loot")
	if lootFolder then
		for _, prompt in ipairs(lootFolder:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				local item = prompt.Parent
				if item and item.Parent then
					local base = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
					if base then
						table.insert(list, {
							item = item,
							base = base,
							itemId = (prompt.ObjectText ~= "" and prompt.ObjectText) or item.Name,
						})
					end
				end
			end
		end
	end
	LOOT_CACHE.prompts = list
	return list
end

local function scanLoot(origin)
	local wanted = {}
	local selected = flag("LootTypes", CATEGORY_NAMES)
	if type(selected) ~= "table" then
		selected = CATEGORY_NAMES
	end
	local wantedKinds = {}
	for _, name in ipairs(selected) do
		local kind = CATEGORY_KIND[name]
		if kind then
			wantedKinds[kind] = true
		end
	end
	local limit = flag("LootLimit", 60)
	local range = flag("LootRange", 250)
	local candidates = {}
	for _, entry in ipairs(lootPrompts()) do
		local kind = categoryOfItemId(entry.itemId)
		if kind == nil or wantedKinds[kind] == true then
			local distance = (entry.base.Position - origin).Magnitude
			if distance <= range then
				table.insert(candidates, {
					instance = entry.base,
					distance = distance,
					text = entry.itemId .. " | " .. formatDistance(distance) .. "m",
					color = (kind and CATEGORY_COLORS[kind]) or Color3.fromRGB(220, 220, 220),
				})
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)
	for index = 1, math.min(#candidates, limit) do
		local candidate = candidates[index]
		wanted[candidate.instance] = {
			text = candidate.text,
			color = candidate.color,
		}
	end
	return wanted
end

