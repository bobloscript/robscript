local function espLoop()
	while not STOP do
		local origin = positionOf(character())
		if origin then
			if flag("PlayerEsp", true) then
				ensureGroup("players", {
					color = Color3.fromRGB(255, 96, 110),
					offset = Vector3.new(0, 0.4, 0),
					size = UDim2.fromOffset(180, 22),
					highlight = true,
				})
				syncGroup("players", scanPlayers(origin))
			else
				clearGroup("players")
			end
			if flag("LootEsp", true) then
				ensureGroup("loot", {
					color = Color3.fromRGB(120, 180, 255),
					offset = Vector3.new(0, 1.6, 0),
					size = UDim2.fromOffset(140, 20),
					textSize = 11,
					highlight = false,
				})
				syncGroup("loot", scanLoot(origin))
			else
				clearGroup("loot")
			end
			if flag("AnimalEsp", true) then
				ensureGroup("animals", {
					color = Color3.fromRGB(255, 70, 70),
					offset = Vector3.new(0, 2.4, 0),
					size = UDim2.fromOffset(150, 21),
					highlight = true,
				})
				syncGroup("animals", scanAnimals(origin))
			else
				clearGroup("animals")
			end
			if flag("WaterEsp", false) then
				ensureGroup("water", {
					color = Color3.fromRGB(90, 200, 255),
					offset = Vector3.new(0, 0, 0),
					size = UDim2.fromOffset(130, 20),
					highlight = false,
				})
				syncGroup("water", scanWater(origin))
			else
				clearGroup("water")
			end
		end
		task.wait(0.35)
	end
end

local function automationLoop()
	local cooldowns = {}

	local function ready(key, seconds)
		local now = os.clock()
		if not cooldowns[key] or now - cooldowns[key] >= seconds then
			cooldowns[key] = now
			return true
		end
		return false
	end

	while not STOP do
		if character() then
			if flag("AutoEat", false) and ready("eat", 2.5) then
				local hunger = meterValue("Hunger")
				if hunger and hunger < flag("EatBelow", 45) then
					local item = findSlot(FOOD_PRIORITY)
					if item and consume(item) then
						Log:Push("Ate <Accent>" .. item.id .. "</Accent>")
					end
				end
			end
			if flag("AutoDrink", false) and ready("drink", 2.5) then
				local thirst = meterValue("Thirst")
				if thirst and thirst < flag("DrinkBelow", 45) then
					local item = findSlot(DRINK_ITEMS)
					if item and consume(item) then
						Log:Push("Drank water")
					end
				end
			end
			if flag("AutoHeal", false) and ready("heal", 2.5) then
				local health = ownHealth()
				if health and health < flag("HealBelow", 60) then
					local item = findSlot(HEAL_PRIORITY)
					if item and consume(item) then
						Log:Push("Healed with <Accent>" .. item.id .. "</Accent>")
					end
				end
			end
			if flag("AutoCraft", false) and ready("craft", 3) then
				local station = CollectionService:GetTagged("CraftingPrompt")
				local origin = positionOf(character())
				local nearStation = false
				for _, prompt in ipairs(station) do
					local part = prompt.Parent
					if part and part:IsA("BasePart") and origin then
						if (part.Position - origin).Magnitude <= 12 then
							nearStation = true
							break
						end
					end
				end
				if nearStation then
					if countOf("Wooden Arrows") + countOf("Arrows") < 1 and countOf("Firewood") >= 1 and countOf("Stone") >= 1 then
						if craft("Wooden Arrows") then
							Log:Push("Crafted <Accent>Wooden Arrows</Accent>")
						end
					elseif ownHealth() < 80 and countOf("Herb") >= 3 then
						if craft("Bandage") then
							Log:Push("Crafted <Accent>Bandage</Accent>")
						end
					elseif countOf("Firewood") >= 1 and (Lighting.ClockTime < 6 or Lighting.ClockTime > 18) and countOf("Wooden Torch") < 1 and countOf("Torch") < 1 then
						if craft("Wooden Torch") then
							Log:Push("Crafted <Accent>Wooden Torch</Accent>")
						end
					end
				end
			end
		end
		task.wait(0.5)
	end
end

