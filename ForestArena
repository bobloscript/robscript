local function workspaceNumber(name, fallback)
	local value = Workspace:GetAttribute(name)
	if typeof(value) == "number" then
		return value
	end
	return fallback
end

local function barrierInfo()
	local center = Workspace:GetAttribute("BarrierCenter")
	local toSize = workspaceNumber("BarrierTo", 2048)
	local stage = workspaceNumber("BarrierStage", 0)
	local at = Workspace:GetAttribute("BarrierAt")
	local origin = rootPart()
	local distance = nil
	local status = "Ready"
	if typeof(center) == "Vector3" and origin then
		local half = math.max(toSize / 2, 1)
		local dx = math.abs(origin.Position.X - center.X)
		local dz = math.abs(origin.Position.Z - center.Z)
		distance = math.min(half - dx, half - dz)
		status = distance > 0 and "Safe" or "Outside the zone"
	end
	return {
		distance = distance,
		status = status,
		stage = stage,
		at = at,
		size = toSize,
	}
end

local function clockString()
	local hour = math.floor(Lighting.ClockTime) % 24
	local minute = math.floor((Lighting.ClockTime % 1) * 60)
	return string.format("%02d:%02d", hour, minute)
end

