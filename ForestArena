						distance = distance,
						name = entry.itemId,
					})
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance < b.distance
	end)
	for index = 1, math.min(#candidates, 3) do
		local candidate = candidates[index]
		local ok = pcall(fireproximityprompt, candidate.prompt)
		if ok then
			AUTO_LOOT_DEBUG.fired = AUTO_LOOT_DEBUG.fired + 1
			AUTO_LOOT_DEBUG.lastPrompt = candidate.name
			AUTO_LOOT_DEBUG.lastDistance = candidate.distance
		end
	end
end

local function scanAnimals(origin)
	local wanted = {}
	local folder = Workspace:FindFirstChild("Wildlife")
	if not folder then
		return wanted
	end
	for _, model in ipairs(folder:GetChildren()) do
		local stats = statsOf(model)
		if stats then
			local position = positionOf(model)
			if position then
				local distance = (position - origin).Magnitude
				if distance <= espRange() then
					local species = stats:GetAttribute(ATTR.Species)
					local health = readHealth(model)
					local hostile = typeof(species) == "string" and HOSTILE_SPECIES[species] == true
					local label = tostring(species or model.Name)
					if flag("AnimalHealth", true) then
						label = label .. " " .. math.floor(health) .. "hp"
					end
					label = label .. " | " .. formatDistance(distance) .. "m"
					wanted[model] = {
						text = label,
						color = hostile and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(150, 220, 255),
					}
				end
			end
		end
	end
	return wanted
end

local function scanWater(origin)
	local wanted = {}
	local zones = Workspace:FindFirstChild("WaterZone")
	if not zones then
		return wanted
	end
	for _, part in ipairs(zones:GetDescendants()) do
		if part:IsA("BasePart") then
			local distance = (part.Position - origin).Magnitude
			if distance <= espRange() then
				wanted[part] = {
					text = "Water | " .. formatDistance(distance) .. "m",
					color = Color3.fromRGB(90, 200, 255),
				}
			end
		end
	end
	return wanted
end

local function waterSources(origin, limit)
	local list = {}
	local zones = Workspace:FindFirstChild("WaterZone")
	if zones then
		for _, part in ipairs(zones:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(list, {
					name = "Water",
					position = part.Position,
				})
			end
		end
	end
	for _, entry in ipairs(list) do
		entry.distance = (entry.position - origin).Magnitude
	end
	table.sort(list, function(a, b)
		return a.distance < b.distance
	end)
	local rows = {}
	for index = 1, math.min(#list, limit or 3) do
		local entry = list[index]
		table.insert(rows, {
			Name = entry.name,
			Value = formatDistance(entry.distance) .. "m",
		})
	end
	return rows
end

----- Inventory and server calls -----

local function inventory()
	if InventoryClient and InventoryClient.slots then
		return InventoryClient
	end
	return nil
end

local function slots()
	local inv = inventory()
	if not inv then
		return {}
	end
	local list = {}
	for slot, item in pairs(inv.slots) do
		if item and typeof(item.id) == "string" and item.id ~= "" and (item.count or 0) > 0 then
			table.insert(list, {
				slot = slot,
				id = item.id,
				count = item.count or 1,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.slot < b.slot
	end)
	return list
end

local function countOf(itemId)
	local total = 0
	for _, item in ipairs(slots()) do
		if item.id == itemId then
			total = total + item.count
		end
	end
	return total
end

local function findSlot(candidates)
	for _, wanted in ipairs(candidates) do
		for _, item in ipairs(slots()) do
			if item.id == wanted then
				return item
			end
		end
	end
	return nil
end

