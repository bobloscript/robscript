local function meterValue(name)
	local stats = statsOf(character())
	if not stats then
		return nil
	end
	if Meters and Meters.valueOf then
		local ok, value = pcall(function()
			return Meters.valueOf(stats, name)
		end)
		if ok and typeof(value) == "number" then
			return value
		end
	end
	local anchor = stats:GetAttribute(name)
	local rate = stats:GetAttribute(name .. "Rate")
	local at = stats:GetAttribute(ATTR.MeterAt)
	if typeof(anchor) ~= "number" then
		return nil
	end
	if typeof(rate) ~= "number" or typeof(at) ~= "number" then
		return anchor
	end
	return math.clamp(anchor + rate * math.max(0, workspace:GetServerTimeNow() - at), 0, 100)
end

