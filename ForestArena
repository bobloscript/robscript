local AIM = {
	point = nil,
	targetName = nil,
	circle = nil,
}

local originalAimPoint = nil

local function installAimPatch()
	if not CameraRig or type(CameraRig.aimPoint) ~= "function" then
		return false
	end
	originalAimPoint = CameraRig.aimPoint
	local wrapper = function()
		if AIM.point then
			return AIM.point
		end
		return originalAimPoint()
	end
	local ok = pcall(function()
		CameraRig.aimPoint = wrapper
	end)
	if ok then
		return true
	end
	if type(setreadonly) == "function" then
		pcall(setreadonly, CameraRig, false)
		local retried = pcall(function()
			CameraRig.aimPoint = wrapper
		end)
		if retried then
			return true
		end
	end
	originalAimPoint = nil
	return false
end

local AIM_PATCHED = installAimPatch()

local function isDrawing()
	local model = character()
	if not model then
		return false
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	return root:GetAttribute(ATTR.Drawing) == true
end

local function pickTarget()
	local camera = Workspace.CurrentCamera
	local origin = rootPart()
	if not camera or not origin then
		return nil
	end
	local maxAngle = math.rad(flag("AimFov", 25))
	local aimPart = flag("AimPart", "Head")
	local cameraPosition = camera.CFrame.Position
	local lookVector = camera.CFrame.LookVector
	local best, bestAngle = nil, maxAngle
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isAlive(player) then
			local model = player.Character
			local head = model:FindFirstChild("Head")
			local part = head
			if aimPart ~= "Head" then
				part = model:FindFirstChild("HumanoidRootPart") or head
			end
			if part and part:IsA("BasePart") then
				local targetPosition = part.Position
				local delta = targetPosition - cameraPosition
				local distance = delta.Magnitude
				if distance > 0.5 and distance <= espRange() then
					local angle = math.acos(math.clamp(lookVector:Dot(delta.Unit), -1, 1))
					if angle < bestAngle then
						best, bestAngle = {
							position = targetPosition,
							name = player.Name,
							distance = distance,
							angle = angle,
						}, angle
					end
				end
			end
		end
	end
	return best
end

local function updateAimCircle()
	if not flag("ShowFov", false) then
		if AIM.circle then
			AIM.circle.Visible = false
		end
		return
	end
	if not AIM.circle then
		local ok, circle = pcall(function()
			local newCircle = Drawing.new("Circle")
			newCircle.Thickness = 1.5
			newCircle.NumSides = 64
			newCircle.Transparency = 0.65
			newCircle.Filled = false
			newCircle.Color = Color3.fromRGB(255, 59, 127)
			return newCircle
		end)
		if not ok then
			return
		end
		AIM.circle = circle
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local camFov = math.rad(camera.FieldOfView)
	local aimFov = math.rad(flag("AimFov", 25))
	local radius = (viewport.Y / 2) * (math.tan(aimFov) / math.tan(camFov / 2))
	AIM.circle.Position = Vector2.new(viewport.X / 2, viewport.Y / 2)
	AIM.circle.Radius = math.clamp(radius, 8, viewport.Y)
	AIM.circle.Visible = true
end

local function combatStep()
	if not CameraRig then
		return
	end
	local enabled = flag("AimAssist", false) and AIM_PATCHED
	local wantedDrawing = isDrawing()
	local armed = enabled and (not flag("AimOnlyDrawing", true) or wantedDrawing)
	local target = nil
	if armed then
		target = pickTarget()
	end
	if armed and target then
		AIM.point = target.position
		AIM.targetName = target.name
	else
		AIM.point = nil
		AIM.targetName = nil
	end
	updateAimCircle()
end

