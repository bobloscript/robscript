local function loadClientModule(folder, name)
	if not PlayerScripts then
		return nil
	end
	local node = PlayerScripts
	if folder then
		for _, part in ipairs(folder) do
			local child = node:FindFirstChild(part)
			if not child then
				return nil
			end
			node = child
		end
	end
	local module = node:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(function()
		return require(module)
	end)
	return ok and result or nil
end

