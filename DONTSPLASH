-- 11. Public API
-- ─────────────────────────────────────────────────────────────────────────────

local api = {
    cfg = CFG,
    window = Window,

    -- { part, distance, state, room } for the closest Listener
    listener = function() return updateNearest() end,

    -- "2 8 8 9", or nil when room 9 is not loaded
    code = function() return readDoorCode() end,

    -- last recorded memory-bridge sequence
    memory = function() return memoryText() end,

    -- current boost output in studs/s (0 when paused)
    boostSpeed = function() return boost.current end,

    clearEsp = function()
        for part in pairs(visuals) do dropVisual(part) end
    end,

    unload = function()
        stopAll()
        for part in pairs(visuals) do
            dropVisual(part)
        end
        highlightCount = 0
        if marksFolder then
            pcall(function() marksFolder:Destroy() end)
            marksFolder = nil
        end
        purgeBoostParts(rootPart())
        boost.constraint = nil
        boost.attachment = nil
        boost.current = 0
        pcall(function() Window:Destroy() end)
        if alarmGui then pcall(function() alarmGui:Destroy() end) end
        if getgenv then
            getgenv().Robscript = nil
            getgenv().StillWaterHub = nil
        end
    end,
}

-- `Robscript` is the current handle; `StillWaterHub` stays as a legacy alias so
-- older snippets and notes keep working.
if getgenv then
    getgenv().Robscript = api
    getgenv().StillWaterHub = api
end

Window:Notify({
    Title = "Robscript.com loaded",
    Content = "RightControl opens the window. ESP is already on.",
    Type = "Success",
    Duration = 6,
})

return api
