    "https://raw.githubusercontent.com/PookiePepelsss/Airflow-UI/refs/heads/main/Source.luau",
}

local Airflow
for _, url in ipairs(AIRFLOW_URLS) do
    local ok, library = pcall(function()
        return loadstring(game:HttpGet(url))()
