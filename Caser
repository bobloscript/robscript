local function acceptState(response)
	if type(response) ~= "table" then
		return
	end
	if type(response.profile) == "table" then
		State.profile = response.profile
	end
	if response.vip ~= nil then
		State.vip = response.vip == true
	end
	if tonumber(response.serverTime) then
		State.serverTime = tonumber(response.serverTime)
	end
end

local function credits()
	local profile = State.profile
	return profile and tonumber(profile.credits) or 0
end

local function inventory()
	local profile = State.profile
	if profile and type(profile.items) == "table" then
		return profile.items
	end
	return {}
end

local function freeOpensFor(caseId)
	local profile = State.profile
	local map = profile and profile.freeOpens
	if type(map) == "table" then
		return tonumber(map[caseId]) or 0
	end
	return 0
end

local function presetUnlocked()
	if not Economy or type(Economy.manyOpen) ~= "function" then
		return false
	end
	local ok, result = pcall(Economy.manyOpen, State.profile)
	return ok and result == true
end

-- 6 without VIP, 10 with VIP or the preset pass. The server is the real judge; this is the UI side.
local function maxOpenPerCall()
	if State.vip or presetUnlocked() then
		return 10
	end
	return 6
end

local callRemote -- forward declaration, the action layer below fills it in

local function refreshState()
	if not callRemote then
		return false
	end
	local response = callRemote("state", {}, 4)
	if type(response) == "table" then
		acceptState(response)
		return true
	end
	return false
end

----- Case catalog view -----


local function casePriceText(case)
	if case.vip then
		return "VIP"
	elseif case.free then
		return "free"
	elseif (tonumber(case.price) or 0) > 0 then
		return money(case.price)
	end
	return "free"
end

local function buildCaseList()
	CaseList = {}
	CaseByLabel = {}
	LabelById = {}

	local now = State.serverTime
	local paid, special = {}, {}

	for _, case in ipairs(Catalog.Cases) do
		local pool = type(case.pool) == "table" and #case.pool or 0
		local ended = now and case.endsAt and case.endsAt <= now
		if pool > 0 and not ended then
			local label = string.format("%s - %s", tostring(case.name), casePriceText(case))
			if CaseByLabel[label] then
				label = label .. " (" .. tostring(case.id) .. ")"
			end
			local entry = { label = label, case = case, id = case.id, price = tonumber(case.price) or 0 }
			CaseByLabel[label] = entry
			LabelById[entry.id] = label
			table.insert(CaseList, entry)
			if case.free or case.vip then
				table.insert(special, entry)
			else
				table.insert(paid, entry)
			end
		end
	end

	table.sort(paid, function(left, right)
		if left.price == right.price then
			return left.label < right.label
		end
		return left.price < right.price
	end)
	table.sort(special, function(left, right)
		return left.label < right.label
	end)

	CaseList = {}
	for _, entry in ipairs(paid) do
		table.insert(CaseList, entry)
	end
	for _, entry in ipairs(special) do
		table.insert(CaseList, entry)
	end

	local labels = {}
	for _, entry in ipairs(CaseList) do
		table.insert(labels, entry.label)
	end
	return labels
end

local CaseLabels = buildCaseList()

local function cheapestPaidLabels(amount)
	local labels = {}
	for _, entry in ipairs(CaseList) do
		if not entry.case.free and not entry.case.vip and entry.price > 0 then
			table.insert(labels, entry.label)
			if #labels >= amount then
				break
			end
		end
	end
	return labels
end

local function defaultLabel()
	local labels = cheapestPaidLabels(1)
	return labels[1] or CaseLabels[1]
end

