-- The Airflow window flags survive only while the script runs, and the rotation queue is not
-- a flag at all, so the queue and the filters are kept in a small JSON file next to the script.
local CONFIG_FILE = "RobscriptTeamCaser.json"
local HttpService = game:GetService("HttpService")
local Saved = {}

local function loadSaved()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then
		return
	end
	local ok, raw = pcall(function()
		if not isfile(CONFIG_FILE) then
			return nil
		end
		return readfile(CONFIG_FILE)
	end)
	if not ok or type(raw) ~= "string" or raw == "" then
		return
	end
	local decoded
	ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(decoded) == "table" then
		Saved = decoded
	end
end

local function saveSaved()
	if type(writefile) ~= "function" then
		return
	end
	local rows = {}
	if ui.rotationTable then
		local ok, current = pcall(function()
			return ui.rotationTable:Get()
		end)
		if ok and type(current) == "table" then
			for _, row in ipairs(current) do
				if type(row) == "table" then
					local label = row.Case or row[1]
					local entry = CaseByLabel[label]
					table.insert(rows, {
						Case = label,
						Id = entry and entry.id or row.Id or nil,
						Opens = row.Opens or row[2],
					})
				end
			end
		end
	end
	local data = {
		rows = rows,
		rotate = ui.rotateCases and toggleOf(ui.rotateCases) or nil,
		single = valueOf(ui.caseDropdown, nil),
		perOpen = valueOf(ui.casesPerOpen, nil),
		sellEvery = valueOf(ui.sellEvery, nil),
		autoSell = ui.autoSell and toggleOf(ui.autoSell) or nil,
		forceSellAt = valueOf(ui.forceSellAt, nil),
		minValueU = valueOf(ui.minValue, nil),
		maxValueU = valueOf(ui.maxValue, nil),
		rarities = valueOf(ui.rarityDropdown, nil),
		kinds = valueOf(ui.kindDropdown, nil),
		keywords = valueOf(ui.keywordInput, nil),
		reserveU = valueOf(ui.reserve, nil),
	}
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then
		State.lastSaveError = tostring(encoded)
		return
	end
	local wrote, writeError = pcall(function()
		writefile(CONFIG_FILE, encoded)
	end)
	if wrote then
		State.lastSaveError = nil
		State.lastSavedAt = os.clock()
	else
		State.lastSaveError = tostring(writeError)
	end
end

loadSaved()

