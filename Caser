----- Public API -----

local api = {}

local function destroy()
	State.running = false
	State.destroyed = true
	State.token = State.token + 1
	pcall(saveSaved)
	pcall(function()
		Window:Destroy()
	end)
	if getgenv().CaserHub == api then
		getgenv().CaserHub = nil
	end
end

api = {
	state = State,
	stats = State.stats,
	open = function(count)
		if count then
			pcall(function()
				ui.casesPerOpen:Set(tonumber(count) or 6)
			end)
		end
		return openAttempt()
	end,
	start = function()
		pcall(function()
			ui.autoOpen:Set(true, true)
		end)
		startLoop()
	end,
	stop = function()
		stopLoop("api")
	end,
	sell = function()
		return sellNow("api")
	end,
	refresh = refreshState,
	credits = credits,
	inventory = inventory,
	money = money,
	gameMoney = gameMoney,
	unitsToCredits = unitsToCredits,
	filterPreview = function()
		local ids, worth = collectSellable(currentFilters())
		return { count = #ids, value = worth }
	end,
	skip = State.skipped,
	destroy = destroy,
	saveConfig = saveSaved,
	configFile = CONFIG_FILE,
	window = Window,
	ui = ui,
}

getgenv().CaserHub = api

pushLog("<Success>Robscript Team - Caser loaded</Success> - RightControl toggles the window")

-- Registered last on purpose: the loop compares itself with getgenv().CaserHub, so it has to
-- run after the hub published itself there.
task.spawn(function()
	local owner = api
	while owner ~= nil and getgenv().CaserHub == owner and not State.destroyed do
		task.wait(10)
		if getgenv().CaserHub == owner and not State.destroyed then
			pcall(saveSaved)
		end
	end
end)
