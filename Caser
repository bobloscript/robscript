----- Formatting helpers -----

-- The game prints money as credits / 100 ("1 805.07" for 180507 credits, see Economy.money),
-- with a space every three digits and no ".00" tail. Every number the user sees in this hub
-- goes through the same two functions, so the hub and the game never disagree.
local MONEY_UNIT = 100

local function gameMoney(value)
	value = tonumber(value) or 0
	local formatted = string.format("%.2f", math.abs(value) / MONEY_UNIT)
	local whole, cents = string.match(formatted, "^(%d+)%.(%d+)$")
	if not whole then
		return formatted
	end
	whole = string.reverse(string.reverse(whole):gsub("(%d%d%d)", "%1 ")):gsub("^%s", "")
	local negative = value < 0 and (whole ~= "0" or cents ~= "00")
	return (negative and "-" or "") .. whole .. (cents == "00" and "" or "." .. cents)
end

local function money(value)
	return gameMoney(value) .. " ◈"
end

-- Sliders are shown in the same units the game uses (credits / 100), the API stays in credits.
local function unitsToCredits(units)
	return (tonumber(units) or 0) * MONEY_UNIT
end

local function formatNumber(value)
	value = tonumber(value) or 0
	local sign = value < 0 and "-" or ""
	value = math.abs(value)
	if value >= 1e9 then
		return string.format("%s%.2fb", sign, value / 1e9)
	elseif value >= 1e6 then
		return string.format("%s%.2fm", sign, value / 1e6)
	elseif value >= 1e3 then
		return string.format("%s%.1fk", sign, value / 1e3)
	end
	return sign .. tostring(math.floor(value))
end

local function shortTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	if seconds >= 3600 then
		return string.format("%dh %02dm", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
	elseif seconds >= 60 then
		return string.format("%dm %02ds", math.floor(seconds / 60), seconds % 60)
	end
	return string.format("%ds", seconds)
end

