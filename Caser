local function keywordList()
	local raw = valueOf(ui.keywordInput, "")
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local list = {}
	for piece in string.gmatch(raw, "[^,]+") do
		local trimmed = string.lower(string.gsub(piece, "^%s*(.-)%s*$", "%1"))
		if trimmed ~= "" then
			table.insert(list, trimmed)
		end
	end
	return list
end

local function matchesKeywords(info, keywords)
	if #keywords == 0 then
		return true
	end
	local haystack = string.lower(tostring(info.weapon or "") .. " " .. tostring(info.name or "") .. " " .. tostring(info.fullName or ""))
	for _, word in ipairs(keywords) do
		if string.find(haystack, word, 1, true) then
			return true
		end
	end
	return false
end

-- Decides whether one inventory entry may be sold. Locked entries never are.
local function shouldSellEntry(entry, info, filters)
	if not info then
		return false
	end
	if filters.keepLocked and (entry.locked == true or entry.favorite == true) then
		return false
	end
	local rarity = tonumber(info.rarity) or 1
	if not filters.rarities[rarity] then
		return false
	end
	local kind = tostring(info.kind or "")
	if not filters.kinds[kind] then
		return false
	end
	local worth = tonumber(info.value) or 0
	if worth < filters.minValue or worth > filters.maxValue then
		return false
	end
	if not matchesKeywords(info, filters.keywords) then
		return false
	end
	return true
end

local function collectSellable(filters)
	local ids = {}
	local worth = 0
	local kept = 0
	for _, entry in ipairs(inventory()) do
		local info = Catalog.ById[entry.id]
		if info then
			if shouldSellEntry(entry, info, filters) then
				table.insert(ids, entry.uid)
				worth = worth + (tonumber(info.value) or 0)
			else
				kept = kept + 1
			end
		end
	end
	return ids, worth, kept
end

local function currentFilters()
	return {
		rarities = selectedRarities(),
		kinds = selectedKinds(),
		keywords = keywordList(),
		minValue = unitsToCredits(valueOf(ui.minValue, 0)),
		maxValue = unitsToCredits(valueOf(ui.maxValue, 1e10)),
		keepLocked = toggleOf(ui.keepLocked),
	}
end

-- The server runs one action per profile at a time: opening and selling share the same
-- ~1 s lock. Sleep out the known part of it, then retry while the answer says "busy".
local function waitForAction(timeout)
	local deadline = os.clock() + (timeout or 3)
	while os.clock() < deadline do
		local left = OPEN_LOCK - (os.clock() - State.lastActionAt)
		if left <= 0 then
			return
		end
		task.wait(math.min(left, 0.25))
	end
end

-- One RemoteFunction call at a time. A server handler that errors leaves InvokeServer
-- yielded forever, so the call runs in its own thread and the caller waits with a deadline
-- instead of blocking the loop. A pending call is never duplicated: the next one waits.
local Pending = { active = false, done = false, result = nil, failure = nil, startedAt = 0 }

callRemote = function(kind, payload, timeout)
	local deadline = os.clock() + (timeout or 4)

	if Pending.active then
		while Pending.active and os.clock() < deadline do
			task.wait(0.05)
		end
		if Pending.active then
			return nil, "timeout", true
		end
	end

	Pending.active = true
	Pending.done = false
	Pending.result = nil
	Pending.failure = nil
	Pending.startedAt = os.clock()

	task.spawn(function()
		local ok, response = pcall(function()
			return Request:InvokeServer(kind, payload)
		end)
		if ok then
			Pending.result = response
		else
			Pending.failure = tostring(response)
		end
		Pending.done = true
		Pending.active = false
	end)

	while not Pending.done and os.clock() < deadline do
		task.wait(0.03)
	end

	if not Pending.done then
		return nil, "timeout", true
	end
	if Pending.failure then
		return nil, Pending.failure, false
	end
	return Pending.result, nil, false
end

local function isBusyText(text)
	local lower = string.lower(tostring(text))
	if string.find(lower, BUSY_TEXT, 1, true) then
		return true
	end
	-- The free case has its own throttle: "Free cases: wait 1s".
	if string.find(lower, "^wait", 1) or string.find(lower, "wait%d+s", 1) then
		return true
	end
	return false
end

local function invokeAction(kind, payload, timeout)
	local deadline = os.clock() + (timeout or 5)
	local lastError = nil
	repeat
		waitForAction(timeout)
		local response, failure, hung = callRemote(kind, payload, timeout)
		if hung then
			-- The previous call never came back: keep the loop honest instead of piling up.
			State.lastActionAt = os.clock()
			return nil, "timeout", true
		end
		if failure then
			return nil, failure, false
		end
		if type(response) ~= "table" then
			return nil, "empty response", false
		end
		if response.ok then
			State.lastActionAt = os.clock()
			return response, nil, false
		end
		local errorText = tostring(response.error or "")
		lastError = errorText
		if isBusyText(errorText) then
			-- Still inside the server window: wait a little and retry. Do NOT re-arm the
			-- lock timer here, or every retry would sleep a full extra second.
			task.wait(0.3)
		else
			return response, nil, false
		end
	until os.clock() > deadline
	return nil, lastError or "the server stayed busy", false
end

-- Returns how many entries were sold, or nil when the call could not run at all.
local function sellNow(reason)
	if State.selling then
		return nil
	end
	local filters = currentFilters()
	local ids, worth = collectSellable(filters)
	if #ids == 0 then
		return 0
	end

	State.selling = true
	local soldCount = 0
	local gained = 0
	local failure = nil

	for start = 1, #ids, SELL_CHUNK do
		local chunk = {}
		for index = start, math.min(start + SELL_CHUNK - 1, #ids) do
			table.insert(chunk, ids[index])
		end
		local response, transportError, hung = invokeAction("sell", { ids = chunk }, 4)
		if hung then
			failure = "the server stopped answering"
			break
		end
		if not response then
			failure = tostring(transportError)
			break
		end
		acceptState(response)
		if response.ok then
			soldCount = soldCount + #chunk
			gained = gained + (tonumber(response.value) or 0)
		else
			failure = tostring(response.error)
			break
		end
		task.wait(0.05)
	end

	State.selling = false

	if soldCount > 0 then
		State.stats.sold = State.stats.sold + soldCount
		State.stats.earned = State.stats.earned + gained
		pushLog(string.format("<Success>Sold %d items for %s</Success> (%s)", soldCount, money(gained), tostring(reason or "manual")))
	end
	if failure then
		pushLog("<Warning>Sell stopped: " .. failure .. "</Warning>")
	end
	if failure and soldCount == 0 then
		return nil
	end
	return soldCount, gained, worth
end

----- Rotation -----

local function rotationRows()
	if not ui.rotationTable then
		return {}
	end
	local ok, rows = pcall(function()
		return ui.rotationTable:Get()
	end)
	if not ok or type(rows) ~= "table" then
		return {}
	end
	local list = {}
	for _, row in ipairs(rows) do
		if type(row) == "table" then
			local entry = CaseByLabel[row.Case or row[1]]
			local opens = tonumber(row.Opens or row[2]) or 0
			if entry then
				table.insert(list, { entry = entry, opens = math.max(1, math.floor(opens)) })
			end
		end
	end
	return list
end

local function rotationMode()
	return toggleOf(ui.rotateCases)
end

local function currentAmount()
	local limit = maxOpenPerCall()
	local wanted = math.floor((tonumber(valueOf(ui.casesPerOpen, 6)) or 6) + 0.5)
	return math.clamp(wanted, 1, limit)
end

local function affordable(entry, count)
	if entry.price <= 0 then
		return true
	end
	return credits() >= entry.price * count
end

local function singleCase()
	local label = valueOf(ui.caseDropdown, nil)
	if type(label) == "string" then
		local entry = CaseByLabel[label]
		if entry then
			return entry
		end
	end
	return CaseByLabel[defaultLabel()]
end

-- Walks the queue and returns the next entry that is not skipped, plus its row. Cases the
-- server put on a cooldown ("Free cases: wait 2s", VIP cooldown) are walked past, and when
-- every row is cooling down the shortest remaining wait is reported instead.
local function pickRotationTarget()
	local rows = rotationRows()
	if #rows == 0 then
		return nil, nil, "the rotation queue is empty"
	end
	local now = os.clock()
	local bestCooldown = nil
	for _ = 1, #rows do
		if State.rotationIndex > #rows then
			State.rotationIndex = 1
			State.rotationOpened = 0
		end
		local index = math.clamp(State.rotationIndex, 1, #rows)
		local row = rows[index]
		local cooldownLeft = (State.caseCooldown[row.entry.id] or 0) - now
		if cooldownLeft <= 0 and not State.skipped[row.entry.id] then
			return row.entry, row, nil
		end
		if cooldownLeft > 0 and (bestCooldown == nil or cooldownLeft < bestCooldown) then
			bestCooldown = cooldownLeft
		end
		State.rotationIndex = (index % #rows) + 1
		State.rotationOpened = 0
	end
	if bestCooldown then
		return nil, nil, "cooldown", bestCooldown
	end
	return nil, nil, "every case in the rotation is skipped"
end

local function advanceRotation(afterOpen)
	local rows = rotationRows()
	if #rows == 0 then
		return
	end
	if afterOpen then
		State.rotationOpened = State.rotationOpened + 1
	end
	local index = math.clamp(State.rotationIndex, 1, #rows)
	local row = rows[index]
	if not row or State.rotationOpened >= row.opens then
		State.rotationIndex = (index % #rows) + 1
		State.rotationOpened = 0
	end
end

-- Moves to the next row no matter how many opens the current one still had left. Used when
-- the row cannot be opened at all (no credits, cooldown, dead case) - otherwise the queue
-- would sit on it until its "opens" counter ran out, which never happens.
local function skipRotationRow()
	local rows = rotationRows()
	if #rows == 0 then
		return
	end
	local index = math.clamp(State.rotationIndex, 1, #rows)
	State.rotationIndex = (index % #rows) + 1
	State.rotationOpened = 0
end

----- Dropped items -----

local function noteDrops(items, caseEntry)
	if type(items) ~= "table" then
		return 0
	end
	local value = 0
	for _, drop in ipairs(items) do
		local info = Catalog.ById[drop.item]
		if info then
			local worth = tonumber(info.value) or 0
			value = value + worth
			State.stats.dropped = State.stats.dropped + 1
			if worth > State.stats.best then
				State.stats.best = worth
				State.stats.bestName = tostring(info.fullName or info.name or "?")
			end
			if (tonumber(info.rarity) or 0) >= 4 then
				pushLog(string.format(
					"<Success>%s dropped from %s</Success> - %s",
					tostring(info.fullName or info.name or "?"),
					tostring(caseEntry and caseEntry.case.name or "case"),
					money(worth)
				))
			end
		end
	end
	return value
end

----- Opening -----

local function requestOpen(entry, count)
	local payload = {
		case = entry.id,
		count = count,
		turbo = toggleOf(ui.fastMode),
	}
	if freeOpensFor(entry.id) > 0 and not State.noFree[entry.id] then
		payload.free = true
	end
	return invokeAction("open", payload, 4)
end

-- One attempt. Returns "opened", "busy", "waiting", "skipped" or "error".
local function openAttempt()
	local entry, row
	if rotationMode() then
		local reason, cooldownLeft
		entry, row, reason, cooldownLeft = pickRotationTarget()
		if not entry then
			if reason == "cooldown" then
				return "cooling", string.format("every case is cooling down, next in %.1fs", cooldownLeft or 1)
			end
			return "empty", reason
		end
	else
		entry = singleCase()
		if not entry then
			return "empty", "pick a case first"
		end
		local left = (State.caseCooldown[entry.id] or 0) - os.clock()
		if left > 0 then
			return "cooling", string.format("%s opens again in %.1fs", tostring(entry.case.name), left)
		end
	end

	if State.skipped[entry.id] then
		return "skipped", tostring(entry.case.name) .. " is skipped"
	end

	local count = currentAmount()
	local cost = entry.price * count
	local reserve = unitsToCredits(valueOf(ui.reserve, 0))

	if cost > 0 and credits() - cost < reserve then
		State.skipReason = "not enough credits for " .. tostring(entry.case.name)
		State.notice = "credits"
		if rotationMode() then
			skipRotationRow()
			return "rotate", State.skipReason
		end
		return "waiting", State.skipReason
	end

	if not affordable(entry, count) then
		State.skipReason = "not enough credits for " .. tostring(entry.case.name)
		State.notice = "credits"
		if rotationMode() then
			skipRotationRow()
			return "rotate", State.skipReason
		end
		return "waiting", State.skipReason
	end

	State.opening = true
	local response, transportError, hung = requestOpen(entry, count)
	State.opening = false

	if hung then
		return "timeout", "the server is not answering yet"
	end
	if transportError then
		if string.find(string.lower(tostring(transportError)), "busy", 1, true) then
			return "busy", tostring(transportError)
		end
		return "error", "request failed: " .. tostring(transportError)
	end
	if type(response) ~= "table" then
		return "error", "empty response from the server"
	end

	if response.ok then
		State.lastOpenAt = os.clock()
		State.notice = nil
		State.skipReason = ""
		acceptState(response)
		State.stats.opens = State.stats.opens + 1
		State.stats.cases = State.stats.cases + count
		State.stats.invested = State.stats.invested + cost
		local dropped = noteDrops(response.items, entry)
		State.lastDrop = {
			case = tostring(entry.case.name),
			value = dropped,
			count = #(response.items or {}),
			at = os.clock(),
		}
		if rotationMode() then
			advanceRotation(true)
		end
		return "opened", nil
	end

	local errorText = tostring(response.error or "")
	local lower = string.lower(errorText)

	local waitSeconds = string.match(lower, "wait%s*(%d+)%s*s")
	if waitSeconds and not string.find(lower, "current action", 1, true) then
		-- Per-case throttle ("Free cases: wait 2s"): park that case, keep the queue moving.
		State.caseCooldown[entry.id] = os.clock() + tonumber(waitSeconds)
		State.lastCooldown = { id = entry.id, seconds = tonumber(waitSeconds) }
		if rotationMode() then
			skipRotationRow()
			return "rotate", errorText
		end
		return "cooling", errorText
	elseif string.find(lower, "wait for the current action", 1, true) or string.find(lower, "^wait", 1) then
		return "busy", errorText
	elseif string.find(lower, "choose 1 to 6", 1, true) or string.find(lower, "opens up to 10", 1, true) then
		return "clamp", errorText
	elseif string.find(lower, "no free opens", 1, true) then
		-- The free case answered that this profile has no free opens. Try a plain (price 0)
		-- open next time, and give up on the row after a few answers like this.
		State.noFree[entry.id] = true
		State.noFreeHits[entry.id] = (State.noFreeHits[entry.id] or 0) + 1
		if State.noFreeHits[entry.id] >= 3 then
			State.noFreeHits[entry.id] = 0
			if rotationMode() then
				skipRotationRow()
				return "rotate", errorText
			end
			return "waiting", errorText
		end
		return "busy", errorText
	elseif string.find(lower, "inventory full", 1, true) then
		return "full", errorText
	elseif string.find(lower, "not enough", 1, true) or string.find(lower, "credits", 1, true) then
		State.skipReason = "not enough credits"
		State.notice = "credits"
		if rotationMode() then
			skipRotationRow()
			return "rotate", errorText
		end
		return "waiting", errorText
	elseif string.find(lower, "opens again in", 1, true) then
		-- VIP case cooldown: temporary, so the queue simply moves on.
		if rotationMode() then
			skipRotationRow()
			return "rotate", errorText
		end
		return "waiting", errorText
	elseif string.find(lower, "free-case slot", 1, true) then
		State.skipped[entry.id] = true
		return "skipped", errorText
	elseif string.find(lower, "vip", 1, true) then
		State.skipped[entry.id] = true
		return "skipped", errorText
	elseif string.find(lower, "ended", 1, true) or string.find(lower, "verified item prices", 1, true) then
		State.skipped[entry.id] = true
		return "skipped", errorText
	end

	return "error", errorText
end

local function stopLoop(reason)
	if not State.running then
		return
	end
	State.running = false
	State.token = State.token + 1
	if ui.autoOpen then
		pcall(function()
			ui.autoOpen:Set(false, true)
		end)
	end
	pushLog("<Warning>Auto open stopped: " .. tostring(reason or "manual") .. "</Warning>")
end

local function loopStep()
	State.lastLoopAt = os.clock()

	-- Inventory guard runs first: a full bag makes every open fail.
	local guard = tonumber(valueOf(ui.forceSellAt, INVENTORY_MAX)) or INVENTORY_MAX
	if #inventory() >= guard then
		local sold = sellNow("inventory guard")
		if not sold or sold == 0 then
			stopLoop("inventory is full and no item matches the sell filters")
			return 0.5
		end
		State.opensSinceSell = 0
		return 0.05
	end

	-- Selling costs the same ~1 s lock as opening, so it runs in one batch every N opens
	-- instead of after each one (that would halve the opening speed).
	local every = math.floor(tonumber(valueOf(ui.sellEvery, 8)) or 8)
	if toggleOf(ui.autoSell) and every > 0 and State.opensSinceSell >= every then
		local sold = sellNow("every " .. tostring(every) .. " opens")
		if sold and sold > 0 then
			State.opensSinceSell = 0
		elseif sold == 0 then
			-- Nothing matches the filters: do not burn a server pause on every step.
			State.opensSinceSell = 0
			pushLog("<Muted>Nothing matched the sell filters, waiting " .. tostring(every) .. " more opens</Muted>")
		end
		return 0.05
	end

	local status, message = openAttempt()
	State.lastOpenStatus = status

	if status == "opened" then
		State.opensSinceSell = State.opensSinceSell + 1
		local pause = math.max(OPEN_LOCK - (os.clock() - State.lastActionAt), 0)
		return math.max(pause, 0.05)
	elseif status == "busy" then
		return 0.25
	elseif status == "cooling" then
		State.skipReason = message or "cooling down"
		return 0.5
	elseif status == "timeout" then
		pushLog("<Warning>The server is slow to answer, waiting</Warning>")
		return 2.0
	elseif status == "clamp" then
		pcall(function()
			ui.casesPerOpen:Set(maxOpenPerCall())
		end)
		return 0.1
	elseif status == "full" then
		local sold = sellNow("inventory full")
		if not sold or sold == 0 then
			stopLoop("inventory is full and nothing can be sold")
			return 0.5
		end
		return 0.05
	elseif status == "rotate" or status == "skipped" then
		-- Every row is too expensive for the balance: sell what the filters allow so the
		-- queue can recover, but only every few seconds instead of on every step.
		if State.notice == "credits" and toggleOf(ui.autoSell) then
			if os.clock() - State.lastSellAttempt > 6 then
				State.lastSellAttempt = os.clock()
				sellNow("refill for credits")
				State.opensSinceSell = 0
			end
		end
		return 0.15
	elseif status == "waiting" then
		-- No money right now: sell what the filters allow, then wait for the balance.
		local sold = sellNow("waiting for credits")
		State.lastSellAttempt = os.clock()
		if not sold or sold == 0 then
			State.skipReason = message or "not enough credits"
			return 1.0
		end
		State.opensSinceSell = 0
		return 0.05
	elseif status == "empty" then
		stopLoop(message or "nothing to open")
		return 0.5
	elseif status == "error" then
		State.lastErrorMessage = tostring(message)
		pushLog("<Error>" .. tostring(message) .. "</Error>")
		return 0.75
	end
	return 0.2
end

local function startLoop()
	if State.running then
		return
	end
	refreshState()
	State.running = true
	State.token = State.token + 1
	local token = State.token
	pushLog("<Success>Auto open started</Success> - up to " .. tostring(maxOpenPerCall()) .. " cases per call")

	task.spawn(function()
		while State.running and State.token == token do
			local started = os.clock()
			local ok, result = pcall(loopStep)
			State.lastIterationMs = (os.clock() - started) * 1000
			if not ok then
				pushLog("<Error>Loop error: " .. tostring(result) .. "</Error>")
				task.wait(1)
			else
				task.wait(math.max(tonumber(result) or 0.1, 0.02))
			end
		end
	end)
end

