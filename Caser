-- Elements expose :Get(); some also keep .Value. Read through both, never trust one shape.
local function valueOf(element, fallback)
	if not element then
		return fallback
	end
	local ok, value = pcall(function()
		return element:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	local raw = element.Value
	if raw ~= nil then
		return raw
	end
	return fallback
end

local function toggleOf(element)
	return valueOf(element, false) == true
end

