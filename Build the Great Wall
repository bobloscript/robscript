	rate = placementRate,
	rotationTasks = setRotationTasks,
	window = Window,
	ui = {
		autoFarm = toggleAutoFarm,
		autoBench = toggleAutoBench,
		autoTreadmill = toggleAutoTreadmill,
		autoSprings = toggleAutoSprings,
		autoUpgrades = toggleAutoUpgrades,
		autopilot = toggleAutopilot,
	},
	destroy = function()
		State.running = false
		State.options.autoFarm = false
		State.options.autoBench = false
		State.options.autoTreadmill = false
		State.options.autoSprings = false
		State.options.autoUpgrades = false
		stopTask()
		pcall(function()
			Window:Destroy()
		end)
		if getgenv().GreatWallHub and getgenv().GreatWallHub.window == Window then
			getgenv().GreatWallHub = nil
		end
	end,
}

---------------------------------------------------------------------
-- Start
---------------------------------------------------------------------
Window:LoadAutoload()

-- A restored "Autopilot = true" must also restore its meaning (all tasks on);
-- config application skips callbacks, so sync it once here.
if State.options.autopilot then
	setRotationTasks(true)
	pcall(function()
		toggleAutopilot:Set(true, true)
	end)
end

task.spawn(schedulerLoop)

logger("loaded. RightControl - show/hide the window")
pcall(function()
	Window:Notify({
		Title = "Great Wall Hub",
		Content = "Started. RightControl hides the window.",
		Type = "Success",
		Duration = 6,
	})
end)
