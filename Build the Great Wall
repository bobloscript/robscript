---------------------------------------------------------------------
-- Utilities
---------------------------------------------------------------------
local function attribute(name, default)
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function coins()
	return tonumber(attribute("Coins", 0)) or 0
end

local function blocksInBag()
	return tonumber(attribute("Blocks", 0)) or 0
end

local function capacity()
	return tonumber(attribute("Capacity", Config.CarryCapacity or 25)) or 25
end

local function serverNow()
	return workspace:GetServerTimeNow()
end

local function character()
	return player.Character
end

local function humanoid()
	local char = character()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function rootPart()
	local char = character()
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function formatNumber(value)
	local text = tostring(math.floor(tonumber(value) or 0))
	return text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function logger(...)
	local parts = {}
	for index = 1, select("#", ...) do
		table.insert(parts, tostring(select(index, ...)))
	end
	print("[GreatWallHub] " .. table.concat(parts, " "))
end

