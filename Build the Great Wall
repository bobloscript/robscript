---------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------
local function quarrySpot()
	local quarry = workspace:FindFirstChild("Quarry")
	local pit = quarry and quarry:FindFirstChild("Pit")
	local floor = pit and pit:FindFirstChild("Floor")
	if floor then
		return floor.Position + Vector3.new(0, 10, 0)
	end
	return Vector3.new(0, 2, -362)
end

local function standUp()
	local hum = humanoid()
	if hum and hum.Sit then
		hum.Sit = false
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
end

local function teleport(position)
	local hrp = rootPart()
	if not hrp then
		return false
	end
	standUp()
	hrp.CFrame = CFrame.new(position)
	task.wait(0.12)
	local current = rootPart()
	if current and (current.Position - position).Magnitude <= 25 then
		return true
	end

	-- the write did not stick: the character is most likely pinned (e.g. shrine pose)
	if State.unsticking then
		return false
	end
	if unstick() then
		local fresh = rootPart()
		if fresh then
			fresh.CFrame = CFrame.new(position)
			task.wait(0.15)
			return true
		end
	end
	return false
end

--- The character is pinned in a pose/geometry: a respawn clears the lock.
function unstick()
	if State.unsticking then
		return false
	end
	State.unsticking = true
	local hum = humanoid()
	if hum then
		logger("resetting character (pinned)")
		hum.Health = 0
		task.wait(0.6)
		local spot = quarrySpot() + Vector3.new(0, 10, 0)
		for _ = 1, 20 do
			local hrp = rootPart()
			if hrp then
				hrp.CFrame = CFrame.new(spot)
			end
			task.wait(0.1)
		end
	end
	State.unsticking = false
	return true
end

--- Check whether CFrame writes still apply (i.e. we are not pinned).
local function isPinned()
	local hrp = rootPart()
	if not hrp then
		return false
	end
	local probe = hrp.Position + Vector3.new(0, 8, 0)
	hrp.CFrame = CFrame.new(probe)
	task.wait(0.15)
	local current = rootPart()
	if not current then
		return false
	end
	return (current.Position - probe).Magnitude > 5
end

---------------------------------------------------------------------
-- Map points
---------------------------------------------------------------------
local PLOT_TIERS = {
	{ Name = "Free", Multiplier = 1 },
	{ Name = "2x", Multiplier = 2 },
	{ Name = "5x", Multiplier = 5 },
	{ Name = "10x", Multiplier = 10 },
	{ Name = "25x", Multiplier = 25 },
	{ Name = "50x", Multiplier = 50 },
	{ Name = "75x", Multiplier = 75 },
	{ Name = "100x", Multiplier = 100 },
	{ Name = "500x", Multiplier = 500 },
}

local function bestGymPlot()
	local area = workspace:FindFirstChild("TrainingArea")
	local plots = area and area:FindFirstChild("Plots")
	if not plots then
		return nil, 1
	end
	local best, bestMultiplier = nil, 0
	for _, tier in ipairs(PLOT_TIERS) do
		local model = plots:FindFirstChild("Plot_" .. tier.Name)
		if model then
			local unlocked = (tier.Name == "Free") or attribute("Gym_" .. tier.Name, false) == true
			if unlocked and tier.Multiplier > bestMultiplier then
				best, bestMultiplier = model, tier.Multiplier
			end
		end
	end
	return best, bestMultiplier
end

local function benchTarget()
	local plot = bestGymPlot()
	if not plot then
		return nil, nil
	end
	local bench = plot:FindFirstChild("BenchPress")
	local prompt = bench and bench:FindFirstChild("BenchPrompt", true)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return nil, nil
	end
	local seat = prompt.Parent and prompt.Parent.Parent
	if not seat or not seat:IsA("BasePart") then
		return nil, nil
	end
	return seat, prompt
end

local function treadmillSpot()
	local plot = bestGymPlot()
	if not plot then
		return nil
	end
	local treadmill = plot:FindFirstChild("Treadmill")
	if not treadmill then
		return nil
	end
	local best
	for _, part in ipairs(treadmill:GetDescendants()) do
		if part:IsA("BasePart") and part.Name == "Belt" then
			if not best or (part.Size.X * part.Size.Z) > (best.Size.X * best.Size.Z) then
				best = part
			end
		end
	end
	return best
end

local function springsOpen()
	return (GreatWall:GetAttribute("WallBoostEnd") or 0) > serverNow()
end

local function springsTimeLeft()
	return math.max(0, (GreatWall:GetAttribute("WallBoostEnd") or 0) - serverNow())
end

local function springsSpot()
	local model = workspace:FindFirstChild("HotSprings")
	local zone = model and model:FindFirstChild("RelaxZone")
	if zone and zone:IsA("BasePart") then
		return zone.Position + Vector3.new(0, 2, 0)
	end
	return nil
end

local function shrineSpot()
	local shrine = workspace:FindFirstChild("UpgradeShrine")
	if not shrine then
		return nil
	end
	local zone = shrine:FindFirstChild("Zone")
	if zone and zone:IsA("BasePart") then
		-- standing closer than ~9 studs locks the character into the praying pose,
		-- so we keep 10 studs away (the purchase radius is 11)
		return zone.Position + Vector3.new(0, -1, 10)
	end
	local altar = shrine:FindFirstChild("Altar")
	if altar then
		local part = altar:FindFirstChildWhichIsA("BasePart")
		if part then
			return part.Position + Vector3.new(0, 2, 12)
		end
	end
	return nil
end

local function shrineZone()
	local shrine = workspace:FindFirstChild("UpgradeShrine")
	local zone = shrine and shrine:FindFirstChild("Zone")
	if zone and zone:IsA("BasePart") then
		return zone
	end
	return nil
end

---------------------------------------------------------------------
-- Upgrades
---------------------------------------------------------------------
local function upgradeLevel(id)
	return tonumber(attribute("Up_" .. id, 0)) or 0
end

local function upgradeCost(id)
	local info = UPGRADE_BY_ID[id]
	if not info then
		return nil
	end
	local level = upgradeLevel(id)
	if level >= (info.Max or 0) then
		return nil
	end
	local costs = info.Costs or {}
	return costs[level + 1]
end

local function upgradeUnlocked(id)
	local info = UPGRADE_BY_ID[id]
	if not info then
		return false
	end
	local required = info.RequiresWalls
	if required and (tonumber(attribute("Walls", 0)) or 0) < required then
		return false
	end
	return true
end

local function upgradePlan()
	local best
	for _, id in ipairs(State.options.upgradeOrder) do
		if upgradeUnlocked(id) then
			local cost = upgradeCost(id)
			if cost then
				if State.options.upgradeStrategy == "Cheapest first" then
					if not best or cost < best.cost then
						best = { id = id, cost = cost }
					end
				else
					return { id = id, cost = cost }
				end
			end
		end
	end
	return best
end

local function hasUpgradeOpportunity()
	if not State.options.autoUpgrades then
		return false
	end
	local plan = upgradePlan()
	if not plan then
		return false
	end
	return coins() >= plan.cost
end

---------------------------------------------------------------------
-- Wall: slots and placement
---------------------------------------------------------------------
local ghostCache = {
	list = {},
	fetchedAt = 0,
}

local function refreshGhosts()
	if os.clock() - ghostCache.fetchedAt < 1.0 then
		return ghostCache.list
	end
	ghostCache.fetchedAt = os.clock()
	local list = {}
	for _, part in ipairs(CollectionService:GetTagged("WallGhost")) do
		if part:IsA("BasePart") and part.Parent and part.Name == "Ghost" and part:GetAttribute("S") then
			table.insert(list, part)
		end
	end
	table.sort(list, function(a, b)
		local layerA, layerB = a:GetAttribute("L") or 0, b:GetAttribute("L") or 0
		if layerA ~= layerB then
			return layerA < layerB
		end
		local sectionA, sectionB = a:GetAttribute("S") or 0, b:GetAttribute("S") or 0
		if sectionA ~= sectionB then
			return sectionA < sectionB
		end
		return (a:GetAttribute("I") or 0) < (b:GetAttribute("I") or 0)
	end)
	ghostCache.list = list
	return list
end

local function ghostTotal()
	return #refreshGhosts()
end

--- Distance the server lets us build from (Reach upgrade raises PlaceRange).
local function currentReach()
	return math.max(18, (tonumber(attribute("PlaceRange", 28)) or 28) - 4)
end

--- Delay between two Place calls. The game's own cooldown is the fastest safe value:
--- PlaceCooldown is a player attribute that already includes Swift/Blitz upgrades.
local function currentDelay()
	if State.options.autoDelay then
		local cooldown = tonumber(attribute("PlaceCooldown", 0.1)) or 0.1
		return math.clamp(cooldown, 0.03, 0.3)
	end
	return State.options.placeDelay
end

local function ghostUsable(ghost, now)
	local section = tostring(ghost:GetAttribute("S"))
	local cooldown = State.sectionCooldown[section]
	if cooldown and now < cooldown then
		return false
	end
	local stamp = State.ghostFailures[ghost]
	if stamp and now - stamp < 20 then
		return false
	end
	if State.options.section ~= "Auto" and section ~= tostring(State.options.section) then
		return false
	end
	return true
end

local function ghostInReach(position, reach)
	local now = os.clock()
	for _, ghost in ipairs(refreshGhosts()) do
		if ghost.Parent and ghost.Name == "Ghost" and (ghost.Position - position).Magnitude <= reach then
			if ghostUsable(ghost, now) then
				return ghost
			end
		end
	end
	return nil
end

--- Pick a slot with the most neighbours: standing next to it gives dozens of
--- placeable slots at once, so we teleport once per cluster instead of per block.
local function anchorGhost(reach)
	local now = os.clock()
	local candidates = {}
	for _, ghost in ipairs(refreshGhosts()) do
		if ghost.Parent and ghost.Name == "Ghost" and ghostUsable(ghost, now) then
			table.insert(candidates, ghost)
			if #candidates >= 260 then
				break
			end
		end
	end
	if #candidates == 0 then
		return nil, 0
	end

	local radius = reach * 0.8
	local best, bestCount = nil, 0
	for _, ghost in ipairs(candidates) do
		local count = 0
		for _, other in ipairs(candidates) do
			if (other.Position - ghost.Position).Magnitude <= radius then
				count = count + 1
			end
		end
		if count > bestCount then
			best, bestCount = ghost, count
		end
	end
	return best, bestCount
end

--- Move the character without the pin machinery: used per cluster, where a
--- failed hop must not trigger a respawn.
local function placeCharacterAt(position)
	local hrp = rootPart()
	if not hrp then
		return false
	end
	standUp()
	hrp.CFrame = CFrame.new(position)
	task.wait(0.1)
	local current = rootPart()
	return current ~= nil and (current.Position - position).Magnitude <= 30
end

--- Stand within reach of the anchor slot, preferring the front side of the wall.
local function moveToCluster(anchor, reach)
	local distance = math.min(reach * 0.5, 18)
	local offsets = {
		Vector3.new(0, 4, distance),
		Vector3.new(0, 4, -distance),
		Vector3.new(distance, 4, 0),
		Vector3.new(-distance, 4, 0),
	}
	for _, offset in ipairs(offsets) do
		if placeCharacterAt(anchor.Position + offset) then
			return true
		end
	end
	return false
end

local function firePlace(ghost)
	State.sequence = State.sequence + 1
	PlaceRemote:FireServer(ghost:GetAttribute("S"), ghost:GetAttribute("L"), ghost:GetAttribute("I"), State.sequence)
end

local function fillBag()
	local spot = quarrySpot()
	if not teleport(spot + Vector3.new(0, 6, 0)) then
		return 0
	end
	task.wait(0.4)

	local started = os.clock()
	local stagnant = 0

	while os.clock() - started < 12 do
		if blocksInBag() >= capacity() then
			break
		end

		local before = blocksInBag()
		FillRemote:FireServer(14, false)
		task.wait(0.07)

		if blocksInBag() <= before then
			stagnant = stagnant + 1
			if stagnant > 14 then
				teleport(spot)
				task.wait(0.4)
				stagnant = 0
			end
		else
			stagnant = 0
		end
	end

	return blocksInBag()
end

---------------------------------------------------------------------
-- Scheduler primitives
---------------------------------------------------------------------
local function beginTask(name, seconds)
	State.generation = State.generation + 1
	State.task = name
	State.taskDuration = seconds
	State.taskUntil = os.clock() + seconds
	return State.generation
end

local function isActive(generation)
	return State.running and State.generation == generation and os.clock() < State.taskUntil
end

local function stopTask()
	State.generation = State.generation + 1
	State.task = "Idle"
end

local function taskEnabled(name)
	if name == "Farm" then
		return State.options.autoFarm
	elseif name == "Bench" then
		return State.options.autoBench
	elseif name == "Treadmill" then
		return State.options.autoTreadmill
	elseif name == "Springs" then
		return State.options.autoSprings
	elseif name == "Upgrades" then
		return State.options.autoUpgrades
	end
	return false
end

local function taskAvailable(name)
	if name == "Springs" then
		return springsOpen() and springsSpot() ~= nil
	elseif name == "Bench" then
		return benchTarget() ~= nil
	elseif name == "Treadmill" then
		return treadmillSpot() ~= nil
	end
	return true
end

local function durationOf(name)
	if name == "Farm" then
		return State.options.farmSeconds
	elseif name == "Bench" then
		return State.options.gymSeconds
	elseif name == "Treadmill" then
		return State.options.runSeconds
	elseif name == "Springs" then
		return State.options.springsSeconds
	end
	return 10
end

---------------------------------------------------------------------
-- Tasks
---------------------------------------------------------------------
local function runFarm(generation)
	local idleSince = os.clock()
	local stuckMoves = 0

	while isActive(generation) do
		local hrp = rootPart()

		if ghostTotal() == 0 then
			-- wall finished / waiting for the next one: nothing to place
			if os.clock() - idleSince > 5 then
				break
			end
			task.wait(0.4)
		elseif blocksInBag() <= 0 then
			fillBag()
			if not isActive(generation) then
				break
			end
			idleSince = os.clock()
		elseif not hrp then
			task.wait(0.2)
		else
			local reach = currentReach()
			State.debug.loops = State.debug.loops + 1

			local searchStart = os.clock()
			local ghost = ghostInReach(hrp.Position, reach)
			State.debug.timeSearch = State.debug.timeSearch + (os.clock() - searchStart)

			if ghost then
				State.debug.fires = State.debug.fires + 1
				firePlace(ghost)
				task.wait(currentDelay())

				local section = tostring(ghost:GetAttribute("S"))
				if ghost.Name == "Block" then
					State.stats.placed = State.stats.placed + 1
					State.debug.accepted = State.debug.accepted + 1
					State.sectionRejects[section] = 0
					State.sectionCooldown[section] = nil
					idleSince = os.clock()
				else
					State.debug.rejected = State.debug.rejected + 1
					State.ghostFailures[ghost] = os.clock()
					State.sectionRejects[section] = (State.sectionRejects[section] or 0) + 1
					if State.sectionRejects[section] >= 5 then
						State.sectionCooldown[section] = os.clock() + 8
						State.sectionRejects[section] = 0
					end
				end
			else
				-- nothing left within reach: hop to the densest cluster once
				local anchorStart = os.clock()
				local anchor, neighbours = anchorGhost(reach)
				State.debug.timeAnchor = State.debug.timeAnchor + (os.clock() - anchorStart)

				local moved = false
				if anchor then
					local moveStart = os.clock()
					moved = moveToCluster(anchor, reach) and neighbours > 0
					State.debug.timeMove = State.debug.timeMove + (os.clock() - moveStart)
					State.debug.moves = State.debug.moves + 1
				end

				if moved then
					idleSince = os.clock()
					stuckMoves = 0
				else
					State.debug.moveFails = State.debug.moveFails + 1
					stuckMoves = stuckMoves + 1
					if stuckMoves >= 6 and State.options.autoUnstuck and isPinned() then
						local hum = humanoid()
						if hum then
							logger("cannot reach the wall - respawning")
							hum.Health = 0
							stuckMoves = 0
							task.wait(3)
						end
					end
				end

				if os.clock() - idleSince > 4 then
					break
				end
				task.wait(0.15)
			end
		end
	end
end

local function runBench(generation)
	local seat, prompt = benchTarget()
	if not seat or not prompt then
		return
	end

	local function press()
		local hrp = rootPart()
		if not hrp then
			return
		end
		if (hrp.Position - seat.Position).Magnitude > 8 then
			hrp.CFrame = CFrame.new(seat.Position + Vector3.new(0, 3, 0))
			task.wait(0.3)
		end
		pcall(function()
			prompt:InputHoldBegin()
		end)
		task.wait(0.12)
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end

	press()
	task.wait(0.6)

	local misses = 0
	while isActive(generation) do
		if tostring(attribute("Training", "")) ~= "Strength" then
			press()
			task.wait(0.5)
			if tostring(attribute("Training", "")) ~= "Strength" then
				misses = misses + 1
				if misses >= 3 and isPinned() then
					unstick()
					misses = 0
					press()
				end
			else
				misses = 0
			end
		end
		task.wait(0.35)
	end

	standUp()
end

local function runTreadmill(generation)
	local belt = treadmillSpot()
	if not belt then
		return
	end
	local spot = belt.Position + Vector3.new(0, 1.4, 0)

	local function stand()
		local hrp = rootPart()
		if hrp then
			hrp.CFrame = CFrame.new(spot)
		end
	end

	stand()
	task.wait(0.6)

	local misses = 0
	while isActive(generation) do
		local hrp = rootPart()
		if hrp and (hrp.Position - spot).Magnitude > 6 then
			stand()
			misses = misses + 1
			if misses >= 3 and isPinned() then
				unstick()
				misses = 0
				stand()
			end
		else
			misses = 0
		end
		task.wait(0.5)
	end
end

local function runSprings(generation)
	local spot = springsSpot()
	if not spot or not springsOpen() then
		return
	end

	local function soak()
		local hrp = rootPart()
		if not hrp then
			return
		end
		hrp.CFrame = CFrame.new(spot)
		task.wait(0.2)
		local hum = humanoid()
		if hum then
			hum.Sit = true
		end
	end

	soak()

	local misses = 0
	while isActive(generation) and springsOpen() do
		local hrp = rootPart()
		if hrp and (hrp.Position - spot).Magnitude > 8 then
			soak()
			misses = misses + 1
			if misses >= 3 and isPinned() then
				unstick()
				misses = 0
				soak()
			end
		else
			misses = 0
		end
		local hum = humanoid()
		if hum and not hum.Sit then
			hum.Sit = true
		end
		task.wait(0.6)
	end

	standUp()
end

local function buyUpgrade(id)
	local ok, result = pcall(function()
		return UpgradeRemote:InvokeServer("Buy", id)
	end)
	if not ok then
		return false, tostring(result)
	end
	if type(result) == "table" then
		if result.ok then
			return true
		end
		return false, tostring(result.reason or "unknown")
	end
	return false, "unknown"
end

local function runUpgrades(generation)
	local plan = upgradePlan()
	if not plan or coins() < plan.cost then
		return
	end
	local spot = shrineSpot()
	if not spot then
		return
	end

	teleport(spot)
	task.wait(0.5)

	while isActive(generation) do
		local nextPlan = upgradePlan()
		if not nextPlan then
			break
		end
		if coins() < nextPlan.cost then
			break
		end

		local ok, reason = buyUpgrade(nextPlan.id)
		if ok then
			State.stats.upgrades = State.stats.upgrades + 1
			logger("bought upgrade: " .. nextPlan.id)
		elseif reason == "far" then
			-- step closer, but not so close that we get pinned in the praying pose
			local zone = shrineZone()
			local moved = false
			if zone then
				for _, offset in ipairs({ 8.5, 7, 5.5 }) do
					teleport(zone.Position + Vector3.new(0, -1, offset))
					task.wait(0.35)
					if buyUpgrade(nextPlan.id) then
						State.stats.upgrades = State.stats.upgrades + 1
						moved = true
						break
					end
				end
			end
			if not moved then
				break
			end
		else
			logger("upgrade " .. nextPlan.id .. " rejected: " .. reason)
			break
		end
		task.wait(0.25)
	end

	if isPinned() then
		unstick()
	end
end

local TASK_FUNCTIONS = {
	Farm = runFarm,
	Bench = runBench,
	Treadmill = runTreadmill,
	Springs = runSprings,
	Upgrades = runUpgrades,
}

local function runTask(name, seconds, manual)
	local fn = TASK_FUNCTIONS[name]
	if not fn then
		return
	end
	local generation = beginTask(name, seconds)
	if manual then
		-- let a hand-started task finish before the scheduler takes over again
		State.manualUntil = State.taskUntil
	end
	local started = os.clock()
	local ok, err = pcall(fn, generation)
	if not ok then
		logger("task " .. name .. " failed: " .. tostring(err))
	elseif os.clock() - started < seconds - 1 then
		logger(string.format("task %s ended early: %.1fs of %.1fs (generation %d -> %d)",
			name, os.clock() - started, seconds, generation, State.generation))
	end
	if State.generation == generation then
		State.task = "Idle"
	end
	if manual and State.manualUntil <= os.clock() then
		State.manualUntil = 0
	end
end

local function enabledTasks()
	local list = {}
	for _, name in ipairs(State.options.order) do
		if taskEnabled(name) and taskAvailable(name) then
			table.insert(list, name)
		end
	end
	-- the springs may be missing from the order list; add them if they are open
	if State.options.autoSprings and springsOpen() and springsSpot() then
		local found = false
		for _, name in ipairs(list) do
			if name == "Springs" then
				found = true
			end
		end
		if not found then
			table.insert(list, "Springs")
		end
	end
	return list
end

--- Which task the rotation will switch to after the current one finishes.
local function nextTaskName()
	local list = enabledTasks()
	if #list == 0 then
		return nil
	end
	for index, name in ipairs(list) do
		if name == State.task then
			return list[(index % #list) + 1]
		end
	end
	return list[1]
end

--- Seconds left before the scheduler switches tasks (0 when idle).
local function taskRemaining()
	if State.task == "Idle" then
		return 0
	end
	return math.max(0, State.taskUntil - os.clock())
end

--- Fraction of the current time slice already spent (0..1).
local function taskProgress()
	local duration = State.taskDuration or 0
	if duration <= 0 or duration > 1e6 then
		return 0
	end
	local remaining = taskRemaining()
	return math.clamp(1 - remaining / duration, 0, 1)
end

local function schedulerLoop()
	while true do
		if not State.running then
			task.wait(0.3)
		elseif State.manualUntil > os.clock() then
			-- a task started by hand (button / API) owns the character right now
			task.wait(0.2)
		else
			local springOverride = State.options.springsPreempt
				and State.options.autoSprings
				and springsOpen()
				and springsSpot() ~= nil

			if springOverride then
				local seconds = math.max(5, math.min(State.options.springsSeconds, springsTimeLeft()))
				runTask("Springs", seconds)
			else
				local list = enabledTasks()
				if #list == 0 then
					State.task = "Idle"
					task.wait(0.4)
				elseif not State.options.autopilot then
					runTask(list[1], 20)
				elseif State.options.mode == "Priority" then
					runTask(list[1], 25)
				else
					for _, name in ipairs(list) do
						if not State.running then
							break
						end
						-- a manual task (button / API) must not be preempted
						if State.manualUntil > os.clock() then
							break
						end
						if hasUpgradeOpportunity() then
							runTask("Upgrades", 12)
						end
						runTask(name, durationOf(name))
					end
				end
			end
		end
	end
end

