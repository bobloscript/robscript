--- Autopilot is a master switch: it turns every rotation task on, and turns
--- them all off again when it is cancelled. State and UI are updated directly
--- (callback skipped) so the result never depends on the toggle's stored value.
local function setRotationTasks(enabled)
	for name, handle in pairs(ROTATION_HANDLES) do
		State.options[ROTATION_OPTIONS[name]] = enabled
		pcall(function()
			handle:Set(enabled, true)
		end)
	end
	logger("autopilot " .. (enabled and "on" or "off") .. " - rotation tasks " .. (enabled and "enabled" or "disabled"))
end

