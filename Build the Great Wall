-- rolling placement speed (blocks per second over the last few seconds)
task.spawn(function()
	while true do
		table.insert(State.rateSamples, { at = os.clock(), placed = State.stats.placed })
		while #State.rateSamples > 6 do
			table.remove(State.rateSamples, 1)
		end
		task.wait(1)
	end
end)

local function placementRate()
	local samples = State.rateSamples
	if #samples < 2 then
		return 0
	end
	local first = samples[1]
	local last = samples[#samples]
	local span = last.at - first.at
	if span <= 0 then
		return 0
	end
	return (last.placed - first.placed) / span
end

