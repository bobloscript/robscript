local Settings = {
	-- training
	trainOn = false,
	trainAutoBuy = true,
	trainEquip = true,
	preferredWeight = "Auto",
	cashReserve = 0,
	-- money
	moneyOn = false,
	-- battles
	battleOn = false,
	ringType = "1v1",
	killAura = true,
	auraRadius = 60,
	flyAbove = true,
	flyHeight = 6,
	autoHits = true,
	hitDelay = 0.2,
	waitForMatch = 45,
	maxFightTime = 90,
	requeueDelay = 3,
	-- rotation
	rotationOn = false,
	rotateMoney = true,
	rotateBattle = true,
	rotateTraining = false,
	moneyMinutes = 5,
	battleMinutes = 10,
	trainingMinutes = 5,
}

local Window, Log

local function log(message, color)
	if Log then
		Log:Push(tostring(message), color)
	end
end

local function notify(title, content, kind)
	pcall(function()
		Window:Notify({ Title = title, Content = content, Type = kind or "Info", Duration = 4 })
	end)
end

getgenv().__BoxingHubGen = (getgenv().__BoxingHubGen or 0) + 1
local SCRIPT_GENERATION = getgenv().__BoxingHubGen

local function scriptAlive()
	return getgenv().__BoxingHubGen == SCRIPT_GENERATION
end

--- A background loop that stops when its generation changes.
local loops = {}
local function startLoop(name, step)
	loops[name] = (loops[name] or 0) + 1
	local myGeneration = loops[name]
	task.spawn(function()
		while loops[name] == myGeneration and scriptAlive() do
			local ok, err = pcall(step)
			if not ok then
				log("<Error>" .. name .. ": " .. tostring(err) .. "</Error>")
				task.wait(1)
			end
			if loops[name] ~= myGeneration then
				break
			end
			task.wait(0.1)
		end
	end)
end

local function stopLoop(name)
	loops[name] = (loops[name] or 0) + 1
end

----------------------------------------------------------------------
-- 1. TRAINING: strength at the gym
----------------------------------------------------------------------

local trainingStats = { started = 0, gained = 0, rate = 0, lastSample = 0, lastStrength = 0, equipped = "-" }
local UiRefs = {}

local function autoTrainEnabled()
	local data = playerData()
	return data ~= nil and data.Autoclicking == true
end

local function setAutoTrain(on)
	if autoTrainEnabled() == on then
		return true
	end
	Remotes.AutoTrain:FireServer()
	task.wait(0.35)
	local data = playerData(true)
	return data ~= nil and data.Autoclicking == on
end
local function ownedWeights()
	local data = playerData()
	return (data and data.Weights) or {}
end

local function ownsWeight(name)
	for _, owned in ipairs(ownedWeights()) do
		if owned == name then
			return true
		end
	end
	return false
end

--- Best weight we already own.
local function bestOwnedWeight()
	local best, bestGain
	for _, info in ipairs(WEIGH_LIST) do
		if not info.robux and ownsWeight(info.name) then
			if not bestGain or info.gain > bestGain then
				best, bestGain = info.name, info.gain
			end
		end
	end
	return best
end

--- Weight we want to be using right now.
local function desiredWeight()
	if Settings.preferredWeight ~= "Auto" then
		return Settings.preferredWeight
	end
	return bestOwnedWeight()
end

--- Best weight we could buy right now (strength requirement met, cash available).
local function nextWeightToBuy()
	local best
	for _, info in ipairs(WEIGH_LIST) do
		if
			not info.robux
			and not ownsWeight(info.name)
			and info.req <= strength()
			and info.price > 0
			and info.price <= money() - Settings.cashReserve
		then
			if not best or info.gain > best.gain then
				best = info
			end
		end
	end
	return best
end

local function equipWeight(name)
	local char = character()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and hum) then
		return false
	end
	Remotes.EquipWeights:FireServer(name)
	task.wait(0.6)

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tool = (backpack and backpack:FindFirstChild(name)) or char:FindFirstChild(name)
	if tool then
		pcall(function()
			hum:EquipTool(tool)
		end)
		trainingStats.equipped = name
		return true
	end
	return false
end

local trainingLoopRunning = false

local function trainingStep()
	if not character() then
		return
	end

	-- Stand where training counts: next to the rack of the weight we want to use.
	local want = desiredWeight() or "Weights [1Kg]"
	local spot = gymSpot(want)
	if distanceTo(spot) > 4 then
		goTo(spot)
		task.wait(0.35)
	end

	-- Buy the next weight when it is allowed and affordable.
	if Settings.trainAutoBuy and os.clock() - (trainingStats.lastBuyCheck or 0) > 4 then
		trainingStats.lastBuyCheck = os.clock()
		local candidate = nextWeightToBuy()
		if candidate and not ownsWeight(candidate.name) then
			local target = Settings.preferredWeight ~= "Auto" and Settings.preferredWeight or candidate.name
			goTo(gymSpot(target))
			task.wait(0.35)
			Remotes.BuyWeights:FireServer(target)
			task.wait(0.9)
			playerData(true)
			if ownsWeight(target) then
				log("<Success>Bought " .. target .. "</Success>")
			end
		end
	end

	-- Put the wanted weight in hand.
	if Settings.trainEquip then
		local worn = trainingStats.equipped
		if desiredWeight() and worn ~= desiredWeight() and ownsWeight(desiredWeight()) then
			equipWeight(desiredWeight())
		end
	end

	-- Keep the game's free auto train switched on.
	if not autoTrainEnabled() then
		setAutoTrain(true)
	end

	-- Strength per minute, for the status row.
	local now = os.clock()
	if now - trainingStats.lastSample >= 10 then
		local delta = strength() - trainingStats.lastStrength
		if trainingStats.lastSample > 0 then
			trainingStats.rate = delta * (60 / (now - trainingStats.lastSample))
		end
		trainingStats.lastStrength = strength()
		trainingStats.lastSample = now
	end
end

local function trainingSet(on)
	Settings.trainOn = on
	if on then
		trainingStats.lastStrength = strength()
		trainingStats.lastSample = os.clock()
		trainingLoopRunning = true
		startLoop("Training", trainingStep)
		log("Training on - gym, " .. tostring(desiredWeight() or "default weights"))
	else
		trainingLoopRunning = false
		stopLoop("Training")
		log("Training off")
	end
	if UiRefs.trainToggle then
		UiRefs.trainToggle:Set(on, true)
	end
end

----------------------------------------------------------------------
-- 2. MONEY: AFK pad
----------------------------------------------------------------------

local moneyStats = { rate = 0, lastSample = 0, lastMoney = 0 }

local function moneyStep()
	if not character() then
		return
	end

	local spot = afkSpot()
	if distanceTo(spot) > 6 then
		goTo(spot)
		task.wait(0.4)
	end

	local now = os.clock()
	if now - moneyStats.lastSample >= 10 then
		local delta = money() - moneyStats.lastMoney
		if moneyStats.lastSample > 0 then
			moneyStats.rate = delta * (60 / (now - moneyStats.lastSample))
		end
		moneyStats.lastMoney = money()
		moneyStats.lastSample = now
	end
end

local function moneySet(on)
	Settings.moneyOn = on
	if on then
		moneyStats.lastMoney = money()
		moneyStats.lastSample = os.clock()
		startLoop("Money", moneyStep)
		log("AFK money on - standing on the free cash pad")
	else
		stopLoop("Money")
		log("AFK money off")
	end
	if UiRefs.moneyToggle then
		UiRefs.moneyToggle:Set(on, true)
	end
end

----------------------------------------------------------------------
-- 3. BATTLES
----------------------------------------------------------------------

local BoxingGui = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("Boxing", 30)

local battleStats = {
	phase = "idle", -- idle | queueing | fighting
	since = os.clock(),
	wins = 0,
	losses = 0,
	opponent = nil,
	pad = nil,
	lastHit = 0,
	lastFly = 0,
	lastHp = 100,
}

local function inMatch()
	return BoxingGui ~= nil and BoxingGui.Enabled == true
end

local function myHealth()
	local hum = humanoid()
	return hum and hum.Health or 0
end

--- Closest living player that is not us.
local function closestOpponent()
	local myPos = rootPosition()
	if not myPos then
		return nil
	end
	local best, bestDistance
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local pos = player.Character:GetPivot().Position
				local d = (pos - myPos).Magnitude
				if d <= Settings.auraRadius and (not bestDistance or d < bestDistance) then
					best, bestDistance = player, d
				end
			end
		end
	end
	return best
end

--- Kill aura, hover and punches.
local function combatStep()
	local target = Settings.killAura and closestOpponent() or battleStats.opponent
	local char = character()
	if not char then
		return
	end

	if target and target.Character then
		battleStats.opponent = target
		local targetPos = target.Character:GetPivot().Position
		local now = os.clock()

		if now - battleStats.lastFly >= 0.1 then
			battleStats.lastFly = now
			if Settings.flyAbove then
				local hover = targetPos + Vector3.new(0, Settings.flyHeight, 0)
				pcall(function()
					char:PivotTo(CFrame.new(hover, targetPos))
				end)
			elseif (char:GetPivot().Position - targetPos).Magnitude > 5 then
				pcall(function()
					char:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0), targetPos))
				end)
			end
		end
	end

	if Settings.autoHits then
		local now = os.clock()
		if now - battleStats.lastHit >= Settings.hitDelay then
			battleStats.lastHit = now
			Remotes.Click:FireServer()
		end
	end
end

local function pickPad()
	local pads = ringPads(Settings.ringType)
	if #pads == 0 then
		return nil
	end
	local chosen = pads[math.random(1, math.min(3, #pads))]
	return chosen
end

local function queueUp()
	local pad = pickPad()
	if not pad then
		log("<Warning>No " .. Settings.ringType .. " ring found</Warning>")
		return false
	end
	battleStats.pad = pad
	goTo(pad.position)
	battleStats.phase = "queueing"
	battleStats.since = os.clock()
	log("Standing on " .. pad.ring .. " (" .. pad.name .. ") and waiting for an opponent")
	return true
end

local function battleStep()
	local now = os.clock()

	if inMatch() then
		if battleStats.phase ~= "fighting" then
			battleStats.phase = "fighting"
			battleStats.since = now
			battleStats.opponent = closestOpponent()
			log("<Success>Match started" .. (battleStats.opponent and (" vs " .. battleStats.opponent.Name) or "") .. "</Success>")
		end

		combatStep()

		if now - battleStats.since > Settings.maxFightTime then
			log("<Warning>Fight took too long, leaving the ring</Warning>")
			goTo(Vector3.new(6.9, 5.4, 18.4))
			battleStats.phase = "idle"
			battleStats.since = now
		end
		return
	end

	-- Not in a match any more.
	if battleStats.phase == "fighting" then
		if myHealth() <= 0 then
			battleStats.losses += 1
			log("<Warning>Lost the match</Warning>")
		else
			battleStats.wins += 1
			log("<Success>Won the match</Success>")
		end
		battleStats.phase = "idle"
		battleStats.since = now
		battleStats.opponent = nil
		return
	end

	if battleStats.phase == "queueing" then
		if now - battleStats.since > Settings.waitForMatch then
			log("<Muted>Nobody came, moving to another ring</Muted>")
			battleStats.phase = "idle"
			battleStats.since = now
		end
		return
	end

	if now - battleStats.since >= Settings.requeueDelay then
		queueUp()
	end
end

local function battleSet(on)
	Settings.battleOn = on
	if on then
		battleStats.phase = "idle"
		battleStats.since = os.clock()
		startLoop("Battle", battleStep)
		log("Auto battle on (" .. Settings.ringType .. ")")
	else
		stopLoop("Battle")
		log("Auto battle off")
	end
	if UiRefs.battleToggle then
		UiRefs.battleToggle:Set(on, true)
	end
end

----------------------------------------------------------------------
-- 4. ROTATION
----------------------------------------------------------------------

local ROTATION_PHASES = { "Money", "Battle", "Training" }
local rotationStats = { index = 0, phase = "-", untilAt = 0, length = 0 }

local function phaseEnabled(name)
	if name == "Money" then
		return Settings.rotateMoney
	elseif name == "Battle" then
		return Settings.rotateBattle
	end
	return Settings.rotateTraining
end

local function phaseMinutes(name)
	if name == "Money" then
		return Settings.moneyMinutes
	elseif name == "Battle" then
		return Settings.battleMinutes
	end
	return Settings.trainingMinutes
end

local function applyPhase(name)
	moneySet(name == "Money")
	battleSet(name == "Battle")
	trainingSet(name == "Training")
	rotationStats.phase = name
	rotationStats.length = phaseMinutes(name) * 60
	rotationStats.untilAt = os.clock() + rotationStats.length
	log("<Accent>Rotation: " .. name .. " for " .. phaseMinutes(name) .. " min</Accent>")
end

local function nextPhase()
	for step = 1, #ROTATION_PHASES do
		rotationStats.index = rotationStats.index % #ROTATION_PHASES + 1
		local name = ROTATION_PHASES[rotationStats.index]
		if phaseEnabled(name) then
			return name
		end
	end
	return nil
end

local function rotationStep()
	if not Settings.rotationOn then
		return
	end
	if os.clock() >= rotationStats.untilAt then
		local name = nextPhase()
		if name then
			applyPhase(name)
		else
			log("<Warning>Rotation has no phases selected</Warning>")
			Settings.rotationOn = false
			stopLoop("Rotation")
			if UiRefs.rotationToggle then
				UiRefs.rotationToggle:Set(false, true)
			end
		end
	end
end

local function rotationSet(on)
	Settings.rotationOn = on
	if on then
		rotationStats.index = 0
		rotationStats.untilAt = 0
		startLoop("Rotation", rotationStep)
		log("Rotation on")
	else
		stopLoop("Rotation")
		rotationStats.phase = "-"
		-- Leaving rotation off should not leave a phase running behind your back.
		trainingSet(false)
		moneySet(false)
		battleSet(false)
		log("Rotation off")
	end
	if UiRefs.rotationToggle then
		UiRefs.rotationToggle:Set(on, true)
	end
end

