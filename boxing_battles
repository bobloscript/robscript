	Desc = "Weights are not bought below this balance",
	Range = { 0, 500000 },
	Increment = 100,
	Suffix = " $",
	CurrentValue = 0,
	Flag = "CashReserve",
	Callback = function(value)
		Settings.cashReserve = value
	end,
})

local weightOptions = {}
for _, info in ipairs(WEIGH_LIST) do
	if not info.robux then
		table.insert(weightOptions, string.format("%s (%s $, needs %s str)", info.name, short(info.price), short(info.req)))
	end
end
table.insert(weightOptions, 1, "Auto (best I own)")

TrainGear:CreateDropdown({
	Name = "Preferred weight",
	Desc = "What to wear, and what to buy when auto buy is on",
	Options = weightOptions,
	CurrentOption = "Auto (best I own)",
	Flag = "PreferredWeight",
	Callback = function(value)
		local chosen = type(value) == "table" and value[1] or value
		Settings.preferredWeight = (chosen == "Auto (best I own)") and "Auto" or tostring(chosen):match("^([^%(]+)") or "Auto"
		Settings.preferredWeight = (Settings.preferredWeight or ""):gsub("%s+$", "")
	end,
})

TrainGear:CreateToggle({
	Name = "Auto buy weights",
	Desc = "Buys the next weight once your strength allows it",
	Flag = "TrainAutoBuy",
	CurrentValue = true,
	Callback = function(on)
		Settings.trainAutoBuy = on
	end,
})

TrainGear:CreateToggle({
	Name = "Keep the weight in hand",
	Desc = "Re-equips it if the tool disappears",
	Flag = "TrainEquip",
	CurrentValue = true,
	Callback = function(on)
		Settings.trainEquip = on
	end,
})

TrainInfo:CreateStatus({
	Name = "Strength",
	Style = "Row",
