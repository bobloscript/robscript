----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function money()
	return leaderstats and leaderstats.Money and leaderstats.Money.Value or 0
end

local function strength()
	return leaderstats and leaderstats.Strength and leaderstats.Strength.Value or 0
end

local function streak()
	return leaderstats and leaderstats.Streak and leaderstats.Streak.Value or 0
end

local function rebirths()
	return leaderstats and leaderstats.Rebirths and leaderstats.Rebirths.Value or 0
end

local function short(value)
	if type(value) ~= "number" then
		return "-"
	end
	local rounded = math.floor(value)
	local text = tostring(rounded)
	local grouped = text:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (grouped:gsub("^%s+", ""))
end

local function character()
	local char = LocalPlayer.Character
	if char and char.Parent then
		return char
	end
	return nil
end

local function humanoid()
	local char = character()
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function rootPosition()
	local char = character()
	if not char then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

local dataCache, dataCacheAt = nil, 0

local function playerData(force)
	local now = os.clock()
	if not force and dataCache and (now - dataCacheAt) < 2 then
		return dataCache
	end
	local ok, data = pcall(function()
		return Remotes.ReadPlayerData:InvokeServer()
	end)
	if ok and type(data) == "table" then
		dataCache, dataCacheAt = data, now
		return data
	end
	return dataCache
end

--- Puts the character on a spot. Used for the gym, the AFK pad and the ring pads.
local function goTo(position)
	local char = character()
	if not char then
		return false
	end
	return pcall(function()
		char:PivotTo(CFrame.new(position))
	end)
end

local function distanceTo(position)
	local current = rootPosition()
	if not current then
		return math.huge
	end
	return (current - position).Magnitude
end

----------------------------------------------------------------------
-- Where things are on the map
----------------------------------------------------------------------

local Map = workspace:WaitForChild("Boxing Map", 30)
local StandsFolder = Map and Map:FindFirstChild("Dumbbell Stands")
local Important = Map and Map:FindFirstChild("Important Stuff")
local RingArea = Map and Map:FindFirstChild("Ring Area")

local function allWeights()
	local list = {}
	if not WeightModule then
		return list
	end
	for name, info in pairs(WeightModule) do
		table.insert(list, {
			name = name,
			price = tonumber(info.Price) or 0,
			gain = tonumber(info.Strength) or 1,
			req = tonumber(info.StrengthReq) or 0,
			robux = info.Price == "Robux",
		})
	end
	table.sort(list, function(a, b)
		if a.robux ~= b.robux then
			return not a.robux
		end
		if a.req == b.req then
			return a.gain < b.gain
		end
		return a.req < b.req
	end)
	return list
end

--- Spot next to the rack of a given weight, where training actually counts.
local function gymSpot(weightName)
	local stand = StandsFolder and StandsFolder:FindFirstChild(weightName)
	local red = stand and stand:FindFirstChild("RedPart", true)
	if red then
		return red.Position + Vector3.new(0, 0.8, 3.2)
	end
	return Vector3.new(38.6, 5.3, 42)
end

local WEIGH_LIST = allWeights()

local function weights()
	return WEIGH_LIST
end

local function afkSpot()
	local pad = Important and Important:FindFirstChild("AFK Pad")
	local main = pad and (pad:FindFirstChild("Main") or pad:FindFirstChildWhichIsA("BasePart", true))
	if main then
		return main.Position + Vector3.new(0, 3.4, 0)
	end
	return Vector3.new(-12.5, 3.4, 19)
end

--- All ring pads of a match type, with how many players are standing around them.
local function ringPads(matchType)
	local result = {}
	if not RingArea then
		return result
	end
	for _, ring in ipairs(RingArea:GetChildren()) do
		if ring:GetAttribute("MatchType") == matchType then
			local pads = ring:FindFirstChild("Pads")
			if pads then
				for _, padModel in ipairs(pads:GetChildren()) do
					local padPart = padModel:FindFirstChildWhichIsA("BasePart", true)
					if padPart and padModel.Name:find("Pad") then
						local nearby = 0
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and p.Character then
								local pos = p.Character:GetPivot().Position
								if (pos - padPart.Position).Magnitude < 16 then
									nearby += 1
								end
							end
						end
						table.insert(result, {
							ring = ring.Name,
							name = padModel.Name,
							position = padPart.Position + Vector3.new(0, 3.2, 0),
							nearby = nearby,
						})
					end
				end
			end
		end
	end
	table.sort(result, function(a, b)
		return a.nearby < b.nearby
	end)
	return result
end

