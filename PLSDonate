----- text delivery through the game's own editor -----
-- The server keeps booth text that was written through the in-game editor.
-- A bare SetCustomization call changes colours and fonts but the text may be
-- dropped, so the hub can drive the editor panel itself.

local function clickButton(button)
	if not button then
		return false
	end
	local ok, list = pcall(getconnections, button.Activated)
	if not ok or type(list) ~= "table" or #list == 0 then
		return false
	end
	for _, connection in ipairs(list) do
		local handler = connection.Function or connection.func
		if handler then
			pcall(handler, "MouseButton1", 1)
		end
	end
	return true
end

local function writeTextThroughEditor(text)
	local gui = playerGui:FindFirstChild("MainGUI")
	local editBooth = gui and gui:FindFirstChild("EditBooth")
	local textSetting = editBooth and editBooth:FindFirstChild("TextSetting", true)
	local editButton = textSetting and textSetting:FindFirstChild("Edit")
	if not editButton then
		return false
	end
	clickButton(editButton)
	task.wait(0.9)
	local panel = gui:FindFirstChild("EditBoothText")
	local textBox = panel and panel:FindFirstChild("TextBox", true)
	if not textBox then
		return false
	end
	pcall(function()
		textBox:CaptureFocus()
	end)
	task.wait(0.15)
	textBox.Text = text
	task.wait(0.25)
	local virtualInput = game:GetService("VirtualInputManager")
	pcall(function()
		virtualInput:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
		virtualInput:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
	end)
	task.wait(0.4)
	pcall(function()
		textBox:ReleaseFocus(true)
	end)
	task.wait(0.4)
	clickButton(panel:FindFirstChild("Close", true))
	task.wait(0.2)
	clickButton(editBooth:FindFirstChild("Close", true))
	return true
end

local editorQueue = nil
local editorBusy = false

function queueEditorWrite(text)
	editorQueue = text
	if editorBusy then
		return
	end
	editorBusy = true
	task.spawn(function()
		while editorQueue do
			local nextText = editorQueue
			editorQueue = nil
			pcall(writeTextThroughEditor, nextText:sub(1, 200))
			-- Closing the game editor pushes its own colours back, so the hub
			-- re-applies the chosen font and colour right after the text is saved.
			task.wait(0.45)
			if setCustomization and state.slot then
				pcall(function()
					setCustomization:FireServer(buildPayload(nextText), "booth")
				end)
			end
			task.wait(0.6)
		end
		editorBusy = false
	end)
end

local function applyBoothText(force)
	if not state.slot then
		return false
	end
	if not setCustomization then
		return false
	end
	local text = renderTemplate(currentTemplate())
	if text == state.text and not force then
		mirrorSign(text)
		return true
	end
	local now = os.clock()
	if not force and now - state.lastWrite < 10 then
		state.pendingText = text
		return false
	end
	state.lastWrite = now
	state.text = text
	local ok = pcall(function()
		setCustomization:FireServer(buildPayload(text), "booth")
	end)
	if ok then
		mirrorSign(text)
		if Airflow.Flags.UseEditor and Airflow.Flags.UseEditor:Get() then
			queueEditorWrite(text)
		end
	end
	return ok
end

task.spawn(function()
	while task.wait(1) do
		if state.pendingText and os.clock() - state.lastWrite >= 10 then
			local pending = state.pendingText
			state.pendingText = nil
			if pending ~= state.text then
				state.text = ""
				applyBoothText(true)
			end
		end
	end
end)

