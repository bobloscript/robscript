local function serverMetrics()
	local players = Players:GetPlayers()
	local botBooths = cachedBots
	local taken, raisedSum, withMoney = 0, 0, 0
	if boothInteractions then
		for _, part in ipairs(boothInteractions:GetChildren()) do
			if part:GetAttribute("BoothSlot") and part:GetAttribute("BoothOwner") then
				taken += 1
			end
		end
	end
	for _, player in ipairs(players) do
		local stats = player:FindFirstChild("leaderstats")
		local raised = stats and stats:FindFirstChild("Raised")
		if raised then
			raisedSum += tonumber(raised.Value) or 0
			if (tonumber(raised.Value) or 0) > 0 then
				withMoney += 1
			end
		end
	end
	local near = 0
	local slot = state.slot
	local part = slot and boothPart(slot)
	if part then
		for _, player in ipairs(players) do
			if player ~= LocalPlayer and player.Character then
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				if root and (root.Position - part.Position).Magnitude < 26 then
					near += 1
				end
			end
		end
	end
	local score = 0
	score += math.min(#players * 2.2, 38)
	score += math.min(taken * 2.4, 22)
	score += math.min(raisedSum / 30, 20)
	score += math.min(near * 2, 12)
	score += math.min(withMoney * 1.5, 8)
	score -= math.min(botBooths * 2.5, 18)
	return {
		players = #players,
		taken = taken,
		raisedSum = raisedSum,
		withMoney = withMoney,
		near = near,
		botBooths = botBooths,
		score = math.clamp(math.floor(score), 0, 100),
	}
end

