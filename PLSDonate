local function recomputeVisitorCount()
	local now = os.time()
	local count = 0
	for _, seenAt in pairs(SESSION.visitors) do
		if now - seenAt < 300 then
			count += 1
		end
	end
	SESSION.visitorCount = count
end

local function recordDonation(amount, donor)
	amount = math.max(1, math.floor(tonumber(amount) or 1))
	SESSION.raised += amount
	SESSION.donations += 1
	SESSION.lastAt = os.time()
	SESSION.lastDonor = donor
	if amount > SESSION.best then
		SESSION.best = amount
	end
	PROFILE.totalRaised += amount
	local entry = PROFILE.donors[tostring(donor or "?")] or { amount = 0, count = 0 }
	entry.amount += amount
	entry.count += 1
	PROFILE.donors[tostring(donor or "?")] = entry
	saveProfile()
end

local function perHour()
	local hours = math.max((os.time() - SESSION.startedAt) / 3600, 2 / 60)
	return math.floor(SESSION.raised / hours)
