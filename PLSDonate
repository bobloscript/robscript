local function nearestOtherPlayer(limit)
	limit = limit or 30
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local best, bestDistance = nil, limit
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local otherRoot = player.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = player, distance
				end
			end
		end
	end
	return best
end

local onDonation -- forward declaration

-- The game announces real donations to the recipient through this event, with the
-- donor name and the amount. It is the only exact donor source the client gets.
local function hookDonationAnnouncement()
	if type(Remotes.OnClientEvent) ~= "function" then
		return
	end
	pcall(function()
		track(Remotes.OnClientEvent("DonationReceived", function(donorName, amount)
			if typeof(donorName) == "Instance" then
				donorName = donorName.Name
			end
			if type(donorName) ~= "string" or donorName == "" then
				return
			end
			state.announcedDonor = donorName
			state.announcedAt = os.time()
			if typeof(amount) == "number" and amount > 0 then
				state.announcedAmount = amount
			end
		end))
	end)
end

local function hookDonations()
	if raisedValue then
		track(raisedValue:GetPropertyChangedSignal("Value"):Connect(function()
			local current = tonumber(raisedValue.Value) or 0
			local delta = current - lastRaised
			lastRaised = current
			if delta > 0 then
				onDonation(delta, nil)
			end
		end))
	end
	if createVfx then
		track(createVfx.OnClientEvent:Connect(function(action, _, character, amount)
			if action ~= "GiveCurrency" and action ~= "GiveGiftbux" then
				return
			end
			if character and character ~= LocalPlayer.Character then
				return
			end
			if typeof(amount) == "number" and amount > 0 then
				state.pendingAmount = amount
			end
			if character then
				for _, player in ipairs(Players:GetPlayers()) do
					if player.Character == character and player ~= LocalPlayer then
						state.pendingDonor = player.Name
					end
				end
			end
		end))
	end
	hookDonationAnnouncement()
end

local donationLog

onDonation = function(amount, donorOverride)
	if state.busy then
		return
	end
	state.busy = true
	task.spawn(function()
		local donor = donorOverride
		if not donor and state.announcedDonor and state.announcedAt and os.time() - state.announcedAt <= 5 then
			donor = state.announcedDonor
		end
		if not donor then
			donor = state.pendingDonor
		end
		if not donor then
			local near = nearestOtherPlayer(40)
			donor = near and near.Name or nil
		end
		if not donor and LocalPlayer.Character then
			donor = "unknown donor"
		end
		state.pendingDonor = nil
		state.pendingAmount = nil
		state.announcedDonor = nil

		recordDonation(amount, donor)

		local hours = math.max((os.time() - SESSION.startedAt) / 3600, 2 / 60)
		local speed = math.floor(SESSION.raised / hours)
		if donationLog then
			donationLog:Push(string.format("<Success>+%d R$</Success> <Muted>%s</Muted> <Accent>%d R$/h</Accent>",
				amount, escape(donor or "?"), speed))
		end

		task.spawn(function()
			local ping = amount >= pingThreshold() and "@everyone" or nil
			if webhookSend(donationEmbed(amount, donor, speed), ping) then
				lastWebhookAt = os.time()
			end
		end)

		if Airflow.Flags.LiveText and Airflow.Flags.LiveText:Get() then
			applyBoothText(true)
		end

		local stageIndex = stageOf(totalRaised())
		if stageIndex ~= state.lastStage then
			state.lastStage = stageIndex
			local stage = STAGES[stageIndex]
			if stageLog then
				stageLog:Push(string.format("<Accent>%s</Accent> <Muted>%d R$</Muted>", stage and stage.name or "?", stage and stage.total or 0))
			end
			if Airflow.Flags.LivingBooth and Airflow.Flags.LivingBooth:Get() then
				applyBoothText(true)
				if stage and stageIndex >= 4 then
					Window:Notify({
						Title = Airflow:T("Stage up"),
						Content = stage.name,
						Type = "Success",
					})
				end
			end
		end

		if Airflow.Flags.ThanksDonor and Airflow.Flags.ThanksDonor:Get() and donor and donor ~= "unknown donor" then
			task.spawn(function()
				task.wait(2)
				sendChat(string.format("thank you %s for %d R$", donor, amount))
			end)
		end

		if Airflow.Flags.SpinOnDonation and Airflow.Flags.SpinOnDonation:Get() then
			task.spawn(spinOnce, amount)
		end
		if Airflow.Flags.JumpOnDonation and Airflow.Flags.JumpOnDonation:Get() then
			task.spawn(jumpFor, amount)
		end
		if Airflow.Flags.GravityOnDonation and Airflow.Flags.GravityOnDonation:Get() then
			task.spawn(gravityDip, amount)
		end
		if Airflow.Flags.DanceOnDonation and Airflow.Flags.DanceOnDonation:Get() then
			task.spawn(function()
				task.wait(0.5)
				pcall(function()
					Players:Chat("/e dance")
				end)
			end)
		end

		state.busy = false
	end)
end

----- show routines -----

function spinOnce(amount)
	local character = LocalPlayer.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	root.Anchored = true
	local perRobux = Airflow.Flags.SpinPerRobux and tonumber(Airflow.Flags.SpinPerRobux:Get()) or 1
	local turns = math.clamp(amount * perRobux, 1, 6)
	local duration = math.clamp(turns * 0.45, 0.5, 3)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
	local spin = TweenService:Create(root, info, {
		CFrame = root.CFrame * CFrame.Angles(0, math.rad(360 * turns), 0),
	})
	spin:Play()
	task.wait(duration + 0.1)
	root.Anchored = false
end

function jumpFor(amount)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local jumps = math.clamp(amount, 1, 10)
	for _ = 1, jumps do
		if humanoid.Health <= 0 then
			return
		end
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local waited = 0
		repeat
			task.wait(0.1)
			waited += 0.1
		until humanoid:GetState() == Enum.HumanoidStateType.Landed or waited > 2
	end
end

function gravityDip(amount)
	local original = workspace.Gravity
	workspace.Gravity = math.max(20, original - math.clamp(amount, 1, 120))
	task.wait(3)
	workspace.Gravity = original
end

