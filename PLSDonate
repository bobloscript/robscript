local BOT_WORDS = { "spin", "jump", "1r$", "+1 speed", "helicopter", "auto", "webhook", "script", "1 r$ = " }

local function countBotBooths()
	local counter = 0
	local mapUi = mapContainer()
	local booths = mapUi and mapUi:FindFirstChild("BoothUI")
	if not booths then
		return 0
	end
	for _, booth in ipairs(booths:GetChildren()) do
		local sign = booth:FindFirstChild("Sign")
		local label = sign and sign:FindFirstChild("TextLabel")
		if label and label.Text ~= "" then
			local lower = label.Text:lower()
			for _, word in ipairs(BOT_WORDS) do
				if lower:find(word, 1, true) then
					counter += 1
					break
				end
			end
		end
	end
	return counter
end

