local PROFILE = {
	sessions = {},
	donors = {},
	totalRaised = 0,
}

local function loadProfile()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then
		return
	end
	if not isfile(STORE_FILE) then
		return
	end
	local ok, raw = pcall(readfile, STORE_FILE)
	if not ok or type(raw) ~= "string" then
		return
	end
	local decoded = nil
	pcall(function()
		decoded = HttpService:JSONDecode(raw)
	end)
	if type(decoded) ~= "table" then
		return
	end
	if type(decoded.sessions) == "table" then
		PROFILE.sessions = decoded.sessions
	end
	if type(decoded.donors) == "table" then
		PROFILE.donors = decoded.donors
	end
	PROFILE.totalRaised = tonumber(decoded.totalRaised) or 0
end

local function saveProfile()
	if type(writefile) ~= "function" then
		return
	end
	local payload = {
		sessions = PROFILE.sessions,
		donors = PROFILE.donors,
		totalRaised = PROFILE.totalRaised,
	}
	pcall(function()
		writefile(STORE_FILE, HttpService:JSONEncode(payload))
	end)
end

