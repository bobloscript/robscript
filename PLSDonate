local function goalValue()
	local raw = Airflow.Flags.BoothGoal and tonumber(Airflow.Flags.BoothGoal:Get())
	return math.max(tonumber(raw) or 500, 1)
end

local function renderTemplate(template)
	local goal = goalValue()
	local raised = totalRaised()
	local sessionRaised = SESSION.raised
	local hours = math.max((os.time() - SESSION.startedAt) / 3600, 2 / 60)
	local perHour = math.floor(sessionRaised / hours)
	local stageIndex = stageOf(raised)
	local stage = STAGES[stageIndex]
	local nextStage = STAGES[stageIndex + 1]
	local toNext = nextStage and math.max(nextStage.total - raised, 0) or 0

	local text = tostring(template or "")

	-- Longer tokens first, otherwise $STAGE eats the head of $STAGENAME.
	local values = {
		["$STAGENAME"] = stage and stage.name or "",
		["$RAISED"] = shortNumber(raised),
		["$DONORS"] = tostring(SESSION.donations),
		["$DONOR"] = SESSION.lastDonor or "?",
		["$STAGE"] = tostring(stageIndex),
		["$GOAL"] = shortNumber(goal),
		["$LEFT"] = shortNumber(math.max(goal - raised, 0)),
		["$NEXT"] = nextStage and shortNumber(toNext) or "-",
		["$RPH"] = shortNumber(perHour),
	}
	local tokens = {}
	for token in pairs(values) do
		tokens[#tokens + 1] = token
	end
	table.sort(tokens, function(a, b)
		return #a > #b
	end)
	for _, token in ipairs(tokens) do
		local value = values[token]
		text = text:gsub(token:gsub("%$", "%%$"), function()
			return value
		end)
	end
	return text
end

local function currentTemplate()
	local mode = Airflow.Flags.TextTemplate and Airflow.Flags.TextTemplate:Get() or "Goal"
	if mode == "Evolution" then
		local stageIndex = stageOf(totalRaised())
		local stage = STAGES[stageIndex]
		local nextStage = STAGES[stageIndex + 1]
		if nextStage then
			return string.format("LEVEL %d - %s\n$RAISED / $GOAL R$\n$NEXT R$ TO EVOLVE",
				stageIndex, stage and stage.name or "")
		end
		return string.format("FINAL FORM - %s\n$RAISED R$ RAISED\nTHANK YOU", stage and stage.name or "")
	elseif mode == "Simple" then
		return "$RAISED R$ RAISED\nTHANK YOU FOR EVERY DONATION"
	elseif mode == "Custom" then
		local custom = Airflow.Flags.SignText and Airflow.Flags.SignText:Get() or ""
		if custom ~= "" then
			return custom
		end
		return "$RAISED / $GOAL R$\n$DONORS DONORS"
	end
	return "$RAISED / $GOAL R$\n$LEFT R$ LEFT\n$RPH R$/H"
end

local function mirrorSign(text)
	local slot = state.slot
	if not slot then
		return
	end
	if not (Airflow.Flags.MirrorLocal and Airflow.Flags.MirrorLocal:Get()) then
		return
	end
	local ui = boothUi(slot)
	local sign = ui and ui:FindFirstChild("Sign")
	local label = sign and sign:FindFirstChild("TextLabel")
	if label then
		label.Text = text
