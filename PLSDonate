local function myBoothSlot()
	if not boothInteractions then
		return nil
	end
	for _, part in ipairs(boothInteractions:GetChildren()) do
		local owner = part:GetAttribute("BoothOwner")
		local slot = part:GetAttribute("BoothSlot")
		if slot and owner == LocalPlayer.UserId then
			return slot
		end
	end
	return nil
end

local function boothPart(slot)
	if not boothInteractions then
		return nil
	end
	for _, part in ipairs(boothInteractions:GetChildren()) do
		if part:GetAttribute("BoothSlot") == slot then
			return part
		end
	end
	return nil
end

local function freeBooths()
	local list = {}
	if not boothInteractions then
		return list
	end
	for _, part in ipairs(boothInteractions:GetChildren()) do
		local slot = part:GetAttribute("BoothSlot")
		if slot and part:GetAttribute("BoothOwner") == nil then
			list[#list + 1] = { slot = slot, part = part }
		end
	end
	table.sort(list, function(a, b)
		return a.slot < b.slot
	end)
	return list
end

local function nearestFreeBooth()
	local list = freeBooths()
	if #list == 0 then
		return nil
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return list[1]
	end
	local best, bestDistance = nil, math.huge
	for _, entry in ipairs(list) do
		local distance = (entry.part.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = entry, distance
		end
	end
	return best
end

local function claimBooth(slot)
	if not claimBoothRemote then
		return false
	end
	local ok = pcall(function()
		claimBoothRemote:InvokeServer(slot)
	end)
	if not ok then
		return false
	end
	task.wait(0.7)
	return myBoothSlot() == slot
end

local function walkToBooth(slot)
	local part = boothPart(slot)
	local character = LocalPlayer.Character
	if not part or not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	local goal = part.Position
	if (root.Position - goal).Magnitude > 60 then
		root.CFrame = CFrame.new(goal + Vector3.new(0, 4, 0))
		task.wait(0.6)
	end
	humanoid.WalkSpeed = 26
	humanoid:MoveTo(goal)
	local reached = false
	local connection = humanoid.MoveToFinished:Connect(function()
		reached = true
	end)
	local deadline = os.clock() + 20
	while not reached and os.clock() < deadline and humanoid.Health > 0 do
		task.wait(0.2)
	end
	connection:Disconnect()
	humanoid.WalkSpeed = 16
	root.CFrame = CFrame.new(goal + Vector3.new(0, 3.4, 0))
end

