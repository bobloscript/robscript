local function hopServer()
	local placeId = PLACE_MAIN
	if voiceAvailable and Airflow.Flags.VoiceServers and Airflow.Flags.VoiceServers:Get() then
		placeId = PLACE_VOICE
	end

	local response = httpRequest({
		Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true", placeId),
		Method = "GET",
	})
	if not response or not response.Body then
		return false
	end
	local decoded = nil
	pcall(function()
		decoded = HttpService:JSONDecode(response.Body)
	end)
	if type(decoded) ~= "table" or type(decoded.data) ~= "table" then
		return false
	end
	local candidates = {}
	for _, server in ipairs(decoded.data) do
		local playing = tonumber(server.playing)
		if playing and server.id ~= game.JobId and playing >= 10 and playing <= 26 then
			candidates[#candidates + 1] = server.id
		end
	end
	if #candidates == 0 then
		return false
	end
	local target = candidates[math.random(#candidates)]

	local loaderUrl = Airflow.Flags.LoaderUrl and tostring(Airflow.Flags.LoaderUrl:Get() or "") or ""
	loaderUrl = loaderUrl:gsub("%s", "")
	if loaderUrl == "" then
		loaderUrl = DEFAULT_LOADER
	end
	if type(queueOnTeleport) == "function" then
		pcall(queueOnTeleport, string.format('loadstring(game:HttpGet("%s"))()', loaderUrl))
	end

	task.spawn(function()
		if webhookSend({
			title = "Server hop",
			color = 10181046,
			description = string.format("Left a server with score **%d**. Session raised: **%d R$** in **%s**.",
				serverMetrics().score, SESSION.raised, clock(os.time() - SESSION.startedAt)),
			footer = { text = "Robscript - PLS DONATE Director" },
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
		}) then
			lastWebhookAt = os.time()
		end
	end)

	local ok = pcall(function()
		TeleportService:TeleportToPlaceInstance(placeId, target, LocalPlayer)
	end)
	return ok
end

task.spawn(function()
	while task.wait(tonumber(Airflow.Flags.HopCheck and Airflow.Flags.HopCheck:Get()) or 30) do
		local metrics = serverMetrics()
		local threshold = Airflow.Flags.HopBelow and tonumber(Airflow.Flags.HopBelow:Get()) or 30
		if Airflow.Flags.AutoHop and Airflow.Flags.AutoHop:Get() and metrics.score < threshold then
			if os.time() - SESSION.startedAt > 120 then
				if hopServer() then
					break
				end
			end
		end
	end
end)

