local stageProgress = StageBox:CreateProgress({
	Name = "To next stage",
	CurrentValue = 0,
	Color = THEME.Accent,
})

local function stageFill()
	local index = stageOf(totalRaised())
	local nextStage = STAGES[index + 1]
	if not nextStage then
		return 1
	end
	local previous = STAGES[index]
	local span = math.max(nextStage.total - (previous and previous.total or 0), 1)
	return math.clamp((totalRaised() - (previous and previous.total or 0)) / span, 0, 1)
end

task.spawn(function()
	while task.wait(1) do
		pcall(function()
			stageProgress:Set(stageFill())
		end)
	end
end)

