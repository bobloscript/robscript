local function signFont()
	local name = Airflow.Flags.SignFont and tostring(Airflow.Flags.SignFont:Get()) or "GothamBold"
	local font = Enum.Font[name]
	return font or Enum.Font.GothamBold
end

local function signColour()
	local colour = Airflow.Flags.SignColor and Airflow.Flags.SignColor:Get()
	if typeof(colour) == "Color3" then
		return colour
	end
	if type(colour) == "string" and colour:find("#") then
		local ok, parsed = pcall(Color3.fromHex, colour)
		if ok then
			return parsed
		end
	end
	return Color3.fromRGB(255, 59, 127)
end

