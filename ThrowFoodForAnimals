--==============================================================
local function setRaritySelection(selection: any)
	for _, rarity in ipairs(RARITY_ORDER) do
		sellRarities[rarity] = false
	end

	local selected = {}
	if type(selection) == "table" then
		local known = {}
		for _, rarity in ipairs(RARITY_ORDER) do
			known[rarity] = true
		end
		for _, rarity in ipairs(selection) do
			if known[rarity] then
				sellRarities[rarity] = true
				table.insert(selected, rarity)
			end
		end
	end

	log(string.format(
		"<Muted>Selling: %s</Muted>",
		#selected > 0 and table.concat(selected, ", ") or "nothing"
	))
end

local function setMutationSelection(selection: any)
	sellMutations = {}

	local selected = {}
	if type(selection) == "table" then
		for _, mutation in ipairs(selection) do
			sellMutations[mutation] = true
			table.insert(selected, mutation)
		end
	end

	log(string.format(
		"<Muted>Selling: %s</Muted>",
		#selected > 0 and table.concat(selected, ", ") or "any mutation"
	))
end

local function countAnimals()
	local total, placed = 0, 0
	if not DataController then
		return total, placed
	end
	local ok, animals = pcall(function()
		return DataController:Get("Animals")
	end)
	if ok and type(animals) == "table" then
		for _, entry in pairs(animals) do
			if type(entry) == "table" then
				total += 1
				if entry.Placed == true then
					placed += 1
				end
			end
		end
	end
	return total, placed
end

