local function doEquipBest()
	if not resolveRemotes() then
		return false
	end
	local ok, result = pcall(function()
		return Remotes.Invoke("Plot_EquipBest")
	end)
	if not ok or type(result) ~= "table" then
		return false, result
	end
	return result.Ok == true, result
end

local function startEquipLoop()
	if equipLoopRunning then
		return
	end
	equipLoopRunning = true
	task.spawn(function()
		while autoEquipBest do
			doEquipBest()
			local waited, delay = 0, math.max(0.2, equipBestDelay)
			while autoEquipBest and waited < delay do
				task.wait(0.1)
				waited += 0.1
			end
		end
		equipLoopRunning = false
	end)
end

local function setAutoEquipBest(enabled: boolean)
	autoEquipBest = enabled == true
	if autoEquipBest then
		if not resolveRemotes() then
			autoEquipBest = false
			return false
		end
		startEquipLoop()
		log("<Success>Best pets: on</Success>")
		return true
	end
	equipLoopRunning = false
	log("<Muted>Best pets: off</Muted>")
	return true
end

