--==============================================================
-- FARM / TRAIN ROTATION
--==============================================================
local function applyRotationPhase(phase: string): boolean
	rotationSwitching = true
	if phase == "Farm" then
		if Toggles.AutoTrain and Toggles.AutoTrain.Value then
			Toggles.AutoTrain:Set(false)
		end
		if Toggles.AutoThrow and not Toggles.AutoThrow.Value then
			Toggles.AutoThrow:Set(true)
		end
	else
		if Toggles.AutoThrow and Toggles.AutoThrow.Value then
			Toggles.AutoThrow:Set(false)
		end
		if Toggles.AutoTrain and not Toggles.AutoTrain.Value then
			Toggles.AutoTrain:Set(true)
		end
	end
	rotationSwitching = false

	local handle = if phase == "Farm" then Toggles.AutoThrow else Toggles.AutoTrain
	return handle ~= nil and handle.Value == true
end

local function stopRotation(stopPhases: boolean)
	autoRotation = false
	rotationLoopRunning = false
	rotationPhase = "Idle"
	rotationPhaseEndsAt = 0

	if not stopPhases then
		return
	end

	rotationSwitching = true
	if Toggles.AutoThrow and Toggles.AutoThrow.Value then
		Toggles.AutoThrow:Set(false)
	end
	if Toggles.AutoTrain and Toggles.AutoTrain.Value then
		Toggles.AutoTrain:Set(false)
	end
	rotationSwitching = false
end

local function startRotationLoop()
	if rotationLoopRunning then
		return
	end
	rotationLoopRunning = true

	task.spawn(function()
		local phase = if rotationStartWith == "Train" then "Train" else "Farm"

		while autoRotation do
			if not applyRotationPhase(phase) then
				notify(
					"Timer",
					if phase == "Farm"
						then "Could not start farming. Rejoin the game and try again."
						else "Could not start training. Rejoin the game and try again.",
					"Error"
				)
				log("<Error>Timer stopped</Error> <Muted>· nothing started</Muted>")
				if Toggles.AutoRotation then
					Toggles.AutoRotation:Set(false, true)
				end
				stopRotation(true)
				break
			end

			local duration = math.max(10, if phase == "Farm" then farmPhaseSeconds else trainPhaseSeconds)
			rotationPhase = phase
			rotationPhaseEndsAt = os.clock() + duration
			log(string.format(
				"<Accent>%s</Accent> <Muted>· %s</Muted>",
				if phase == "Farm" then "Farming" else "Training",
				formatDuration(duration)
			))

			while autoRotation and os.clock() < rotationPhaseEndsAt do
				task.wait(0.25)
			end
			if not autoRotation then
				break
			end

			phase = if phase == "Farm" then "Train" else "Farm"
		end

		rotationPhase = "Idle"
		rotationPhaseEndsAt = 0
		rotationLoopRunning = false
	end)
end

local function setAutoRotation(enabled: boolean)
	if enabled then
		if not resolveThrowMods() then
			return false
		end
		if not resolveTrainMods() then
			return false
		end
		autoRotation = true
		startRotationLoop()
		log("<Success>Timer started</Success>")
		return true
	end
	stopRotation(true)
	log("<Muted>Timer stopped</Muted>")
	return true
end

