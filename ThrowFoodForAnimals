--==============================================================
local function getTrainingSpot()
	local props = workspace:FindFirstChild("LocalPlotProps")
	if not props then
		return nil
	end
	local area = props:FindFirstChild("TrainingArea")
	if not area then
		return nil
	end
	local spot = area:FindFirstChild("TrainingSpot")
	if spot and spot:IsA("BasePart") then
		return spot
	end
	return nil
end

local function teleportToTraining()
	local spot = getTrainingSpot()
	if not spot then
		return false
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	root.CFrame = spot.CFrame + Vector3.new(0, 3, 0)
	return true
end

local function isOnTrainingCircle()
	local spot = getTrainingSpot()
	if not spot then
		return false
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local offset = root.Position - spot.Position
	return Vector3.new(offset.X, 0, offset.Z).Magnitude < math.max(spot.Size.Y, spot.Size.Z) / 2 + 2
end

local function clickTapBonus()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end
	local sequence = playerGui:FindFirstChild("TrainingSequence")
	if not sequence then
		return
	end
	local layer = sequence:FindFirstChild("TapBonusLayer")
	if not layer then
		return
	end
	local button = layer:FindFirstChild("TapBonus")
	if not button or not button:IsA("ImageButton") then
		return
	end
	if not button.Active then
		return
	end

	if type(getconnections) == "function" then
		local ok, connections = pcall(getconnections, button.Activated)
		if ok and connections then
			for _, connection in ipairs(connections) do
				pcall(function()
					if type(connection.Fire) == "function" then
						connection:Fire()
					elseif type(connection.Function) == "function" then
						connection.Function()
					end
				end)
			end
			return
		end
	end
	pcall(function()
		button:Activate()
	end)
end

local function canStartTraining(): boolean
	if not (Remotes and TrainingController) then
		return false
	end
	if ClientState and (ClientState.Busy or ClientState.OfflineOpen) then
		return false
	end
	if ClientState and ClientState.TutorialActive then
		return false
	end
	local running = false
	pcall(function()
		running = TrainingController.IsRunning()
	end)
	return not running
end

local function startTrainClickLoop()
	if trainClickRunning then
		return
	end
	trainClickRunning = true
	task.spawn(function()
		while autoTrain do
			pcall(clickTapBonus)
			task.wait(0.1)
		end
		trainClickRunning = false
	end)
end

local function startTrainLoop()
	if trainLoopRunning then
		return
	end
	trainLoopRunning = true
	task.spawn(function()
		while autoTrain do
			if canStartTraining() then
				if not isOnTrainingCircle() then
					pcall(teleportToTraining)
					task.wait(0.35)
				end
				if autoTrain and canStartTraining() and isOnTrainingCircle() then
					task.spawn(function()
						pcall(function()
							TrainingController.Start()
						end)
					end)
				end
			end
			task.wait(0.5)
		end
		trainLoopRunning = false
	end)
end

