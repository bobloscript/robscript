	-- Older configs stored minutes; bring those two sliders back to seconds.
	pcall(function()
		local flags = Airflow.Flags
		if flags and flags.FarmPhase and (flags.FarmPhase.Value or 0) < 30 then
			flags.FarmPhase:Set(farmPhaseSeconds)
