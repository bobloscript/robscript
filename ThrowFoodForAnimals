local function hookThrowStart()
	if oldThrowStart or not ThrowController then
		return false
	end
	if type(ThrowController.Start) ~= "function" then
		return false
	end
	oldThrowStart = ThrowController.Start
	ThrowController.Start = function(...)
		if autoThrow then
			return
		end
		return oldThrowStart(...)
	end
	return true
end

local function unhookThrowStart()
	if not oldThrowStart then
		return
	end
	if ThrowController then
		pcall(function()
			ThrowController.Start = oldThrowStart
		end)
	end
	oldThrowStart = nil
end

local function ensurePastLine()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end

	if not crossLineCached then
		local area = workspace:FindFirstChild("StarterArea")
		crossLineCached = area and area:FindFirstChild("CrossLine")
	end
	if not crossLineCached then
		return true
	end

	if root.Position.Z < crossLineCached.Position.Z - 2 then
		pastLine = true
		return true
	end

	root.CFrame = CFrame.new(root.Position.X, root.Position.Y + 2, crossLineCached.Position.Z - 8)
	pastLine = true
	return true
end

local function teleportBackFromLine()
	local area = workspace:FindFirstChild("StarterArea")
	local crossLine = area and area:FindFirstChild("CrossLine")
	if not crossLine then
		return
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if root.Position.Z < crossLine.Position.Z + 2 then
		root.CFrame = CFrame.new(root.Position.X, root.Position.Y + 1, crossLine.Position.Z + 4)
	end
end

local function resetThrowState()
	if not Remotes then
		return
	end
	if ClientState and ClientState.Busy then
		ClientState.Busy = nil
		pcall(function()
			Remotes.Invoke("Throw_Cancel")
		end)
		task.wait(0.15)
		pcall(function()
			Remotes.Invoke("Throw_Cancel")
		end)
	end
end

local function waitForCooldown()
	local elapsed = os.clock() - lastThrowAt
	local remain = cooldownEstimate - elapsed
	if remain > 0.05 then
		task.wait(remain + 0.05)
	end
end

local function instantThrowOnce()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, false
	end

	resetThrowState()

	if not pastLine then
		ensurePastLine()
		pastLine = true
	end
	if crossLineCached and root.Position.Z > crossLineCached.Position.Z then
		ensurePastLine()
		pastLine = true
	end

	waitForCooldown()

	if ClientState then
		ClientState.Busy = "Throw"
	end
	local wasAnchored = root.Anchored
	root.Anchored = true

	local complete, caught = false, nil
	local cooldownHit = false
	local startOk, startResult, resolveOk, resolveResult, completeOk, completeResult

	startOk, startResult = pcall(function()
		return Remotes.Invoke("Throw_Start")
	end)
	if startOk and type(startResult) == "table" and startResult.Ok == true then
		resolveOk, resolveResult = pcall(function()
			return Remotes.Invoke("Throw_Resolve", 1)
		end)
		if resolveOk and type(resolveResult) == "table" and resolveResult.Ok == true then
			task.wait(0.4)
			completeOk, completeResult = pcall(function()
				return Remotes.Invoke("Throw_Complete")
			end)
			if completeOk and ((type(completeResult) == "table" and completeResult.Ok == true) or completeResult == true) then
				complete = true
				caught = resolveResult
				lastThrowAt = os.clock()
				cooldownStrikes = 0
			else
				pcall(function()
					Remotes.Invoke("Throw_Cancel")
				end)
			end
		else
			pcall(function()
				Remotes.Invoke("Throw_Cancel")
			end)
		end
	else
		if startResult and startResult.Reason == "Cooldown" then
			cooldownHit = true
			cooldownStrikes += 1
			if cooldownStrikes >= 2 then
				cooldownEstimate = math.min(cooldownEstimate + 0.3, 3.0)
				cooldownStrikes = 0
			end
		end
	end

	root.Anchored = wasAnchored
	if ClientState then
		ClientState.Busy = nil
	end

	if complete and caught and caught.ModelName then
		local name = tostring(caught.ModelName)
		local distance = math.floor(tonumber(caught.Distance) or 0)
		log(string.format("<Success>Caught</Success> %s <Muted>· %d m</Muted>", name, distance))
		if catchAlerts then
			notify("Caught", name .. " · " .. distance .. " m", "Success")
		end
	end

	return complete, cooldownHit
end

local function startThrowLoop()
	if throwLoopRunning then
		return
	end
	throwLoopRunning = true
	task.spawn(function()
		while autoThrow do
			local ok, _, cooldownHit = pcall(instantThrowOnce)
			if not ok then
				task.wait(0.5)
			elseif cooldownHit then
				task.wait(0.1)
			else
				local waited = 0
				while autoThrow and waited < 0.1 do
					task.wait(0.02)
					waited += 0.02
				end
			end
		end
		throwLoopRunning = false
	end)
end

local function trySetThrowPower()
	if powerSet or not Remotes then
		return
	end
	powerSet = true
	pcall(function()
		Remotes.Invoke("Player_SetThrowPower", 999999999)
	end)
end

local function setAutoThrow(enabled: boolean)
	if enabled then
		if not resolveThrowMods() then
			return false
		end
		if not hookThrowStart() then
			return false
		end
		if autoTrain then
			autoTrain = false
			trainLoopRunning = false
			trainClickRunning = false
		end
		autoThrow = true
		pastLine = false
		crossLineCached = nil
		powerSet = false
		lastThrowAt = 0
		cooldownEstimate = 1.5
		cooldownStrikes = 0
		task.spawn(trySetThrowPower)
		startThrowLoop()
		log("<Success>Throwing food: on</Success>")
		return true
	end
	autoThrow = false
	throwLoopRunning = false
	powerSet = false
	unhookThrowStart()
	pastLine = false
	crossLineCached = nil
	pcall(teleportBackFromLine)
	log("<Muted>Throwing food: off</Muted>")
	return true
end

