local okUI, uiError = pcall(buildUI)
if not okUI then
	shutdown()
	error("[" .. HUB_NAME .. "] interface failed to build: " .. tostring(uiError))
end

Environment.RobscriptTFFAShutdown = shutdown

task.spawn(function()
	local ready = resolveThrowMods()
	if game.PlaceId ~= EXPECTED_PLACE_ID then
		notify("Wrong game", "This menu is made for Throw Food For Animals.", "Warning")
		log("<Error>Wrong game</Error> <Muted>· open Throw Food For Animals first</Muted>")
	end
	if not ready then
		log("<Warning>Still loading your game.</Warning> If nothing starts, press Check my game.")
	end
	log(string.format("<Success>Robscript Team - TFFA v%s ready</Success> <Muted>· have fun!</Muted>", HUB_VERSION))
	notify("TFFA", "Ready! Press RightControl to hide this menu.", "Success")
end)
