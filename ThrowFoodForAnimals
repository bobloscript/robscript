local function nextStandPrice()
	if not (DataController and StandsConfig) then
		return nil
	end
	local current = 0
	local ok, value = pcall(function()
		return DataController:Get("Stand")
	end)
	if ok then
		current = value or 0
	end
	local info = StandsConfig.Get(current + 1)
	if type(info) ~= "table" then
		return nil
	end
	return tonumber(info.Price)
end

local function nextFencePrice()
	if not (DataController and FenceConfig) then
		return nil
	end
	local current = 0
	local ok, value = pcall(function()
		return DataController:Get("FenceLevel")
	end)
	if ok then
		current = value or 0
	end
	local info = FenceConfig.Get(current + 1)
	if type(info) ~= "table" then
		return nil
	end
	return tonumber(info.Price)
end

local function canAfford(price: any): boolean
	if type(price) ~= "number" then
		return false
	end
	return getMoney() >= price
end

local function tryUpgradeStand()
	if not resolveUpgradeMods() then
		return false
	end
	if ClientState and ClientState.Busy then
		return false
	end
	local price = nextStandPrice()
	if not price or not canAfford(price) then
		return false
	end
	local ok, result = pcall(function()
		return Remotes.Invoke("Stand_Upgrade")
	end)
	if not ok then
		return false
	end
	return (type(result) == "table" and result.Ok == true) or result == true
end

local function tryUpgradeFence()
	if not resolveUpgradeMods() then
		return false
	end
	if ClientState and ClientState.Busy then
		return false
	end
	local price = nextFencePrice()
	if not price or not canAfford(price) then
		return false
	end
	local ok, result = pcall(function()
		return Remotes.Invoke("Plot_UpgradeFence")
	end)
	if not ok then
		return false
	end
	return (type(result) == "table" and result.Ok == true) or result == true
end

local function startStandUpgradeLoop()
	if standUpLoopRunning then
		return
	end
	standUpLoopRunning = true
	task.spawn(function()
		while autoUpStand do
			pcall(tryUpgradeStand)
			task.wait(upgradeDelay)
		end
		standUpLoopRunning = false
	end)
end

