		Update = function()
			if not DataController then
				return "<Muted>No data</Muted>"
			end
			local ok, owned = pcall(function()
				return DataController:Get("OwnedFoods")
			end)
			if not ok or type(owned) ~= "table" then
				return "<Muted>No data</Muted>"
			end
			local count = 0
			for _, value in pairs(owned) do
				if value == true then
					count += 1
