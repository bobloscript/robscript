local function setAutoUpgradeStand(enabled: boolean)
	autoUpStand = enabled == true
	if autoUpStand then
		if not resolveUpgradeMods() then
			autoUpStand = false
			return false
		end
		startStandUpgradeLoop()
		log("<Success>Stand upgrades: on</Success>")
