-- Drop a leftover window from a build that stopped before it could clean up.
local function purgeLeftoverWindow()
	local roots = {}
	pcall(function()
		table.insert(roots, game:GetService("CoreGui"))
	end)
	local hidden = if typeof(gethui) == "function" then gethui() else nil
	if hidden then
		table.insert(roots, hidden)
	end
	for _, root in ipairs(roots) do
		for _, child in ipairs(root:GetChildren()) do
			if child:IsA("ScreenGui") and child.Name == HUB_NAME then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end
end

