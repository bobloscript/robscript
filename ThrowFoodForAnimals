-- AUTO BUY FOOD
--==============================================================
local function isFoodOwned(index: number): boolean
	local ok, value = pcall(function()
		return DataController:GetPath("OwnedFoods." .. index)
	end)
	return ok and value == true
end

local function isFoodLocked(index: number): boolean
	local ok, value = pcall(function()
		return FoodsConfig.IsLocked(index)
	end)
	return ok and value == true
end

local function tryBuyFood(index: number)
	if not resolveRemotes() then
		return false
	end
	local ok, result = pcall(function()
		return Remotes.Invoke("Shop_Buy", index)
	end)
	if not ok then
		return false
	end
	return (type(result) == "table" and result.Ok == true) or result == true
end

local function tryEquipFood(index: number)
	if not resolveRemotes() then
		return false
	end
	local ok, result = pcall(function()
		return Remotes.Invoke("Shop_Equip", index)
	end)
	if not ok then
		return false
	end
	return (type(result) == "table" and result.Ok == true) or result == true
end

local function buildBuyList(money: number)
	local list = {}
	if not FoodsConfig then
		return list
	end
	for index = 1, FoodsConfig.CountAll() do
		if not isFoodOwned(index) and not isFoodLocked(index) then
			local food = FoodsConfig.GetAny(index)
			if food and type(food.Price) == "number" and money >= food.Price then
				list[#list + 1] = {
					index = index,
					price = food.Price,
					tier = food.Tier or 99,
					name = food.Name or tostring(index),
				}
			end
		end
	end
	table.sort(list, function(a, b)
		if a.tier ~= b.tier then
			return a.tier < b.tier
		end
		return a.price < b.price
	end)
	return list
end

local function buyPass(): number
	if not resolveBuyMods() then
		return 0
	end
	local money = getMoney()
	local list = buildBuyList(money)
	local bought = 0
	for _, candidate in ipairs(list) do
		if not autoBuy then
			break
		end
		money = getMoney()
		if money < candidate.price then
			break
		end
		if isFoodOwned(candidate.index) then
			continue
		end
		if tryBuyFood(candidate.index) then
			bought += 1
			tryEquipFood(candidate.index)
			log(string.format("<Accent>Bought</Accent> %s <Muted>for %s</Muted>", candidate.name, formatMoney(candidate.price)))
		end
		task.wait(buyDelay)
	end
	return bought
end

local function startBuyLoop()
	if buyLoopRunning then
		return
	end
	buyLoopRunning = true
	task.spawn(function()
		while autoBuy do
			pcall(buyPass)
			local waited = 0
			while autoBuy and waited < buyLoopWait do
				task.wait(0.1)
				waited += 0.1
			end
		end
		buyLoopRunning = false
	end)
end

local function setAutoBuy(enabled: boolean)
	if enabled then
		if not resolveBuyMods() then
			return false
		end
		autoBuy = true
		startBuyLoop()
		log("<Success>Food shopping: on</Success>")
		return true
	end
	autoBuy = false
	buyLoopRunning = false
	log("<Muted>Food shopping: off</Muted>")
	return true
end

--==============================================================
-- AUTO SELL (rarity + mutation filters)
--==============================================================
local function rarityFromModelName(modelName: any): string?
	if type(modelName) ~= "string" or modelName == "" then
		return nil
	end
	if not AnimalEconomy or type(AnimalEconomy.Get) ~= "function" then
		return nil
	end
	local info = AnimalEconomy.Get(modelName)
	if type(info) == "table" and type(info.Rarity) == "string" then
		return info.Rarity
	end
	local list = AnimalEconomy.List
	if type(list) == "table" then
		local row = list[modelName]
		if type(row) == "table" and type(row.Rarity) == "string" then
			return row.Rarity
		end
	end
	return nil
end

local function getEntryModelName(entry: any): string?
	if type(entry) ~= "table" then
		return nil
	end
	if type(entry.ModelName) == "string" and entry.ModelName ~= "" then
		return entry.ModelName
	end
	if type(entry.Name) == "string" then
		return entry.Name
	end
	if type(entry.name) == "string" then
		return entry.name
	end
	return nil
end

local function hasMutationFilter(): boolean
	return next(sellMutations) ~= nil
end

local function mutationAllowed(entry: any): boolean
	if not hasMutationFilter() then
		return true
	end
	local mutation = entry and entry.Mutation
	if type(mutation) == "string" and mutation ~= "" then
		return sellMutations[mutation] == true
	end
	return sellMutations["None"] == true
end

local function doAutoSellPass(): number
	if not resolveSellMods() then
		return 0
	end
	local animals
	pcall(function()
		animals = DataController:Get("Animals")
	end)
	if type(animals) ~= "table" then
		return 0
	end
	local sold = 0
	for id, entry in pairs(animals) do
		if not autoSell then
			break
		end
		if type(entry) ~= "table" then
			continue
		end
		if entry.Placed == true then
			continue
		end
		if entry.Bought == true then
			continue
		end
		local modelName = getEntryModelName(entry)
		local rarity = rarityFromModelName(modelName)
		if not rarity or not sellRarities[rarity] then
			continue
		end
		if not mutationAllowed(entry) then
			continue
		end
		local ok, result = pcall(function()
			return Remotes.Invoke("Plot_SellAnimal", id)
		end)
		if ok and type(result) == "table" and result.Ok then
			sold += 1
			task.wait(0.15)
		end
	end
	return sold
end

local function startSellLoop()
	if sellLoopRunning then
		return
	end
	sellLoopRunning = true
	task.spawn(function()
		while autoSell do
			local sold = doAutoSellPass()
			if sold > 0 then
				log(string.format("<Accent>Sold</Accent> %d pet%s", sold, sold == 1 and "" or "s"))
			end
			local waited, delay = 0, math.max(0.2, sellDelay)
			while autoSell and waited < delay do
				task.wait(0.1)
				waited += 0.1
			end
		end
		sellLoopRunning = false
	end)
end

local function setAutoSell(enabled: boolean)
	autoSell = enabled == true
	if autoSell then
		if not resolveSellMods() then
			autoSell = false
			return false
		end
		startSellLoop()
		log("<Success>Selling pets: on</Success>")
		return true
	end
	sellLoopRunning = false
	log("<Muted>Selling pets: off</Muted>")
	return true
end

