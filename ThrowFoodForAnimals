-- MONEY
--==============================================================
local MONEY_SUFFIX = {
	K = 1e3,
	M = 1e6,
	B = 1e9,
	T = 1e12,
	Qa = 1e15,
	Qi = 1e18,
	Sx = 1e21,
	Sp = 1e24,
	Oc = 1e27,
	No = 1e30,
	Dc = 1e33,
	Ud = 1e36,
	Dd = 1e39,
	Td = 1e42,
	Qad = 1e45,
	Qid = 1e48,
}

local MONEY_UNITS = {
	{ 1e48, "Qid" }, { 1e45, "Qad" }, { 1e42, "Td" }, { 1e39, "Dd" }, { 1e36, "Ud" },
	{ 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" }, { 1e24, "Sp" }, { 1e21, "Sx" },
	{ 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
}

local function parseMoney(value: any): number
	if type(value) == "number" then
		return value
	end
	if type(value) ~= "string" then
		return 0
	end
	local cleaned = value:gsub("%s", ""):gsub(",", ""):gsub("%$", "")
	local number, suffix = cleaned:match("^([%d%.eE%+%-]+)(%a*)$")
	if number then
		local parsed = tonumber(number) or 0
		if suffix ~= "" and MONEY_SUFFIX[suffix] then
			return parsed * MONEY_SUFFIX[suffix]
		end
		return parsed
	end
	return tonumber(cleaned) or 0
end

local function formatMoney(value: any): string
	local number = tonumber(value) or 0
	local sign = if number < 0 then "-" else ""
	number = math.abs(number)
	for _, unit in ipairs(MONEY_UNITS) do
		if number >= unit[1] then
			local scaled = number / unit[1]
			local pattern = if scaled >= 100 then "%.0f" elseif scaled >= 10 then "%.1f" else "%.2f"
			return sign .. string.format(pattern, scaled) .. unit[2]
		end
	end
	return sign .. tostring(math.floor(number))
end

local function formatDuration(seconds: number): string
	local total = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	if total >= 60 then
		local minutes = math.floor(total / 60)
		local rest = total % 60
		if rest == 0 then
			return string.format("%d min", minutes)
		end
		return string.format("%d:%02d", minutes, rest)
	end
	return string.format("%d s", total)
end

local function getMoney(): number
	if DataController then
		local ok, value = pcall(function()
			return DataController:Get("Money")
		end)
		if ok and type(value) == "number" then
			return value
		end
	end
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	local money = leaderstats and leaderstats:FindFirstChild("Money")
	if money and type(money.Value) == "number" then
		return money.Value
	end
	return parseMoney(money and money.Value or "0")
end

