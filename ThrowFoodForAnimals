			local remain = math.max(0, rotationPhaseEndsAt - os.clock())
			local label = if rotationPhase == "Train" then "<Accent>Training</Accent>" else "<Success>Farming</Success>"
			return string.format("%s <Muted>· %s left</Muted>", label, formatDuration(remain))
