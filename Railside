local function injuryCount(player: Player): number
	local count = 0
	for _, key in ipairs(INJURY_KEYS) do
		local value = tonumber(attributeOf(player, key)) or 0
		if value > 0 then
			count += 1
		end
	end
	return count
end

local function roleOf(player: Player): string
	local role = attributeOf(player, "StationRole")
	if type(role) == "string" and role ~= "" and ROLE_COLORS[role] then
		return role
	end
	local team = player.Team
	if team then
		for roleId, roleData in pairs((roleConfig and roleConfig.Roles) or {}) do
			if type(roleData) == "table" and roleData.Team == team.Name then
				return roleId
			end
		end
	end
	return "Unknown"
end

----- ESP -----
local function removeEsp(player: Player)
	local entry = espEntries[player]
	if not entry then
		return
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
	if entry.billboard then
		entry.billboard:Destroy()
	end
	espEntries[player] = nil
end

local function clearEsp()
	for player in pairs(espEntries) do
		removeEsp(player)
	end
end

local function buildEsp(player: Player, character: Model, role: string): EspEntry
	local color = ROLE_COLORS[role] or Color3.new(1, 1, 1)

	local highlight = Instance.new("Highlight")
	highlight.Name = "RailSideHubHighlight"
	highlight.FillColor = color
	highlight.FillTransparency = 0.7
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee = character
	highlight.Parent = character

	local entry: EspEntry = { highlight = highlight, billboard = nil, label = nil, role = role }

	local anchor = (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")) :: BasePart?
	if anchor then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "RailSideHubTag"
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.fromOffset(240, 40)
		billboard.StudsOffset = Vector3.new(0, 2.1, 0)
		billboard.MaxDistance = State.espMaxDistance
		billboard.Adornee = anchor

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.4
		label.TextWrapped = true
		label.Text = player.Name
		label.Parent = billboard

		billboard.Parent = anchor
		entry.billboard = billboard
		entry.label = label
	end

	return entry
end

local function updateEsp()
	if not State.espEnabled then
		return
	end

	local root = getRoot()

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			continue
		end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local role = roleOf(player)

		local visible = character ~= nil
			and humanoid ~= nil
			and humanoid.Health > 0
			and State.espRoles[role] == true

		if not visible then
			removeEsp(player)
			continue
		end

		local distance = 0
		if root then
			local targetRoot = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if targetRoot then
				distance = (root.Position - targetRoot.Position).Magnitude
			end
		end

		if distance > State.espMaxDistance then
			removeEsp(player)
			continue
		end

		local entry = espEntries[player]
		if
			not entry
			or entry.role ~= role
			or not entry.highlight
			or not entry.highlight.Parent
			or (entry.billboard == nil and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")) ~= nil)
		then
			removeEsp(player)
			entry = buildEsp(player, character, role)
			espEntries[player] = entry
		end

		if entry.label then
			local health = humanoid and math.max(0, math.floor(humanoid.Health)) or 0
			local roleText = ROLE_LABELS[role] or role
			if State.espShowDistance then
				entry.label.Text = string.format("%s\n%s | %d hp | %d m", player.Name, roleText, health, math.floor(distance))
			else
				entry.label.Text = string.format("%s\n%s | %d hp", player.Name, roleText, health)
			end
		end
	end

	for player in pairs(espEntries) do
		if not player.Parent then
			removeEsp(player)
		end
	end
end

----- Survival helpers -----
local function fire(remote: Instance?, ...)
	if not remote then
		return false
	end
	local args = table.pack(...)
	local ok = pcall(function()
		(remote :: any):FireServer(table.unpack(args, 1, args.n))
	end)
	return ok
end

local function invokeShop(action: string, payload: any): (boolean, any)
	if not Remotes.ShopRequest then
		return false, "no shop"
	end
	local ok, result = pcall(function()
		return (Remotes.ShopRequest :: any):InvokeServer(action, payload)
	end)
	return ok, result
end

local function nearestThreat()
	local myRole = roleOf(LocalPlayer)
	-- Passengers look for the patrol; the patrol and the guards look for passengers.
	local hostile = if myRole == "Citizen" then HOSTILE_TO_CITIZEN else HOSTILE_TO_STAFF
	local root = getRoot()

	local bestDistance = math.huge
	local bestPlayer: Player? = nil
	local bestRole = "-"

	if not root then
		return math.huge, nil, "-"
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local role = roleOf(player)
			if hostile[role] then
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local targetRoot = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if targetRoot and humanoid and humanoid.Health > 0 then
					local distance = (root.Position - targetRoot.Position).Magnitude
					if distance < bestDistance then
						bestDistance = distance
						bestPlayer = player
						bestRole = role
					end
				end
			end
		end
	end

	return bestDistance, bestPlayer, bestRole
end

