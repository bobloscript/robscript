UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	for _, bind in ipairs(Binds) do
		local handle = bind.handle
		if handle and not handle.Listening and handle.Value == input.KeyCode then
			task.spawn(bind.action)
		end
	end
end)

----- Master loop -----
local accumulator = 0
local espWasEnabled = false
local fearHeld = false

RunService.Heartbeat:Connect(function(deltaTime: number)
	accumulator += deltaTime
	if accumulator < 0.15 then
		return
	end
	accumulator = 0

	if State.espEnabled and not espWasEnabled then
		espWasEnabled = true
	elseif not State.espEnabled and espWasEnabled then
		espWasEnabled = false
		clearEsp()
	end

	updateEsp()

	local distance, threat, threatRole = nearestThreat()
	State.nearestThreatDistance = distance
	State.nearestThreatName = if threat then threat.Name else "-"
	State.nearestThreatRole = threatRole

	local now = os.clock()
	local inDanger = threat ~= nil and distance <= State.dangerRadius

	if inDanger and State.dangerAlert and now - State.lastThreatNotice > 6 then
		State.lastThreatNotice = now
		beep()
		Hub.notify(
			T("danger"),
			string.format("%s (%s) — %d m", threat.Name, ROLE_LABELS[threatRole] or threatRole, math.floor(distance)),
			"Warning"
		)
	end

	if inDanger and State.autoReleaseOnDanger and now - State.lastReleaseAt > 2 then
		State.lastReleaseAt = now
		fire(Remotes.GripRelease)
	end

	local frozen = attributeOf(LocalPlayer, "StationFearFrozen") == true
	local fearEffect = tonumber(attributeOf(LocalPlayer, "StationFearEffect")) or 0
	local fearUntil = tonumber(attributeOf(LocalPlayer, "StationFearEffectUntil")) or 0

	if State.autoPanic then
		local shouldHold = frozen or (fearEffect > 0 and workspace:GetServerTimeNow() < fearUntil)
		if shouldHold and not fearHeld then
			fearHeld = true
			fire(Remotes.FearResist, true)
		elseif not shouldHold and fearHeld then
			fearHeld = false
			fire(Remotes.FearResist, false)
		end
	elseif fearHeld then
		fearHeld = false
		fire(Remotes.FearResist, false)
	end

	if State.autoDrink and now - State.lastDrinkAt > 8 then
		local stamina = tonumber(attributeOf(LocalPlayer, "Stamina")) or 100
		local cola = tonumber(attributeOf(LocalPlayer, "ShopCola")) or 0
		if stamina < 35 and cola > 0 then
			State.lastDrinkAt = now
			fire(Remotes.Drink)
		end
	end

	if State.autoBandage and now - State.lastBandageAt > 15 and injuryCount(LocalPlayer) > 0 then
		local coins = tonumber(attributeOf(LocalPlayer, "ZcpCoins")) or 0
		if coins >= BANDAGE_PRICE then
			State.lastBandageAt = now
			task.spawn(function()
				invokeShop("buy", "Bandage")
			end)
		end
	end

	if State.autoPills and now - State.lastPillsAt > 25 then
		local fear = tonumber(attributeOf(LocalPlayer, "Fear")) or 0
		local sanity = tonumber(attributeOf(LocalPlayer, "Sanity")) or 100
		local coins = tonumber(attributeOf(LocalPlayer, "ZcpCoins")) or 0
		if (fear >= 40 or sanity <= 60) and coins >= PILLS_PRICE then
			State.lastPillsAt = now
			task.spawn(function()
				invokeShop("buy", "Pills")
			end)
		end
	end
end)

