local function accuracyText()
	local stats = runtime.stats
	if not stats then
		return "-"
	end
	local judged = stats.Perfect + stats.Good + stats.Miss
	if judged == 0 then
		return "100.0%"
	end
	return string.format("%.1f%%", (stats.Perfect + stats.Good * 0.6) / judged * 100)
end

local function phaseText()
	local phase = runtime.phase
	if phase == "Playing" then
		return "<Success>Playing</Success>"
	elseif phase == "Lobby" then
		return "<Muted>Lobby</Muted>"
	elseif phase == "Results" then
		return "<Muted>Results</Muted>"
	elseif phase == "" then
		return "<Muted>Idle</Muted>"
	end
	return "<Muted>" .. phase .. "</Muted>"
end

