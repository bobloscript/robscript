----- Public API -----

local FLAG_MAP = {
	{ flag = "Autoplay", key = "autoplay" },
	{ flag = "TimingOffset", key = "offsetMs" },
	{ flag = "NaturalTiming", key = "naturalTiming" },
	{ flag = "Jitter", key = "jitterMs" },
	{ flag = "AutoJoin", key = "autoJoin" },
	{ flag = "AutoVote", key = "autoVote" },
	{ flag = "PreferredPart", key = "preferredPart" },
	{ flag = "VoteStrategy", key = "voteStrategy" },
	{ flag = "Difficulty", key = "forcedDifficulty" },
}

syncFromUI = function()
	local flags = Airflow.Flags
	if type(flags) ~= "table" then
		return
	end
	for _, entry in ipairs(FLAG_MAP) do
		local handle = flags[entry.flag]
		if handle and type(handle.Get) == "function" then
			local ok, value = pcall(function()
				return handle:Get()
			end)
			if ok and value ~= nil then
				settings[entry.key] = value
			end
		end
	end
end

local api = {}

function api.Destroy()
	if not RUNNING then
		return
	end
	RUNNING = false
	for _, connection in ipairs(CONNECTIONS) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	CONNECTIONS = {}
	pcall(function()
		Window:Destroy()
	end)
	if getgenv().RobScriptTS == api then
		getgenv().RobScriptTS = nil
	end
end

api.Window = Window
api.Runtime = runtime
api.Airflow = Airflow
api.Settings = settings

function api.Resolve()
	return resolveLaneDown()
end

getgenv().RobScriptTS = api

pcall(function()
	Window:LoadAutoload()
end)

syncFromUI()

Window:Notify({
	Title = "Loaded",
	Content = "Symphony Orchestra ready. Auto Play hits every note.",
	Type = "Success",
})

if not runtime.laneDown then
	Window:Notify({
		Title = "Game not recognised",
		Content = "The note function was not found. Press Rescan in Settings.",
		Type = "Warning",
	})
end
