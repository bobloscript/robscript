----- Upvalue access -----

local valueOnlyUpvalues = false
do
	local token = {}
	local probe = function()
		return token
	end
	local pack = table.pack(pcall(debug.getupvalue, probe, 1))
	if pack[1] then
		if rawequal(pack[2], token) then
			valueOnlyUpvalues = true
		elseif rawequal(pack[3], token) then
			valueOnlyUpvalues = false
		else
			valueOnlyUpvalues = (pack.n < 3)
		end
	end
end

local function readUpvalue(target, index)
	local ok, first, second = pcall(debug.getupvalue, target, index)
	if not ok then
		return false, nil
	end
	if valueOnlyUpvalues then
		return true, first
	end
	return true, second
end

----- Finding laneDown inside the live client -----

local SOURCE_SUFFIX = "PlayerScripts.RhythmClient"

local function looksLikeConfig(value)
	return type(value) == "table" and value.PerfectWindow ~= nil and value.GoodWindow ~= nil and value.SoloBonus ~= nil
end

local function looksLikeSong(value)
	return type(value) == "table" and (value.SecondsPerBeat ~= nil or value.Title ~= nil) and value.Charts ~= nil
end

local function isServerClock(value)
	return type(value) == "number" and value > 1.0e9 and value < 4.0e9
end

local function collectCandidates()
	if type(getgc) ~= "function" then
		return nil, "getgc is not available in this executor"
	end

	local found = {}
	local ok, err = pcall(function()
		for _, item in ipairs(getgc()) do
			if type(item) == "function" then
				local okInfo, source = pcall(debug.info, item, "s")
				if okInfo and type(source) == "string" and #source >= #SOURCE_SUFFIX then
					if string.sub(source, -#SOURCE_SUFFIX) == SOURCE_SUFFIX then
						table.insert(found, item)
					end
				end
			end
		end
	end)

	if not ok then
		return nil, tostring(err)
	end

	return found, nil
end

local function resolveLaneDown()
	local candidates, collectError = collectCandidates()

	if not candidates then
		runtime.resolveNote = tostring(collectError)
		return nil
	end

	local best = nil
	local bestScore = -math.huge

	for _, candidate in ipairs(candidates) do
		local total = 0
		local functions = 0
		local instances = 0
		local clocks = 0
		local hasConfig = false
		local hasSong = false

		for index = 1, 64 do
			local ok, value = readUpvalue(candidate, index)
			if not ok then
				break
			end
			if value ~= nil then
				total = total + 1
				local kind = typeof(value)
				if kind == "table" then
					if rawequal(value, Config) or looksLikeConfig(value) then
						hasConfig = true
					end
					if looksLikeSong(value) then
						hasSong = true
					end
				elseif kind == "function" then
					functions = functions + 1
				elseif kind == "Instance" then
					instances = instances + 1
				elseif kind == "number" and isServerClock(value) then
					clocks = clocks + 1
				end
			end
		end

		if hasConfig and not hasSong and total >= 12 and total <= 24 and functions >= 2 and clocks >= 2 then
			local score = 100 - math.abs(total - 16) * 5 + clocks * 2 + functions
			if score > bestScore then
				bestScore = score
				best = candidate
			end
		end
	end

	if not best then
		runtime.resolveNote = string.format("no candidate among %d RhythmClient closures", #candidates)
		return nil
	end

	runtime.laneDown = best
	runtime.notesIndex = nil
	runtime.statsIndex = nil
	runtime.resolvedAt = os.clock()
	runtime.resolveNote = string.format("resolved (%d closures)", #candidates)
	return best
end

----- Reading the live note list and counters -----

local function resolveIndexes()
	local laneDown = runtime.laneDown
	if not laneDown then
		return
	end

	for index = 1, 32 do
		local ok, value = readUpvalue(laneDown, index)
		if not ok then
			break
		end
		if type(value) == "table" then
			if runtime.statsIndex == nil and value.Perfect ~= nil and value.Score ~= nil and value.Miss ~= nil then
				runtime.statsIndex = index
			end
			if runtime.notesIndex == nil then
				local first = rawget(value, 1)
				if type(first) == "table" and first.Time ~= nil and first.Lane ~= nil then
					runtime.notesIndex = index
				end
			end
		end
	end
end

local function getNotes()
	if not runtime.laneDown then
		return nil
	end

	if runtime.notesIndex then
		local ok, value = readUpvalue(runtime.laneDown, runtime.notesIndex)
		if ok and type(value) == "table" then
			return value
		end
		runtime.notesIndex = nil
	end

	resolveIndexes()

	if runtime.notesIndex then
		local ok, value = readUpvalue(runtime.laneDown, runtime.notesIndex)
		if ok and type(value) == "table" then
			return value
		end
	end

	return nil
end

local function getStats()
	if not runtime.laneDown or not runtime.statsIndex then
		resolveIndexes()
	end
	if not runtime.laneDown or not runtime.statsIndex then
		return nil
	end
	local ok, value = readUpvalue(runtime.laneDown, runtime.statsIndex)
	if ok and type(value) == "table" then
		return value
	end
	runtime.statsIndex = nil
	return nil
end

----- Song clock -----

local function audioOffsetSeconds()
	local playerOffset = LocalPlayer:GetAttribute("OrchestraAudioOffset") or 0
	if type(playerOffset) ~= "number" then
		playerOffset = 0
	end
	local base = Config.AudioOffset or 0
	if type(base) ~= "number" then
		base = 0
	end
	return base + playerOffset / 1000
end

local function songClock()
	local start = runtime.startTime
	if not start then
		return nil
	end
	return Workspace:GetServerTimeNow() - start - audioOffsetSeconds()
end

