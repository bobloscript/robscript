end

local function onState(payload)
	if type(payload) ~= "table" then
		return
	end

	runtime.state = payload
	runtime.phase = tostring(payload.Phase or "")
	runtime.songId = payload.SongId
	runtime.part = mySeat(payload)

	if payload.Phase == "Playing" then
		if payload.Round ~= runtime.lastRound then
			runtime.lastRound = payload.Round
			runtime.startTime = nil
			session.songs = session.songs + 1
			log(string.format("<Muted>now playing:</Muted> %s", songLabel(payload.SongId)))
		end
		if payload.StartTime then
			runtime.startTime = payload.StartTime
		end
		runtime.clockSource = runtime.startTime and "state" or "waiting"
	else
		runtime.clockSource = "idle"
	end
end

track(StateRemote.OnClientEvent:Connect(function(payload)
	local ok, err = pcall(onState, payload)
	if not ok then
		runtime.errors = runtime.errors + 1
		warn("[Robscript] state handler: " .. tostring(err))
	end
end))

----- Auto play -----

local MAX_HIT_LATENESS = 0.12

local function autoplayTick(deltaTime)
	local laneDown = runtime.laneDown
	if not laneDown then
		return
	end

	local notes = getNotes()
	if not notes or #notes == 0 then
		return
	end

	local clock = songClock()
	if not clock or clock < -5 or clock > 900 then
		return
	end

	local lead = math.min(deltaTime * 0.5, 0.03)
	if settings.naturalTiming and settings.jitterMs > 0 then
		lead = lead + (math.random() * 2 - 1) * (settings.jitterMs / 1000)
	end
	lead = lead + settings.offsetMs / 1000

	local moment = clock + lead
	local snapshot = table.clone(notes)

	for index = 1, #snapshot do
		local note = snapshot[index]
		if type(note) == "table" and not note.Judged and type(note.Time) == "number" and type(note.Lane) == "number" then
			local delta = moment - note.Time
			if delta >= 0 and delta <= MAX_HIT_LATENESS then
				local ok = pcall(laneDown, note.Lane)
				if ok then
					if note.Judged then
						runtime.hits = runtime.hits + 1
					else
						runtime.attempts = runtime.attempts + 1
					end
				else
					runtime.errors = runtime.errors + 1
				end
			end
		end
	end
end

----- Automation -----

local GRADE_RANK = { S = 6, A = 5, B = 4, C = 3, D = 2 }

local function myGrades()
	local map = {}
	local raw = LocalPlayer:GetAttribute("OrchestraBestGrades")
	if type(raw) == "string" and raw ~= "" then
		for songId, grade in string.gmatch(raw, "([%w_]+)=(%a)") do
			map[songId] = grade
		end
	end
	return map
end

local function chooseVote(options)
	if type(options) ~= "table" or #options == 0 then
		return nil
	end

	if settings.voteStrategy == "Random" then
		return options[math.random(#options)]
	end

	local grades = myGrades()
	local bestIndex = nil
	local bestRank = math.huge

	for index, songId in ipairs(options) do
		local grade = grades[songId]
		local rank = grade and (GRADE_RANK[grade] or 1) or 0

		if settings.voteStrategy == "Unplayed first" then
			if grade == nil then
				return songId
			end
		else
			if rank < bestRank then
				bestRank = rank
				bestIndex = index
			end
		end
	end

	if bestIndex then
		return options[bestIndex]
	end

	return options[1]
end

local function pickPart(state)
	if settings.preferredPart ~= "Any" then
		return settings.preferredPart
	end

	local seats = state and state.Seats
	if type(seats) ~= "table" then
		seats = {}
	end

	for _, part in ipairs(Config.PartOrder or {}) do
		if seats[part] == nil then
			return part
		end
	end

	return ""
end

local function automationTick()
	syncFromUI()

	local state = runtime.state
	if not state then
		return
	end

	local phase = tostring(state.Phase or "")
	local member = LocalPlayer:GetAttribute("OrchestraMember")
	local seat = mySeat(state)
	runtime.part = seat

	if settings.autoJoin and (phase == "Lobby" or phase == "Results") then
		if not member then
			RequestRemote:FireServer("JoinOrchestra", pickPart(state))
			log("<Muted>joining the orchestra as</Muted> " .. partLabel(pickPart(state)))
		elseif not seat then
			RequestRemote:FireServer("PickPart", pickPart(state))
			log("<Muted>picking a part:</Muted> " .. partLabel(pickPart(state)))
		end
	end

	if settings.autoVote and phase == "Lobby" and type(state.VoteOptions) == "table" and #state.VoteOptions > 0 then
		local key = table.concat(state.VoteOptions, ",")
		if key ~= runtime.lastVoteKey then
			runtime.lastVoteKey = key
			runtime.votedFor = nil
		end

		local choice = chooseVote(state.VoteOptions)
		if choice and choice ~= runtime.votedFor then
			runtime.votedFor = choice
			RequestRemote:FireServer("Vote", choice)
			log("<Muted>voted for</Muted> " .. songLabel(choice))
		end
	end

	if settings.forcedDifficulty ~= "Keep" then
		local current = LocalPlayer:GetAttribute("OrchestraDifficulty")
		if current ~= settings.forcedDifficulty and (os.clock() - runtime.lastDifficultyAt) > 10 then
			runtime.lastDifficultyAt = os.clock()
			RequestRemote:FireServer("SetMyDifficulty", settings.forcedDifficulty)
			log("<Muted>difficulty set to</Muted> " .. tostring(settings.forcedDifficulty))
		end
	end

	local stats = getStats()
	if stats then
		runtime.stats = {
			Perfect = stats.Perfect or 0,
			Good = stats.Good or 0,
			Miss = stats.Miss or 0,
			Score = stats.Score or 0,
			Combo = stats.Combo or 0,
			MaxCombo = stats.MaxCombo or 0,
		}
	end
end

----- Resolve + loops -----

resolveLaneDown()

task.spawn(function()
	if not runtime.laneDown and RUNNING then
		for _ = 1, 30 do
			if not RUNNING then
				return
			end
			task.wait(1)
			if resolveLaneDown() then
				break
			end
		end
	end
end)

track(RunService.PreRender:Connect(function(deltaTime)
	if not RUNNING or not settings.autoplay then
		return
	end
	if not runtime.laneDown then
		return
	end
	local ok, err = pcall(autoplayTick, deltaTime)
	if not ok then
		runtime.errors = runtime.errors + 1
		warn("[Robscript] autoplay: " .. tostring(err))
		if runtime.errors > 25 then
			runtime.errors = 0
			settings.autoplay = false
			local handle = Airflow.Flags and Airflow.Flags.Autoplay
			if handle and type(handle.Set) == "function" then
				pcall(function()
					handle:Set(false, true)
				end)
			end
			log("<Error>Auto Play stopped after repeated errors</Error>")
		end
	end
end))

task.spawn(function()
	while RUNNING do
		local ok, err = pcall(automationTick)
		if not ok then
			warn("[Robscript] automation: " .. tostring(err))
		end
		task.wait(0.75)
	end
end)

task.spawn(function()
	task.wait(1.5)
	pcall(function()
		RequestRemote:FireServer("Sync")
	end)
end)

