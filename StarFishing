}

local Window, Log
local UiRefs = {}

local function log(message, color)
	if Log then
		Log:Push(tostring(message), color)
	end
end

local function notify(title, content, kind)
	pcall(function()
		Window:Notify({ Title = title, Content = content, Type = kind or "Info", Duration = 4 })
	end)
end

getgenv().__StarFishingGen = (getgenv().__StarFishingGen or 0) + 1
local SCRIPT_GENERATION = getgenv().__StarFishingGen

local function scriptAlive()
	return getgenv().__StarFishingGen == SCRIPT_GENERATION
end

local loops = {}
local function startLoop(name, step)
	loops[name] = (loops[name] or 0) + 1
	local mine = loops[name]
	task.spawn(function()
		while loops[name] == mine and scriptAlive() do
			local ok, err = pcall(step)
			if not ok then
				log("<Error>" .. name .. ": " .. tostring(err) .. "</Error>")
				task.wait(1)
			end
			if loops[name] ~= mine then
				break
			end
			task.wait(0.05)
		end
	end)
end

local function stopLoop(name)
	loops[name] = (loops[name] or 0) + 1
end

