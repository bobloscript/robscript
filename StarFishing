-- Start
----------------------------------------------------------------------

task.spawn(function()
	-- Fill the filter lists once the player data is in.
	local deadline = os.clock() + 30
	while os.clock() < deadline do
		local rarities = rarityList()
		if #rarities > 0 then
			UiRefs.rarityDropdown:SetOptions(rarities, { KeepSelection = true })
			UiRefs.typeDropdown:SetOptions(typeList(), { KeepSelection = true })
			break
		end
		task.wait(1)
	end
	pcall(function()
		Window:LoadAutoload()
	end)
	log("<Success>Loaded</Success> - " .. #stars() .. " stars, " .. short(money()) .. " cash")
end)

print("[Star Fishing Hub] loaded")
