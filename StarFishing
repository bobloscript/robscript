----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function short(value)
	if type(value) ~= "number" then
		return "-"
	end
	local text = tostring(math.floor(value))
	local grouped = text:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (grouped:gsub("^%s+", ""))
end

local function character()
	local char = LocalPlayer.Character
	if char and char.Parent then
		return char
	end
	return nil
end

local function rootPosition()
	local char = character()
	if not char then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

local function goTo(position)
	local char = character()
	if not char then
		return
	end
	pcall(function()
		char:PivotTo(CFrame.new(position))
	end)
end

local function rodTool()
	local char = character()
	if not char then
		return nil
	end
	local inHand = char:FindFirstChild("Rod")
	if inHand then
		return inHand
	end
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local stored = backpack and backpack:FindFirstChild("Rod")
	if stored then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum:EquipTool(stored)
			end)
			task.wait(0.4)
			return char:FindFirstChild("Rod")
		end
	end
	return nil
end

local function rodGui()
	local gui = PlayerGui:FindFirstChild("RodGui")
	if gui and gui.Enabled then
		return gui
	end
	return nil
end

local function inventoryFull()
	local gui = PlayerGui:FindFirstChild("RodGui")
	local flag = gui and gui.Frame:FindFirstChild("InventoryFull")
	return flag ~= nil and flag.Visible == true
end

local function stars()
	local ok, list = pcall(function()
		return GetStars:InvokeServer()
	end)
	if ok and type(list) == "table" then
		return list
	end
	return {}
end

local function money()
	local ok, value = pcall(function()
		return GetMoney:InvokeServer()
	end)
	return ok and tonumber(value) or 0
end

local function starRarity(name)
	if StarModule then
		local data = StarModule.Data and StarModule.Data[name]
		if data and data.Rarity then
			return data.Rarity
		end
	end
	return "Unknown"
end

local function starValue(name)
	if StarModule and type(StarModule.getSellValue) == "function" then
		local ok, value = pcall(StarModule.getSellValue, name)
		if ok and type(value) == "number" then
			return value
		end
	end
	return 0
end

