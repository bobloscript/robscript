local sellStats = { lastValue = 0, lastCount = 0, soldTotal = 0, moneyTotal = 0 }

local function rarityList()
	local seen = {}
	for _, star in ipairs(stars()) do
		seen[starRarity(star.name)] = true
	end
	local list = {}
	for rarity in pairs(seen) do
		table.insert(list, rarity)
	end
	table.sort(list)
	return list
end

local function typeList()
	local seen = {}
	for _, star in ipairs(stars()) do
		if star.name then
			seen[star.name] = true
		end
	end
	local list = {}
	for name in pairs(seen) do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

local function allowed(star)
	if next(Settings.sellRarities) ~= nil and not Settings.sellRarities[starRarity(star.name)] then
		return false
	end
	if next(Settings.sellTypes) ~= nil and not Settings.sellTypes[star.name] then
		return false
	end
	if Settings.keepFavourites and star.isFavourite then
		return false
	end
	return true
end

--- Stars that match the filters right now.
local function matchingStars()
	local picked = {}
	for _, star in ipairs(stars()) do
		if allowed(star) then
			local value = starValue(star.name) * (tonumber(star.size) or 1)
			table.insert(picked, { star = star, value = value })
		end
	end
	return picked
end

local function totalValue(picked)
	local total = 0
	for _, entry in ipairs(picked) do
		total += entry.value
	end
	return total
end

----------------------------------------------------------------------
-- Merchant: the free way to sell stars
----------------------------------------------------------------------

local DialogueGlobal = ReplicatedStorage:WaitForChild("Dialogue", 30)
local DialogueEvents = DialogueGlobal
	and DialogueGlobal:WaitForChild("Events", 30)
	and DialogueGlobal.Events:WaitForChild("Global", 30)
local PresentOptions = DialogueEvents and DialogueEvents:WaitForChild("PresentClientDialogueOptions", 30)
local ChooseOption = DialogueEvents and DialogueEvents:WaitForChild("ClientChoosesDialogueOption", 30)

local function starMerchant()
	local npcs = workspace:FindFirstChild("NonPlayableCharacters")
	local npc = npcs and npcs:FindFirstChild("Star Merchant")
	if not npc then
		return nil, nil
	end
	local prompt
	for _, d in ipairs(npc:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			prompt = d
			break
		end
	end
	return npc, prompt
end

--- Opens the merchant and returns the dialogue options he offers.
local function merchantOptions()
	local npc, prompt = starMerchant()
	if not (npc and prompt and PresentOptions) then
		return nil
	end

	goTo(npc:GetPivot().Position + Vector3.new(0, 0, 4))
	task.wait(1)

	local captured
	local connection = PresentOptions.OnClientEvent:Connect(function(_, _, options)
		if type(options) == "table" and #options > 0 then
			captured = options
		end
	end)

	for _ = 1, 3 do
		if captured then
			break
		end
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(0.2, (prompt.HoldDuration or 0) + 0.2))
			prompt:InputHoldEnd()
		end)
		task.wait(1.4)
	end

	connection:Disconnect()
	return captured
end

--- Sells everything the merchant will take. Favourites are skipped by the game.
local function sellEverything()
	if not ChooseOption then
		log("<Error>Dialogue system not found</Error>")
		return 0
	end

	local options = merchantOptions()
	if not options then
		log("<Warning>Could not reach the Star Merchant</Warning>")
		return 0
	end

	local sellAll
	for _, option in ipairs(options) do
		if option.id == "sell-all" then
			sellAll = option
		end
	end
	if not sellAll then
		log("<Warning>The merchant has nothing to buy right now</Warning>")
		return 0
	end

	local before = money()
	ChooseOption:FireServer(sellAll)
	task.wait(3)
	local gained = math.max(0, money() - before)

	if gained > 0 then
		sellStats.soldTotal += 1
		sellStats.moneyTotal += gained
		log("<Success>Sold the catch for " .. short(gained) .. "</Success>")
	else
		log("<Warning>Nothing was sold</Warning>")
	end
	return gained
end

local saleBusy = false

--- Sells everything that matches the filters, protecting the rest with
--- favourites. Used by the Sell button and by the auto sell when the bag fills.
local function performSale()
	if saleBusy then
		return 0
	end

	local picked = matchingStars()
	if #picked == 0 then
		log("<Warning>Nothing matches the filters - the bag will stay full</Warning>")
		return 0
	end

	saleBusy = true

	-- The merchant buys the whole backpack at once, so everything that has to
	-- stay is marked as a favourite first - the game never sells favourites.
	-- Whatever we mark is un-marked again after the sale.
	local marked = {}
	local all = stars()
	if #picked < #all and Settings.keepFavourites then
		for _, entry in ipairs(all) do
			if not allowed(entry) and not entry.isFavourite then
				pcall(function()
					ClientFavouriteItem:FireServer(entry.id)
				end)
				table.insert(marked, entry.id)
				task.wait(0.03)
			end
		end
		if #marked > 0 then
			log("Protected " .. #marked .. " star(s) you wanted to keep")
			task.wait(1)
		end
	end

	local gained = sellEverything()

	for _, id in ipairs(marked) do
		pcall(function()
			ClientFavouriteItem:FireServer(id)
		end)
		task.wait(0.02)
	end

	saleBusy = false
	return gained
end

-- Lets the fishing loop sell when the backpack fills up.
autoSellHook = performSale

