-- 1. FISHING
----------------------------------------------------------------------

local GlobalEvents = Events:WaitForChild("Global", 30)
local NewFishing = GlobalEvents and GlobalEvents:WaitForChild("NewFishing", 30)
local ClientRecieveItems = GlobalEvents and GlobalEvents:WaitForChild("ClientRecieveItems", 30)

local fishStats = {
	casts = 0,
	catches = 0,
	misses = 0,
	startedAt = 0,
	lastLog = 0,
}

--- Plays the same little flourish the game shows on a perfect cast.
local function perfectFlair()
	local sounds = ReplicatedStorage:FindFirstChild("Sounds")
	local cast = sounds and sounds:FindFirstChild("PerfectCast")
	if cast then
		local ok, clone = pcall(function()
			local copy = cast:Clone()
			copy.Parent = workspace.CurrentCamera
			copy:Play()
			game:GetService("Debris"):AddItem(copy, 3)
			return copy
		end)
	end
	pcall(function()
		local dialogue = ReplicatedStorage:FindFirstChild("Dialogue")
		local ev = dialogue and dialogue:FindFirstChild("Events")
		local localEv = ev and ev:FindFirstChild("Local")
		local speech = localEv and localEv:FindFirstChild("ClientSpeech")
		if speech then
			speech:Fire("Perfect!!!", Color3.new(1, 0.7768, 0.0013))
		end
	end)
end

--- One full cast, driven through the game's own events.
--- The game decides the catch when the cast is sent, then expects us to ask for
--- each star at its own pace. Doing it this way keeps working even if the rod's
--- own animation script has given up.
local function serverCast()
	local char = character()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local rod = rodTool()
	local tip = rod and rod:FindFirstChild("Model")
	local nodes = tip and tip:FindFirstChild("Nodes")
	local rodTip = nodes and nodes:FindFirstChild("RodTip")
	local attachment = rodTip and rodTip:FindFirstChild("Attachment")

	if not (hum and root and attachment) then
		return false, 0, "Rod is not in hand"
	end

	local answer
	local connection = ClientRecieveItems.OnClientEvent:Connect(function(ok, position, castId, stars, model, timers)
		answer = { ok = ok, castId = castId, stars = stars, timers = timers }
	end)

	NewFishing.CastRod:FireServer(hum, root.CFrame.Position, root.CFrame.LookVector, attachment)

	local deadline = os.clock() + 6
	while not answer and os.clock() < deadline do
		task.wait(0.05)
	end

	if not answer then
		connection:Disconnect()
		return false, 0, "The game did not answer"
	end

	if not answer.ok or not answer.stars or #answer.stars == 0 then
		connection:Disconnect()
		return false, 0, "Nothing bit"
	end

	for index, star in ipairs(answer.stars) do
		local waitTime = tonumber((answer.timers or {})[index]) or tonumber(star.interval) or 0.2
		task.wait(math.clamp(waitTime, 0.05, 3))
		NewFishing.RequestSpawn:FireServer(star.castID, star.starID)
	end

	task.wait(0.15)
	GlobalEvents.WithdrawBobber:FireServer(hum)
	connection:Disconnect()

	return true, #answer.stars
end

--- The rod the game thinks is equipped. Needed when the rod's own script died,
--- because the server then never hears that a rod was put in hand.
local rodName = nil
task.spawn(function()
	local updates = Data:FindFirstChild("UpdateClientRodsBobbers")
	if not updates then
		return
	end
	local connection
	connection = updates.OnClientEvent:Connect(function(rods)
		for _, rod in ipairs(rods or {}) do
			if rod.isCurrentRod then
				rodName = rod.name
			end
		end
	end)
	pcall(function()
		updates:FireServer()
	end)
	task.wait(3)
	connection:Disconnect()
end)

--- Puts the game back into a clean casting state.
local function recoverRod()
	local char = character()
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	rodTool()
	if rodName then
		pcall(function()
			Data.Rods.RodEquipAbility:FireServer(true, rodName)
		end)
	end
	if hum then
		pcall(function()
			GlobalEvents.WithdrawBobber:FireServer(hum)
		end)
	end
	task.wait(0.5)
end

--- Set once the selling tab is built. Used when the backpack fills up mid-run.
local autoSellHook: (() -> number)? = nil

local function fishingStep()
	if not character() then
		return
	end

	if inventoryFull() then
		if Settings.autoSellOnFull and autoSellHook then
			local spot = rootPosition()
			log("<Accent>Backpack is full - selling the catch</Accent>")
			autoSellHook()
			if spot then
				goTo(spot)
				task.wait(0.6)
			end
			return
		end
		if not Settings.ignoreFull then
			if os.clock() - (fishStats.lastLog or 0) > 5 then
				fishStats.lastLog = os.clock()
				log("<Warning>Backpack is full - sell some stars first</Warning>")
			end
			task.wait(1)
			return
		end
	end

	local ok, count, reason = serverCast()
	if ok then
		fishStats.casts += 1
		fishStats.catches += count
		fishStats.missStreak = 0
		if Settings.perfectFlair then
			perfectFlair()
		end
		log(string.format("<Success>Cast %d: %d star(s)</Success>", fishStats.casts, count))
	else
		fishStats.misses += 1
		fishStats.missStreak = (fishStats.missStreak or 0) + 1

		-- A few misses in a row usually means the rod state is stale: put the rod
		-- away and back, and tell the game which rod is equipped again.
		if fishStats.missStreak == 3 or fishStats.missStreak == 8 then
			recoverRod()
		end

		if fishStats.missStreak == 8 then
			log("<Warning>Nothing is biting at all - if it stays like this, rejoin the server</Warning>")
		elseif os.clock() - (fishStats.lastLog or 0) > 3 then
			fishStats.lastLog = os.clock()
			log("<Muted>" .. tostring(reason) .. "</Muted>")
		end
		task.wait(0.6)
	end

	task.wait(Settings.castDelay or 0.35)
end

local function fishingSet(on)
	Settings.fishingOn = on
	if on then
		fishStats.startedAt = os.clock()
		startLoop("Fishing", fishingStep)
		log("Auto fishing on")
	else
		stopLoop("Fishing")
		log("Auto fishing off")
	end
	if UiRefs and UiRefs.fishing then
		UiRefs.fishing:Set(on, true)
	end
end
