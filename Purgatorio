local codexCache = {}

local function moduleTable(name, getter)
	if codexCache[name] ~= nil then
		return codexCache[name] or nil
	end
	local module = asset(name)
	if not module then
		codexCache[name] = false
		return nil
	end
	local ok, result = pcall(function()
		return require(module)[getter]()
	end)
	if ok and type(result) == "table" then
		codexCache[name] = result
		return result
	end
	codexCache[name] = false
	return nil
end

local function damageTable()
	return moduleTable("DamageValues", "GetTable")
end

local function itemTable()
	return moduleTable("ItemTable", "GetTable")
end

local function equipTable()
	return moduleTable("EquipsTable", "GetTable")
end

local function abilityInfo()
	if codexCache.abilityInfo ~= nil then
		return codexCache.abilityInfo or nil
	end
	local module = asset("AbilityInfo")
	if not module then
		codexCache.abilityInfo = false
		return nil
	end
	local ok, result = pcall(function()
		return require(module)
	end)
	if ok and type(result) == "table" then
		codexCache.abilityInfo = result
		return result
	end
	codexCache.abilityInfo = false
	return nil
end

local function buildWeaponRows()
	local rows = {}
	local weapons = asset("WeaponScripts")
	if not weapons then
		return rows
	end
	local damage = damageTable()
	local info = abilityInfo()
	for _, folder in ipairs(weapons:GetChildren()) do
		if folder:IsA("Folder") then
			local modules = {}
			for _, child in ipairs(folder:GetChildren()) do
				if child:IsA("ModuleScript") then
					table.insert(modules, child)
				end
			end
			table.sort(modules, function(a, b)
				return a.Name < b.Name
			end)
			for _, module in ipairs(modules) do
				local id = module:GetAttribute("Name")
				if type(id) ~= "string" then
					id = module.Name
				end
				local data = damage and damage[id]
				local meta = info and info[id]
				local damageText = "-"
				local staggerText = "-"
				if data then
					damageText = string.format("%d-%d", math.floor((data.DamageMin or 0) + 0.5), math.floor((data.DamageMax or 0) + 0.5))
					staggerText = string.format("%.1f", data.StaggerDamage or 0)
				end
				table.insert(rows, {
					folder.Name,
					id,
					(meta and meta.Type) or "—",
					damageText,
					staggerText,
				})
			end
		end
	end
	return rows
end

local function buildItemRows()
	local rows = {}
	local items = itemTable()
	if not items then
		return rows
	end
	local names = {}
	for name in pairs(items) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local entry = items[name]
		if type(entry) == "table" then
			local description = tostring(entry.Description or entry.Lore or "")
			description = description:gsub("\n", " ")
			if #description > 64 then
				description = description:sub(1, 61) .. "..."
			end
			table.insert(rows, {
				tostring(entry.Name or name),
				tostring(entry.Type or "-"),
				tostring(entry.MaxStack or 1),
				escapeRich(description),
			})
		end
	end
	return rows
end

local function buildEquipRows()
	local rows = {}
	local equips = equipTable()
	if not equips then
		return rows
	end
	local names = {}
	for name in pairs(equips) do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in ipairs(names) do
		local entry = equips[name]
		if type(entry) == "table" then
			table.insert(rows, {
				tostring(entry.Name or name),
				tostring(entry.Type or "-"),
				tostring(entry.Grade or "-"),
				tostring(entry.Defense or 0),
			})
		end
	end
	return rows
end

