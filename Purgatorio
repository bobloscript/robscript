----- Flags -----

local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local function colorToHex(color)
	local red = math.floor(math.clamp(color.R, 0, 1) * 255 + 0.5)
	local green = math.floor(math.clamp(color.G, 0, 1) * 255 + 0.5)
	local blue = math.floor(math.clamp(color.B, 0, 1) * 255 + 0.5)
	return string.format("#%02X%02X%02X", red, green, blue)
end

local function escapeRich(text)
	text = tostring(text)
	text = text:gsub("&", "&amp;")
	text = text:gsub("<", "&lt;")
	text = text:gsub(">", "&gt;")
	return text
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function hiddenParent()
	local ok, gui = pcall(function()
		return gethui()
	end)
	if ok and gui then
		return gui
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	return playerGui or game:GetService("CoreGui")
end

local function distanceOrigin()
	local character = LocalPlayer.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			return root.Position
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.new(0, 0, 0)
end

local function displayName(raw)
	local text = tostring(raw or "")
	text = text:gsub("%d+$", "")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if text == "" then
		return "Enemy"
	end
	return text:sub(1, 1):upper() .. text:sub(2)
end

