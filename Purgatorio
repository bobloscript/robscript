		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local moved = mobileState.dragging
		mobileState.dragStart = nil
		mobileState.dragging = false
		if not moved then
			pcall(toggleLock)
			paintMobileLock()
		end
	end)

	cycle.Activated:Connect(function()
		pcall(function()
			if lockState.active then
				cycleLock(1)
			else
				toggleLock()
			end
		end)
		paintMobileLock()
	end)

	mobileState.cleanup = function()
		pcall(function()
			moveConnection:Disconnect()
		end)
	end
end

