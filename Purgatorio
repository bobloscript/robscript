resetFlagCache()

local running = true
local collectAccumulator = 0
local visualAccumulator = 0
local effectsAccumulator = 0
local lastError = nil

-- pcall alone would swallow a broken render tick, so every failure is kept
-- and warned once per message; GetLastError exposes it to the caller.
local function safeCall(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		local message = tostring(err)
		lastError = message
		if stats.lastError ~= message then
			stats.lastError = message
			warn("[RobScript Purgatorio] " .. message)
		end
	end
	return ok
end

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	if deltaTime > 0 then
		stats.fps = math.floor(1 / deltaTime + 0.5)
	end
	collectAccumulator = collectAccumulator + deltaTime
	visualAccumulator = visualAccumulator + deltaTime
	effectsAccumulator = effectsAccumulator + deltaTime

	if collectAccumulator >= COLLECT_INTERVAL then
		collectAccumulator = 0
		safeCall(collectTargets)
	end

	if visualAccumulator >= VISUAL_INTERVAL then
		visualAccumulator = 0
		for _, target in pairs(targets) do
			safeCall(updateTarget, target)
		end
		updateStats()
	end

	if effectsAccumulator >= EFFECTS_INTERVAL then
		effectsAccumulator = 0
		if flag("Fullbright", false) then
			refreshFullbright()
		end
		refreshFov()
		safeCall(updateOverlay)
		safeCall(updateMobileLock)
	end
end)

local lockConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not running then
		return
	end
	if flag("LockOn", false) then
		safeCall(updateLock, deltaTime)
	elseif lockState.active then
		releaseLock()
	end
end)

local lockInput = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running or not flag("LockOn", false) then
		return
	end
	local expected = LOCK_KEYS[flag("LockKey", "Middle mouse")]
	if not expected then
		return
	end
	local matches = false
	if expected.EnumType == Enum.UserInputType then
		matches = input.UserInputType == expected
	else
		matches = input.KeyCode == expected
	end
	if matches then
		safeCall(toggleLock)
	end
end)

local lockWheel = UserInputService.InputChanged:Connect(function(input, processed)
	if processed or not running or not lockState.active then
		return
	end
	if not flag("LockSwitch", true) then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel and input.Position.Z ~= 0 then
		safeCall(cycleLock, input.Position.Z > 0 and 1 or -1)
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("EnemyESP", false)
			setFlag("NPCESP", false)
			setFlag("AllyESP", false)
			setFlag("GatheringESP", false)
			setFlag("LockOn", false)
			releaseLock()
			clearAllTargets()
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	pcall(function()
		lockConnection:Disconnect()
	end)
	pcall(function()
		lockInput:Disconnect()
	end)
	pcall(function()
		lockWheel:Disconnect()
	end)
	pcall(releaseLock)
	pcall(destroyMobileLock)
	clearAllTargets()
	destroyOverlay()
	pcall(function()
		setFullbright(false)
	end)
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptPurgatorio then
		getgenv().RobScriptPurgatorio = nil
	end
end

----- Public interface -----

getgenv().RobScriptPurgatorio = {
	Version = "1.1",
	Actions = {
		Refresh = collectTargets,
		Clear = clearAllTargets,
		RefreshCodex = refreshCodex,
		Destroy = destroy,
	},
	GetStats = function()
		return {
			enemies = stats.enemies,
			npcs = stats.npcs,
			allies = stats.allies,
			gathering = stats.gathering,
			targets = (function()
				local count = 0
				for _ in pairs(targets) do
					count = count + 1
				end
				return count
			end)(),
		}
	end,
	GetLock = function()
		local target = lockState.target
		return {
			active = lockState.active,
			target = target and ((target.info and target.info.display) or "enemy") or nil,
			distance = (function()
				local position = target and targetPosition(target)
				local root = localRoot()
				if not position or not root then
					return nil
				end
				return math.floor((position - root.Position).Magnitude + 0.5)
			end)(),
		}
	end,
	ToggleLock = function()
		return toggleLock()
	end,
	CycleLock = function(direction)
		if not lockState.active then
			return false
		end
		cycleLock(direction)
		return true
	end,
	ToggleUI = function()
		pcall(function()
			Window:Toggle()
		end)
	end,
	ReleaseLock = function()
		releaseLock()
	end,
	ShowMobileLock = function(force)
		mobileState.force = force == true
		updateMobileLock()
		return mobileState.gui ~= nil and mobileState.gui.Enabled
	end,
	GetLastError = function()
		return lastError
	end,
	GetCodexCount = function()
		local source = flag("CodexSource", "Weapons")
		local entry = CODEX[source]
		if not entry then
			return 0
		end
		local ok, rows = pcall(entry.build)
		if ok and type(rows) == "table" then
			return #rows
		end
		return 0
	end,
	SaveConfig = function(name)
		return (pcall(function()
			Window:SaveConfig(name)
		end))
	end,
	LoadConfig = function(name)
		return (pcall(function()
			Window:LoadConfig(name)
		end))
	end,
	ListConfigs = function()
		local ok, list = pcall(function()
			return Window:ListConfigs()
		end)
		if ok and type(list) == "table" then
			return list
		end
		return {}
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	GetCodexSources = function()
		local list = {}
		for key in pairs(CODEX) do
			table.insert(list, key)
		end
		table.sort(list)
		return list
	end,
	SetCodex = function(source)
		if not CODEX[source] then
			return false
		end
		pcall(function()
			setFlag("CodexSource", source)
		end)
		pcall(refreshCodex)
		return true
	end,
	SelectTab = function(name)
		local map = { Visuals = VisualsTab, World = WorldTab, Combat = CombatTab, Info = InfoTab, Codex = CodexTab, Settings = SettingsTab }
		local tab = map[name]
		if not tab then
			return false
		end
		return (pcall(function()
			Window:SelectTab(tab)
		end))
	end,
	Destroy = destroy,
}

----- Boot -----

pcall(function()
	Window:LoadAutoload()
end)

task.spawn(function()
	pcall(collectTargets)
	pcall(refreshCodex)
end)

Window:Notify({ Title = "Robscript Team", Content = "PURGATORIO v1 is ready", Type = "Success" })

return getgenv().RobScriptPurgatorio
