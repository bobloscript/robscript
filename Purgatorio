local function releaseVisuals(target)
	if target.billboard then
		pcall(function()
			target.billboard:Destroy()
		end)
		target.billboard = nil
	end
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	if target.lines then
		for _, line in ipairs(target.lines) do
			if line then
				pcall(function()
					line:Remove()
				end)
			end
		end
		target.lines = nil
	end
	if target.tracer then
		pcall(function()
			target.tracer:Remove()
		end)
		target.tracer = nil
	end
	target.hasVisual = false
end

local function resolveParts(target)
	local model = target.model
	if not model or not model.Parent then
		return false
	end
	if target.kind == "gathering" then
		target.part = model
		target.focusPart = model
		target.root = model
		target.humanoid = nil
		return true
	end
	target.root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	target.hurtbox = model:FindFirstChild("Hurtbox")
	target.focusPart = model:FindFirstChild("Head") or target.hurtbox or target.root
	target.humanoid = model:FindFirstChildOfClass("Humanoid")
	return target.root ~= nil and target.focusPart ~= nil
end

local function createTarget(kind, model)
	local target = {
		kind = kind,
		model = model,
		hasVisual = false,
	}
	if not resolveParts(target) then
		return nil
	end
	return target
end

local function dropTarget(model)
	local target = targets[model]
	if not target then
		return
	end
	releaseVisuals(target)
	targets[model] = nil
end

local function clearAllTargets()
	for model in pairs(targets) do
		dropTarget(model)
	end
	stats.enemies = 0
	stats.npcs = 0
	stats.allies = 0
	stats.gathering = 0
end

----- Collection -----

local function ensureTarget(kind, model)
	local target = targets[model]
	if target then
		if target.kind ~= kind then
			releaseVisuals(target)
			targets[model] = nil
			target = nil
		else
			return target
		end
	end
	target = createTarget(kind, model)
	if target then
		targets[model] = target
	end
	return target
end

local function collectEnemyModels()
	local models = {}
	local seen = {}
	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") then
			models[#models + 1] = model
			seen[model] = true
		end
	end
	-- Enemies normally sit in Workspace, but a spawn folder would still be indexed
	-- by name in Workspace.EnemyList, so fall back to the name lookup.
	local list = workspace:FindFirstChild("EnemyList")
	if list then
		for _, entry in ipairs(list:GetChildren()) do
			if not workspace:FindFirstChild(entry.Name) then
				local model = workspace:FindFirstChild(entry.Name, true)
				if model and model:IsA("Model") and not seen[model] then
					models[#models + 1] = model
					seen[model] = true
				end
			end
		end
	end
	return models
end

local function collectNpcModels()
	local models = {}
	local seen = {}
	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") then
			models[#models + 1] = model
			seen[model] = true
		end
	end
	-- Citizens live inside Workspace.Citizens, not at the root.
	local citizens = workspace:FindFirstChild("Citizens")
	if citizens then
		for _, model in ipairs(citizens:GetChildren()) do
			if model:IsA("Model") and not seen[model] then
				models[#models + 1] = model
				seen[model] = true
			end
		end
	end
	local office = workspace:FindFirstChild("Office")
	if office then
		local npcs = office:FindFirstChild("NPCS")
		if npcs then
			for _, descendant in ipairs(npcs:GetDescendants()) do
				if descendant:IsA("Model") and descendant:FindFirstChildOfClass("Humanoid") and not seen[descendant] then
					models[#models + 1] = descendant
					seen[descendant] = true
				end
			end
		end
	end
	return models
end

local function collectTargets()
	local seen = {}

	local combatEnabled = flag("LockOn", false)
	if flag("EnemyESP", true) or combatEnabled then
		for _, model in ipairs(collectEnemyModels()) do
			local info, humanoid = enemyInfo(model)
			if info then
				local target = ensureTarget("enemy", model)
				if target then
					target.info = info
					target.humanoid = humanoid
					seen[model] = true
				end
			end
		end
	end

	if flag("NPCESP", false) then
		for _, model in ipairs(collectNpcModels()) do
			local info = npcInfo(model)
			if info then
				local target = ensureTarget("npc", model)
				if target then
					target.info = info
					seen[model] = true
				end
			end
		end
	end

	if flag("AllyESP", false) then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local character = player.Character
				if character and character.Parent then
					local target = ensureTarget("ally", character)
					if target then
						target.player = player
						seen[character] = true
					end
				end
			end
		end
	end

	if flag("GatheringESP", false) then
		for _, part in ipairs(gatheringParts()) do
			local target = ensureTarget("gathering", part)
			if target then
				seen[part] = true
			end
		end
	end

	for model, target in pairs(targets) do
		if not seen[model] or not target.model or not target.model.Parent then
			dropTarget(model)
		end
	end
end

----- Rendering -----

local function healthColor(ratio)
	if ratio > 0.6 then
		return Color3.fromRGB(120, 255, 150)
	end
	if ratio > 0.3 then
		return Color3.fromRGB(255, 210, 90)
	end
	return Color3.fromRGB(255, 90, 110)
end

local function projectBox(center, size)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local half = size * 0.5
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local depthHits = 0
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				local world = center + Vector3.new(half.X * x, half.Y * y, half.Z * z)
				local screen = camera:WorldToViewportPoint(world)
				if screen.Z > 0 then
					depthHits = depthHits + 1
					minX = math.min(minX, screen.X)
					minY = math.min(minY, screen.Y)
					maxX = math.max(maxX, screen.X)
					maxY = math.max(maxY, screen.Y)
				end
			end
		end
	end
	if depthHits < 2 then
		return nil
	end
	return minX, minY, maxX, maxY
end

local function hideLines(target)
	if target.lines then
		for _, line in ipairs(target.lines) do
			if line and line.Visible then
				line.Visible = false
			end
		end
	end
	if target.tracer and target.tracer.Visible then
		target.tracer.Visible = false
	end
end

local function updateBox(target, color, visible, center, size)
	local enabled = visible and flag("EnemyBox", false)
	if not enabled or not center or not size then
		hideLines(target)
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end

	local minX, minY, maxX, maxY = projectBox(center, size)
	if not minX then
		hideLines(target)
		return
	end

	if not target.lines then
		target.lines = { newLine(), newLine(), newLine(), newLine() }
	end
	local lines = target.lines
	if not lines[1] then
		return
	end

	local topLeft = Vector2.new(minX, minY)
	local topRight = Vector2.new(maxX, minY)
	local bottomLeft = Vector2.new(minX, maxY)
	local bottomRight = Vector2.new(maxX, maxY)
	local segments = {
		{ topLeft, topRight },
		{ topRight, bottomRight },
		{ bottomRight, bottomLeft },
		{ bottomLeft, topLeft },
	}
	for index = 1, 4 do
		local line = lines[index]
		local segment = segments[index]
		if line and segment then
			line.From = segment[1]
			line.To = segment[2]
			line.Color = color
			line.Thickness = 1
			line.Visible = true
		end
	end
end

local function updateTracer(target, color, visible)
	local enabled = visible and flag("EnemyTracer", false) and target.kind == "enemy"
	if not enabled then
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or not target.focusPart then
		return
	end
	local viewport = camera.ViewportSize
	local screen = camera:WorldToViewportPoint(target.focusPart.Position)
	if screen.Z <= 0 then
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end
	if not target.tracer then
		target.tracer = newLine()
	end
	if not target.tracer then
		return
	end
	target.tracer.From = Vector2.new(viewport.X * 0.5, viewport.Y)
	target.tracer.To = Vector2.new(screen.X, screen.Y)
	target.tracer.Color = color
	target.tracer.Thickness = 1
	target.tracer.Visible = true
end

local function updateEnemy(target, distance, visible)
	local info = target.info or {}
	local humanoid = target.humanoid
	local maxHealth = humanoid and humanoid.MaxHealth or 0
	local health = humanoid and humanoid.Health or 0
	local ratio = 0
	if maxHealth > 0 then
		ratio = math.clamp(health / maxHealth, 0, 1)
	end

	local elite = info.grade ~= nil and info.grade <= ELITE_GRADE
	local color = elite and flag("EliteColor", COLOR_ELITE) or flag("EnemyColor", COLOR_ENEMY)

	local firstLine = ""
	if flag("EnemyName", true) then
		firstLine = escapeRich(info.display or target.model.Name)
	end
	if flag("EnemyGrade", true) and info.grade ~= nil then
		if firstLine ~= "" then
			firstLine = firstLine .. "  "
		end
		firstLine = firstLine .. "G" .. tostring(info.grade)
	end

	local secondLine = {}
	if flag("EnemyHealth", true) then
		table.insert(secondLine, string.format("%d/%d", math.floor(health + 0.5), math.floor(maxHealth + 0.5)))
	end
	if flag("EnemyLevel", true) and info.level ~= nil then
		table.insert(secondLine, "Lv" .. tostring(info.level))
	end
	if flag("EnemyFaction", false) and info.faction then
		table.insert(secondLine, escapeRich(info.faction))
	end
	if flag("EnemyDistance", true) then
		table.insert(secondLine, formatDistance(distance))
	end

	local showBillboard = visible and (firstLine ~= "" or #secondLine > 0)
	if showBillboard then
		if not target.billboard then
			target.billboard, target.label, target.barBack, target.barFill = buildBillboard(target.focusPart, 3.2, 220)
		end
		if target.billboard then
			target.billboard.Enabled = true
			if target.label then
				target.label.TextColor3 = color
				local text = firstLine
				if #secondLine > 0 then
					if text ~= "" then
						text = text .. "\n"
					end
					text = text .. table.concat(secondLine, " · ")
				end
				target.label.Text = text
			end
			if target.barBack and target.barFill then
				local showBar = flag("EnemyHealth", true) and maxHealth > 0
				target.barBack.Visible = showBar
				if showBar then
					target.barFill.Size = UDim2.fromScale(ratio, 1)
					target.barFill.BackgroundColor3 = healthColor(ratio)
				end
			end
		end
	elseif target.billboard then
		target.billboard.Enabled = false
	end

	local chams = visible and flag("EnemyChams", true)
	if chams then
		if not target.highlight then
			target.highlight = buildHighlight(target.model)
		end
		if target.highlight then
			target.highlight.FillColor = color
			target.highlight.OutlineColor = color
		end
	elseif target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end

	local boxCenter, boxSize
	if flag("EnemyHitbox", false) and target.hurtbox then
		boxCenter = target.hurtbox.Position
		boxSize = target.hurtbox.Size
	else
		local ok, center, size = pcall(function()
			return target.model:GetBoundingBox()
		end)
		if ok and center then
			boxCenter = center.Position
			boxSize = size
		end
	end
	updateBox(target, color, visible, boxCenter, boxSize)
	updateTracer(target, color, visible)
end

local function updateSimple(target, distance, visible, color, valueText, nameFlag)
	local display = target.info and target.info.display or nil
	if target.kind == "ally" then
		if target.player then
			display = target.player.DisplayName
			if display == "" then
				display = target.player.Name
			end
		else
			display = target.model.Name
		end
	elseif target.kind == "gathering" then
		display = "Gathering spot"
	elseif not display then
		display = displayName(target.model.Name)
	end

	local text = ""
	if flag(nameFlag, true) then
		text = escapeRich(display)
	end
	if valueText ~= nil and valueText ~= "" then
		if text ~= "" then
			text = text .. "\n"
		end
		text = text .. valueText
	end

	local show = visible and text ~= ""
	if show then
		if not target.billboard then
			target.billboard, target.label = buildBillboard(target.focusPart, 3.2, 200)
		end
		if target.billboard and target.label then
			target.billboard.Enabled = true
			target.label.TextColor3 = color
			target.label.Text = text
		end
	elseif target.billboard then
		target.billboard.Enabled = false
	end

	local chamsFlag = "AllyChams"
	if target.kind == "npc" then
		chamsFlag = "NPCChams"
	elseif target.kind == "gathering" then
		chamsFlag = "GatheringChams"
	end
	if visible and flag(chamsFlag, true) then
		if not target.highlight then
			target.highlight = buildHighlight(target.model)
		end
		if target.highlight then
			target.highlight.FillColor = color
			target.highlight.OutlineColor = color
		end
	elseif target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
end

local function updateTarget(target)
	if not target.model or not target.model.Parent then
		releaseVisuals(target)
		return
	end
	if not target.focusPart or not target.focusPart.Parent then
		if not resolveParts(target) then
			releaseVisuals(target)
			return
		end
	end

	local origin = distanceOrigin()
	local distance = (target.focusPart.Position - origin).Magnitude
	local renderDistance = flag("RenderDistance", 2500)
	local visible = distance <= renderDistance

	if target.kind == "enemy" then
		if not flag("EnemyESP", true) then
			visible = false
		end
		updateEnemy(target, distance, visible)
	elseif target.kind == "npc" then
		if not flag("NPCESP", false) then
			visible = false
		end
		updateSimple(target, distance, visible, flag("NpcColor", COLOR_NPC), formatDistance(distance), "NPCName")
	elseif target.kind == "ally" then
		if not flag("AllyESP", false) then
			visible = false
		end
		local character = target.model
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local hud = ""
		if humanoid then
			hud = string.format("%d/%d", math.floor(humanoid.Health + 0.5), math.floor(humanoid.MaxHealth + 0.5))
		end
		updateSimple(target, distance, visible, flag("AllyColor", COLOR_ALLY), hud .. " · " .. formatDistance(distance), "AllyName")
	elseif target.kind == "gathering" then
		if not flag("GatheringESP", false) then
			visible = false
		end
		updateSimple(target, distance, visible, flag("GatheringColor", COLOR_GATHERING), formatDistance(distance), "GatheringName")
	end
	target.hasVisual = visible
end

local function updateStats()
	local counts = { enemies = 0, npcs = 0, allies = 0, gathering = 0 }
	local byKind = { enemy = "enemies", npc = "npcs", ally = "allies", gathering = "gathering" }
	for _, target in pairs(targets) do
		local key = byKind[target.kind]
		if target.hasVisual and key then
			counts[key] = counts[key] + 1
		end
	end
	stats.enemies = counts.enemies
	stats.npcs = counts.npcs
	stats.allies = counts.allies
	stats.gathering = counts.gathering
end

