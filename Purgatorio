local function releaseLock()
	lockState.active = false
	lockState.target = nil
	destroyLockIndicator()
	local root = localRoot()
	if root then
		local orient = root:FindFirstChild("AimAssistOrientation")
		if orient then
			pcall(function()
				orient.Enabled = false
			end)
		end
	end
end

local function engageLock()
	lockState.target = nil
	local list = lockCandidates()
	if #list == 0 then
		releaseLock()
		return false
	end
	lockState.target = list[1].target
	lockState.active = true
	return true
end

local function toggleLock()
	if lockState.active then
		releaseLock()
		return false
	end
	return engageLock()
end

local function cycleLock(direction)
	local list = lockCandidates()
	if #list == 0 then
		releaseLock()
		return
	end
	local index = nil
	for i, entry in ipairs(list) do
		if entry.target == lockState.target then
			index = i
			break
		end
	end
	if not index then
		lockState.target = list[1].target
		lockState.active = true
		return
	end
	index = index + (direction or 1)
	if index > #list then
		index = 1
	end
	if index < 1 then
		index = #list
	end
	lockState.target = list[index].target
	lockState.active = true
end

local function updateLock(deltaTime)
	if not lockState.active then
		return
	end
	local target = lockState.target
	if not lockTargetAlive(target) then
		releaseLock()
		return
	end
	local position = targetPosition(target)
	local camera = workspace.CurrentCamera
	local root = localRoot()
	if not position or not camera or not root then
		releaseLock()
		return
	end
	local distance = (position - camera.CFrame.Position).Magnitude
	if distance > lockRange() * 1.4 then
		releaseLock()
		return
	end

	if flag("LockTurnCharacter", true) then
		local orient = root:FindFirstChild("AimAssistOrientation")
		if orient then
			pcall(function()
				orient.Responsiveness = tonumber(flag("LockTurnSpeed", 60)) or 60
				orient.CFrame = CFrame.lookAt(root.Position, Vector3.new(position.X, root.Position.Y, position.Z))
				orient.Enabled = true
			end)
		end
	end

	if flag("LockCamera", true) then
		local desired = CFrame.lookAt(camera.CFrame.Position, position)
		local speed = tonumber(flag("LockCameraSpeed", 14)) or 14
		local alpha = 1 - math.exp(-(deltaTime or 0.016) * speed)
		camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	end

	if flag("LockIndicator", true) then
		local indicator = lockState.indicator
		if not indicator or indicator.Adornee ~= target.focusPart or not indicator.Parent then
			destroyLockIndicator()
			lockState.indicator = buildLockIndicator(target.focusPart)
		end
	else
		destroyLockIndicator()
	end
end

