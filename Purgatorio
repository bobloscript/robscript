local function enemyInfo(model)
	if not model:IsA("Model") then
		return nil
	end
	if model == LocalPlayer.Character or isPlayerCharacter(model) then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local enemyName = model:GetAttribute("EnemyName")
	local team = teamOf(model)
	if not enemyName and team ~= "Enemy" then
		return nil
	end
	local grade = model:GetAttribute("Grade")
	local info = {
		display = displayName(enemyName or model.Name),
		grade = type(grade) == "number" and grade or nil,
		level = model:GetAttribute("Level"),
		faction = model:GetAttribute("Faction"),
		xp = model:GetAttribute("XP"),
		health = humanoid.Health,
		maxHealth = humanoid.MaxHealth,
	}
	return info, humanoid
end

local function npcInfo(model)
	if not model:IsA("Model") then
		return nil
	end
	if model == LocalPlayer.Character or isPlayerCharacter(model) then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	local dialogueType = model:GetAttribute("DialogueType")
	local inCitizens = model.Parent ~= nil and model.Parent.Name == "Citizens"
	if not dialogueType and not inCitizens then
		return nil
	end
	return {
		display = dialogueType and displayName(dialogueType) or displayName(model.Name),
		health = humanoid.Health,
		maxHealth = humanoid.MaxHealth,
	}, humanoid
end

local function gatheringParts()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return {}
	end
	local folder = map:FindFirstChild("GeneratedGatheringSpots")
	if not folder then
		return {}
	end
	local parts = {}
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			table.insert(parts, child)
		elseif child:IsA("Model") then
			local part = child.PrimaryPart
			if not part then
				for _, descendant in ipairs(child:GetDescendants()) do
					if descendant:IsA("BasePart") then
						part = descendant
						break
					end
				end
			end
			if part then
				table.insert(parts, part)
			end
		end
	end
	return parts
end

