-- Souls-like target lock: the enemy nearest to the crosshair is held until the
-- player releases it, kills it, or walks out of range.
local lockState = { target = nil, active = false, indicator = nil }

local LOCK_KEYS = {
	["Middle mouse"] = Enum.UserInputType.MouseButton3,
	["Q"] = Enum.KeyCode.Q,
	["Tab"] = Enum.KeyCode.Tab,
	["F"] = Enum.KeyCode.F,
	["G"] = Enum.KeyCode.G,
}

local function lockRange()
	return tonumber(flag("LockRange", 150)) or 150
end

local function localRoot()
	local character = LocalPlayer.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function targetPosition(target)
	if not target or not target.focusPart or not target.focusPart.Parent then
		return nil
	end
	return target.focusPart.Position
end

local function lockTargetAlive(target)
	if not target or not target.model or not target.model.Parent then
		return false
	end
	if target.humanoid and target.humanoid.Health <= 0 then
		return false
	end
	return targetPosition(target) ~= nil
end

local function aimedAngle(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local offset = position - camera.CFrame.Position
	if offset.Magnitude < 0.5 then
		return nil
	end
	return math.deg(math.acos(math.clamp(camera.CFrame.LookVector:Dot(offset.Unit), -1, 1)))
end

local function lockCandidates()
	local camera = workspace.CurrentCamera
	if not camera then
		return {}
	end
	local origin = camera.CFrame.Position
	local maxDistance = lockRange()
	local list = {}
	for _, target in pairs(targets) do
		if target.kind == "enemy" and lockTargetAlive(target) then
			local position = targetPosition(target)
			local distance = (position - origin).Magnitude
			if distance <= maxDistance then
				local angle = aimedAngle(position)
				if angle then
					table.insert(list, { target = target, angle = angle, distance = distance })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.angle < b.angle
	end)
	return list
end

local function destroyLockIndicator()
	if lockState.indicator then
		pcall(function()
			lockState.indicator:Destroy()
		end)
		lockState.indicator = nil
