	table.insert(lines, string.format("Progress %d%%  ·  Package %d%%", math.floor(progress + 0.5), math.floor(packageIntegrity + 0.5)))

	local sanity = characterValue("Sanity")
	local shield = characterValue("Shield")
	local stagger = characterValue("Stagger")
	local maxStagger = characterValue("MaxStagger")
	local statsLine = {}
	if sanity ~= nil then
		table.insert(statsLine, string.format("Sanity %d", math.floor((tonumber(sanity) or 0) + 0.5)))
	end
	if shield ~= nil then
		table.insert(statsLine, string.format("Shield %d", math.floor((tonumber(shield) or 0) + 0.5)))
	end
	if stagger ~= nil and maxStagger ~= nil then
		table.insert(statsLine, string.format("Stagger %d/%d", math.floor((tonumber(stagger) or 0) + 0.5), math.floor((tonumber(maxStagger) or 0) + 0.5)))
	end
	table.insert(lines, table.concat(statsLine, "  ·  "))
	table.insert(lines, string.format("Enemies %d  ·  FPS %d", stats.enemies, stats.fps))

	overlay.label.Text = table.concat(lines, "\n")
end

