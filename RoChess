local function getBoard()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local chess = gui:FindFirstChild("ChessUI")
    if not chess then return nil end
    local root = chess:FindFirstChild("Root")
    if not root then return nil end
    local board = root:FindFirstChild("Board")
    if not board then return nil end
    return board
end

local Config = { AutoPlay = false, Depth = 3, NodeCap = 150000, MoveDelay = 1.5 }
local Bot = { orientation = "w", ourSide = "w", state = nil, lastGrid = nil, pending = nil,
    lastAttempt = 0, running = true, lastInfo = "idle", lastMove = "-", lastPly = -1, awaitingPly = nil }

-- S-frames: S1 = visually BOTTOM-left. Engine row 0 = rank 8.
local function squareToIndex(n)
    local vn = math.floor((n - 1) / 8)
    local col = (n - 1) % 8
    if Bot.orientation == "w" then
        return (7 - vn) * 8 + col
    end
    return vn * 8 + (7 - col)
end

local function indexToSquareFrame(board, idx)
    local erow, f = math.floor(idx / 8), idx % 8
    local n
    if Bot.orientation == "w" then
        n = (7 - erow) * 8 + f + 1
    else
        n = erow * 8 + (7 - f) + 1
    end
    return board.Squares:FindFirstChild("S" .. n)
end

local function readGrid(board)
    local centers = {}
    local sqSize = 100
    for i = 1, 64 do
        local fr = board.Squares:FindFirstChild("S" .. i)
        if not fr then return nil end
        local ap, as = fr.AbsolutePosition, fr.AbsoluteSize
        centers[i] = Vector2.new(ap.X + as.X / 2, ap.Y + as.Y / 2)
        sqSize = math.max(sqSize, as.X)
    end
    local sgrid = {}
    for i = 0, 63 do sgrid[i] = "" end
    local pieces = board:FindFirstChild("Pieces")
    if not pieces then return nil end
    for _, p in ipairs(pieces:GetChildren()) do
        if p:IsA("ImageLabel") and p.Visible then
            local piece = PIECE_BY_IMG[p.Image]
            if piece then
                local ap, as = p.AbsolutePosition, p.AbsoluteSize
                local c = Vector2.new(ap.X + as.X / 2, ap.Y + as.Y / 2)
                local bestN, bestD = 0, math.huge
                for n = 1, 64 do
                    local d = (centers[n] - c).Magnitude
                    if d < bestD then bestD, bestN = d, n end
                end
                if bestN > 0 and bestD < sqSize * 0.75 then
                    sgrid[bestN - 1] = piece
                end
            end
        end
    end
    -- orientation: white king in the visual bottom half => white at bottom
    for i = 0, 63 do
        if sgrid[i] == "K" then
            Bot.orientation = math.floor(i / 8) <= 3 and "w" or "b"
            break
        end
    end
    local grid = {}
    for n = 1, 64 do grid[squareToIndex(n)] = sgrid[n - 1] end
    return grid
end

local function inferCastling(grid)
    local c = ""
    if grid[60] == "K" then
        if grid[63] == "R" then c = c .. "K" end
        if grid[56] == "R" then c = c .. "Q" end
    end
    if grid[4] == "k" then
        if grid[7] == "r" then c = c .. "k" end
        if grid[0] == "r" then c = c .. "q" end
    end
    return c
end

local function resync(board, sideGuess)
    local grid = readGrid(board)
    if not grid then return false end
    Bot.ourSide = Bot.orientation
    local count = 0
    for i = 0, 63 do if grid[i] ~= "" then count = count + 1 end end
    if count < 2 then Bot.state = nil Bot.lastGrid = nil return false end
    local st = Engine.NewState()
    st.b = grid
    st.castling = inferCastling(grid)
    st.side = sideGuess or "w"
    Bot.state = st
    Bot.lastGrid = grid
    Bot.lastInfo = "synced (" .. count .. " pieces, we play " .. Bot.ourSide .. ")"
    return true
end

local function applyMove(st, m)
    local legal = Engine.LegalMoves(st)
    for _, lm in ipairs(legal) do
        if lm.from == m.from and lm.to == m.to and (m.promo == "" or lm.promo:upper() == m.promo:upper()) then
            Engine.Make(st, lm)
            return lm
        end
    end
    return nil
end

-- Build engine state from the game's move list (live sessions, ground truth).
local START_BACK = "RNBQKBNR"

local function newGameState()
    local st = Engine.NewState()
    for i = 0, 63 do st.b[i] = "" end
    for f = 0, 7 do
        st.b[f] = START_BACK:sub(f + 1, f + 1):lower()
        st.b[8 + f] = "p"
        st.b[48 + f] = "P"
        st.b[56 + f] = START_BACK:sub(f + 1, f + 1)
    end
    return st
end

local function uciSquare(u, pos)
    local f = string.byte(u, pos) - 97
    local r = tonumber(u:sub(pos + 1, pos + 1))
    if not f or not r or f < 0 or f > 7 or r < 1 or r > 8 then return nil end
    return (8 - r) * 8 + f
end

local function stateFromUcis(ucis)
    local st = newGameState()
    for _, u in ipairs(ucis) do
        if type(u) ~= "string" or #u < 4 then return nil end
        local from, to = uciSquare(u, 1), uciSquare(u, 3)
        if not from or not to then return nil end
        local mv = { from = from, to = to, promo = #u >= 5 and u:sub(5, 5) or "" }
        if not applyMove(st, mv) then return nil end
    end
    return st
end

local function diffToMove(oldG, newG)
    local froms, tos = {}, {}
    for i = 0, 63 do
        local o, nw = oldG[i], newG[i]
        if o ~= nw then
            if o ~= "" and nw == "" then table.insert(froms, i)
            elseif nw ~= "" then table.insert(tos, i) end
        end
    end
    if #froms == 0 or #tos == 0 then return nil end
    if #froms == 2 and #tos == 2 then
        for _, fr in ipairs(froms) do
            local p = oldG[fr]
            if p == "K" or p == "k" then
                for _, t in ipairs(tos) do
                    if math.abs(fileOf(t) - fileOf(fr)) == 2 then
                        return { from = fr, to = t, flags = "castle" }
                    end
                end
            end
        end
        return nil
    end
    if #froms == 1 and #tos == 1 then
        local from, to = froms[1], tos[1]
        local p = oldG[from]
        local m = { from = from, to = to, flags = "" }
        if p == "P" or p == "p" then
            local moved = newG[to]
            if moved:upper() ~= "P" then
                m.promo = moved
                m.flags = "promo"
            elseif fileOf(from) ~= fileOf(to) and oldG[to] == "" then
                m.flags = "ep"
            end
        end
        return m
    end
    return nil
end

local function squareName(idx)
    return string.char(97 + fileOf(idx)) .. tostring(8 - rankOf(idx))
end

local function clickSquare(board, idx)
    local fr = indexToSquareFrame(board, idx)
    if not fr then return false end
    local ap, as = fr.AbsolutePosition, fr.AbsoluteSize
    local x, y = ap.X + as.X / 2, ap.Y + as.Y / 2
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.08)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    return true
end

local PROMO_TYPE_ID = { Q = 5, R = 4, B = 3, N = 2 }

-- engine move (0-63, row0=rank8) -> game coords (1-64, 1=a1)
local function toGameSquare(idx)
    return mirrorW(idx) + 1
end

local function performMove(board, m)
    local done = false
    local s = App and App.session
    if s and (s.kind == "online" or s.kind == "bot") and not s.over then
        local promoId = m.promo ~= "" and PROMO_TYPE_ID[m.promo:upper()] or nil
        local ok, res = pcall(App.onBoardMove, toGameSquare(m.from), toGameSquare(m.to), promoId)
        if not ok then
            print("[RoblyChess] onBoardMove error:", res)
        else
            done = res ~= false
        end
    end
    if not done then
        clickSquare(board, m.from)
        task.wait(0.25)
        clickSquare(board, m.to)
    end
    Bot.pending = { from = m.from, to = m.to, time = os.clock() }
    Bot.lastMove = squareName(m.from) .. squareName(m.to) .. (m.promo ~= "" and "=" .. m.promo:upper() or "")
end

local function thinkAndPlay(board)
    if not Bot.state then return end
    if Bot.state.side ~= Bot.ourSide then return end
    if os.clock() - Bot.lastAttempt < Config.MoveDelay then return end
    Bot.lastAttempt = os.clock()
    Bot.lastInfo = "thinking (depth " .. Config.Depth .. ")..."
    local best, score = Engine.BestMove(Bot.state, Config.Depth, Config.NodeCap)
    if not best then Bot.lastInfo = "no legal moves" return end
    Bot.lastInfo = string.format("played %s%s (eval %+d)", squareName(best.from), squareName(best.to), score or 0)
    performMove(board, best)
end

local function liveSession()
    local s = App and App.session
    if s and (s.kind == "online" or s.kind == "bot") then return s end
    return nil
end

local function tickLive(s, board)
    if s.over then
        Bot.lastInfo = "game over"
        Bot.awaitingPly = nil
        return
    end
    local ucis = s.ucis or {}
    if Bot.awaitingPly then
        if #ucis >= Bot.awaitingPly then
            Bot.awaitingPly = nil
        elseif os.clock() - (Bot.awaitingSince or 0) > 6 then
            Bot.awaitingPly = nil
            Bot.lastPly = -2
            Bot.lastInfo = "move confirm timeout - resyncing"
        else
            return -- waiting for server to confirm our move
        end
    end
    if #ucis ~= Bot.lastPly or not Bot.state then
        Bot.lastPly = #ucis
        local st = stateFromUcis(ucis)
        if st then
            Bot.state = st
            Bot.lastGrid = nil
            Bot.pending = nil
            Bot.lastInfo = "live sync (ply " .. #ucis .. ", to move " .. st.side .. ")"
        else
            Bot.state = nil
            Bot.lastInfo = "uci parse failed (ply " .. #ucis .. ")"
        end
    end
    if not Bot.state then return end
    local ok, myTurn = pcall(function() return s:isMyTurn() end)
    if not ok or not myTurn then return end
    Bot.ourSide = Bot.state.side
    if not Config.AutoPlay then return end
    if os.clock() - Bot.lastAttempt < Config.MoveDelay then return end
    Bot.lastAttempt = os.clock()
    Bot.lastInfo = "thinking (depth " .. Config.Depth .. ")..."
    local best, score = Engine.BestMove(Bot.state, Config.Depth, Config.NodeCap)
    if not best then Bot.lastInfo = "no legal moves" return end
    Bot.lastInfo = string.format("played %s%s (eval %+d)", squareName(best.from), squareName(best.to), score or 0)
    Bot.lastMove = squareName(best.from) .. squareName(best.to) .. (best.promo ~= "" and "=" .. best.promo:upper() or "")
    local promoId = best.promo ~= "" and PROMO_TYPE_ID[best.promo:upper()] or nil
    local ok2, res = pcall(App.onBoardMove, toGameSquare(best.from), toGameSquare(best.to), promoId)
    if ok2 then
        -- onBoardMove may return false/nil even when the move was accepted
        -- (bot games), so confirmation comes from ucis, not the return value.
        Bot.awaitingPly = #ucis + 1
        Bot.awaitingSince = os.clock()
        if res == false then Bot.lastInfo = Bot.lastInfo .. " [sent?]" end
    else
        print("[RoblyChess] onBoardMove error:", res)
        Bot.lastInfo = "move rejected by game"
        Bot.lastAttempt = os.clock() + 5
    end
end

local function botLoop()
    task.wait(1)
    while Bot.running do
        local board = getBoard()
        local s = liveSession()
        if s and board then
            tickLive(s, board)
        elseif board then
            local grid = readGrid(board)
            if grid then
                local anyPiece = false
                for i = 0, 63 do if grid[i] ~= "" then anyPiece = true break end end
                if anyPiece then
                    if not Bot.state or not Bot.lastGrid then
                        resync(board)
                    else
                        local mv = diffToMove(Bot.lastGrid, grid)
                        if mv then
                            if Bot.pending and mv.from == Bot.pending.from and mv.to == Bot.pending.to then
                                Bot.pending = nil
                                local ok = Bot.state and applyMove(Bot.state, mv)
                                if not ok then resync(board) end
                            else
                                local ok = Bot.state and applyMove(Bot.state, mv)
                                if not ok then
                                    resync(board)
                                else
                                    Bot.lastInfo = "opponent: " .. squareName(mv.from) .. squareName(mv.to)
                                end
                            end
                        else
                            local changes = 0
                            for i = 0, 63 do if grid[i] ~= Bot.lastGrid[i] then changes = changes + 1 end end
                            if changes > 4 then
                                resync(board)
                            end
                        end
                    end
                    Bot.lastGrid = grid
                    if Config.AutoPlay then
                        thinkAndPlay(board)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

