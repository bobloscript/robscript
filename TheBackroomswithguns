local function releaseVisuals(target)
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	if target.billboard then
		pcall(function()
			target.billboard:Destroy()
		end)
		target.billboard = nil
		target.label = nil
	end
	if target.healthBar then
		pcall(function()
			target.healthBar:Destroy()
		end)
		target.healthBar = nil
	end
	if target.lines then
		for _, line in ipairs(target.lines) do
			pcall(function()
				line.Visible = false
				line:Remove()
			end)
		end
		target.lines = nil
	end
	if target.tracer then
		pcall(function()
			target.tracer.Visible = false
			target.tracer:Remove()
		end)
		target.tracer = nil
	end
	target.hasVisual = false
end

