local levelOptions, levelAnchors = {}, {}
local areaOptions, areaAnchors = {}, {}
local placeOptions, placeAnchors = {}, {}
local waypoints = {}

local function findAnchor(name)
	local ok, object = pcall(function()
		return workspace:FindFirstChild(name, true)
	end)
	if not object then
		return nil
	end
	if object:IsA("BasePart") then
		return object.Position
	end
	if object:IsA("Model") then
		local okPivot, pivot = pcall(function()
			return object:GetPivot().Position
		end)
		if okPivot and pivot then
			return pivot
		end
	end
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant.Position
		end
	end
	return nil
end

local function teleportTo(position, label)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "no character"
	end
	local target = position + Vector3.new(0, 4, 0)
	pcall(function()
		character:PivotTo(CFrame.new(target))
	end)
	root.CFrame = CFrame.new(target)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end)
	end
	task.spawn(function()
		task.wait(0.5)
		if root.Parent and root.Position.Y < target.Y - 40 then
			pcall(function()
				character:PivotTo(CFrame.new(target))
			end)
		end
	end)
	return true, label
end

local function buildLevelData()
	local orderMap = {}
	local modules = ReplicatedStorage:FindFirstChild("Modules")
	local config = modules and modules:FindFirstChild("DiscoveryConfig")
	if config then
		local ok, data = pcall(require, config)
		if ok and type(data) == "table" and data.Levels then
			for index, level in ipairs(data.Levels) do
				orderMap[level.Id] = index
			end
		end
	end

	local seen = {}
	local levels = workspace:FindFirstChild("Levels")
	if levels then
		for _, part in ipairs(levels:GetChildren()) do
			if part:IsA("BasePart") then
				if not seen[part.Name] then
					seen[part.Name] = true
					levelOptions[#levelOptions + 1] = part.Name
					levelAnchors[part.Name] = part.Position
				end
			end
		end
	end

	for name in pairs(orderMap) do
		if not seen[name] then
			local anchor = findAnchor(name)
			if anchor then
				seen[name] = true
				levelOptions[#levelOptions + 1] = name
				levelAnchors[name] = anchor
			end
		end
	end

	table.sort(levelOptions, function(a, b)
		local orderA = orderMap[a] or 999
		local orderB = orderMap[b] or 999
		if orderA == orderB then
			return a < b
		end
		return orderA < orderB
	end)
end

local function buildAreaData()
	local areas = workspace:FindFirstChild("Areas")
	if not areas then
		return
	end
	local seen = {}
	for _, part in ipairs(areas:GetChildren()) do
		if part:IsA("BasePart") and not seen[part.Name] then
			seen[part.Name] = true
			areaOptions[#areaOptions + 1] = part.Name
			areaAnchors[part.Name] = part.Position
		end
	end
	table.sort(areaOptions)
end

local function buildPlaceData()
	for _, name in ipairs(PLACE_NAMES) do
		local anchor = findAnchor(name)
		if anchor then
			placeOptions[#placeOptions + 1] = name
			placeAnchors[name] = anchor
		end
	end
end

local function loadWaypoints()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return
	end
	if not isfile(WAYPOINT_FILE) then
		return
	end
	local ok, raw = pcall(readfile, WAYPOINT_FILE)
	if not ok or type(raw) ~= "string" or raw == "" then
		return
	end
	local decodedOk, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not decodedOk or type(decoded) ~= "table" then
		return
	end
	for slot, value in pairs(decoded) do
		if type(value) == "table" and type(value.x) == "number" then
			waypoints[tostring(slot)] = Vector3.new(value.x, value.y, value.z)
		end
	end
end

local function saveWaypoints()
	if type(writefile) ~= "function" then
		return
	end
	local payload = {}
	for slot, position in pairs(waypoints) do
		payload[slot] = { x = position.X, y = position.Y, z = position.Z }
	end
	pcall(function()
		writefile(WAYPOINT_FILE, HttpService:JSONEncode(payload))
	end)
end

