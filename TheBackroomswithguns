local function entityTypeOf(model)
	local discovery = model:GetAttribute("DiscoveryId")
	if type(discovery) == "string" and discovery ~= "" then
		return discovery
	end
	return model.Name
end

local function targetName(target)
	if not target then
		return "none"
	end
	if target.kind == "player" and target.player then
		return target.player.Name
	end
	return entityTypeOf(target.model)
end

local function isBossEntity(model, humanoid)
	if model.Name == "Lighter" or model.Name == "KingIllusion" then
		return true
	end
	if humanoid and humanoid.MaxHealth >= 400 then
		return true
	end
	return false
end

local function selectedEntityTypes()
	local selection = flagList("EntityTypes", ENTITY_TYPES)
	local lookup = {}
	for _, name in ipairs(selection) do
		lookup[name] = true
	end
	return lookup
end

local function collectEntities(seen)
	if not flag("EntityESP", true) then
		return
	end
	local allowed = selectedEntityTypes()
	local candidates = {}
	local present = {}

	local folder = workspace:FindFirstChild("Enemies")
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") then
				candidates[#candidates + 1] = model
				present[model] = true
			end
		end
	end
	for _, model in ipairs(CollectionService:GetTagged("Enemy")) do
		if model:IsA("Model") and not present[model] then
			present[model] = true
			candidates[#candidates + 1] = model
		end
	end

	for _, model in ipairs(candidates) do
		local humanoid = humanoidOf(model)
		local typeName = entityTypeOf(model)
		if humanoid and humanoid.Health > 0 and allowed[typeName] then
			local target = targets[model]
			if not target then
				target = createTarget("entity", model, nil)
				if target then
					targets[model] = target
				end
			end
			if target then
				seen[model] = true
			end
		end
	end
end

local function shouldTrackPlayer(player)
	if player == LocalPlayer then
		return false
	end
	local character = player.Character
	if not character or not character.Parent then
		return false
	end
	local humanoid = humanoidOf(character)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	return true
end

local function collectPlayers(seen)
	if not flag("PlayerESP", true) then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if shouldTrackPlayer(player) then
			local character = player.Character
			local target = targets[character]
			if not target then
				target = createTarget("player", character, player)
				if target then
					targets[character] = target
				end
			else
				target.player = player
			end
			if target then
				seen[character] = true
			end
		end
	end
end

local function collectPickups(seen)
	if not flag("PickupESP", false) then
		return
	end
	local selection = flagList("PickupTypes", PICKUP_TYPES)
	local allowed = {}
	for _, name in ipairs(selection) do
		allowed[name] = true
	end
	local folder = workspace:FindFirstChild("SpawnedPickups")
	if not folder then
		return
	end
	for _, part in ipairs(folder:GetChildren()) do
		if allowed[part.Name] and (part:IsA("BasePart") or part:IsA("Model")) then
			local target = targets[part]
			if not target then
				target = createTarget("pickup", part, nil)
				if target then
					targets[part] = target
				end
			end
			if target then
				seen[part] = true
			end
		end
	end
end

local function collectTargets()
	local seen = {}
	collectEntities(seen)
	collectPlayers(seen)
	collectPickups(seen)
	for model in pairs(targets) do
		if not seen[model] then
			dropTarget(model)
		end
	end
end

