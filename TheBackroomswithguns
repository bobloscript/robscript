local function collectMarkers()
	local wanted = {}
	for _, definition in ipairs(MARKER_DEFS) do
		if flag(definition.Flag, false) then
			for _, name in ipairs(definition.Names) do
				local object = workspace:FindFirstChild(name, true)
				if object and not wanted[object] then
					wanted[object] = definition.Label
				end
			end
		end
	end

	for object in pairs(markerObjects) do
		if not wanted[object] then
			local entry = markerObjects[object]
			if entry.billboard then
				pcall(function()
					entry.billboard:Destroy()
				end)
			end
			if entry.highlight then
				pcall(function()
					entry.highlight:Destroy()
				end)
			end
			markerObjects[object] = nil
		end
	end

	for object, label in pairs(wanted) do
		if not markerObjects[object] then
			local anchor = object:IsA("BasePart") and object or nil
			if not anchor and object:IsA("Model") then
				anchor = headOf(object)
			end
			if not anchor then
				for _, descendant in ipairs(object:GetDescendants()) do
					if descendant:IsA("BasePart") then
						anchor = descendant
						break
					end
				end
