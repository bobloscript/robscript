	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		jumpConnection:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	uninstallSilentAim()
	pcall(panic)
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptBWG then
		getgenv().RobScriptBWG = nil
	end
end

----- Public interface -----

getgenv().RobScriptBWG = {
	Version = "1.0",
	Actions = {
		Refresh = collectTargets,
		Clear = clearAllTargets,
		Teleport = teleportTo,
		Fullbright = setFullbright,
		ApplyWeapon = refreshWeaponConfig,
		InstallSilentAim = installSilentAim,
		Destroy = destroy,
	},
	GetStats = function()
		return { entities = stats.entities, players = stats.players, pickups = stats.pickups }
	end,
	GetTargets = function()
		local list = {}
		for model, target in pairs(targets) do
			list[#list + 1] = {
				name = (target.player and target.player.Name) or model.Name,
				kind = target.kind,
				visible = target.hasVisual,
				chams = target.highlight ~= nil,
			}
		end
		return list
	end,
	GetLevels = function()
		return levelOptions, levelAnchors
	end,
	GetAimTarget = function()
		return aimTarget
	end,
	GetSilentAimReady = function()
		return silentAimInstalled
	end,
	ProbeAim = function()
		local result = pickAimTarget(3)
		if not result then
			return nil
		end
		return { name = targetName(result.target), kind = result.target.kind, distance = result.distance }
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	Destroy = destroy,
}

----- Boot -----

-- Silent aim needs the namecall hook once; the toggle only switches the flag.
pcall(installSilentAim)

pcall(function()
	Window:LoadAutoload()
end)

Window:Notify({ Title = "Robscript Team", Content = "The Backrooms With Guns is ready", Type = "Success" })

return getgenv().RobScriptBWG
