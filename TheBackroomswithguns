----- Flags -----

-- Flags are cached after the interface is built, so a config load cannot
-- desync the runtime: every tick reads the same objects the user sees.
local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function flagList(name, fallback)
	local value = flag(name, fallback)
	if type(value) == "table" then
		return value
	end
	if type(value) == "string" then
		return { value }
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local function colorToHex(color)
	local red = math.floor(math.clamp(color.R, 0, 1) * 255 + 0.5)
	local green = math.floor(math.clamp(color.G, 0, 1) * 255 + 0.5)
	local blue = math.floor(math.clamp(color.B, 0, 1) * 255 + 0.5)
	return string.format("%02X%02X%02X", red, green, blue)
end

local function escapeText(text)
	local value = tostring(text)
	value = string.gsub(value, "&", "&amp;")
	value = string.gsub(value, "<", "&lt;")
	value = string.gsub(value, ">", "&gt;")
	return value
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function formatHealth(humanoid)
	if not humanoid then
		return "?"
	end
	local current = humanoid.Health
	local maximum = humanoid.MaxHealth
	if maximum == math.huge then
		return "inf"
	end
	if current == math.huge then
		return "inf"
	end
	return string.format("%d/%d", math.floor(current + 0.5), math.floor(maximum + 0.5))
end

local function cameraOrigin()
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function characterRoot()
	local character = LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function currentTool()
	local character = LocalPlayer.Character
	return character and character:FindFirstChildWhichIsA("Tool")
end

local function inMenu()
	return LocalPlayer:GetAttribute("InMenu") == true
end

local function humanoidOf(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid
	end
	return nil
end

local function headOf(model)
	if model:IsA("BasePart") then
		return model
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root and root:IsA("BasePart") then
		return root
	end
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			return descendant
		end
	end
	return nil
end

