----- Target registry -----

local function resolveParts(target)
	local model = target.model
	if not model or not model.Parent then
		return false
	end
	if model:IsA("BasePart") then
		target.root = model
		target.head = model
		return true
	end
	target.root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if target.kind == "entity" then
		target.humanoid = humanoidOf(model)
		target.head = headOf(model)
	elseif target.kind == "player" then
		target.humanoid = humanoidOf(model)
		target.head = model:FindFirstChild("Head") or target.root
	else
		target.head = model
	end
	return target.head ~= nil
end

local function createTarget(kind, model, player)
	local target = {
		kind = kind,
		model = model,
		player = player,
		hasVisual = false,
		lastTextAt = 0,
	}
	if not resolveParts(target) then
		return nil
	end
	return target
end

local function dropTarget(model)
	local target = targets[model]
	if not target then
		return
	end
	releaseVisuals(target)
	targets[model] = nil
end

local function clearAllTargets()
	for model in pairs(targets) do
		dropTarget(model)
	end
	stats.entities = 0
	stats.players = 0
	stats.pickups = 0
end

