				billboard.Name = "POI_Marker"
				billboard.AlwaysOnTop = true
				billboard.LightInfluence = 0
				billboard.Size = UDim2.fromOffset(160, 24)
				billboard.StudsOffset = Vector3.new(0, 3, 0)
				billboard.MaxDistance = 2000
				local text = Instance.new("TextLabel")
				text.BackgroundTransparency = 1
				text.Size = UDim2.fromScale(1, 1)
				text.Font = Enum.Font.GothamBold
				text.TextSize = 12
				text.TextColor3 = COLOR_MARKER
				text.TextStrokeTransparency = 0.4
				text.Text = label
				text.Parent = billboard
				billboard.Adornee = anchor
				billboard.Parent = anchor
				markerObjects[object] = { object = object, billboard = billboard }
			end
		end
	end
end

----- Aim -----

local fovCircle = { lines = {}, visible = false }

local function buildFovCircle()
	if not DrawingLib or #fovCircle.lines > 0 then
		return
	end
	for index = 1, 36 do
		local line = newLine()
		if line then
			line.Thickness = 1
			line.Color = Color3.fromHex("#FF3B7F")
			line.Transparency = 0.45
			fovCircle.lines[#fovCircle.lines + 1] = line
		end
	end
end

local function updateFovCircle()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local enabled = flag("AimCircle", true) and flag("AimAssist", true) and not inMenu()
	buildFovCircle()
	if not enabled then
		for _, line in ipairs(fovCircle.lines) do
			if line.Visible then
				line.Visible = false
			end
		end
		fovCircle.visible = false
		return
	end
	fovCircle.visible = true
	local radius = flag("AimFOV", 160)
	local center = camera.ViewportSize * 0.5
	local count = #fovCircle.lines
	if count == 0 then
		return
	end
	for index = 1, count do
		local line = fovCircle.lines[index]
		local angleA = (index - 1) / count * math.pi * 2
		local angleB = index / count * math.pi * 2
		line.From = center + Vector2.new(math.cos(angleA), math.sin(angleA)) * radius
		line.To = center + Vector2.new(math.cos(angleB), math.sin(angleB)) * radius
		line.Visible = true
	end
end

local aimCache = { at = 0, list = {} }

local function aimCandidates()
	local now = os.clock()
	if now - aimCache.at < 0.1 then
		return aimCache.list
	end
	aimCache.at = now
	local list = {}
	local selection = flagList("AimTargets", { "Entities" })
	local wantEntities, wantPlayers = false, false
	for _, value in ipairs(selection) do
		if value == "Entities" then
			wantEntities = true
		elseif value == "Players" then
			wantPlayers = true
		end
	end

	if wantEntities then
		for model, target in pairs(targets) do
			if target.kind == "entity" and target.head and target.head.Parent then
				local humanoid = target.humanoid
				if humanoid and humanoid.Health > 0 then
					list[#list + 1] = target
				end
			end
		end
	end
	if wantPlayers then
		for model, target in pairs(targets) do
			if target.kind == "player" and target.head and target.head.Parent then
				local humanoid = target.humanoid
				if humanoid and humanoid.Health > 0 then
					list[#list + 1] = target
				end
			end
		end
	end
	aimCache.list = list
	return list
end

local function pickAimTarget(radiusMultiplier)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local center = camera.ViewportSize * 0.5
	local radius = flag("AimFOV", 160) * (radiusMultiplier or 1)
	local headOnly = flag("AimHead", true)
	local best, bestScore = nil, math.huge
	for _, target in ipairs(aimCandidates()) do
		local part = target.head
		if headOnly and target.kind == "entity" then
			local head = target.model:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				part = head
			end
		end
		if part and part.Parent then
			local screen = camera:WorldToViewportPoint(part.Position)
			if screen.Z > 0 then
				local delta = Vector2.new(screen.X, screen.Y) - center
				local magnitude = delta.Magnitude
				if magnitude <= radius and magnitude < bestScore then
					best = { target = target, part = part, screen = delta, distance = magnitude }
					bestScore = magnitude
				end
			end
		end
	end
	return best
end

local function canAimNow()
	if inMenu() then
		return false
	end
	if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		return false
	end
	if flag("AimRMB", true) and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		return false
	end
	return true
end

local function stepAim()
	if not flag("AimAssist", true) then
		aimStatus = "disabled"
		return
	end
	if not canAimNow() then
		aimStatus = "idle"
		return
	end
	local result = pickAimTarget(1)
	if not result then
		aimStatus = "no target"
		return
	end
	aimStatus = targetName(result.target)
	aimTarget = result.target
	local smooth = math.max(1, flag("AimSmooth", 6))
	local delta = result.screen
	if delta.Magnitude > 240 then
		delta = delta.Unit * 240
	end
	pcall(function()
		mousemoverel(delta.X / smooth, delta.Y / smooth)
	end)
end

----- Silent aim -----

local silentAimInstalled = false
local silentAimOriginal
local inflictTarget

local function installSilentAim()
	if silentAimInstalled then
		return true
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	inflictTarget = remotes and remotes:FindFirstChild("InflictTarget")
	if not inflictTarget then
		return false
	end
	local ok = pcall(function()
		silentAimOriginal = hookmetamethod(game, "__namecall", function(self, ...)
			local method = getnamecallmethod()
			if method == "FireServer" and self == inflictTarget and flag("SilentAim", false) then
				local arguments = table.pack(...)
				local payload = arguments[1]
				if type(payload) == "table" and payload.Type == "Gun" then
					local result = pickAimTarget(1.5)
					if result and result.part then
						payload.Hit = result.part
						payload.IsHeadshot = result.part.Name == "Head"
						payload.Position = result.part.Position
						local root = characterRoot()
						if root then
							payload.Distance = (result.part.Position - root.Position).Magnitude
						end
					end
				end
				return silentAimOriginal(self, table.unpack(arguments, 1, arguments.n))
			end
			return silentAimOriginal(self, ...)
		end)
	end)
	if not ok then
		return false
	end
	silentAimInstalled = true
	return true
end

local function uninstallSilentAim()
	if not silentAimInstalled or not silentAimOriginal then
		return
	end
	pcall(function()
		hookmetamethod(game, "__namecall", silentAimOriginal)
	end)
	silentAimInstalled = false
	silentAimOriginal = nil
end

----- Weapon config -----

local configOriginals = setmetatable({}, { __mode = "k" })
local PATCH_KEYS = { "Recoil", "Spread", "BulletBloom", "FireRate", "ReloadTime", "CameraRecoilingEnabled", "BaseDamage" }

local function snapshotConfig(config)
	local snapshot = configOriginals[config]
	if snapshot then
		return snapshot
	end
	snapshot = {}
	for _, key in ipairs(PATCH_KEYS) do
		snapshot[key] = config[key]
	end
	configOriginals[config] = snapshot
	return snapshot
end

local function applyWeaponConfig(config)
	if type(config) ~= "table" or config.BaseDamage == nil then
		return false
	end
	local snapshot = snapshotConfig(config)
	local noRecoil = flag("NoRecoil", true)
	local noSpread = flag("NoSpread", true)
	local rapid = flag("RapidFire", false)
	local fastReload = flag("InstantReload", false)
	local rapidRate = flag("RapidRate", 0.08)

	config.Recoil = noRecoil and 0 or snapshot.Recoil
	if noRecoil then
		config.CameraRecoilingEnabled = false
	else
		config.CameraRecoilingEnabled = snapshot.CameraRecoilingEnabled
	end
	config.Spread = noSpread and 0 or snapshot.Spread
	config.BulletBloom = noSpread and 0 or snapshot.BulletBloom
	config.ReloadTime = fastReload and 0 or snapshot.ReloadTime
	if rapid then
		local base = snapshot.FireRate or 0.4
		config.FireRate = math.min(base, rapidRate)
	else
		config.FireRate = snapshot.FireRate
	end
	return true
end

local function weaponConfigs()
	local list = {}
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ character, backpack }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					local folder = tool:FindFirstChild("Setting")
					if folder then
						for _, module in ipairs(folder:GetChildren()) do
							if module:IsA("ModuleScript") then
								local ok, config = pcall(require, module)
								if ok then
									list[#list + 1] = config
								end
							end
						end
					end
				end
			end
		end
	end
	return list
end

local function refreshWeaponConfig()
	local patched = 0
	for _, config in ipairs(weaponConfigs()) do
		if applyWeaponConfig(config) then
			patched = patched + 1
		end
	end
	return patched
end

local function restoreWeaponConfig()
	for config, snapshot in pairs(configOriginals) do
		for key, value in pairs(snapshot) do
			pcall(function()
				config[key] = value
			end)
		end
	end
	configOriginals = setmetatable({}, { __mode = "k" })
end

local function applyNoHeat()
	if not flag("NoHeat", true) then
		return
	end
	local tool = currentTool()
	local folder = tool and tool:FindFirstChild("ValueFolder")
	if not folder then
		return
	end
	for _, holder in ipairs(folder:GetChildren()) do
		local heat = holder:FindFirstChild("Heat")
		if heat and heat:IsA("NumberValue") and heat.Value > 0 then
			heat.Value = 0
		end
	end
end

