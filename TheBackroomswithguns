local function graphicsFolder()
	local settings = ReplicatedStorage:FindFirstChild("Settings")
	return settings and settings:FindFirstChild("Graphics")
end

-- The world toggles only touch a setting while they are enabled and restore
-- the value the user had before. They never force a setting back on.
local function applyGraphicsToggles()
	local folder = graphicsFolder()
	local list = {
		{ Flag = "NoVHS", Name = "VHS" },
		{ Flag = "NoVignette", Name = "Vignette" },
		{ Flag = "NoShake", Name = "ScreenShake" },
		{ Flag = "NoDamageNumbers", Name = "DamageNumbers" },
	}
	for _, entry in ipairs(list) do
		local value = folder and folder:FindFirstChild(entry.Name)
		if value and value:IsA("BoolValue") then
			if flag(entry.Flag, false) then
				if graphicsOriginals[entry.Name] == nil then
					graphicsOriginals[entry.Name] = value.Value
				end
				if value.Value then
					value.Value = false
				end
			elseif graphicsOriginals[entry.Name] ~= nil then
				value.Value = graphicsOriginals[entry.Name]
				graphicsOriginals[entry.Name] = nil
			end
		end
	end

	local attribute = LocalPlayer:GetAttribute("CameraBobbleEnabled")
	if flag("NoBobble", false) then
		if bobbleOriginal == nil then
			bobbleOriginal = attribute
		end
		if attribute ~= false then
			LocalPlayer:SetAttribute("CameraBobbleEnabled", false)
		end
	elseif bobbleOriginal ~= nil then
		LocalPlayer:SetAttribute("CameraBobbleEnabled", bobbleOriginal)
		bobbleOriginal = nil
	end
end

local lastForcedFov = 70

-- A custom FOV is enforced only when it differs from the game default, so the
-- native scope and sprint FOV logic keeps working at 70.
local function setCameraFov()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local value = flag("FovValue", 70)
	if math.abs(value - 70) < 0.5 then
		if lastForcedFov ~= 70 then
			camera.FieldOfView = 70
			lastForcedFov = 70
		end
		return
	end
	lastForcedFov = value
	if math.abs(camera.FieldOfView - value) > 0.5 then
		camera.FieldOfView = value
	end
end

----- Movement -----

local noclipParts = {}
local noclipActive = false
local speedApplied = false
local jumpApplied = false
local flyVelocity = nil

local function setNoclip(on)
	local character = LocalPlayer.Character
	if on then
		if not character then
			return
		end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				noclipParts[part] = true
				part.CanCollide = false
			end
		end
	else
		for part in pairs(noclipParts) do
			if part.Parent then
				pcall(function()
					part.CanCollide = true
				end)
			end
		end
		noclipParts = {}
	end
end

local function setFly(on)
	if on then
		local root = characterRoot()
		if not root then
			return
		end
		if flyVelocity then
			flyVelocity:Destroy()
		end
		flyVelocity = Instance.new("BodyVelocity")
		flyVelocity.Name = "BWG_Fly"
		flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		flyVelocity.Velocity = Vector3.zero
		flyVelocity.Parent = root
	else
		if flyVelocity then
			pcall(function()
				flyVelocity:Destroy()
			end)
			flyVelocity = nil
		end
	end
end

local function updateFly()
	if not flag("Fly", false) then
		if flyVelocity then
			setFly(false)
		end
		return
	end
	if not flyVelocity or not flyVelocity.Parent then
		setFly(true)
		if not flyVelocity then
			return
		end
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local direction = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		direction += camera.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		direction -= camera.CFrame.LookVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		direction += camera.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		direction -= camera.CFrame.RightVector
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.yAxis
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction -= Vector3.yAxis
	end
	if direction.Magnitude > 0 then
		direction = direction.Unit
	end
	flyVelocity.Velocity = direction * flag("FlySpeed", 60)
end

local function enforceSpeed()
	local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if flag("SpeedEnabled", false) then
		local speed = flag("WalkSpeed", 16)
		if math.abs(humanoid.WalkSpeed - speed) > 0.1 then
			humanoid.WalkSpeed = speed
			speedApplied = true
		end
	elseif speedApplied then
		humanoid.WalkSpeed = DEFAULT_WALK_SPEED
		speedApplied = false
	end
	if flag("JumpEnabled", false) then
		local power = flag("JumpPower", 50)
		if math.abs(humanoid.JumpPower - power) > 0.1 then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = power
			jumpApplied = true
		end
	elseif jumpApplied then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = DEFAULT_JUMP_POWER
		jumpApplied = false
	end
end

local function enforceMovement()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local wantNoclip = flag("Noclip", false)
	if wantNoclip ~= noclipActive then
		noclipActive = wantNoclip
		setNoclip(wantNoclip)
	end
	if wantNoclip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				noclipParts[part] = true
				part.CanCollide = false
			end
		end
	end
end

