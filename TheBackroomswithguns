		return flag("BossColor", COLOR_BOSS)
	end
	return flag("EntityColor", COLOR_ENTITY)
end

local function playerColor()
	return flag("PlayerColor", COLOR_PLAYER)
end

local function pickupColor()
	return flag("PickupColor", COLOR_PICKUP)
end

local function entityLabel(target, distance)
	local model = target.model
	local parts = {}
	if flag("EntityName", true) then
		parts[#parts + 1] = string.format(
			'<font color="#%s">%s</font>',
			colorToHex(entityColor(model, target.humanoid)),
			escapeText(entityTypeOf(model))
		)
	end
	local details = {}
	if flag("EntityHealth", true) and target.humanoid then
		details[#details + 1] = formatHealth(target.humanoid)
	end
	if flag("EntityDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	if #details > 0 then
		parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
	end
	return table.concat(parts, "\n")
end

local function playerLabel(target, distance)
	local player = target.player
	if not player then
		return ""
	end
	local humanoid = target.humanoid
	local parts = {}
	if flag("PlayerName", true) then
		parts[#parts + 1] = string.format('<font color="#%s">%s</font>', colorToHex(playerColor()), escapeText(player.Name))
	end
	local details = {}
	if flag("PlayerMode", true) then
		details[#details + 1] = player:GetAttribute("SurvivalMode") == true and "Survival" or "Classic"
	end
	if flag("PlayerHealth", true) then
		details[#details + 1] = formatHealth(humanoid)
	end
	if flag("PlayerTokens", true) then
		local tokens = player:GetAttribute("WrapTokens")
		if typeof(tokens) == "number" then
			details[#details + 1] = string.format("%d tokens", tokens)
		end
	end
	if flag("PlayerDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	if #details > 0 then
		parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
	end
	return table.concat(parts, "\n")
end

local function pickupLabel(target, distance)
	local part = target.model
	local parts = {}
	if flag("PickupName", true) then
		local label = PICKUP_LABELS[part.Name] or part.Name
		parts[#parts + 1] = string.format('<font color="#%s">%s</font>', colorToHex(pickupColor()), escapeText(label))
	end
	if flag("PickupDistance", true) then
		parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', formatDistance(distance))
	end
	return table.concat(parts, "\n")
end

local function updateChams(target, color, enabled)
	if not enabled then
		if target.highlight then
			pcall(function()
				target.highlight:Destroy()
			end)
			target.highlight = nil
		end
		return
	end
	if not target.highlight or not target.highlight.Parent then
		target.highlight = buildHighlight(target.model, color)
	end
	local highlight = target.highlight
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

local function updateBillboard(target, color, distance, visible)
	if not visible then
		if target.billboard then
			target.billboard.Enabled = false
		end
		return
	end
	if not target.billboard or not target.billboard.Parent then
		local offsetY = 2.6
		if target.kind == "entity" then
			offsetY = 2.2
		elseif target.kind == "pickup" then
			offsetY = 1.1
		end
		target.billboard, target.label, target.healthBar = buildBillboard(target.head, offsetY)
	end
	local billboard = target.billboard
	if not billboard then
		return
	end
	local renderDistance = flag(target.kind == "pickup" and "PickupRenderDistance" or "RenderDistance", 2500)
	billboard.MaxDistance = renderDistance
	billboard.Enabled = visible
	if not visible then
		return
	end
	local now = os.clock()
	if now - target.lastTextAt >= TEXT_INTERVAL then
		target.lastTextAt = now
		local text
		if target.kind == "entity" then
			text = entityLabel(target, distance)
		elseif target.kind == "player" then
			text = playerLabel(target, distance)
		else
			text = pickupLabel(target, distance)
		end
		if target.label then
			target.label.Text = text
			target.label.TextColor3 = color
		end
		local healthBar = target.healthBar
		if healthBar then
			local humanoid = target.humanoid
			local showBar = humanoid ~= nil and target.kind ~= "pickup"
			healthBar.Visible = showBar and flag("HealthBar", true) or false
			if showBar and humanoid.MaxHealth > 0 and humanoid.MaxHealth ~= math.huge then
				local fraction = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
				healthBar.Size = UDim2.new(0.7 * fraction, 0, 0, 3)
				healthBar.BackgroundColor3 = fraction > 0.5 and Color3.fromRGB(120, 235, 130)
					or fraction > 0.25 and Color3.fromRGB(255, 196, 64)
					or Color3.fromRGB(235, 86, 86)
			end
		end
	end
end

local function projectBox(center, size)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local half = size * 0.5
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local hits = 0
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				local world = center + Vector3.new(half.X * x, half.Y * y, half.Z * z)
				local screen = camera:WorldToViewportPoint(world)
				if screen.Z > 0 then
					hits = hits + 1
					minX = math.min(minX, screen.X)
					minY = math.min(minY, screen.Y)
					maxX = math.max(maxX, screen.X)
					maxY = math.max(maxY, screen.Y)
				end
			end
		end
	end
	if hits < 2 then
		return nil
	end
	return minX, minY, maxX, maxY
end

local function updateBox(target, color, visible)
	local boxFlag = target.kind == "player" and "PlayerBox" or "EntityBox"
	if not visible or not flag(boxFlag, false) then
		if target.lines then
			for _, line in ipairs(target.lines) do
				if line.Visible then
					line.Visible = false
				end
			end
		end
		return
	end

	local center, size
	if target.kind == "player" then
		center = target.root.Position
		size = PLAYER_BOX_SIZE
	else
		local ok, boxCenter, boxSize = pcall(function()
			local cf, sz = target.model:GetBoundingBox()
			return cf.Position, sz
		end)
		if not ok then
			return
		end
		center = boxCenter
		size = boxSize
	end

	local minX, minY, maxX, maxY = projectBox(center, size)
	if not minX then
		if target.lines then
			for _, line in ipairs(target.lines) do
				line.Visible = false
			end
		end
		return
	end

	if not target.lines then
		target.lines = { newLine(), newLine(), newLine(), newLine() }
	end
	local lines = target.lines
	if not lines[1] then
		return
	end

	local topLeft = Vector2.new(minX, minY)
	local topRight = Vector2.new(maxX, minY)
	local bottomLeft = Vector2.new(minX, maxY)
	local bottomRight = Vector2.new(maxX, maxY)
	local segments = {
		{ topLeft, topRight },
		{ topRight, bottomRight },
		{ bottomRight, bottomLeft },
		{ bottomLeft, topLeft },
	}
	for index = 1, 4 do
		local line = lines[index]
		if line then
			local segment = segments[index]
			line.From = segment[1]
			line.To = segment[2]
			line.Color = color
			line.Thickness = 1
			line.Visible = true
		end
	end
end

local function updateTracer(target, color, visible)
	local enabled = visible and flag("PlayerTracer", false) and target.kind == "player"
	if not enabled then
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local screen = camera:WorldToViewportPoint(target.head.Position)
	if screen.Z <= 0 then
		if target.tracer then
			target.tracer.Visible = false
		end
		return
	end
	if not target.tracer then
		target.tracer = newLine()
	end
	if not target.tracer then
		return
	end
	local tracer = target.tracer
	tracer.From = Vector2.new(viewport.X * 0.5, viewport.Y)
	tracer.To = Vector2.new(screen.X, screen.Y)
	tracer.Color = color
	tracer.Thickness = 1
	tracer.Visible = true
end

local function updateTarget(target)
	if not target.model or not target.model.Parent then
		releaseVisuals(target)
		return
	end
	if not target.head or not target.head.Parent then
		if not resolveParts(target) then
			releaseVisuals(target)
			return
		end
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = cameraOrigin()
	local distance = (target.head.Position - origin).Magnitude
	local renderDistance = flag(target.kind == "pickup" and "PickupRenderDistance" or "RenderDistance", 2500)
	local visible = distance <= renderDistance
	if not visible and target.billboard and distance > renderDistance * 2 then
		pcall(function()
			target.billboard:Destroy()
		end)
		target.billboard = nil
		target.label = nil
		target.healthBar = nil
	end

	local color
	if target.kind == "entity" then
		color = entityColor(target.model, target.humanoid)
	elseif target.kind == "player" then
		color = playerColor()
	else
		color = pickupColor()
	end

	updateChams(target, color, visible and flag(target.kind == "pickup" and "PickupChams" or (target.kind == "player" and "PlayerChams" or "EntityChams"), true))
	updateBillboard(target, color, distance, visible)
	updateBox(target, color, visible)
	updateTracer(target, color, visible)
	target.hasVisual = visible
end

local function updateStats()
	local entityCount, playerCount, pickupCount = 0, 0, 0
	for _, target in pairs(targets) do
		if target.hasVisual then
			if target.kind == "entity" then
				entityCount = entityCount + 1
			elseif target.kind == "player" then
				playerCount = playerCount + 1
			else
				pickupCount = pickupCount + 1
			end
		end
	end
	stats.entities = entityCount
	stats.players = playerCount
	stats.pickups = pickupCount
end

