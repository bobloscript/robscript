local function watchMatchContent()
    local matchContent = Workspace:FindFirstChild("MatchContent")
    if not matchContent then
        return
    end
    track(matchContent.ChildAdded:Connect(function(child)
        local label = HazardNames[child.Name]
        if not label then
            return
        end
        if HazardLog then
            HazardLog:Push("<Accent>" .. label .. "</Accent> appeared", "Warning")
        end
        if Flags.HazardAlert then
            playPing(1.15)
            safeNotify({
                Title = "Hazard incoming",
                Content = label,
                Icon = "triangle-alert",
                Type = "Warning",
                Duration = 3,
            })
        end
        if (child.Name == "EscapeTower" or child.Name == "NukeBunker") and refreshMarkers then
            refreshMarkers()
        end
    end))
end

local function watchWater()
    local function refresh()
        State.water = readNumber(Workspace:GetAttribute("SeaTop"), 0)
        State.seaLevel = readNumber(Workspace:GetAttribute("SeaLevel"), 0)
    end
    refresh()
    track(Workspace:GetAttributeChangedSignal("SeaTop"):Connect(refresh))
    track(Workspace:GetAttributeChangedSignal("SeaLevel"):Connect(refresh))
end

----- Remote hooks -----
local function hookRemotes()
    if not Supported then
        return
    end

    local writerChosen = WriterRemotes:FindFirstChild("WriterChosen")
    local writerLive = WriterRemotes:FindFirstChild("WriterLive")
    local wordAnnounced = WriterRemotes:FindFirstChild("WordAnnounced")

    if writerChosen and writerChosen:IsA("RemoteEvent") then
        track(writerChosen.OnClientEvent:Connect(function(name)
            State.liveWriter = tostring(name or "")
            if State.liveWriter == LocalPlayer.Name and Flags.TurnAlert then
                playPing(1.35)
                flashHud()
                safeNotify({
                    Title = "Your turn to write",
                    Content = "Whatever you type becomes real",
                    Icon = "pencil-line",
                    Type = "Success",
                    Duration = 4,
                })
            end
        end))
    end

    if writerLive and writerLive:IsA("RemoteEvent") then
        track(writerLive.OnClientEvent:Connect(function(tag, a, b)
            -- "begin" carries the writer character and the writer name,
            -- the typed text arrives as "text", the locked word as "stamp".
            if tag == "begin" then
                State.liveWord = ""
                if type(b) == "string" and b ~= "" then
                    State.liveWriter = b
                end
            elseif tag == "text" then
                State.liveWord = tostring(a or "")
            elseif tag == "stamp" then
                State.liveWord = tostring(a or "")
            end
        end))
    end

    if wordAnnounced and wordAnnounced:IsA("RemoteEvent") then
        track(wordAnnounced.OnClientEvent:Connect(function(rich)
            local writer, word = parseAnnouncement(rich)
            pushWord(writer, word)
            if WordLog then
                WordLog:Push("<b>" .. writer .. "</b> wrote <Accent>" .. word .. "</Accent>")
            end
            if Flags.WordAlert then
                playPing(1)
                safeNotify({
                    Title = word,
                    Content = "written by " .. writer,
                    Icon = "scroll-text",
                    Type = "Info",
                    Duration = 3,
                })
            end
            task.delay(4, function()
                if State.liveWord == word then
                    State.liveWord = ""
                end
            end)
        end))
    end

    if EconomyRemotes then
        local deathFeed = EconomyRemotes:FindFirstChild("DeathFeed")
        if deathFeed and deathFeed:IsA("RemoteEvent") then
            track(deathFeed.OnClientEvent:Connect(function(a, b)
                local text = type(a) == "string" and a or tostring(b or "")
                if DeathLog and text ~= "" then
                    DeathLog:Push("<Muted>" .. text .. "</Muted>")
                end
            end))
        end
    end

    if NukeRemotes then
        local nuke = NukeRemotes:FindFirstChild("Nuke")
        if nuke and nuke:IsA("RemoteEvent") then
            track(nuke.OnClientEvent:Connect(function()
                if HazardLog then
                    HazardLog:Push("<Error>Nuke launched</Error>", "Error")
                end
                if Flags.HazardAlert then
                    playPing(0.75)
                end
            end))
        end
    end

    if IslandRemotes then
        local zoneDoomed = IslandRemotes:FindFirstChild("ZoneDoomed")
        if zoneDoomed and zoneDoomed:IsA("RemoteEvent") then
            track(zoneDoomed.OnClientEvent:Connect(function()
                if HazardLog then
                    HazardLog:Push("<Warning>Your zone is sinking</Warning>", "Warning")
                end
                if Flags.HazardAlert then
                    playPing(0.9)
                end
            end))
        end
    end
end

