local function updateHud()
    if not HudRoot then
        return
    end
    local card = HudRoot:FindFirstChild("Card")
    if not card then
        return
    end
    local wordLabel = card:FindFirstChild("Word")
    local lineLabel = card:FindFirstChild("Line")
    local waterLabel = card:FindFirstChild("Water")

    local word = State.liveWord ~= "" and State.liveWord or State.lastWord
    if wordLabel then
        wordLabel.Text = (word ~= "" and word) or "-"
        wordLabel.TextColor3 = State.liveWord ~= "" and THEME.Accent or THEME.Text
    end

    if lineLabel then
        if State.liveWord ~= "" then
            lineLabel.Text = State.liveWriter ~= "" and (State.liveWriter .. " is typing") or "typing"
        elseif State.lastWord ~= "" then
            lineLabel.Text = (State.lastWriter ~= "" and State.lastWriter or "someone") .. " wrote it"
        else
            lineLabel.Text = "waiting for the first word"
        end
    end

    if waterLabel then
        local root = getRoot()
        if root then
            local margin = root.Position.Y - State.water
            if margin < Flags.WaterMargin then
                waterLabel.Text = string.format("water %.1f studs above your feet - GET HIGHER", math.abs(margin))
                waterLabel.TextColor3 = Color3.fromRGB(255, 96, 96)
            else
                waterLabel.Text = string.format("water %.1f  |  you have %.1f studs of room", State.water, margin)
                waterLabel.TextColor3 = THEME.Muted
            end
        else
            waterLabel.Text = ""
        end
    end
end

