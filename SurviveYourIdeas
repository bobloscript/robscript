TypingBox:CreateStatusList({
    Name = "Matching what is typed",
    MaxRows = 6,
    EmptyText = "nobody is typing",
    UpdateRate = 0.4,
    Update = function()
        if not CatalogLoaded then
            return nil
        end
        local prefix = State.liveWord
        if prefix == "" then
            return nil
        end
        local needle = string.lower(prefix)
        local matches = {}
        for _, row in ipairs(CatalogRows) do
            if string.sub(string.lower(row[1]), 1, #needle) == needle then
                table.insert(matches, { Text = row[1], Value = row[3], Tone = "Accent" })
            end
        end
        if #matches == 0 then
            return { { Text = "<Muted>" .. prefix .. "</Muted>", Value = "no match" } }
        end
        table.sort(matches, function(a, b)
            if #a.Text == #b.Text then
                return a.Text < b.Text
            end
            return #a.Text < #b.Text
        end)
        while #matches > 6 do
            table.remove(matches)
        end
        return matches
    end,
})

