    elseif LightingBackup then
        Lighting.Ambient = LightingBackup.Ambient
        Lighting.OutdoorAmbient = LightingBackup.OutdoorAmbient
        Lighting.Brightness = LightingBackup.Brightness
        Lighting.ClockTime = LightingBackup.ClockTime
        Lighting.GlobalShadows = LightingBackup.GlobalShadows
        Lighting.FogEnd = LightingBackup.FogEnd
        Lighting.ExposureCompensation = LightingBackup.ExposureCompensation
        LightingBackup = nil
    end
end

local function setParticles(on)
    if on then
        if ParticleBackup then
            for _, emitter in ipairs(ParticleBackup) do
                pcall(function()
                    emitter.Enabled = true
                end)
            end
            ParticleBackup = nil
        end
        return
    end
    if ParticleBackup then
        return
    end
    ParticleBackup = {}
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("ParticleEmitter") or object:IsA("Fire") or object:IsA("Smoke") or object:IsA("Sparkles") then
            if object.Enabled then
                object.Enabled = false
                table.insert(ParticleBackup, object)
            end
        end
    end
end

