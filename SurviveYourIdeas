----- Small helpers -----
local function stamp()
    return os.date("%H:%M:%S")
end

local function getCharacter()
    local character = LocalPlayer.Character
    if character and character.Parent then
        return character
    end
    return nil
end

local function getRoot()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function readNumber(value, fallback)
    if type(value) == "number" then
        return value
    end
    return fallback or 0
end

local function fmtSeconds(total)
    total = math.max(0, math.floor(total))
    return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

local function playPing(pitch)
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if gui then
        for _, descendant in ipairs(gui:GetDescendants()) do
            if descendant:IsA("Sound") and descendant.SoundId ~= "" then
                local clone = descendant:Clone()
                clone.Name = "SYI_Ping"
                clone.PlaybackSpeed = pitch or 1
                clone.Parent = SoundService
                clone:Play()
                task.delay(3, function()
                    if clone then
                        pcall(function()
                            clone:Destroy()
                        end)
                    end
                end)
                return true
            end
        end
    end
    return false
end

local function flashHud()
    if not HudRoot then
        return
    end
    local card = HudRoot:FindFirstChild("Card")
    if not card then
        return
    end
    local original = card.BackgroundColor3
    card.BackgroundColor3 = THEME.Accent
    TweenService:Create(card, TweenInfo.new(0.45), { BackgroundColor3 = original }):Play()
end

local function safeNotify(options)
    if not Window then
        return
    end
    pcall(function()
        Window:Notify(options)
    end)
end

----- Reading the in-game interface -----
local function gameGui(name)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then
        return nil
    end
    return playerGui:FindFirstChild(name)
end

local function readInterfaceText(name)
    local gui = gameGui("SYI_Interface")
    if not gui then
        return nil
    end
    local label = gui:FindFirstChild(name, true)
    if label and (label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox")) then
        return label.Text
    end
    return nil
end

local function readAliveCount()
    return tonumber(readInterfaceText("Alive")) or 0
end

local function readTimeLeft()
    local text = readInterfaceText("Time")
    if not text then
        return 0
    end
    local minutes, seconds = string.match(text, "(%d+):(%d+)")
    if minutes then
        return tonumber(minutes) * 60 + tonumber(seconds)
    end
    return tonumber(text) or 0
end

local function readMessage()
    return readInterfaceText("Message") or ""
end

local function myWriterChance()
    return readNumber(LocalPlayer:GetAttribute("WriterChance"), 0)
end

----- Word parsing -----
local function parseAnnouncement(rich)
    if type(rich) ~= "string" then
        return "?", "?"
    end
    local word = string.match(rich, "<i>(.-)</i>")
    local writer = string.match(rich, "^(.-)%s+said")
    if not word then
        word = string.gsub(rich, "<.->", "")
    end
    return writer or "?", word
end

local function pushWord(writer, word)
    State.lastWord = word
    State.lastWriter = writer
    table.insert(State.words, 1, {
        Word = word,
        Writer = writer,
        Time = stamp(),
    })
    while #State.words > MAX_WORD_ROWS do
        table.remove(State.words)
    end
    if WordTable then
        pcall(function()
            WordTable:SetRows(State.words)
        end)
    end
end

----- Safe tower markers -----
local function clearMarkers()
    for _, marker in ipairs(ActiveMarkers) do
        pcall(function()
            marker:Destroy()
        end)
    end
    ActiveMarkers = {}
end

refreshMarkers = function()
    clearMarkers()
    if not Flags.TowerMarkers then
        return
    end
    local distance = Flags.MarkerDistance
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") and (object.Name == "EscapeTower" or object.Name == "NukeBunker") then
            local ok, pivot = pcall(function()
                return object:GetPivot().Position
            end)
            if ok and pivot then
                local highlight = Instance.new("Highlight")
                highlight.Name = "SYI_Marker"
                highlight.Adornee = object
                highlight.FillColor = object.Name == "NukeBunker" and Color3.fromRGB(90, 180, 255)
                    or Color3.fromRGB(255, 59, 127)
                highlight.FillTransparency = 0.72
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.OutlineTransparency = 0.25
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = object
                table.insert(ActiveMarkers, highlight)

                local billboard = Instance.new("BillboardGui")
                billboard.Name = "SYI_MarkerLabel"
                billboard.Adornee = object
                billboard.Size = UDim2.fromOffset(110, 26)
                billboard.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
                billboard.AlwaysOnTop = true
                billboard.MaxDistance = distance
                billboard.LightInfluence = 0
                billboard.Parent = object

                local label = Instance.new("TextLabel")
                label.BackgroundTransparency = 1
                label.Size = UDim2.fromScale(1, 1)
                label.Font = Enum.Font.GothamBold
                label.TextSize = 14
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextStrokeTransparency = 0.4
                label.Text = object.Name == "NukeBunker" and "BUNKER" or "SAFE"
                label.Parent = billboard

                table.insert(ActiveMarkers, billboard)
            end
        end
    end
end

local function nearestTower()
    local root = getRoot()
    if not root then
        return nil, 0
    end
    local bestName, bestDistance = nil, math.huge
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") and (object.Name == "EscapeTower" or object.Name == "NukeBunker") then
            local ok, pivot = pcall(function()
                return object:GetPivot().Position
            end)
            if ok and pivot then
                local distance = (pivot - root.Position).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestName = object.Name
                end
            end
        end
    end
    return bestName, bestDistance
end

