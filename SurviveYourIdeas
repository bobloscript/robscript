local CatalogRows = {}
local CatalogTotal = 0
local CatalogLoaded = false

local DiaryFolder = ReplicatedStorage:FindFirstChild("Diary")
local CatalogModule = DiaryFolder and DiaryFolder:FindFirstChild("DiaryCatalog")
if CatalogModule then
    local okRequire, catalog = pcall(require, CatalogModule)
    if okRequire and type(catalog) == "table" and type(catalog.all) == "function" then
        local okAll, entries = pcall(catalog.all)
        if okAll and type(entries) == "table" then
            local seen = {}
            for id, entry in pairs(entries) do
                local word = tostring(entry.key or id)
                if not seen[word] then
                    seen[word] = true
                    table.insert(CatalogRows, {
                        word,
                        tostring(entry.cat or "?"),
                        tostring(entry.line or ""),
                    })
                end
            end
            table.sort(CatalogRows, function(a, b)
                return a[1] < b[1]
            end)
            CatalogTotal = #CatalogRows
            CatalogLoaded = true
        end
    end
end

local categoryNames = { "All" }
do
    local seen = {}
    for _, row in ipairs(CatalogRows) do
        if not seen[row[2]] then
            seen[row[2]] = true
            table.insert(categoryNames, row[2])
        end
    end
    table.sort(categoryNames, function(a, b)
        if a == "All" then
            return true
        end
        if b == "All" then
            return false
        end
        return a < b
    end)
end

local currentCategory = "All"
local showInternal = false
local catalogTable = nil

local function isInternalWord(word)
    return string.find(word, ":", 1, true) ~= nil
end

local function collectCatalogRows()
    local rows = {}
    for _, row in ipairs(CatalogRows) do
        local categoryMatches = currentCategory == "All" or row[2] == currentCategory
        local visibilityMatches = showInternal or not isInternalWord(row[1])
        if categoryMatches and visibilityMatches then
            table.insert(rows, row)
        end
    end
    return rows
end

local function applyCatalogFilter()
    local rows = collectCatalogRows()
    if catalogTable then
        pcall(function()
            catalogTable:SetRows(rows)
        end)
    end
    return #rows
end

