----- Helpers -----

local function now()
	return os.clock()
end

local function waitUntil(predicate, timeout)
	local deadline = now() + (timeout or 2)
	repeat
		local ok, result = pcall(predicate)
		if ok and result then
			return true
		end
		task.wait(0.05)
	until now() >= deadline
	return false
end

local function formatMoney(value)
	if type(value) ~= "number" then
		return "$0"
	end
	if value >= 1e15 then
		return string.format("$%.2fQa", value / 1e15)
	elseif value >= 1e12 then
		return string.format("$%.2fT", value / 1e12)
	elseif value >= 1e9 then
		return string.format("$%.2fB", value / 1e9)
	elseif value >= 1e6 then
		return string.format("$%.2fM", value / 1e6)
	elseif value >= 1e3 then
		return string.format("$%.1fK", value / 1e3)
	end
	return string.format("$%d", math.floor(value))
end

local function getCash()
	local value = LocalPlayer:GetAttribute("Cash")
	if type(value) == "number" then
		return value
	end
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	local money = leaderstats and leaderstats:FindFirstChild("Money/s")
	if money then
		local parsed = tonumber((tostring(money.Value):gsub("[^%d%.]", "")))
		if parsed then
			return parsed
		end
	end
	return 0
end

