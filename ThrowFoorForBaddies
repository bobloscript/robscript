local function sellUids(uids)
	if #uids == 0 or not R.SellSell then
		return 0
	end
	stopTraining()
	local position = partPosition(sellStall())
	if position then
		teleport(Vector3.new(position.X, position.Y + 3, position.Z + 6))
	end
	local ok, result = pcall(function()
		return R.SellSell:InvokeServer(uids)
	end)
	task.wait(0.3)
	if ok and type(result) == "number" and result > 0 then
		return result
	end
	return 0
end

local function sellSpare(keepFavorites)
	local uids = {}
	for _, baddie in ipairs(sellableExtras()) do
		if not (keepFavorites and baddie.favorite) then
			table.insert(uids, baddie.uid)
		end
	end
	if #uids == 0 then
		return 0, 0
	end
	return #uids, sellUids(uids)
end

