local function trainSlice(seconds)
	if not R.PullUpStart then
		return false
	end
	local position = partPosition(pullUpRing())
	if position then
		teleport(Vector3.new(position.X, position.Y + 3.2, position.Z))
	else
		local barPosition = partPosition(station("PullUp"))
		if barPosition then
			teleport(Vector3.new(barPosition.X, barPosition.Y + 3.2, barPosition.Z + 4))
		end
	end
	pcall(function()
		R.PullUpStart:FireServer()
	end)
	if not waitUntil(function()
		return training()
	end, 2) then
		return false
	end
	local deadline = now() + (seconds or TRAIN_CHUNK)
	while now() < deadline and RUNNING do
		task.wait(0.2)
		if not training() then
			break
		end
	end
	if R.PullUpStop then
		pcall(function()
			R.PullUpStop:FireServer()
		end)
	end
	waitUntil(function()
		return not training()
	end, 2)
	return true
end

----- Throw -----

local CATCH = {
	count = 0,
	last = nil,
}

local function inventoryCount()
	local inventory = LocalPlayer:FindFirstChild("BaddieInventory")
	return inventory and #inventory:GetChildren() or 0
end

local function beginThrow()
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return R.ThrowBegin:InvokeServer(false)
		end)
		if ok and type(result) == "table" and type(result.MeterStart) == "number" then
			return result
		end
		task.wait(0.25)
	end
	return nil
end

local function tapAtPeak(meterStart)
	local target = meterStart + METER_PEAK
	local serverNow = Workspace:GetServerTimeNow()
	while target <= serverNow + 0.02 do
		target += METER_PERIOD
	end
	local deadline = now() + (target - serverNow) + 1
	while RUNNING do
		local remaining = target - Workspace:GetServerTimeNow()
		if remaining <= 0.003 or now() > deadline then
			break
		end
		task.wait(math.min(remaining * 0.5, 0.05))
	end
	local tapTime = Workspace:GetServerTimeNow()
	if tapTime > target + 0.02 then
		tapTime = target
	end
	local ok, result = pcall(function()
		return R.ThrowTap:InvokeServer(tapTime, false)
	end)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local function throwOnce()
	local zone = throwZone()
	if not zone then
		return false, "no throw zone"
	end
	stopTraining()
	if throwing() then
		if R.ThrowFinish then
			pcall(function()
				R.ThrowFinish:FireServer()
			end)
		end
		waitUntil(function()
			return not throwing()
		end, 2)
	end
	if heldBaddie() then
		return false, "baddie in hand"
	end

	teleport(zone.CFrame.Position)
	local session = beginThrow()
	if not session then
		return false, "throw did not start"
	end

	local before = inventoryCount()
	local result = tapAtPeak(session.MeterStart)
	if R.ThrowFinish then
		pcall(function()
			R.ThrowFinish:FireServer()
		end)
	end
	if not result then
		waitUntil(function()
			return not throwing()
		end, 2)
		return false, "tap failed"
	end

	waitUntil(function()
		return inventoryCount() > before or countPending() > 0 or heldBaddie() ~= nil
	end, CATCH_TIMEOUT)
	waitUntil(function()
		return not throwing()
	end, 2)

	local reward = result.Reward
	if type(reward) == "table" then
		CATCH.count += 1
		CATCH.last = {
			id = tostring(reward.Id or "?"),
			income = reward.Income or 0,
			mutation = tostring(reward.Mutation or "None"),
			oneIn = reward.OneIn,
			size = tostring(reward.Size or "Normal"),
			good = reward.Good == true,
			new = reward.New == true,
		}
		if CATCH.last.good or CATCH.last.new or CATCH.last.mutation ~= "None" then
			local name = CATCH.last.id
			if CATCH.last.mutation ~= "None" then
				name = CATCH.last.mutation .. " " .. name
			end
			if type(CATCH.last.oneIn) == "number" then
				name = name .. string.format(" (1 in %d)", CATCH.last.oneIn)
			end
			log(string.format("Caught %s", name))
		end
	end
	return true, result
end

