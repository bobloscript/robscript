	PullUpBoostClaim = { "PullUp", "BoostClaim" },
	NotifyShow = { "Notify", "Show" },
}

local R = {}

local function resolveRemotes()
	for key, path in pairs(REMOTE_PATHS) do
		local folder = ReplicatedStorage:FindFirstChild(path[1])
		if not folder then
			local ok, result = pcall(function()
				return ReplicatedStorage:WaitForChild(path[1], 6)
			end)
			folder = ok and result or nil
		end
		local remote = folder and folder:FindFirstChild(path[2])
		if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
			R[key] = remote
		else
			R[key] = nil
		end
	end
end

resolveRemotes()

