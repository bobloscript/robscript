	local cash = getCash()
	local owned = foodsOwnedSet()
	local best = nil
	for _, food in ipairs(foodEntries()) do
		if not food.Exclusive and type(food.Price) == "number" and food.Price > 0 and food.Price <= cash and not owned[food.Id] then
			if not best or (food.Tier or 0) > (best.Tier or 0) then
				best = food
			end
		end
	end
	return best
end

local function bestOwnedFood()
	local owned = foodsOwnedSet()
	local best = nil
	for _, food in ipairs(foodEntries()) do
		if owned[food.Id] and not food.Exclusive then
			if not best or (food.Tier or 0) > (best.Tier or 0) then
				best = food
			end
		end
	end
	return best
end

