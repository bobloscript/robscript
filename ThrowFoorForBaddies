----- Flag access -----

function flagValue(name, fallback)
	local handle = Airflow.Flags[name]
	if not handle then
		return fallback
	end
	local ok, value = pcall(function()
		if type(handle.Get) == "function" then
			return handle:Get()
		end
		return handle.Value
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

function masterOn()
	return flagValue("AutoFarm", false) == true
end

local function on(name, fallback)
	if not masterOn() then
		return false
	end
	return flagValue(name, fallback) == true
end

----- Rotation helpers -----

local function rotationOn()
	return flagValue("Rotation", false) == true
end

local function rotationDuration(phase)
	if phase == "Bar" then
		return flagValue("BarTime", 60)
	end
	return flagValue("ThrowTime", 120)
end

local function rotationStart()
	ROT.active = true
	ROT.phase = flagValue("RotationStart", "Throw") == "Bar" and "Bar" or "Throw"
	ROT.startedAt = now()
	ROT.endsAt = ROT.startedAt + rotationDuration(ROT.phase)
end

local function rotationRecompute()
	if not ROT.active then
		return
	end
	ROT.endsAt = ROT.startedAt + rotationDuration(ROT.phase)
end

local function rotationReset()
	ROT.active = false
	ROT.phase = "Throw"
	ROT.endsAt = 0
end

local function phaseLabel()
	if rotationOn() and ROT.active then
		return ROT.phase == "Bar" and "<Warning>Bar</Warning>" or "<Success>Throw</Success>"
	end
	if flagValue("AutoThrow", true) then
		return "<Success>Throw</Success>"
	end
	return "<Muted>Idle</Muted>"
end

local function nextSwitchLabel()
	if not rotationOn() or not ROT.active then
		return "<Muted>Off</Muted>"
	end
	local left = math.max(0, math.floor(ROT.endsAt - now()))
	return string.format("%s <Muted>%d:%02d</Muted>", ROT.phase == "Bar" and "to throw" or "to bar", math.floor(left / 60), left % 60)
end

