----- Throw guard -----

function updateThrowGuard()
	if not RUNNING then
		return
	end
	local enabled = masterOn() and flagValue("AutoThrow", true) == true
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return
	end
	if enabled and not GUARD.gui then
		local existing = playerGui:FindFirstChild("WelcomeBackGui")
		if existing then
			GUARD.gui = existing
			GUARD.owned = #existing:GetChildren() == 0
		else
			local gui = Instance.new("ScreenGui")
			gui.Name = "WelcomeBackGui"
			gui.ResetOnSpawn = false
			gui.Enabled = false
			gui.Parent = playerGui
			GUARD.gui = gui
			GUARD.owned = true
		end
	elseif not enabled and GUARD.gui then
		if GUARD.owned or #GUARD.gui:GetChildren() == 0 then
			pcall(function()
				GUARD.gui:Destroy()
			end)
		end
		GUARD.gui = nil
		GUARD.owned = false
	end
end

----- Pipeline -----

function settlePen(forceSell)
	local placed = false
	local guard = 0
	while heldBaddie() and guard < 8 do
		guard += 1
		setDoing("Placing")
		if not placeHeld() then
			local worst = worstEquipped()
			if not worst or not R.PenUnequip then
				log("No room in the pen")
				break
			end
			pcall(function()
				R.PenUnequip:FireServer(worst.uid)
			end)
			task.wait(0.45)
			if not placeHeld() then
				log("No room in the pen")
				break
			end
		end
		placed = true
	end

	local spare = #sellableExtras()
	if spare > 0 and (forceSell or spare >= SPARE_BATCH) and flagValue("SellSpare", true) then
		setDoing("Selling")
		local count, earned = sellSpare(flagValue("KeepFavorites", true))
		if count > 0 and earned > 0 then
			log(string.format("Sold %d for %s", count, formatMoney(earned)))
		end
	end
	return placed
end

function housekeeping()
	local stamp = now()

	if on("AutoFruit", true) and stamp >= TIMERS.food then
		TIMERS.food = stamp + 6
		local food = bestAffordableFood()
		if food then
			setDoing("Buying fruit")
			if buyFood(food) then
				log(string.format("Fruit bought: %s", food.Name or food.Id))
			end
		else
			equipOwnedFood()
		end
	end

	if on("AutoUpgradePlot", true) and stamp >= TIMERS.plot then
		TIMERS.plot = stamp + 5
		setDoing("Upgrading")
		if upgradePlot() then
			log("Pen upgraded")
		end
	end

	if on("AutoUpgradeBar", true) and stamp >= TIMERS.bar then
		TIMERS.bar = stamp + 5
		setDoing("Upgrading")
		if upgradeBar() then
			log("Bar upgraded")
		end
	end

	if on("EquipBest", true) and stamp >= TIMERS.sweep then
		TIMERS.sweep = stamp + 20
		equipBest()
	end

	setDoing("Idle")
end

local function rotationTick()
	if not rotationOn() then
		ROT.active = false
		return
	end
	if not ROT.active then
		rotationStart()
		log(ROT.phase == "Bar" and "Rotation: bar phase" or "Rotation: throw phase")
	end
	if now() >= ROT.endsAt then
		if ROT.phase == "Throw" then
			settlePen(true)
		end
		ROT.phase = ROT.phase == "Throw" and "Bar" or "Throw"
		ROT.startedAt = now()
		ROT.endsAt = ROT.startedAt + rotationDuration(ROT.phase)
		stopTraining()
		log(ROT.phase == "Bar" and "Rotation: bar phase" or "Rotation: throw phase")
		if ROT.phase == "Bar" then
			housekeeping()
		end
	end
end

local function step()
	if not masterOn() then
		if DOING ~= "Idle" then
			setDoing("Idle")
		end
		task.wait(0.25)
		return
	end

	rotationTick()

	if rotationOn() and ROT.active and ROT.phase == "Bar" then
		if not on("AutoBar", true) then
			setDoing("Idle")
			task.wait(0.3)
			return
		end
		setDoing("Training")
		local slice = math.max(1, math.min(TRAIN_CHUNK, ROT.endsAt - now()))
		trainSlice(slice)
		return
	end

	if not rotationOn() and not flagValue("AutoThrow", true) and on("AutoBar", true) then
		setDoing("Training")
		trainSlice(math.min(TRAIN_CHUNK, flagValue("TrainTime", 60)))
		return
	end

	if on("AutoPlace", true) then
		if settlePen(false) then
			setDoing("Idle")
			return
		end
	elseif heldBaddie() then
		if now() - TIMERS.hint > 30 then
			TIMERS.hint = now()
			log("<Warning>Baddie in hand, Auto place is off</Warning>")
		end
		setDoing("Idle")
		task.wait(0.4)
		return
	end

	housekeeping()

	if flagValue("AutoThrow", true) then
		setDoing("Throwing")
		local ok, reason = throwOnce()
		if not ok then
			if reason ~= "baddie in hand" then
				log("Throw failed, retrying")
			end
			setDoing("Idle")
			task.wait(0.5)
		end
		return
	end

	setDoing("Idle")
	task.wait(0.25)
end

local function mainLoop()
	while RUNNING do
		local ok, err = pcall(step)
		if not ok then
			log("<Error>Error: " .. tostring(err) .. "</Error>")
			task.wait(1)
		end
		task.wait(0.05)
	end
end

----- Diagnostics -----

function diagnose()
	log("<Accent>Check my game</Accent>")
	log(string.format("placeId %d, version %s", game.PlaceId, VERSION))
	local missing = {}
	for key, path in pairs(REMOTE_PATHS) do
		if not R[key] then
			table.insert(missing, path[1] .. "/" .. path[2])
		end
	end
	if #missing == 0 then
		log("Remotes found")
	else
		log("<Warning>Remotes missing: " .. table.concat(missing, ", ") .. "</Warning>")
	end
	log(string.format("Throw zone %s", throwZone() and "ok" or "<Error>missing</Error>"))
	log(string.format("Pen %s, part %s", penModel() and penModel().Name or "<Error>missing</Error>", penPart() and "ok" or "<Error>missing</Error>"))
	log(string.format("Sell stall %s, bar prompt %s", sellStall() and "ok" or "<Error>missing</Error>", barPrompt() and "ok" or "<Error>missing</Error>"))
	log(string.format("Meter period %.2f s", METER_PERIOD))
	log(string.format("Cash %s, strength %d, level %d", formatMoney(getCash()), math.floor(LocalPlayer:GetAttribute("Strength") or 0), math.floor(LocalPlayer:GetAttribute("Level") or 0)))
	log(string.format("Pen tier %d (%s), slots %d, bar level %d", penTier(), penTierName(), penSlotCount(), math.floor(LocalPlayer:GetAttribute("BarLevel") or 0)))
	log(string.format("Baddies %d, equipped %d, spare %d, pending %d", #baddieList(), countEquipped(), select(1, spareCounts()), countPending()))
	log(string.format("Master %s, rotation %s (%s)", tostring(masterOn()), tostring(rotationOn()), ROT.phase))
end

----- Anti AFK -----

local function startBoostWatcher()
	if not R.PullUpBoostOffer or not R.PullUpBoostClaim then
		return
	end
	track(R.PullUpBoostOffer.OnClientEvent:Connect(function(token)
		if not RUNNING or not flagValue("ClaimBoosts", true) then
			return
		end
		task.delay(0.12, function()
			if RUNNING and training() and R.PullUpBoostClaim then
				pcall(function()
					R.PullUpBoostClaim:FireServer(token)
				end)
			end
		end)
	end))
end

local function startAntiAfk()
	if not VirtualUser then
		return
	end
	track(LocalPlayer.Idled:Connect(function()
		if not RUNNING or not flagValue("StayInGame", true) then
			return
		end
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
	end))
end

----- Lifecycle -----

function destroy()
	RUNNING = false
	pcall(function()
		stopTraining()
	end)
	if GUARD.gui and (GUARD.owned or #GUARD.gui:GetChildren() == 0) then
		pcall(function()
			GUARD.gui:Destroy()
		end)
	end
	GUARD.gui = nil
	GUARD.owned = false
	for _, connection in ipairs(CONNECTIONS) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(CONNECTIONS)
	pcall(function()
		Window:Destroy()
	end)
	local genv = getgenv and getgenv() or _G
	if genv.RobScriptTFFB then
		genv.RobScriptTFFB = nil
	end
end

local genv = getgenv and getgenv() or _G
genv.RobScriptTFFB = {
	Version = VERSION,
	Destroy = destroy,
	Toggle = function()
		Window:Toggle()
	end,
	Check = function()
		diagnose()
	end,
	SellNow = function()
		return sellSpare(flagValue("KeepFavorites", true))
	end,
	Get = function(name)
		return flagValue(name, nil)
	end,
	Set = function(name, value)
		local handle = Airflow.Flags[name]
		if handle then
			handle:Set(value)
			return true
		end
		return false
	end,
}

