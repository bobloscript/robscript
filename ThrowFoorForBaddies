----- Baddies -----

local function baddieList()
	local list = {}
	local inventory = LocalPlayer:FindFirstChild("BaddieInventory")
	if not inventory then
		return list
	end
	for _, child in ipairs(inventory:GetChildren()) do
		if child:IsA("Folder") then
			table.insert(list, {
				uid = child.Name,
				id = child:GetAttribute("BaddieId") or "?",
				income = child:GetAttribute("Income") or 0,
				equipped = child:GetAttribute("Equipped") == true,
				pending = child:GetAttribute("Pending") == true,
				favorite = child:GetAttribute("Favorite") == true,
				mutation = child:GetAttribute("Mutation") or "None",
				size = child:GetAttribute("Size") or "Normal",
			})
		end
	end
	return list
end

local function countEquipped(list)
	local total = 0
	for _, baddie in ipairs(list or baddieList()) do
		if baddie.equipped then
			total += 1
		end
	end
	return total
end

local function countPending(list)
	local total = 0
	for _, baddie in ipairs(list or baddieList()) do
		if baddie.pending then
			total += 1
		end
	end
	return total
end

local function penTier()
	return LocalPlayer:GetAttribute("PenTier") or 0
end

local function penSlotCount()
	local tier = math.clamp(penTier(), 0, PEN_MAX_TIER)
	local config = getConfig("PenConfig")
	if config and type(config.Slots) == "function" then
		local ok, value = pcall(config.Slots, tier)
		if ok and type(value) == "number" then
			return value
		end
	end
	return PEN_BASE_SLOTS + PEN_SLOTS_PER_TIER * tier
end

local function penTierName()
	local config = getConfig("PenConfig")
	local names = config and config.TierNames
	local index = math.clamp(penTier(), 0, PEN_MAX_TIER)
	if type(names) == "table" and (names[index + 1] or names[index]) then
		return names[index + 1] or names[index]
	end
	return "Pen " .. tostring(index)
end

local function worstEquipped(list)
	local worst = nil
	for _, baddie in ipairs(list or baddieList()) do
		if baddie.equipped and not baddie.pending then
			if not worst or baddie.income < worst.income then
				worst = baddie
			end
		end
	end
	return worst
end

local function sellableExtras(list)
	local result = {}
	for _, baddie in ipairs(list or baddieList()) do
		if not baddie.equipped and not baddie.pending then
			table.insert(result, baddie)
		end
	end
	table.sort(result, function(a, b)
		return a.income < b.income
	end)
	return result
end

local function spareCounts()
	local total, favorites = 0, 0
	for _, baddie in ipairs(sellableExtras()) do
		total += 1
		if baddie.favorite then
			favorites += 1
		end
	end
	return total, favorites
end

----- Pen placement -----

local function penWorldPosition(localOffset)
	local pen = penPart()
	if not pen then
		return nil
	end
	local world = pen.CFrame * CFrame.new(localOffset.X, 0, localOffset.Y)
	return Vector3.new(world.X, pen.Position.Y - 0.2, world.Z)
end

local function freePenPosition()
	local pen = penPart()
	if not pen then
		return nil
	end
	local halfX = math.max(5, pen.Size.X / 2 - 3)
	local halfZ = math.max(5, pen.Size.Z / 2 - 3)

	local taken = {}
	local penBaddies = Workspace:FindFirstChild("PenBaddies")
	if penBaddies then
		for _, model in ipairs(penBaddies:GetChildren()) do
			local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local relative = pen.CFrame:PointToObjectSpace(part.Position)
				if math.abs(relative.X) <= halfX + 2 and math.abs(relative.Z) <= halfZ + 2 then
					table.insert(taken, Vector2.new(relative.X, relative.Z))
				end
			end
		end
	end

	local candidates = {}
	local step = 5
	local x = -halfX
	while x <= halfX do
		local z = -halfZ
		while z <= halfZ do
			table.insert(candidates, Vector2.new(x, z))
			z += step
		end
		x += step
	end
	table.sort(candidates, function(a, b)
		return a.Magnitude < b.Magnitude
	end)

	for _, candidate in ipairs(candidates) do
		local isFree = true
		for _, point in ipairs(taken) do
			if (point - candidate).Magnitude < 3.8 then
				isFree = false
				break
			end
		end
		if isFree then
			return penWorldPosition(candidate)
		end
	end

	return nil
end

local function placeHeld()
	if not heldBaddie() then
		return false
	end
	if countEquipped() >= penSlotCount() then
		return false
	end
	local position = freePenPosition()
	if not position or not R.PenPlace then
		return false
	end
	pcall(function()
		R.PenPlace:FireServer(position)
	end)
	task.wait(0.45)
	return true
end

