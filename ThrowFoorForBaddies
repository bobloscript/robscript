local CONFIG_CACHE = {}

local function getConfig(name)
	if CONFIG_CACHE[name] ~= nil then
		return CONFIG_CACHE[name] or nil
	end
	local system = ReplicatedStorage:FindFirstChild("BaddieSystem")
	local module = system and system:FindFirstChild(name)
	if not module then
		CONFIG_CACHE[name] = false
		return nil
	end
	local ok, value = pcall(require, module)
	CONFIG_CACHE[name] = (ok and type(value) == "table") and value or false
	return CONFIG_CACHE[name] or nil
end

local function applyThrowConfig()
	local folder = ReplicatedStorage:FindFirstChild("ThrowCinematic")
	local module = folder and folder:FindFirstChild("ThrowConfig")
	if not module then
		return
	end
	local ok, config = pcall(require, module)
	if ok and type(config) == "table" and type(config.MeterPeriod) == "number" and config.MeterPeriod > 0.2 then
		METER_PERIOD = config.MeterPeriod
		METER_PEAK = METER_PERIOD / 2
	end
end

