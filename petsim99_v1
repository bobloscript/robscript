----- Guards: diamonds / bars -----
local lastSpendWarn = 0
local diamondNotifiedAt = 0

local function pushWarning(text)
    if Log then
        pcall(function()
            Log:Push("<Warning>" .. text .. "</Warning>")
        end)
    end
end

local function notify(title, content, kind)
    pcall(function()
        Window:Notify({ Title = title, Content = content, Type = kind or "Info", Time = 6 })
    end)
end

local function registerDiamondSpend(amount, reason)
    if amount <= 0 then
        return
    end
    S.sessionSpent += amount
    if not S.allowDiamonds then
        S.diamondBreach = true
        pushWarning(string.format("Списано %d алмазов (%s) при выключенной защите", amount, tostring(reason)))
        if os.clock() - diamondNotifiedAt > 30 then
            diamondNotifiedAt = os.clock()
            notify("PS99 Hub", T("notif_diamond"), "Error")
        end
    elseif S.minDiamonds > 0 and diamonds() < S.minDiamonds then
        pushWarning(string.format("Баланс алмазов ниже минимума (%d)", S.minDiamonds))
    end
    if S.maxSpend > 0 and S.sessionSpent > S.maxSpend then
        pushWarning(string.format("Бюджет алмазов за сессию превышен: %d / %d", S.sessionSpent, S.maxSpend))
    end
end

local function canSpendDiamonds(amount, reason)
    if not S.allowDiamonds then
        if S.diamondWarn and os.clock() - lastSpendWarn > 8 then
            lastSpendWarn = os.clock()
            pushWarning("Трата алмазов заблокирована: " .. T("allow_diamonds") .. " выключено (" .. tostring(reason) .. ")")
        end
        return false
    end
    local balance = diamonds()
    if amount > 0 and balance - amount < S.minDiamonds then
        if S.diamondWarn then
            pushWarning(string.format("Не хочу опускать алмазы ниже %d (сейчас %d)", S.minDiamonds, balance))
        end
        return false
    end
    if S.maxSpend > 0 and S.sessionSpent + amount > S.maxSpend then
        if S.diamondWarn then
            pushWarning(string.format("Бюджет сессии: %d из %d уже потрачено", S.sessionSpent, S.maxSpend))
        end
        return false
    end
    return true
end

local function guardedInvoke(name, ...)
    local before = diamonds()
    local result = invoke(name, ...)
    local after = diamonds()
    if after < before then
        registerDiamondSpend(before - after, name)
    end
    return result
end

----- Breakables -----
local breakablesCache = {}
local breakablesAt = 0

local function breakableValue(identifier)
    local text = tostring(identifier):lower()
    if text:find("huge") or text:find("giant") then
        return 110
    end
    if text:find("vault") then
        return 100
    end
    if text:find("diamond") then
        return 95
    end
    if text:find("safe") then
        return 90
    end
    if text:find("chest") then
        return 85
    end
    if text:find("lucky") then
        return 80
    end
    if text:find("crate") then
        return 70
    end
    if text:find("present") then
        return 65
    end
    if text:find("barrel") then
        return 40
    end
    return 30
end

local function getBreakables()
    if os.clock() - breakablesAt < 0.8 then
        return breakablesCache
    end
    breakablesAt = os.clock()
    local list = {}
    local container = Things:FindFirstChild("Breakables")
    if not container then
        breakablesCache = list
        return list
    end
    for _, model in ipairs(container:GetChildren()) do
        if model:IsA("Model") then
            local part = model:FindFirstChildWhichIsA("BasePart")
            if part then
                list[#list + 1] = {
                    model = model,
                    part = part,
                    area = model:GetAttribute("AreaID") or "",
                    zone = model:GetAttribute("ParentID") or "",
                    id = model:GetAttribute("BreakableID") or "",
                    class = model:GetAttribute("BreakableClass") or "",
                }
            end
        end
    end
    breakablesCache = list
    return list
end

local function areaAllowed(area)
    if area == "VIP" and not S.allowVIP then
        return false
    end
    return true
end

local function targetScore(entry, rootPosition, mode)
    local distance = (entry.part.Position - rootPosition).Magnitude
    if mode == "Diamonds" then
        if not tostring(entry.id):lower():find("diamond") then
            return nil
        end
        if S.diamondAreas == "Main" and entry.area ~= "Main" then
            return nil
        elseif S.diamondAreas == "Easy" and entry.area ~= "Easy" then
            return nil
        end
        return 1e6 - distance
    elseif mode == "Chests" then
        local text = tostring(entry.id):lower()
        if not (text:find("chest") or text:find("safe") or text:find("vault")) then
            return nil
        end
        return 1e6 - distance
    elseif mode == "Best value" then
        return breakableValue(entry.id) * 100 - distance
    end
    return -distance
end

local function pickTarget(rootPosition)
    local best, bestScore
    for _, entry in ipairs(getBreakables()) do
        if areaAllowed(entry.area) then
            local score = targetScore(entry, rootPosition, S.target)
            if score and (not bestScore or score > bestScore) then
                best, bestScore = entry, score
            end
        end
    end
    return best
end

----- Zones -----
local zoneListCache = { at = 0, list = {}, byName = {} }
local zoneMetaCache = { at = 0, byNumber = {} }

local function cleanZoneName(name)
    return (tostring(name):gsub("^%d+%s*|%s*", ""))
end

local function zoneList()
    if os.clock() - zoneListCache.at < 30 and #zoneListCache.list > 0 then
        return zoneListCache.list
    end
    local list, byName = {}, {}
    local map = Workspace:FindFirstChild("Map")
    if map then
        for _, folder in ipairs(map:GetChildren()) do
            local number = tonumber(tostring(folder.Name):match("^(%d+)"))
            if number then
                local persistent = folder:FindFirstChild("PERSISTENT")
                local teleport = persistent and persistent:FindFirstChild("Teleport")
                local anchor = teleport and teleport.Position
                if not anchor then
                    local parts = folder:FindFirstChild("PARTS", true)
                    local part = parts and parts:FindFirstChildWhichIsA("BasePart", true)
                    anchor = part and part.Position
                end
                local center
                local parts = folder:FindFirstChild("PARTS")
                if parts then
                    local sum, count = Vector3.zero, 0
                    for _, object in ipairs(parts:GetDescendants()) do
                        if object:IsA("BasePart") then
                            sum += object.Position
                            count += 1
                        end
                    end
                    if count > 0 then
                        center = sum / count
                    end
                end
                local entry = {
                    folder = folder,
                    number = number,
                    name = folder.Name,
                    clean = cleanZoneName(folder.Name),
                    anchor = anchor,
                    center = center,
                }
                list[#list + 1] = entry
                byName[folder.Name] = entry
            end
        end
    end
    table.sort(list, function(a, b)
        return a.number < b.number
    end)
    zoneListCache = { at = os.clock(), list = list, byName = byName }
    return list
end

local function zoneMeta()
    if os.clock() - zoneMetaCache.at < 60 and next(zoneMetaCache.byNumber) then
        return zoneMetaCache.byNumber
    end
    local byNumber = {}
    local worlds = Directory:FindFirstChild("Zones")
    if worlds then
        for _, world in ipairs(worlds:GetChildren()) do
            for _, module in ipairs(world:GetChildren()) do
                local number = tonumber(tostring(module.Name):match("^(%d+)"))
                if number and not byNumber[number] then
                    local ok, data = pcall(require, module)
                    if ok and type(data) == "table" then
                        byNumber[number] = {
                            maxEgg = data.MaximumAvailableEgg,
                            name = data.ZoneName,
                        }
                    end
                end
            end
        end
    end
    zoneMetaCache = { at = os.clock(), byNumber = byNumber }
    return byNumber
end

local function currentZoneInfo()
    local _, _, root = getCharacter()
    if not root then
        return nil
    end
    local best, bestDistance
    for _, zone in ipairs(zoneList()) do
        if zone.anchor then
            local distance = (zone.anchor - root.Position).Magnitude
            if not bestDistance or distance < bestDistance then
                best, bestDistance = zone, distance
            end
        end
    end
    if not best then
        return nil
    end
    return { name = best.name, number = best.number, clean = best.clean }
end

local function currentWorld()
    local zone = currentZoneInfo()
    if not zone then
        return "World 1"
    end
    local worlds = Directory:FindFirstChild("Zones")
    if not worlds then
        return "World 1"
    end
    for _, world in ipairs(worlds:GetChildren()) do
        for _, module in ipairs(world:GetChildren()) do
            local number = tonumber(tostring(module.Name):match("^(%d+)"))
            if number == zone.number then
                return world.Name
            end
        end
    end
    return "World 1"
end

local readCapsules -- defined in the Eggs section below

local function maxUnlockedEggTier()
    local maxTier = S.unlockedEggTier or 0
    for tier, capsule in pairs(readCapsules()) do
        if not capsule.locked and capsule.price and tier > maxTier then
            maxTier = tier
        end
    end
    S.unlockedEggTier = maxTier
    return maxTier
end

local function bestZone()
    local list = zoneList()
    if S.farmZone ~= "Auto" then
        local selected = zoneListCache.byName[S.farmZone]
        if selected then
            return selected
        end
    end
    if S.zoneLock and os.clock() - S.zoneLock.at < 600 then
        local locked = zoneListCache.byName[S.zoneLock.name]
        if locked then
            return locked
        end
    end
    local meta = zoneMeta()
    local limit = maxUnlockedEggTier()
    if limit > 0 then
        for index = #list, 1, -1 do
            local zone = list[index]
            local info = meta[zone.number]
            local slow = S.zoneSlow[zone.number]
            if info and info.maxEgg and info.maxEgg <= limit and zone.anchor
                and not (slow and os.clock() - slow < 600) then
                return zone
            end
        end
    end
    -- No data yet: use the highest zone with loaded breakables.
    local loaded = {}
    for _, entry in ipairs(getBreakables()) do
        loaded[entry.zone] = true
    end
    local best
    for _, zone in ipairs(list) do
        if loaded[zone.clean] then
            best = zone
        end
    end
    return best or list[1]
end

local function snapshotZoneBreakables(cleanName)
    local set, count = {}, 0
    for _, entry in ipairs(getBreakables()) do
        if entry.zone == cleanName then
            set[entry.model.Name] = true
            count += 1
        end
    end
    return set, count
end

local function countZoneDestroyed(set, cleanName)
    local current = {}
    for _, entry in ipairs(getBreakables()) do
        if entry.zone == cleanName then
            current[entry.model.Name] = true
        end
    end
    local gone = 0
    for uid in pairs(set) do
        if not current[uid] then
            gone += 1
        end
    end
    return gone
end

-- "Best zone" = the highest zone whose egg tier is already unlocked, not the
-- closest one. Every Map zone keeps a PERSISTENT.Teleport anchor, so the whole
-- world can be parsed without waiting for streaming. If the pets cannot break
-- the zone in 12 seconds, the zone is marked "too tough" and the hub steps down.
local function bestLocation()
    local _, _, root = getCharacter()
    if not root then
        return nil
    end
    local zone = bestZone()
    if not zone then
        return nil
    end
    local order
    if S.area == "Main" then
        order = { "Main" }
    elseif S.area == "Easy" then
        order = { "Easy" }
    elseif S.area == "VIP" then
        order = { "VIP" }
    else
        order = { "Main", "Easy" }
    end
    if (S.area == "Auto" or S.area == "VIP") and S.allowVIP then
        order[#order + 1] = "VIP"
    end
    for _, area in ipairs(order) do
        local nearest, nearestDistance
        for _, entry in ipairs(getBreakables()) do
            if entry.zone == zone.clean and entry.area == area then
                local distance = (entry.part.Position - root.Position).Magnitude
                if not nearestDistance or distance < nearestDistance then
                    nearest, nearestDistance = entry, distance
                end
            end
        end
        if nearest then
            return {
                zone = zone,
                zoneName = zone.name,
                name = zone.clean .. " · " .. area,
                area = area,
                anchor = nearest.part.Position,
                distance = nearestDistance,
                target = nearest,
            }
        end
    end
    local fallback = zone.center or zone.anchor
    if fallback then
        return {
            zone = zone,
            zoneName = zone.name,
            name = zone.clean,
            area = "Main",
            anchor = fallback,
            pending = true,
        }
    end
end

local function gateOf(zone)
    local interact = zone.folder:FindFirstChild("INTERACT")
    local gate = interact and interact:FindFirstChild("Gate", true)
    if gate and gate:IsA("BasePart") then
        return gate
    end
end

local function nextBuyGate()
    for _, zone in ipairs(zoneList()) do
        local gate = gateOf(zone)
        local hud = gate and gate:FindFirstChild("GateHUD")
        if hud and hud.Enabled then
            return zone, gate, hud
        end
    end
end

local function buyNextLocation()
    local zone, gate, hud = nextBuyGate()
    if not zone then
        return false, "no gate"
    end
    local character = getCharacter()
    if not character then
        return false, "no character"
    end
    local _, _, root = getCharacter()
    local baseY = gate.Position.Y - gate.Size.Y / 2 + 4
    root.CFrame = CFrame.new(Vector3.new(gate.Position.X, baseY, gate.Position.Z + 12))
    task.wait(0.8)
    local buy = hud:FindFirstChild("Buy", true)
    if not buy then
        return false, "no buy button"
    end
    local ok, connections = pcall(function()
        return getconnections(buy.Activated)
    end)
    if not ok or not connections or #connections == 0 then
        return false, "button not wired"
    end
    for _, connection in ipairs(connections) do
        task.spawn(function()
            pcall(connection.Function)
        end)
    end
    task.wait(1.2)
    if hud.Enabled == false then
        return true, zone.name
    end
    return false, "need more currency"
end

----- Eggs -----
local eggCache = { names = {}, at = 0, world = "World 1" }
local capsuleCache = { list = {}, at = 0, station = nil }

local function eggNames()
    if os.clock() - eggCache.at < 10 and next(eggCache.names) then
        return eggCache.names
    end
    local names = {}
    local world = currentWorld()
    local rootFolder = Directory:FindFirstChild("Eggs")
    local zoneEggs = rootFolder and rootFolder:FindFirstChild("Zone Eggs")
    local worldFolder = zoneEggs and zoneEggs:FindFirstChild(world)
    if worldFolder then
        for _, update in ipairs(worldFolder:GetChildren()) do
            for _, egg in ipairs(update:GetChildren()) do
                local number = tonumber(tostring(egg.Name):match("^(%d+)"))
                if number then
                    names[number] = egg.Name
                end
            end
        end
    end
    eggCache = { names = names, at = os.clock(), world = world }
    return names
end

readCapsules = function()
    if os.clock() - capsuleCache.at < 2.5 and next(capsuleCache.list) then
        return capsuleCache.list, capsuleCache.station
    end
    local list = {}
    local station
    local model = Things:FindFirstChild("Eggs")
    local main = model and model:FindFirstChild("Main")
    local count, sum = 0, Vector3.zero
    if main then
        for _, capsule in ipairs(main:GetChildren()) do
            local tier = tonumber(tostring(capsule.Name):match("^(%d+)"))
            if tier then
                local part = capsule:FindFirstChildWhichIsA("BasePart", true)
                local hud = capsule:FindFirstChild("PriceHUD", true)
                local locked = false
                local prices = {}
                if hud then
                    local lockGui = hud:FindFirstChild("PriceHUDLocked", true)
                    if lockGui then
                        for _, node in ipairs(lockGui:GetDescendants()) do
                            if node:IsA("TextLabel") and node.Text == "Locked" and node.Visible then
                                locked = true
                            end
                        end
                    end
                    local container = hud:FindFirstChild("PriceHUD", true) or hud
                    for _, frame in ipairs(container:GetChildren()) do
                        if frame.Name == "Gold Coins" or frame.Name == "Gold Bars" or frame.Name == "Diamonds" then
                            local amount = frame:FindFirstChild("Amount")
                            if amount then
                                local text = amount:IsA("TextLabel") and amount.Text or hudLabel(amount)
                                prices[frame.Name] = shortNumber(text)
                            end
                        end
                    end
                end
                local currency, price
                if prices["Gold Coins"] and prices["Gold Coins"] > 0 then
                    currency, price = "Gold Coins", prices["Gold Coins"]
                elseif prices["Gold Bars"] and prices["Gold Bars"] > 0 then
                    currency, price = "Gold Bars", prices["Gold Bars"]
                elseif prices["Diamonds"] and prices["Diamonds"] > 0 then
                    currency, price = "Diamonds", prices["Diamonds"]
                end
                if part then
                    count += 1
                    sum += part.Position
                end
                list[tier] = {
                    tier = tier,
                    pos = part and part.Position,
                    locked = locked,
                    prices = prices,
                    price = price,
                    currency = currency,
                }
            end
        end
    end
    if count > 0 then
        station = sum / count
    else
        local zoneEggs = Things:FindFirstChild("ZoneEggs")
        local mainZone = zoneEggs and zoneEggs:FindFirstChild("Main")
        local part = mainZone and mainZone:FindFirstChildWhichIsA("BasePart", true)
        station = part and part.Position
    end
    capsuleCache = { list = list, at = os.clock(), station = station }
    return list, station
end

local function eggAtStation()
    local _, station = readCapsules()
    local _, _, root = getCharacter()
    if not station or not root then
        return false
    end
    return (root.Position - station).Magnitude < 55
end

local function capsulePayment(capsule)
    local prices = capsule.prices or {}
    if prices["Gold Coins"] and prices["Gold Coins"] > 0 and prices["Gold Coins"] <= coins() then
        return "Gold Coins", prices["Gold Coins"]
    end
    if prices["Gold Bars"] and prices["Gold Bars"] > 0 and S.allowBars and prices["Gold Bars"] <= goldBars() then
        return "Gold Bars", prices["Gold Bars"]
    end
    if prices["Diamonds"] and prices["Diamonds"] > 0 and S.allowDiamonds and prices["Diamonds"] <= diamonds() then
        return "Diamonds", prices["Diamonds"]
    end
    return nil
end

local function bestEgg()
    local capsules = readCapsules()
    if not next(capsules) then
        return nil
    end
    local best
    for tier, capsule in pairs(capsules) do
        if not capsule.locked and capsulePayment(capsule) then
            if not best or tier > best.tier then
                best = capsule
            end
        end
    end
    return best
end

local function chosenEgg()
    if S.eggChoice ~= "Best" then
        local tier = tonumber(tostring(S.eggChoice):match("^(%d+)"))
        if tier then
            local capsules = readCapsules()
            local capsule = capsules[tier]
            if capsule then
                return capsule
            end
            return { tier = tier, locked = false }
        end
    end
    return bestEgg()
end

local function eggDisplayName(tier)
    local names = eggNames()
    local name = names[tier]
    if not name then
        return tostring(tier)
    end
    return tostring(tier) .. " · " .. tostring(name):gsub("^%d+%s*|%s*", "")
end

local function hatchOne(capsule)
    if not capsule then
        return false, "no egg"
    end
    local names = eggNames()
    local name = names[capsule.tier]
    if not name then
        return false, "no name"
    end
    local payment, amount = capsulePayment(capsule)
    if not payment then
        local prices = capsule.prices or {}
        if prices["Gold Bars"] and not S.allowBars then
            return false, "bars locked"
        end
        if prices["Diamonds"] and not S.allowDiamonds then
            return false, "diamond guard"
        end
        if prices["Diamonds"] and not canSpendDiamonds(prices["Diamonds"], "egg") then
            return false, "diamond guard"
        end
        return false, "no coins"
    end
    if payment == "Diamonds" and not canSpendDiamonds(amount, "egg") then
        return false, "diamond guard"
    end
    S.hatchNow = { egg = name, state = "trying", at = os.clock() }
    local ok = guardedInvoke("Eggs_RequestPurchase", name, 1)
    if ok then
        S.hatchNow = { egg = name, state = "ok", at = os.clock() }
        S.sessionHatched += 1
        S.lastTier = capsule.tier
    else
        S.hatchNow = { egg = name, state = "refused", at = os.clock() }
    end
    return ok, name
end

----- Quests / rank -----
local QUEST_VERBS = {
    "Hatch", "Break", "Use", "Earn", "Collect", "Open", "Fish", "Dig",
    "Deal", "Spin", "Pop", "Claim", "Catch", "Defeat", "Upgrade",
}
local QUEST_BLOCKED = {
    "Stars", "Reward", "Claim", "Locked", "Level", "RANKUP", "Unlocked",
    "Complete", "Points", "Strength", "Re-Roll", "Rank ",
}

local function textHas(text, words)
    for _, word in ipairs(words) do
        if text:find(word, 1, true) then
            return true
        end
    end
    return false
end

local function parseQuests()
    local quests = {}
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local rankGui = gui and gui:FindFirstChild("Rank")
    if not rankGui then
        return quests
    end
    local seen = {}
    for _, node in ipairs(rankGui:GetDescendants()) do
        if node:IsA("TextLabel") then
            local text = node.Text
            if #text >= 8 and #text <= 70 and not seen[text] then
                if text:match("^%u") and textHas(text, QUEST_VERBS) and not textHas(text, QUEST_BLOCKED) then
                    seen[text] = true
                    quests[#quests + 1] = text
                end
            end
        end
    end
    return quests
end

local function rankInfo()
    local info = { name = "?", number = "?", rewards = nil, ready = false }
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local rankGui = gui and gui:FindFirstChild("Rank")
    if not rankGui then
        return info
    end
    for _, node in ipairs(rankGui:GetDescendants()) do
        if node:IsA("TextLabel") then
            local text = node.Text
            if node.Name == "Rank" then
                info.name = text
            elseif node.Name == "RankNum" then
                local number = text:match("Rank%s*(%d+)")
                if number then
                    info.number = number
                end
            elseif node.Name == "ProgressText" then
                local rewards = text:match("(%d+)%s*Rewards?%s*Left")
                if rewards then
                    info.rewards = tonumber(rewards)
                end
            end
            if text:find("RANKUP READY", 1, true) then
                info.ready = true
            end
        end
    end
    return info
end

local function questAction()
    local quests = parseQuests()
    if #quests == 0 then
        return nil
    end
    return quests[1]
end

