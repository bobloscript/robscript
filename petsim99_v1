    local _, _, root = getCharacter()
    local container = Things:FindFirstChild("Orbs")
    if not root or not container then
        return
    end
    local best, bestDistance
    for _, orb in ipairs(container:GetChildren()) do
        if orb:IsA("BasePart") and orb.Position.Y > -100 then
            local distance = (orb.Position - root.Position).Magnitude
            if not bestDistance or distance < bestDistance then
                best, bestDistance = orb, distance
            end
        end
    end
    if best and bestDistance < 400 then
        teleport(best.Position)
    end
end)

----- Auto tap: clicks the nearest breakable without moving the character -----
local lastTapAt = 0
addTask(0.05, function()
    if not S.autoTap or not S.farm then
        return
    end
    if S.respect and playerIsMoving() then
        return
    end
    local interval = math.clamp(tonumber(S.tapInterval) or 0.2, 0.05, 1)
    if os.clock() - lastTapAt < interval then
        return
    end
    local _, _, root = getCharacter()
    if not root then
        return
    end
    local nearest, nearestDistance
    for _, entry in ipairs(getBreakables()) do
        if entry.area ~= "VIP" or S.allowVIP then
            local distance = (entry.part.Position - root.Position).Magnitude
            if distance < 45 and (not nearestDistance or distance < nearestDistance) then
                nearest, nearestDistance = entry, distance
            end
        end
    end
    if not nearest then
        return
    end
    lastTapAt = os.clock()
    fire("Click")
    if type(fireclickdetector) == "function" then
        local detector = nearest.model:FindFirstChildWhichIsA("ClickDetector", true)
        if detector then
            -- Distance and click type matter: fireclickdetector(det, 0) is ignored by PS99.
            pcall(fireclickdetector, detector, 32, 1)
        end
    end
end)

