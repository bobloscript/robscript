----- Language -----
local function loadLanguage()
    local ok, data = pcall(function()
        if type(isfile) == "function" and isfile("PS99Hub/lang.txt") then
            return readfile("PS99Hub/lang.txt")
        end
    end)
    if ok and (data == "EN" or data == "RU") then
        return data
    end
    return "RU"
end

local function saveLanguage(value)
    pcall(function()
        if type(writefile) == "function" then
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("PS99Hub") then
                makefolder("PS99Hub")
            end
            writefile("PS99Hub/lang.txt", value)
        end
    end)
end

