    end,
})

local function eggPriceText()
    local capsule = chosenEgg()
    if not capsule then
        return "—"
    end
    if capsule.locked then
        return T("locked")
    end
    local parts = {}
    local prices = capsule.prices or {}
    for _, currency in ipairs({ "Gold Coins", "Gold Bars", "Diamonds" }) do
        local value = prices[currency]
        if value and value > 0 then
            parts[#parts + 1] = shortFormat(value) .. " " .. currency
        end
    end
    if #parts > 0 then
        return table.concat(parts, " / ")
    end
    if capsule.price then
        return shortFormat(capsule.price) .. " " .. tostring(capsule.currency)
    end
    return "?"
end

