local function T(key, ...)
    local value = (L[Lang] and L[Lang][key]) or L.ru[key] or key
    if select("#", ...) > 0 then
        local ok, formatted = pcall(string.format, value, ...)
        if ok then
            return formatted
        end
    end
    return value
end

