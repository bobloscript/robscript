----- Helpers: character / movement -----
local function getCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end
    return character, humanoid, root
end

local function playerIsMoving()
    return UserInputService:IsKeyDown(Enum.KeyCode.W)
        or UserInputService:IsKeyDown(Enum.KeyCode.A)
        or UserInputService:IsKeyDown(Enum.KeyCode.S)
        or UserInputService:IsKeyDown(Enum.KeyCode.D)
        or UserInputService:IsKeyDown(Enum.KeyCode.Space)
end

local currentTween
local function stopTween()
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)
        currentTween = nil
    end
end

local function teleport(position)
    local character, _, root = getCharacter()
    if not character then
        return false
    end
    stopTween()
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(position + Vector3.new(0, 6, 0))
    return true
end

local function tweenTeleport(position, duration)
    local character, _, root = getCharacter()
    if not character then
        return false
    end
    stopTween()
    currentTween = TweenService:Create(
        root,
        TweenInfo.new(duration or 0.35, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(position + Vector3.new(0, 6, 0)) }
    )
    currentTween:Play()
    return true
end

local walking = false
local walkTween

local function stopWalking()
    walking = false
    if walkTween then
        pcall(function()
            walkTween:Cancel()
        end)
        walkTween = nil
    end
end

-- PS99 resets Humanoid.MoveDirection every frame, so we glide along a path from
-- PathfindingService in short steps: it looks like walking and avoids walls.
local function walkTo(position)
    if walking then
        return false
    end
    local character, _, root = getCharacter()
    if not character then
        return false
    end
    walking = true
    task.spawn(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.5,
            AgentHeight = 5,
            AgentCanJump = true,
        })
        local ok = pcall(function()
            path:ComputeAsync(root.Position, position)
        end)
        local waypoints
        if ok and path.Status == Enum.PathStatus.Success then
            waypoints = path:GetWaypoints()
        else
            waypoints = { { Position = position } }
        end
        for _, waypoint in ipairs(waypoints) do
            if not walking or getgenv().__PS99Gen ~= GENERATION then
                break
            end
            local _, _, liveRoot = getCharacter()
            if not liveRoot then
                break
            end
            local distance = (waypoint.Position - liveRoot.Position).Magnitude
            if distance > 1.5 then
                local duration = math.clamp(distance / 38, 0.05, 30)
                walkTween = TweenService:Create(
                    liveRoot,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear),
                    { CFrame = CFrame.new(waypoint.Position + Vector3.new(0, 2, 0)) }
                )
                walkTween:Play()
                walkTween.Completed:Wait()
                walkTween = nil
            end
        end
        walking = false
    end)
    return true
end

local function travelTo(position)
    local _, _, root = getCharacter()
    if not root then
        return false
    end
    if S.movement == "Tween TP" then
        local distance = (position - root.Position).Magnitude
        return tweenTeleport(position, math.clamp(distance / 250, 0.4, 12))
    elseif S.movement == "Путь (Pathfinding)" or S.movement == "Pathfinding" then
        return walkTo(position)
    end
    return teleport(position)
end

local defaultWalkSpeed
local function restoreMovement()
    local character, humanoid, root = getCharacter()
    if not character then
        return
    end
    local body = root:FindFirstChild("PS99HubFly")
    if body then
        body:Destroy()
    end
    pcall(function()
        humanoid.PlatformStand = false
        humanoid.Sit = false
        humanoid.AutoRotate = true
    end)
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.PlatformStanding or state == Enum.HumanoidStateType.Physics then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    if defaultWalkSpeed then
        humanoid.WalkSpeed = defaultWalkSpeed
    end
    root.AssemblyLinearVelocity = Vector3.zero
    stopWalking()
    stopTween()
end

----- Helpers: remotes / numbers -----
local function invoke(name, ...)
    local remote = Network:FindFirstChild(name)
    if not remote or not remote:IsA("RemoteFunction") then
        return false
    end
    local args = table.pack(...)
    local ok, result = pcall(function()
        return remote:InvokeServer(table.unpack(args, 1, args.n))
    end)
    if not ok then
        return false
    end
    return result
end

local function fire(name, ...)
    local remote = Network:FindFirstChild(name)
    if not remote or not remote:IsA("RemoteEvent") then
        return false
    end
    local args = table.pack(...)
    pcall(function()
        remote:FireServer(table.unpack(args, 1, args.n))
    end)
    return true
end

local function shortNumber(value)
    local text = tostring(value or ""):gsub(",", "")
    local numberPart, suffix = text:match("^([%d%.]+)([kKmMbBtT]?)$")
    if not numberPart then
        return 0
    end
    local number = tonumber(numberPart) or 0
    suffix = suffix:lower()
    if suffix == "k" then
        number *= 1e3
    elseif suffix == "m" then
        number *= 1e6
    elseif suffix == "b" then
        number *= 1e9
    elseif suffix == "t" then
        number *= 1e12
    end
    return math.floor(number)
end

local function shortFormat(value)
    value = tonumber(value) or 0
    if value >= 1e12 then
        return string.format("%.2ft", value / 1e12)
    elseif value >= 1e9 then
        return string.format("%.2fb", value / 1e9)
    elseif value >= 1e6 then
        return string.format("%.2fm", value / 1e6)
    elseif value >= 1e3 then
        return string.format("%.1fk", value / 1e3)
    end
    return tostring(math.floor(value))
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then
        return string.format("%d:%02d:%02d", hours, minutes, secs)
    end
    return string.format("%02d:%02d", minutes, secs)
end

