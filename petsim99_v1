----- Scheduler -----
local tasks = {}

local function addTask(interval, callback)
    tasks[#tasks + 1] = { interval = interval, nextAt = 0, callback = callback }
end

local frameCount = 0
RunService.RenderStepped:Connect(function()
    frameCount += 1
end)

RunService.Heartbeat:Connect(function()
    if getgenv().__PS99Gen ~= GENERATION then
        return
    end
    local now = os.clock()
    for _, entry in ipairs(tasks) do
        if now >= entry.nextAt then
            entry.nextAt = now + entry.interval
            local ok, err = pcall(entry.callback)
            if not ok then
                warn("[PS99 Hub] task: " .. tostring(err))
            end
        end
    end
end)

