----- Farm loop -----
local lastTravelAt = 0

addTask(0.5, function()
    if not S.farm or S.hatchBusy then
        return
    end
    local _, humanoid, root = getCharacter()
    if not root then
        return
    end
    if S.respect and playerIsMoving() then
        setAction(T("act_pause"))
        return
    end
    if S.farmMode == "AFK" then
        local best = bestLocation()
        if not best then
            setAction(T("act_wait"))
            return
        end
        if not S.standPos or S.standZone ~= best.zone.number then
            S.standPos = best.anchor
            S.standZone = best.zone.number
            S.standEmptyAt = nil
            S.zoneCheck = nil
        end
        S.farmAnchor = S.standPos
        local distance = (root.Position - S.standPos).Magnitude
        local needTravel = distance > 40 or (best.pending and distance > 25)
        if needTravel and os.clock() - lastTravelAt > 6 then
            lastTravelAt = os.clock()
            setAction(string.format(T("act_zone_travel"), best.zoneName))
            travelTo(S.standPos)
        elseif not needTravel then
            setAction(string.format(T("act_zone"), best.zone.number, best.zone.clean, best.area))
            -- AFK means stand. Taps reach 85 studs; if nothing is near for 12 s,
            -- move to the next cluster instead of chasing every breakable.
            local hasNear = false
            for _, entry in ipairs(getBreakables()) do
                if entry.zone == best.zone.clean and (entry.part.Position - root.Position).Magnitude < 50 then
                    hasNear = true
                    break
                end
            end
            if hasNear then
                S.standEmptyAt = nil
            elseif not S.standEmptyAt then
                S.standEmptyAt = os.clock()
            elseif os.clock() - S.standEmptyAt > 12 then
                S.standPos = best.anchor
                S.standZone = best.zone.number
                S.standEmptyAt = nil
                lastTravelAt = os.clock()
                travelTo(S.standPos)
                setAction(string.format(T("act_zone_travel"), best.zoneName))
            end
            if S.farmZone == "Auto" and not S.zoneLock and not best.pending then
                local zone = best.zone
                if S.zoneCheck and S.zoneCheck.zone == zone.number and os.clock() - S.zoneCheck.at >= 12 then
                    if S.zoneCheck.count >= 5 then
                        local gone = countZoneDestroyed(S.zoneCheck.uids, zone.clean)
                        if gone >= 2 then
                            S.zoneLock = { name = zone.name, at = os.clock() }
                            pushWarning("Зона " .. zone.name .. " закреплена: " .. tostring(gone) .. " брейкаблов за 12 с")
                        else
                            S.zoneSlow[zone.number] = os.clock()
                            pushWarning("Зона " .. zone.name .. " слишком крепкая — ищу зону ниже")
                        end
                    end
                    S.zoneCheck = nil
                elseif not S.zoneCheck then
                    local uids, count = snapshotZoneBreakables(zone.clean)
                    S.zoneCheck = { zone = zone.number, at = os.clock(), uids = uids, count = count }
                end
            end
        end
    else
        local target = pickTarget(root.Position)
        if not target then
            setAction(T("act_wait"))
            return
        end
        setAction(T("act_target") .. ": " .. tostring(target.id) .. " · " .. tostring(target.area))
        if os.clock() - lastTravelAt > 0.35 then
            lastTravelAt = os.clock()
            teleport(target.part.Position)
        end
    end
end)

