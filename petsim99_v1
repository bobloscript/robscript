local perfData = { texture = {}, fx = {}, gui = {}, players = {} }

local function setTextures(enabled)
    if enabled then
        if #perfData.texture == 0 then
            for _, object in ipairs(Workspace:GetDescendants()) do
                if object:IsA("Decal") or object:IsA("Texture") then
                    perfData.texture[#perfData.texture + 1] = { object = object, value = object.Transparency }
                    object.Transparency = 1
                end
            end
        end
    else
        for _, entry in ipairs(perfData.texture) do
            if entry.object.Parent then
                entry.object.Transparency = entry.value
            end
        end
        perfData.texture = {}
    end
end

local function worldFxContainers()
    local list = {}
    for _, name in ipairs({ "VFX", "Effects", "RandomEvents" }) do
        local container = Things:FindFirstChild(name)
        if container then
            list[#list + 1] = container
        end
    end
    return list
end

local function setWorldFX(enabled)
    if enabled then
        if #perfData.fx == 0 then
            for _, container in ipairs(worldFxContainers()) do
                for _, object in ipairs(container:GetDescendants()) do
                    if object:IsA("BasePart") then
                        perfData.fx[#perfData.fx + 1] = { object = object, kind = "part", value = object.LocalTransparencyModifier }
                        object.LocalTransparencyModifier = 1
                    elseif object:IsA("ParticleEmitter") or object:IsA("Beam") or object:IsA("Trail") then
                        perfData.fx[#perfData.fx + 1] = { object = object, kind = "fx", value = object.Enabled }
                        object.Enabled = false
                    end
                end
            end
        end
    else
        for _, entry in ipairs(perfData.fx) do
            if entry.object.Parent then
                if entry.kind == "part" then
                    entry.object.LocalTransparencyModifier = entry.value
                else
                    entry.object.Enabled = entry.value
                end
            end
        end
        perfData.fx = {}
    end
end

local GUI_FX_NAMES = { "GUIFX Holder", "_FullscreenTestGui", "_DeviceTestGui", "ArrowHolder", "RandomDrops" }

local function setGuiFX(enabled)
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then
        return
    end
    if enabled then
        if #perfData.gui == 0 then
            for _, name in ipairs(GUI_FX_NAMES) do
                local object = gui:FindFirstChild(name)
                if object then
                    perfData.gui[#perfData.gui + 1] = { object = object, value = object.Enabled }
                    object.Enabled = false
                end
            end
        end
    else
        for _, entry in ipairs(perfData.gui) do
            if entry.object.Parent then
                entry.object.Enabled = entry.value
            end
        end
        perfData.gui = {}
    end
end

local function setPlayers(enabled)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, object in ipairs(player.Character:GetDescendants()) do
                if object:IsA("BasePart") then
                    object.LocalTransparencyModifier = enabled and 1 or 0
                end
            end
        end
    end
end

local function setPetsVisibility()
    local _, _, root = getCharacter()
    local container = Things:FindFirstChild("Pets")
    if not container or not root then
        return
    end
    for _, pet in ipairs(container:GetChildren()) do
        if pet:IsA("Model") then
            local part = pet:FindFirstChildWhichIsA("BasePart")
            if part then
                local near = (part.Position - root.Position).Magnitude < 60
                local hide = (near and S.ownPets) or (not near and S.otherPets)
                part.LocalTransparencyModifier = hide and 1 or 0
            end
        end
    end
end

