----- Hatch trip -----
local function hatchTrip(manual)
    if S.hatchBusy then
        return false, "busy"
    end
    S.hatchBusy = true
    task.spawn(function()
        local ok, err = pcall(function()
            local _, _, root = getCharacter()
            if not root then
                return
            end
            local returnPosition = (S.farm and S.farmAnchor) or root.Position
            local capsule = chosenEgg()
            local targetPosition = capsule and capsule.pos
            if not targetPosition then
                local _, station = readCapsules()
                targetPosition = station
            end
            if not targetPosition then
                -- The egg stand may be streamed out; its physical model still has a part.
                local eggModel = Things:FindFirstChild("Eggs")
                local main = eggModel and eggModel:FindFirstChild("Main")
                local part = main and main:FindFirstChildWhichIsA("BasePart", true)
                targetPosition = part and part.Position
            end
            if not targetPosition then
                setAction(T("act_egg_travel_fail"))
                return
            end
            local _, _, liveRoot = getCharacter()
            if not liveRoot then
                return
            end
            if (liveRoot.Position - targetPosition).Magnitude > 30 then
                setAction(T("act_hatch_go"))
                teleport(targetPosition)
                task.wait(1.6)
            end
            local _, _, afterRoot = getCharacter()
            if not afterRoot or (afterRoot.Position - targetPosition).Magnitude > 90 then
                setAction(T("act_egg_travel_fail"))
                return
            end
            capsuleCache.at = 0
            capsule = chosenEgg()
            if not capsule then
                setAction(T("act_no_eggs"))
                return
            end

            local amount = math.clamp(tonumber(S.hatchAmount) or 4, 1, 20)
            local successes = 0
            for index = 1, amount do
                if getgenv().__PS99Gen ~= GENERATION then
                    break
                end
                if playerIsMoving() then
                    setAction(T("act_pause"))
                    break
                end
                local egg = chosenEgg()
                if not egg then
                    setAction(T("act_no_eggs"))
                    break
                end
                setAction(string.format("%s: %s (%d/%d)", T("act_hatch"), eggDisplayName(egg.tier), index, amount))
                local success, info = hatchOne(egg)
                if success then
                    successes += 1
                elseif info == "bars locked" then
                    pushWarning(T("notif_no_bars"))
                    break
                elseif info == "diamond guard" then
                    break
                else
                    setAction(T("act_refused"))
                    pushWarning("Яйцо не открылось: проверь слоты питомцев или подожди кулдаун")
                    task.wait(5)
                    break
                end
                task.wait(2.2)
            end

            if S.farm and returnPosition then
                setAction(T("act_hatch_back"))
                teleport(returnPosition)
                task.wait(0.8)
            end
            if successes > 0 then
                setAction(string.format("%s: %d", T("notif_hatch_done"), successes))
            end
        end)
        if not ok then
            warn("[PS99 Hub] hatch trip: " .. tostring(err))
        end
        S.hatchBusy = false
    end)
    return true
end

