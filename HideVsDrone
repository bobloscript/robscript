----- Flags -----

-- Flags are cached after the interface is built, so a config load cannot
-- desync the runtime: every tick reads the same objects the user sees.
local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local function colorToHex(color)
	local red = math.floor(math.clamp(color.R, 0, 1) * 255 + 0.5)
	local green = math.floor(math.clamp(color.G, 0, 1) * 255 + 0.5)
	local blue = math.floor(math.clamp(color.B, 0, 1) * 255 + 0.5)
	return string.format("#%02X%02X%02X", red, green, blue)
end

-- Distance is measured from the camera by default, because a drone operator
-- looks at the map through a scriptable camera that is not on the character.
local function distanceOrigin()
	if flag("DistanceFrom", "Camera") == "Character" then
		local character = LocalPlayer.Character
		if character then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then
				return root.Position
			end
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function runtimeFolder()
	local runtime = workspace:FindFirstChild("Runtime")
	if runtime then
		return runtime:FindFirstChild("ActiveDrones")
	end
	return nil
end

local function roleOf(player)
	local role = player:GetAttribute("Role")
	if type(role) == "string" and role ~= "" then
		return role
	end
	return ROLE_SURVIVOR
end

local function isAlive(player)
	return player:GetAttribute("Alive") ~= false
end

