----- Runtime -----

resetFlagCache()

local collectAccumulator = 0
local visualAccumulator = 0

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	collectAccumulator = collectAccumulator + deltaTime
	visualAccumulator = visualAccumulator + deltaTime

	if collectAccumulator >= COLLECT_INTERVAL then
		collectAccumulator = 0
		pcall(collectTargets)
	end

	if visualAccumulator >= VISUAL_INTERVAL then
		visualAccumulator = 0
		for _, target in pairs(targets) do
			pcall(updateTarget, target)
		end
		updateStats()
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("PlayerESP", false)
			setFlag("DroneESP", false)
			clearAllTargets()
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	clearAllTargets()
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptHvD then
		getgenv().RobScriptHvD = nil
	end
end

----- Public interface -----

getgenv().RobScriptHvD = {
	Version = "1.0",
	Actions = {
		Refresh = collectTargets,
		Clear = clearAllTargets,
		Destroy = destroy,
	},
	GetStats = function()
		return { players = stats.players, drones = stats.drones }
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	GetTargets = function()
		local list = {}
		for model, target in pairs(targets) do
			local boxVisible = false
			if target.lines then
				for _, line in ipairs(target.lines) do
					if line and line.Visible then
						boxVisible = true
						break
					end
				end
			end
			list[#list + 1] = {
				name = (target.player and target.player.Name) or model.Name,
				kind = target.kind,
				visible = target.hasVisual,
				billboard = target.billboard ~= nil and target.billboard.Enabled or false,
				chams = target.highlight ~= nil,
				box = boxVisible,
				tracer = target.tracer ~= nil and target.tracer.Visible or false,
			}
		end
		return list
	end,
	Destroy = destroy,
}

