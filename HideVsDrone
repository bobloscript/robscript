----- Visual objects -----

local function releaseVisuals(target)
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	if target.billboard then
		pcall(function()
			target.billboard:Destroy()
		end)
		target.billboard = nil
		target.label = nil
	end
	if target.lines then
		for _, line in ipairs(target.lines) do
			pcall(function()
				line.Visible = false
				line:Remove()
			end)
		end
		target.lines = nil
	end
	if target.tracer then
		pcall(function()
			target.tracer.Visible = false
			target.tracer:Remove()
		end)
		target.tracer = nil
	end
	target.hasVisual = false
end

local function buildBillboard(part, offsetY)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromOffset(260, 44)
	billboard.StudsOffset = Vector3.new(0, offsetY, 0)
	billboard.Enabled = false

	local label = Instance.new("TextLabel")
	label.Name = "ESP_Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.RichText = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Bottom
	label.TextStrokeTransparency = 0.35
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = ""
	label.Parent = billboard

	billboard.Adornee = part
	billboard.Parent = part
	return billboard, label
end

local function buildHighlight(model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Chams"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0.1
	highlight.Parent = model
	return highlight
end

----- Target registry -----

local function resolveParts(target)
	local model = target.model
	if not model or not model.Parent then
		return false
	end
	if target.kind == "player" then
		target.root = model:FindFirstChild("HumanoidRootPart")
		target.focusPart = model:FindFirstChild("Head") or target.root
		target.humanoid = model:FindFirstChildOfClass("Humanoid")
	else
		target.root = model:FindFirstChild("Core") or model.PrimaryPart
		target.focusPart = target.root
		target.humanoid = nil
	end
	return target.root ~= nil and target.focusPart ~= nil
end

local function createTarget(kind, model, player)
	local target = {
		kind = kind,
		model = model,
		player = player,
		hasVisual = false,
		lastTextAt = 0,
	}
	if not resolveParts(target) then
		return nil
	end
	return target
end

local function dropTarget(model)
	local target = targets[model]
	if not target then
		return
	end
	releaseVisuals(target)
	targets[model] = nil
end

local function clearAllTargets()
	for model in pairs(targets) do
		dropTarget(model)
	end
	stats.players = 0
	stats.drones = 0
end

----- Collection -----

local function shouldTrackPlayer(player)
	if player == LocalPlayer then
		return false
	end
	if player:GetAttribute("DataReady") == false then
		return false
	end
	local role = roleOf(player)
	if role == ROLE_OPERATOR and not flag("ShowOperator", true) then
		return false
	end
	if role ~= ROLE_OPERATOR and not flag("ShowSurvivor", true) then
		return false
	end
	return true
end

local function collectPlayers(seen)
	if not flag("PlayerESP", true) then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if shouldTrackPlayer(player) then
			local character = player.Character
			if character and character.Parent then
				local target = targets[character]
				if not target then
					target = createTarget("player", character, player)
					if target then
						targets[character] = target
					end
				else
					target.player = player
				end
				if target then
					seen[character] = true
				end
			end
		end
	end
end

local function ignoreOwnDrone()
	return flag("IgnoreOwnDrone", true)
end

local function collectDrones(seen)
	if not flag("DroneESP", true) then
		return
	end
	local container = runtimeFolder()
	if not container then
		return
	end
	local localUserId = LocalPlayer.UserId
	for _, drone in ipairs(container:GetChildren()) do
		if drone:IsA("Model") then
			local ownerId = drone:GetAttribute("OwnerId")
			local ownDrone = ownerId == localUserId
			if not (ownDrone and ignoreOwnDrone()) then
				local target = targets[drone]
				if not target then
					target = createTarget("drone", drone, nil)
					if target then
						targets[drone] = target
					end
				end
				if target then
					seen[drone] = true
				end
			end
		end
	end
end

local function collectTargets()
	local seen = {}
	collectPlayers(seen)
	collectDrones(seen)
	for model in pairs(targets) do
		if not seen[model] then
			dropTarget(model)
		end
	end
end

----- Rendering -----

local function playerColor(player)
	if not isAlive(player) then
		return COLOR_DEAD
	end
	if roleOf(player) == ROLE_OPERATOR then
		return flag("OperatorColor", COLOR_OPERATOR)
	end
	return flag("SurvivorColor", COLOR_SURVIVOR)
end

local function droneColor(drone)
	if drone:GetAttribute("OwnerId") == LocalPlayer.UserId then
		return flag("OwnDroneColor", COLOR_OWN_DRONE)
	end
	return flag("DroneColor", COLOR_DRONE)
end

local function playerLabelText(target, distance)
	local player = target.player
	if not player then
		return ""
	end
	local parts = {}
	if flag("PlayerName", true) then
		parts[#parts + 1] = string.format('<font color="#FFFFFF">%s</font>', player.Name)
	end
	local details = {}
	if flag("PlayerRole", true) then
		details[#details + 1] = roleOf(player)
	end
	if flag("PlayerHealth", true) and target.humanoid then
		details[#details + 1] = string.format("%d HP", math.floor(target.humanoid.Health + 0.5))
	end
	if flag("PlayerDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	if not isAlive(player) then
		details[#details + 1] = "DEAD"
	end
	if #details > 0 then
		parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
	end
	return table.concat(parts, "\n")
end

local function droneLabelText(target, distance)
	local drone = target.model
	local parts = {}
	local droneId = drone:GetAttribute("DroneId")
	local title = string.format("Drone #%s", tostring(droneId or "?"))
	if drone.Name:match("^Spotter") then
		title = string.format("Spotter #%s", tostring(droneId or "?"))
	end
	if drone:GetAttribute("OwnerId") == LocalPlayer.UserId then
		title = title .. "  (YOU)"
	end
	parts[#parts + 1] = string.format('<font color="#FFFFFF">%s</font>', title)

	local details = {}
	if flag("DroneOwner", true) then
		local owner = Players:GetPlayerByUserId(drone:GetAttribute("OwnerId") or 0)
		details[#details + 1] = owner and owner.Name or "no pilot"
	end
	if flag("DroneHealth", true) then
		local health = drone:GetAttribute("Health")
		if typeof(health) == "number" then
			details[#details + 1] = string.format("%d HP", math.floor(health + 0.5))
		end
	end
	if flag("DroneDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	if #details > 0 then
		parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
	end
	return table.concat(parts, "\n")
end

local function updateChams(target, color, enabled)
	if not enabled then
		if target.highlight then
			pcall(function()
				target.highlight:Destroy()
			end)
			target.highlight = nil
		end
		return
	end
	if not target.highlight or not target.highlight.Parent then
		target.highlight = buildHighlight(target.model)
	end
	local highlight = target.highlight
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

local function updateBillboard(target, color, distance, visible)
	if not target.billboard or not target.billboard.Parent then
		local offsetY = target.kind == "player" and 2.6 or 1.6
		target.billboard, target.label = buildBillboard(target.focusPart, offsetY)
	end
	local billboard = target.billboard
	local renderDistance = flag("RenderDistance", 2500)
	billboard.MaxDistance = renderDistance
	billboard.Enabled = visible
	if not visible then
		return
	end
	local now = os.clock()
	if now - target.lastTextAt >= TEXT_INTERVAL then
		target.lastTextAt = now
		local text
		if target.kind == "player" then
			text = playerLabelText(target, distance)
		else
			text = droneLabelText(target, distance)
		end
		target.label.Text = text
	end
	target.label.TextColor3 = color
end

local function projectBox(center, size)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local half = size * 0.5
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local depthHits = 0
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				local world = center + Vector3.new(half.X * x, half.Y * y, half.Z * z)
				local screen = camera:WorldToViewportPoint(world)
				if screen.Z > 0 then
					depthHits = depthHits + 1
					minX = math.min(minX, screen.X)
					minY = math.min(minY, screen.Y)
					maxX = math.max(maxX, screen.X)
					maxY = math.max(maxY, screen.Y)
				end
			end
		end
	end
	if depthHits < 2 then
		return nil
	end
	return minX, minY, maxX, maxY
end

local function updateBox(target, color, visible)
	local boxFlag = target.kind == "player" and "PlayerBox" or "DroneBox"
	if not visible or not flag(boxFlag, false) then
		if target.lines then
			for _, line in ipairs(target.lines) do
				if line.Visible then
					line.Visible = false
				end
			end
		end
		return
	end

	local center, size
	if target.kind == "player" then
		center = target.root.Position
		size = PLAYER_BOX_SIZE
	else
		local ok, boxCenter, boxSize = pcall(function()
			local cf, sz = target.model:GetBoundingBox()
			return cf.Position, sz
		end)
		if not ok then
			return
		end
		center = boxCenter
		size = boxSize
	end

	local minX, minY, maxX, maxY = projectBox(center, size)
	if not minX then
		if target.lines then
			for _, line in ipairs(target.lines) do
				line.Visible = false
			end
		end
		return
	end

	if not target.lines then
		target.lines = { newLine(), newLine(), newLine(), newLine() }
	end
	local lines = target.lines
	if not lines[1] then
		return
	end

	local topLeft = Vector2.new(minX, minY)
	local topRight = Vector2.new(maxX, minY)
	local bottomLeft = Vector2.new(minX, maxY)
	local bottomRight = Vector2.new(maxX, maxY)

	local segments = {
		{ topLeft, topRight },
		{ topRight, bottomRight },
		{ bottomRight, bottomLeft },
		{ bottomLeft, topLeft },
	}
	for index = 1, 4 do
		local line = lines[index]
		if line then
			local segment = segments[index]
			line.From = segment[1]
			line.To = segment[2]
			line.Color = color
			line.Thickness = 1
			line.Visible = true
		end
	end
end

local function updateTracer(target, color, visible)
	local enabled = visible and flag("PlayerTracer", false) and target.kind == "player"
	if not enabled then
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local screen = camera:WorldToViewportPoint(target.focusPart.Position)
	if screen.Z <= 0 then
		if target.tracer then
			target.tracer.Visible = false
		end
		return
	end
	if not target.tracer then
		target.tracer = newLine()
	end
	if not target.tracer then
		return
	end
	local tracer = target.tracer
	tracer.From = Vector2.new(viewport.X * 0.5, viewport.Y)
	tracer.To = Vector2.new(screen.X, screen.Y)
	tracer.Color = color
	tracer.Thickness = 1
	tracer.Visible = true
end

local function updateTarget(target)
	if not target.model or not target.model.Parent then
		releaseVisuals(target)
		return
	end
	if not target.root or not target.root.Parent then
		if not resolveParts(target) then
			releaseVisuals(target)
			return
		end
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = distanceOrigin()
	local distance = (target.focusPart.Position - origin).Magnitude
	local renderDistance = flag("RenderDistance", 2500)
	local inRange = distance <= renderDistance

	local color
	local visible = inRange
	if target.kind == "player" then
		color = playerColor(target.player or LocalPlayer)
		if not target.player then
			visible = false
		end
	else
		color = droneColor(target.model)
	end

	updateChams(target, color, visible and flag(target.kind == "player" and "PlayerChams" or "DroneChams", true))
	updateBillboard(target, color, distance, visible)
	updateBox(target, color, visible)
	updateTracer(target, color, visible)
	target.hasVisual = visible
end

local function updateStats()
	local playerCount = 0
	local droneCount = 0
	for _, target in pairs(targets) do
		if target.hasVisual then
			if target.kind == "player" then
				playerCount = playerCount + 1
			else
				droneCount = droneCount + 1
			end
		end
	end
	stats.players = playerCount
	stats.drones = droneCount
end

