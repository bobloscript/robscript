	local function buildHighlight(model)
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Chams"
		highlight.Adornee = model
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 0.1
		highlight.Parent = model
		return highlight
	end

	local function resolveParts(target)
		local model = target.model
		if not model or not model.Parent then
			return false
		end
		if target.kind == KIND_PLAYER then
			target.root = model:FindFirstChild("HumanoidRootPart")
			target.focusPart = model:FindFirstChild("Head") or target.root
			target.humanoid = model:FindFirstChildOfClass("Humanoid")
		elseif target.kind == KIND_NPC then
			target.humanoid = model:FindFirstChildOfClass("Humanoid")
			target.root = (target.humanoid and target.humanoid.RootPart) or firstBasePart(model)
			target.focusPart = model:FindFirstChild("Head") or target.root
		elseif target.kind == KIND_VEHICLE then
			target.seat = model:FindFirstChild("DriverSeat", true)
			target.root = firstBasePart(model)
			target.focusPart = target.root
			target.humanoid = nil
		else
			target.root = firstBasePart(model)
			target.focusPart = target.root
			target.humanoid = nil
		end
		return target.root ~= nil and target.focusPart ~= nil
	end

	local function createTarget(kind, model, player)
		local target = {
			kind = kind,
			model = model,
			player = player,
			hasVisual = false,
			chamSlot = false,
			lastTextAt = 0,
		}
		if not resolveParts(target) then
			return nil
		end
		return target
	end

	local function dropTarget(model)
		local target = Esp.targets[model]
		if not target then
			return
		end
		releaseVisuals(target)
		Esp.targets[model] = nil
	end

	function Esp.Clear()
		for model in pairs(Esp.targets) do
			dropTarget(model)
		end
		Esp.stats.players = 0
		Esp.stats.objects = 0
	end

	local function collectPlayers(seen)
		if not flag("PlayerESP", false) then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local char = player.Character
				if char and char.Parent then
					local target = Esp.targets[char]
					if not target then
						target = createTarget(KIND_PLAYER, char, player)
						if target then
							Esp.targets[char] = target
						end
					else
						target.player = player
					end
					if target then
						seen[char] = true
					end
				end
			end
		end
	end

	local function collectFolder(folder, kind, enabled, seen, filter)
		if not enabled or not folder then
			return
		end
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") and (not filter or filter(child)) then
				local target = Esp.targets[child]
				if not target then
					target = createTarget(kind, child, nil)
					if target then
						Esp.targets[child] = target
					end
				end
				if target then
					seen[child] = true
				end
			end
		end
	end

	local function collectVehicles(seen)
		if not flag("VehicleESP", false) then
			return
		end
		local folder = workspace:FindFirstChild("Vehicles")
		if folder then
			collectFolder(folder, KIND_VEHICLE, true, seen, function(model)
				return model:FindFirstChild("DriverSeat", true) ~= nil
			end)
		end
		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Model") and child:FindFirstChild("DriverSeat", true) then
				local target = Esp.targets[child]
				if not target then
					target = createTarget(KIND_VEHICLE, child, nil)
					if target then
						Esp.targets[child] = target
					end
				end
				if target then
					seen[child] = true
				end
			end
		end
	end

	local function collectAirdrops(seen)
		if not flag("AirdropESP", false) then
			return
		end
		local candidates = {}
		for _, child in ipairs(workspace:GetChildren()) do
			candidates[#candidates + 1] = child
		end
		local map = workspace:FindFirstChild("Map")
		if map then
			for _, child in ipairs(map:GetChildren()) do
				candidates[#candidates + 1] = child
			end
		end
		for _, child in ipairs(candidates) do
			local lower = child.Name:lower()
			if child:IsA("Model") and child.Name ~= "AirDropPoints"
				and (lower:find("airdrop", 1, true) or lower:find("crate", 1, true)) then
				local target = Esp.targets[child]
				if not target then
					target = createTarget(KIND_AIRDROP, child, nil)
					if target then
						Esp.targets[child] = target
					end
				end
				if target then
					seen[child] = true
				end
			end
		end
	end

	local function applyChamBudget()
		local origin = distanceOrigin()
		local candidates = {}
		for _, target in pairs(Esp.targets) do
			if target.focusPart and target.focusPart.Parent then
				candidates[#candidates + 1] = target
			end
		end
		for _, target in ipairs(candidates) do
			target.chamSlot = false
		end
		if #candidates > CHAM_BUDGET then
			table.sort(candidates, function(a, b)
				return (a.focusPart.Position - origin).Magnitude < (b.focusPart.Position - origin).Magnitude
			end)
			for index = 1, CHAM_BUDGET do
				candidates[index].chamSlot = true
			end
		else
			for _, target in ipairs(candidates) do
				target.chamSlot = true
			end
		end
	end

	local function collectTargets()
		local seen = {}
		collectPlayers(seen)
		collectFolder(workspace:FindFirstChild("DroppedItems"), KIND_DROP, flag("DropESP", false), seen)
		local map = workspace:FindFirstChild("Map")
		collectFolder(map and map:FindFirstChild("NPCs"), KIND_NPC, flag("NpcESP", false), seen)
		collectFolder(workspace:FindFirstChild("QuestPumpkins"), KIND_PUMPKIN, flag("PumpkinESP", false), seen)
		collectVehicles(seen)
		collectAirdrops(seen)
		for model in pairs(Esp.targets) do
			if not seen[model] then
				dropTarget(model)
			end
		end
		applyChamBudget()
	end

	local function playerColor(player)
		if not player then
			return COLOR_PLAYER
		end
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health <= 0 then
			return COLOR_DEAD
		end
		if player:GetAttribute("IsInCombat") == true then
			return flag("CombatColor", COLOR_COMBAT)
		end
		return flag("PlayerColor", COLOR_PLAYER)
	end

	local function targetColor(target)
		if target.kind == KIND_PLAYER then
			return playerColor(target.player)
		elseif target.kind == KIND_DROP then
			if target.model:GetAttribute("item_type") == "money" then
				return flag("MoneyColor", COLOR_MONEY)
			end
			return flag("LootColor", COLOR_LOOT)
		elseif target.kind == KIND_VEHICLE then
			return flag("VehicleColor", COLOR_VEHICLE)
		elseif target.kind == KIND_NPC then
			return flag("NpcColor", COLOR_NPC)
		elseif target.kind == KIND_PUMPKIN then
			return flag("PumpkinColor", COLOR_PUMPKIN)
		end
		return flag("AirdropColor", COLOR_AIRDROP)
	end

	local function playerLabelText(target, distance)
		local player = target.player
		if not player then
			return ""
		end
		local parts = {}
		if flag("PlayerName", true) then
			local color = player:GetAttribute("IsInCombat") == true and "#FF4E7A" or "#FFFFFF"
			parts[#parts + 1] = string.format('<font color="%s">%s</font>', color, escapeRichText(player.Name))
		end
		local details = {}
		if flag("PlayerJob", true) then
			local job = player:GetAttribute("Job")
			if type(job) == "string" and job ~= "" then
				details[#details + 1] = escapeRichText(prettify(job))
			end
		end
		if flag("PlayerHealth", true) and target.humanoid then
			details[#details + 1] = string.format("%d HP", math.floor(target.humanoid.Health + 0.5))
		end
		if flag("PlayerDistance", true) then
			details[#details + 1] = shortDistance(distance)
		end
		if #details > 0 then
			parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
		end
		local level = player:GetAttribute("level")
		if flag("PlayerLevel", true) and typeof(level) == "number" and level > 1 then
			parts[#parts + 1] = string.format('<font color="#7FD4FF">Lv %d</font>', level)
		end
		return table.concat(parts, "\n")
	end

	local function dropLabelText(target, distance)
		local drop = target.model
		local parts = {
			string.format('<font color="#FFFFFF">%s</font>', escapeRichText(dropTitle(drop))),
		}
		local details = {}
		local amount = dropAmount(drop)
		if amount then
			details[#details + 1] = string.format("x%s", amount)
		end
		local source = parseDropSource(drop)
		if source and flag("DropSource", true) then
			details[#details + 1] = escapeRichText(source)
		end
		if flag("DropDistance", true) then
			details[#details + 1] = shortDistance(distance)
		end
		if #details > 0 then
			parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
		end
		return table.concat(parts, "\n")
	end

	local function vehicleLabelText(target, distance)
		local model = target.model
		local parts = {
			string.format('<font color="#FFFFFF">%s</font>', escapeRichText(model.Name)),
		}
		local details = {}
		if flag("VehicleDriver", true) then
			local driverName = nil
			if target.seat and target.seat.Occupant then
				local char = target.seat.Occupant.Parent
				local driverPlayer = char and Players:GetPlayerFromCharacter(char)
