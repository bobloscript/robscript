-- Kitchen coordinates measured on the live map. Every entry is relative to the
-- kitchen centre, and the centre itself is recomputed from the four grill models
-- at runtime, so the numbers survive a different server or a moved restaurant.
local ANCHOR_OFFSETS = {
	Vector3.new(0, 0, 0),
	Vector3.new(-7, 0, -6),
	Vector3.new(9, 0, 0),
	Vector3.new(0, 0, 7),
	Vector3.new(-4, 0, 4),
}

local stuckAnchors = {}
local anchorIndex = 1

local function floorYAt(position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local char = LocalPlayer.Character
	if char then
		params.FilterDescendantsInstances = { char }
	end
	local result = workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), params)
	return result and result.Position.Y or nil
end

-- Centre of the cooking area: the average of the four grill areas, with the
-- fridge pulled in so the point never lands on a counter.
local function prepareAnchors(house)
	local center = Vector3.new(-264.0, 0, 343.7)
	local grillList = grillsOf(house)
	local sumX, sumZ, count = 0, 0, 0
	for _, grill in ipairs(grillList) do
		local area = grill:FindFirstChild("GrillArea")
		if area then
			sumX = sumX + area.Position.X
			sumZ = sumZ + area.Position.Z
			count = count + 1
		end
	end
	if count > 0 then
		center = Vector3.new(sumX / count, 0, sumZ / count)
	end
	local floor = floorYAt(center) or 252.4
	center = Vector3.new(center.X, floor, center.Z)

	stuckAnchors = {}
	for _, offset in ipairs(ANCHOR_OFFSETS) do
		stuckAnchors[#stuckAnchors + 1] = center + offset
	end
	anchorIndex = 1
	return center
end

local function nextAnchor()
	if #stuckAnchors == 0 then
		return nil
	end
	local anchor = stuckAnchors[anchorIndex]
	anchorIndex = anchorIndex % #stuckAnchors + 1
	return anchor
end

-- Walks toward a point and reports whether the character actually moved, so a
-- wedged body can be told apart from a slow one.
local function waitWhileMoving(goal, arriveXZ, deadline)
	local _, humanoid, root = character()
	if not humanoid or not root then
		return false, false
	end
	local startPosition = root.Position
	local lastPosition = root.Position
	local lastMovedAt = os.clock()
	local jumps = 0
	while os.clock() < deadline do
		if not running or not state.auto then
			return false, false
		end
		humanoid:MoveTo(goal)
		task.wait(MOVE_REISSUE)
		if not root.Parent then
			return false, false
		end
		if horizontalDistance(root.Position, goal) <= arriveXZ then
			return true, true
		end
		if (root.Position - lastPosition).Magnitude > 0.6 then
			lastPosition = root.Position
			lastMovedAt = os.clock()
		elseif os.clock() - lastMovedAt > STUCK_JUMP_AFTER then
			-- A small hop over a counter edge, exactly like a player would.
			humanoid.Jump = true
			jumps = jumps + 1
			lastMovedAt = os.clock()
		end
	end
	local moved = (root.Position - startPosition).Magnitude > 2
	return false, moved
end

-- PathfindingService gives a walking route around counters; the final stretch is
-- plain MoveTo because the interaction points sit inside solid props. When the
-- character wedges anyway, it steps to the measured kitchen coordinates and then
-- resumes the interrupted walk.
local function navigate(goal, arriveXZ, timeout)
	local _, humanoid, root = character()
	if not humanoid or not root then
		return false
	end
	local deadline = os.clock() + (timeout or 18)

	local ok, path = pcall(function()
		local newPath = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			AgentMaxSlope = 45,
		})
		newPath:ComputeAsync(root.Position, goal)
		return newPath
	end)

	local waypoints = ok and path and path:GetWaypoints() or {}
	state.trace = "n:wps:" .. #waypoints
	if #waypoints > 1 then
		for index = 2, #waypoints do
			if os.clock() > deadline or not running or not state.auto then
				return false
			end
			local waypoint = waypoints[index]
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			local reached = waitWhileMoving(waypoint.Position, 2.2, math.min(deadline, os.clock() + 4))
			state.trace = ("n:wp%d:%s"):format(index, tostring(reached))
			if not reached and not running then
				return false
			end
		end
	end

	local arrived = waitWhileMoving(goal, arriveXZ, math.min(deadline, os.clock() + 9))
	if arrived then
		humanoid:MoveTo(root.Position)
		return true
	end

	-- Stuck: walk to the kitchen coordinates, then continue the same goal.
	for attempt = 1, 3 do
		if not running or not state.auto or os.clock() > deadline then
			break
		end
		local anchor = nextAnchor()
		if not anchor then
			break
		end
		state.trace = "n:unstick" .. attempt
		local _, moved = waitWhileMoving(anchor, 3.0, math.min(deadline, os.clock() + 4))
		if not moved then
			-- Nothing helped: nudge sideways so the body leaves the corner.
			local _, _, currentRoot = character()
			if currentRoot then
				humanoid:MoveTo(currentRoot.Position + Vector3.new(3, 0, 0))
				task.wait(0.4)
			end
		end
		if waitWhileMoving(goal, arriveXZ, math.min(deadline, os.clock() + 6)) then
			humanoid:MoveTo(root.Position)
			return true
		end
	end

	humanoid:MoveTo(root.Position)
	return false
end

-- Keeps the character clear of the counter: the grill area centre sits inside
-- the solid counter, so the approach point is pushed toward the room instead.
local function approachPoint(targetPosition, targetSize, center)
	local delta = Vector3.new(center.X - targetPosition.X, 0, center.Z - targetPosition.Z)
	if delta.Magnitude < 0.1 then
		delta = Vector3.new(1, 0, 0)
	end
	local depth = math.min(targetSize.X, targetSize.Z) * 0.5 + 1.5
	return targetPosition + delta.Unit * depth
end

----- Finish press -----

local function pressFinish(button)
	local fired = pcall(function()
		firesignal(button.MouseButton1Click)
	end)
	if fired then
		return true
	end
	-- Fallback for executors without firesignal.
	local okMove = pcall(function()
		mousemoveabs(button.AbsolutePosition.X + button.AbsoluteSize.X * 0.5,
			button.AbsolutePosition.Y + button.AbsoluteSize.Y * 0.5)
	end)
	if okMove then
		pcall(mouse1click)
		return true
	end
	return false
end

