local function findStore()
	local map = workspace:FindFirstChild("Map")
	local tiles = map and map:FindFirstChild("Tiles")
	if not tiles then
		return nil
	end
	for _, tile in ipairs(tiles:GetChildren()) do
		for _, model in ipairs(tile:GetChildren()) do
			if model:IsA("Model") then
				local interior = model:FindFirstChild("Interior")
				if interior and interior:FindFirstChild("ShelfStockingJob") then
					return model
				end
			end
		end
	end
	return nil
end

local function shelfParts(store)
	local interior = store and store:FindFirstChild("Interior")
	local job = interior and interior:FindFirstChild("ShelfStockingJob")
	if not job then
		return nil
	end
	local boxes = {}
	for _, child in ipairs(job:GetChildren()) do
		if child:IsA("BasePart") and string.find(child.Name, "Box", 1, true)
			and child:FindFirstChildWhichIsA("ProximityPrompt") then
			boxes[#boxes + 1] = child
		end
	end
	local shelves = {}
	local folder = job:FindFirstChild("Shelves")
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("BasePart") then
				shelves[#shelves + 1] = child
			end
		end
	end
	local doorSystem = interior:FindFirstChild("DoorSystem")
	local doorPart = doorSystem and (doorSystem:FindFirstChild("DoorBase") or doorSystem:FindFirstChildWhichIsA("BasePart"))
	return boxes, shelves, doorPart
end

local function carriedBox()
