-- The restaurant model is looked up instead of hard-coded, so the script keeps
-- working if the job moves to another tile.
local function findKitchen()
	local map = workspace:FindFirstChild("Map")
	local tiles = map and map:FindFirstChild("Tiles")
	if not tiles then
		return nil
	end
	local _, _, root = character()
	local origin = root and root.Position or Vector3.zero
	local best, bestDistance = nil, math.huge
	for _, tile in ipairs(tiles:GetChildren()) do
		local house = tile:FindFirstChild("SteakHouse")
		if house then
			local interior = house:FindFirstChild("Interior")
			local fridge = interior and interior:FindFirstChild("Fridge")
			local base = fridge and fridge:FindFirstChild("Base")
			local ok, frame = pcall(function()
				return house:GetBoundingBox()
			end)
			local position = ok and frame.Position or Vector3.zero
			local distance = (position - origin).Magnitude
			if distance < bestDistance and base then
				best, bestDistance = house, distance
			end
		end
	end
	return best
end

-- The fridge model contains two parts named "Base"; only one of them carries
-- the interaction attachment, so the prompt is searched across the whole model.
local function fridgePrompt(house)
	local interior = house and house:FindFirstChild("Interior")
	local fridge = interior and interior:FindFirstChild("Fridge")
	if not fridge then
		return nil, nil
	end
	for _, descendant in ipairs(fridge:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") and descendant.ObjectText == "Get Steak" then
			return descendant, descendant.Parent
		end
	end
	for _, descendant in ipairs(fridge:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			return descendant, descendant.Parent
		end
	end
	return nil, nil
end

local function worldPositionOf(instance)
	if not instance then
		return nil
	end
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	if instance:IsA("BasePart") then
		return instance.Position
	end
	local ok, frame = pcall(function()
		return instance:GetBoundingBox()
	end)
	return ok and frame and frame.Position or nil
end

local function grillsOf(house)
	local list = {}
	local interior = house and house:FindFirstChild("Interior")
	if not interior then
		return list
	end
	for _, child in ipairs(interior:GetChildren()) do
		if child.Name == "Grill" and child:FindFirstChild("GrillArea") then
			list[#list + 1] = child
		end
	end
	return list
end

