			end
			details[#details + 1] = driverName and escapeRichText(driverName) or "empty"
		end
		if flag("VehicleDistance", true) then
			details[#details + 1] = shortDistance(distance)
		end
		if #details > 0 then
			parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
		end
		return table.concat(parts, "\n")
	end

	local function worldLabelText(target, distance)
		local model = target.model
		local parts = {
			string.format('<font color="#FFFFFF">%s</font>', escapeRichText(model.Name)),
		}
		local details = {}
		if target.kind == KIND_PUMPKIN then
			local spot = model:GetAttribute("Spot")
			if type(spot) == "string" and spot ~= "" then
				details[#details + 1] = escapeRichText(spot)
			end
		end
		if flag("WorldDistance", true) then
			details[#details + 1] = shortDistance(distance)
		end
		if #details > 0 then
			parts[#parts + 1] = string.format('<font color="#A6A6B4">%s</font>', table.concat(details, "  |  "))
		end
