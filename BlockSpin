-- Declared up here so the bridge can hide the hub once the map opens.
local Window

-- The map is its own script; this only spawns it on demand from the executor
-- workspace so one toggle in the hub is enough.
local function loadMapModule()
	local existing = getgenv().RobScriptMap
	if type(existing) == "table" and type(existing.Open) == "function" then
		return existing, nil
	end
	local okRead, source = pcall(readfile, "BlockSpinMap.lua")
	if not okRead or type(source) ~= "string" or #source < 100 then
		return nil, "file"
	end
	local chunk = loadstring(source)
	if not chunk then
		return nil, "compile"
	end
	local okRun, err = pcall(chunk)
	if not okRun then
		return nil, tostring(err)
	end
	local module = getgenv().RobScriptMap
	if type(module) ~= "table" then
		return nil, "module"
	end
	return module, nil
end

local function openMap()
	local module, reason = loadMapModule()
	if not module then
		return nil, reason
	end
	pcall(function()
		module.Open()
	end)
	-- The hub draws at DisplayOrder 999, so the map is lifted above it and the
	-- hub steps aside to keep the plan readable.
	if type(module.Raise) == "function" then
		pcall(function()
			module.Raise()
		end)
	end
	if Window then
		pcall(function()
			Window:Toggle(false)
		end)
	end
	return module, nil
end

----- One cooking cycle -----

local function log(line)
	if Log then
		pcall(function()
			Log:Push(line)
		end)
	end
end

local function setPhase(phase)
	state.phase = phase
end

local function cycle(house)
	local prompt, attachment = fridgePrompt(house)
	local anchor = worldPositionOf(attachment)
	if not prompt or not anchor then
		return "no-fridge"
	end
	local kitchenCenter = prepareAnchors(house)

	-- 1. Already holding a steak (for example after a failed placement): skip the fridge.
	local tool = cookableTool()
	if not tool then
		setPhase(PHASE_FRIDGE)
		local fridgeApproach = approachPoint(anchor, Vector3.new(6, 3, 13), kitchenCenter)
		local target = fridgeApproach + Vector3.new(0, -1, 0)
		local arrived = navigate(target, FRIDGE_ARRIVE, 18)
		if not running or not state.auto then
			return "stop"
		end
		if not arrived then
			-- Last resort: the measured fridge-side coordinate, then continue.
			local _, moved = waitWhileMoving(anchor + Vector3.new(4, -1, 1), FRIDGE_ARRIVE, 4)
			local _, _, currentRoot = character()
			arrived = moved and currentRoot ~= nil and (currentRoot.Position - anchor).Magnitude <= 8
		end
		if not arrived then
			log("<Warning>Could not reach the fridge</Warning>")
			return "not-arrived"
		end
		local _, _, root = character()
		if not root or (root.Position - anchor).Magnitude > 8 then
			return "not-arrived"
		end
		setPhase(PHASE_TAKE)
		pcall(fireproximityprompt, prompt)
		task.wait(0.9)
		tool = cookableTool()
	end

	if not tool then
		state.failed = state.failed + 1
		log("<Error>No steak from the fridge</Error>")
		return "no-steak"
	end

	if tool.Parent ~= LocalPlayer.Character then
		local _, humanoid = character()
		if humanoid then
			pcall(function()
				humanoid:EquipTool(tool)
			end)
			task.wait(0.3)
		end
	end

	-- 2. The beacon marks the assigned grill; a free one is the fallback.
	local grills = grillsOf(house)
	if #grills == 0 then
		return "no-grill"
	end
	local targetIndex = beaconGrill(grills) or freeGrill(grills)
	if not targetIndex then
		local index = 1
		for i, grill in ipairs(grills) do
			if grillItem(grill) == "" then
				index = i
				break
			end
		end
		targetIndex = index
	end

	local grill = grills[targetIndex]
	local area = grill:FindFirstChild("GrillArea")
	setPhase(PHASE_GRILL)
	local grillApproach = approachPoint(area.Position, area.Size, kitchenCenter)
	local arrivedGrill = navigate(grillApproach, GRILL_ARRIVE, 15)
	if not running or not state.auto then
		return "stop"
	end
	if not arrivedGrill then
		log("<Warning>Could not reach the grill</Warning>")
		return "not-arrived"
	end
	state.lastGrill = targetIndex

	-- Close the last couple of studs to the counter so the steak places itself.
	waitWhileMoving(area.Position, 2.8, 2.5)

	-- 3. The steak places itself when the player reaches the counter.
	local gui = LocalPlayer.PlayerGui
	local progress = gui:FindFirstChild("ProgressBar")
	local frame = progress and progress:FindFirstChild("ProgressBarFrame")
	local deadline = os.clock() + 3.5
	while os.clock() < deadline and not (frame and frame.Visible) do
		task.wait(0.03)
	end

	if not (frame and frame.Visible) then
		-- Try one more grill before giving up on the steak.
		local other = freeGrill(grills)
		if other and other ~= targetIndex then
			local otherArea = grills[other]:FindFirstChild("GrillArea")
			setPhase(PHASE_RETRY)
			navigate(approachPoint(otherArea.Position, otherArea.Size, kitchenCenter), GRILL_ARRIVE, 12)
			waitWhileMoving(otherArea.Position, 2.8, 2.5)
			state.lastGrill = other
			deadline = os.clock() + 3.5
			while os.clock() < deadline and not frame.Visible do
				task.wait(0.03)
			end
			grill = grills[other]
		end
	end

	if not (frame and frame.Visible) then
		state.failed = state.failed + 1
		log("<Warning>Steak did not reach a grill</Warning>")
		return "not-placed"
	end

	-- 4. Press Finish inside the green zone.
	setPhase(PHASE_COOK)
	local main = frame:FindFirstChild("MainFrame")
	local amount = main and main:FindFirstChild("BarAmount")
	local green = main and main:FindFirstChild("CookedPerfectly")
	local inputFrame = frame:FindFirstChild("InputFrame")
	local button = inputFrame and inputFrame:FindFirstChild("FinishBar")
	if not (amount and green and button) then
		return "no-widgets"
	end

	local zoneStart = green.Position.X.Scale
	local zoneEnd = zoneStart + green.Size.X.Scale
	local margin = math.clamp(flag("PressMargin", 0.01), 0.0, math.max(0.0, zoneEnd - zoneStart - 0.005))
	local targetBar = zoneStart + margin
	local cashBefore = money() or 0
	local pressedAt = -1
	local cookDeadline = os.clock() + 20
	while os.clock() < cookDeadline do
		if not running or not state.auto then
			return "stop"
		end
		local bar = amount.Size.X.Scale
		if bar >= targetBar then
			setPhase(PHASE_PRESS)
			pressFinish(button)
			pressedAt = bar
			break
		end
		task.wait(0.004)
	end

	if pressedAt < 0 then
		state.failed = state.failed + 1
		log("<Error>Green zone was missed</Error>")
		return "missed"
	end
	state.lastPress = pressedAt

	-- 5. Wait for the bar to close, then wait for the payout. The grill
	-- attributes only exist while a steak sits on it, so money is the honest
	-- success signal: the payout lands a few seconds after the press.
	setPhase(PHASE_SETTLE)
	local closeDeadline = os.clock() + 3
	while os.clock() < closeDeadline and frame.Visible do
		task.wait(0.03)
	end

	state.cooked = state.cooked + 1
	-- The payout lands in several increments a few seconds after the press, so
	-- the highest value seen in the window is the real amount.
	local paid = 0
	local payDeadline = os.clock() + 5
	while os.clock() < payDeadline do
		local current = money() or 0
		if current - cashBefore > paid then
			paid = current - cashBefore
			state.sessionCash = current
		end
		task.wait(0.25)
	end

	if paid > 0 then
		state.perfect = state.perfect + 1
		state.earned = state.earned + paid
		state.lastResult = string.format("+$%d", paid)
		log(("<Success>Sold the steak</Success> <Muted>+$%d, bar %.3f</Muted>"):format(paid, pressedAt))
	else
		state.failed = state.failed + 1
		state.lastResult = "No payout"
		log(("<Warning>Steak burnt</Warning> <Muted>bar %.3f</Muted>"):format(pressedAt))
	end

	-- Small human pause before the next order.
	task.wait(0.4)
	return "ok"
end

