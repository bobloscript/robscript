----- Runtime -----

resetFlagCache()

local espConnection = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	local ok, err = pcall(Esp.Update, deltaTime)
	if not ok then
		Esp.lastError = tostring(err)
	end
end)

-- RenderStepped, not Heartbeat: the camera has to be written after the default
-- camera script, otherwise the game overwrites the lock every frame.
local lockConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not running then
		return
	end
	if flag("LockOn", false) then
		pcall(updateLock, deltaTime)
	elseif lockState.active then
		pcall(releaseLock)
	end
end)

local lockInput = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running or not flag("LockOn", false) then
		return
	end
	local expected = LOCK_KEYS[flag("LockKey", "Middle mouse")]
	if expected and (input.UserInputType == expected or input.KeyCode == expected) then
		pcall(toggleLock)
	end
end)

local lockWheel = UserInputService.InputChanged:Connect(function(input)
	if not running or not lockState.active or not flag("LockSwitch", true) then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		pcall(cycleLock, input.Position.Z > 0 and 1 or -1)
	end
end)

local workerThread = task.spawn(function()
	pcall(worker)
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			state.auto = false
			setFlag("AutoCook", false)
			local _, humanoid, root = character()
			if humanoid and root then
				humanoid:MoveTo(root.Position)
			end
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	state.auto = false
	pcall(function()
		inputConnection:Disconnect()
	end)
	pcall(function()
		espConnection:Disconnect()
	end)
	pcall(function()
		lockConnection:Disconnect()
	end)
	pcall(function()
		lockInput:Disconnect()
	end)
	pcall(function()
		lockWheel:Disconnect()
	end)
	pcall(releaseLock)
	pcall(Esp.Clear)
	local _, humanoid, root = character()
	if humanoid and root then
		pcall(function()
			humanoid:MoveTo(root.Position)
		end)
	end
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptCook then
		getgenv().RobScriptCook = nil
	end
end

----- Public interface -----

getgenv().RobScriptCook = {
	Version = "1.0",
	Start = function()
		state.auto = true
		setFlag("AutoCook", true)
	end,
	Stop = function()
		state.auto = false
		setFlag("AutoCook", false)
	end,
	ShelfStart = function()
		shelfState.auto = true
		state.auto = false
		setFlag("AutoCook", false)
		setFlag("ShelfStocking", true)
	end,
	ShelfStop = function()
		shelfState.auto = false
		setFlag("ShelfStocking", false)
	end,
	GetShelfState = function()
		return {
			auto = shelfState.auto,
			phase = shelfState.phase,
			placed = shelfState.placed,
			failed = shelfState.failed,
			earned = shelfState.earned,
			ticks = shelfState.ticks,
			lastError = shelfState.lastError,
		}
	end,
	GetState = function()
		return {
			phase = state.phase,
			auto = state.auto,
			perfect = state.perfect,
			failed = state.failed,
			earned = state.earned,
			lastPress = state.lastPress,
			lastGrill = state.lastGrill,
			result = state.lastResult,
			ticks = state.ticks,
			lastError = state.lastError,
			seenAuto = state.seenAuto,
			trace = state.trace,
			stateId = tostring(state),
		}
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	GetEsp = function()
		local list = {}
		for model, target in pairs(Esp.targets) do
			list[#list + 1] = {
				name = (target.player and target.player.Name) or model.Name,
				kind = target.kind,
				visible = target.hasVisual,
				billboard = target.billboard ~= nil and target.billboard.Enabled or false,
				chams = target.highlight ~= nil,
				box = target.lines ~= nil and target.lines[1] ~= nil and target.lines[1].Visible or false,
				tracer = target.tracer ~= nil and target.tracer.Visible or false,
			}
		end
		return {
			players = Esp.stats.players,
			objects = Esp.stats.objects,
			targets = list,
			error = Esp.lastError,
		}
	end,
	ClearEsp = function()
		Esp.Clear()
	end,
	OpenMap = function()
		local module, reason = openMap()
		return module ~= nil, reason
	end,
	GetMap = function()
		local module = getgenv().RobScriptMap
		if type(module) ~= "table" then
			return nil
		end
		local ok, state = pcall(function()
			return module.GetState()
		end)
		return ok and state or nil
	end,
	GetLock = function()
		return {
			active = lockState.active,
			name = lockState.target and lockState.target.player and lockState.target.player.Name or nil,
			indicator = lockState.indicator ~= nil,
			candidates = #lockCandidates(),
		}
	end,
	ToggleLock = function()
		return toggleLock()
	end,
	CycleLock = function(direction)
		return cycleLock(direction or 1)
	end,
	ReleaseLock = function()
		releaseLock()
	end,
	Destroy = destroy,
}

