local function horizontalDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function money()
	local hud = LocalPlayer:FindFirstChild("PlayerGui")
	local top = hud and hud:FindFirstChild("TopRightHud")
	local holder = top and top:FindFirstChild("Holder")
	local frame = holder and holder:FindFirstChild("Frame")
	local label = frame and frame:FindFirstChild("MoneyTextLabel")
	if not label then
