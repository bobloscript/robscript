	local DRAWING = (type(Drawing) == "table" and type(Drawing.new) == "function") and Drawing or nil

	local function newLine()
		if not DRAWING then
			return nil
		end
		local ok, line = pcall(DRAWING.new, "Line")
		if ok and line then
			line.Visible = false
			return line
		end
		return nil
	end

	local function escapeRichText(text)
		local value = tostring(text)
		value = value:gsub("&", "&amp;")
		value = value:gsub("<", "&lt;")
		value = value:gsub(">", "&gt;")
		return value
	end

	local function prettify(text)
		local spaced = tostring(text):gsub("_", " ")
		spaced = spaced:gsub("(%l)(%u)", "%1 %2")
		spaced = spaced:gsub("(%u)(%u%l)", "%1 %2")
		spaced = spaced:gsub("^%l", string.upper)
		return spaced
	end

	local function distanceOrigin()
		if flag("DistanceFrom", "Camera") == "Character" then
			local _, _, root = character()
			if root then
				return root.Position
			end
		end
		local camera = workspace.CurrentCamera
		if camera then
			return camera.CFrame.Position
		end
		return Vector3.zero
	end

	local function shortDistance(studs)
		if studs >= 1000 then
			return string.format("%.1fk", studs / 1000)
		end
		return string.format("%dm", math.floor(studs + 0.5))
	end

	local function parseDropSource(drop)
		for _, value in pairs(drop:GetAttributes()) do
			if type(value) == "string" and value:sub(1, 1) == "{" then
				local custom = value:match('"custom_field_01"%s*:%s*"([^"]*)"')
				if custom and custom ~= "" then
					return custom
				end
				local sku = value:match('"sku"%s*:%s*"([^"]*)"')
				if sku and sku ~= "" then
					return prettify(sku)
				end
			end
		end
		return nil
	end

	local function dropAmount(drop)
		local billboard = drop:FindFirstChildOfClass("BillboardGui")
		local label = billboard and billboard:FindFirstChildOfClass("TextLabel")
		if not label or type(label.Text) ~= "string" then
			return nil
		end
		return label.Text:match("x%s*(%d+)")
	end

	local function dropTitle(drop)
		local itemType = drop:GetAttribute("item_type")
		if type(itemType) == "string" and itemType ~= "" then
			if itemType == "money" then
				return "Money"
			end
			if drop.Name:match("^%d+$") then
				return prettify(itemType)
			end
		end
		if drop.Name:match("^%d+$") then
			return type(itemType) == "string" and prettify(itemType) or "Item"
		end
		return drop.Name
	end

	local function firstBasePart(model)
		local primary = model.PrimaryPart
		if primary then
			return primary
		end
		for _, child in ipairs(model:GetChildren()) do
			if child:IsA("BasePart") then
				return child
			end
		end
		return model:FindFirstChildWhichIsA("BasePart", true)
	end

