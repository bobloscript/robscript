	end

	local function targetLabelText(target, distance)
		if target.kind == KIND_PLAYER then
			return playerLabelText(target, distance)
		elseif target.kind == KIND_DROP then
			return dropLabelText(target, distance)
		elseif target.kind == KIND_VEHICLE then
			return vehicleLabelText(target, distance)
		end
		return worldLabelText(target, distance)
	end

	local function updateChams(target, color, enabled)
		if not enabled then
			if target.highlight then
				pcall(function()
					target.highlight:Destroy()
				end)
				target.highlight = nil
			end
			return
		end
		if not target.highlight or not target.highlight.Parent then
			target.highlight = buildHighlight(target.model)
		end
		target.highlight.FillColor = color
		target.highlight.OutlineColor = color
		target.highlight.FillTransparency = 0.65
		target.highlight.OutlineTransparency = 0.1
		target.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	end

	local function updateBillboard(target, color, distance, visible)
		if not target.billboard or not target.billboard.Parent then
			local offsetY = 2.6
			if target.kind == KIND_DROP then
				offsetY = 1.5
			elseif target.kind == KIND_VEHICLE then
				offsetY = 2.2
			elseif target.kind == KIND_PUMPKIN then
				offsetY = 1.4
			elseif target.kind == KIND_AIRDROP then
				offsetY = 3
			end
			target.billboard, target.label = buildBillboard(target.focusPart, offsetY)
		end
		local renderDistance = flag("RenderDistance", 2000)
		target.billboard.MaxDistance = renderDistance
		target.billboard.Enabled = visible
		if not visible then
			return
		end
		local now = os.clock()
		local interval = target.kind == KIND_PLAYER and TEXT_INTERVAL or OBJECT_TEXT_INTERVAL
		if now - target.lastTextAt >= interval then
			target.lastTextAt = now
			target.label.Text = targetLabelText(target, distance)
		end
		target.label.TextColor3 = color
		target.label.TextSize = flag("TextSize", 14)
	end

	local function projectBox(center, size)
		local camera = workspace.CurrentCamera
		if not camera then
			return nil
		end
		local half = size * 0.5
		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local hits = 0
		for x = -1, 1, 2 do
			for y = -1, 1, 2 do
				for z = -1, 1, 2 do
					local world = center + Vector3.new(half.X * x, half.Y * y, half.Z * z)
					local screen = camera:WorldToViewportPoint(world)
					if screen.Z > 0 then
						hits = hits + 1
						minX = math.min(minX, screen.X)
						minY = math.min(minY, screen.Y)
						maxX = math.max(maxX, screen.X)
						maxY = math.max(maxY, screen.Y)
					end
				end
			end
		end
		if hits < 2 then
			return nil
		end
		return minX, minY, maxX, maxY
	end

	local function updateBox(target, color, visible)
		local boxFlag = target.kind == KIND_PLAYER and "PlayerBox" or "VehicleBox"
		local boxable = target.kind == KIND_PLAYER or target.kind == KIND_VEHICLE
		if not (visible and boxable and flag(boxFlag, false)) then
			if target.lines then
				for _, line in ipairs(target.lines) do
					line.Visible = false
				end
			end
			return
		end

		local center, size
		if target.kind == KIND_PLAYER then
			if not target.root then
				return
			end
			center, size = target.root.Position, PLAYER_BOX_SIZE
		else
			local ok, frame, boxSize = pcall(function()
				local cf, sz = target.model:GetBoundingBox()
				return cf, sz
			end)
			if not ok then
				return
			end
			center, size = frame.Position, boxSize
		end

		local minX, minY, maxX, maxY = projectBox(center, size)
		if not minX then
			return
		end
		if not target.lines then
			target.lines = { newLine(), newLine(), newLine(), newLine() }
		end
		local lines = target.lines
		if not lines[1] then
			return
		end
		local corners = {
			{ Vector2.new(minX, minY), Vector2.new(maxX, minY) },
			{ Vector2.new(maxX, minY), Vector2.new(maxX, maxY) },
			{ Vector2.new(maxX, maxY), Vector2.new(minX, maxY) },
			{ Vector2.new(minX, maxY), Vector2.new(minX, minY) },
		}
		for index = 1, 4 do
			local line = lines[index]
			if line then
				line.From = corners[index][1]
				line.To = corners[index][2]
				line.Color = color
				line.Thickness = 1
				line.Visible = true
			end
		end
	end

	local function updateTracer(target, color, visible)
		local tracerFlag = target.kind == KIND_PLAYER and "PlayerTracer" or "VehicleTracer"
		local traceable = target.kind == KIND_PLAYER or target.kind == KIND_VEHICLE
		if not (visible and traceable and flag(tracerFlag, false)) then
			if target.tracer and target.tracer.Visible then
				target.tracer.Visible = false
			end
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local screen = camera:WorldToViewportPoint(target.focusPart.Position)
		if screen.Z <= 0 then
			if target.tracer then
				target.tracer.Visible = false
			end
			return
		end
		if not target.tracer then
			target.tracer = newLine()
		end
		if not target.tracer then
			return
		end
		target.tracer.From = Vector2.new(viewport.X * 0.5, viewport.Y)
		target.tracer.To = Vector2.new(screen.X, screen.Y)
		target.tracer.Color = color
		target.tracer.Thickness = 1
		target.tracer.Visible = true
	end

	local function updateTarget(target)
		if not target.model or not target.model.Parent then
			releaseVisuals(target)
			return
		end
		if not target.root or not target.root.Parent then
			if not resolveParts(target) then
				releaseVisuals(target)
				return
			end
		end
		local origin = distanceOrigin()
		local distance = (target.focusPart.Position - origin).Magnitude
		local inRange = distance <= flag("RenderDistance", 2000)
		local color = targetColor(target)
		local visible = inRange
		if target.kind == KIND_PLAYER and not target.player then
			visible = false
		end

		local chamsFlag = "Chams"
		if target.kind == KIND_DROP then
			chamsFlag = "DropChams"
		elseif target.kind == KIND_VEHICLE then
			chamsFlag = "VehicleChams"
		elseif target.kind == KIND_NPC then
			chamsFlag = "NpcChams"
		elseif target.kind == KIND_PUMPKIN then
			chamsFlag = "PumpkinChams"
		elseif target.kind == KIND_AIRDROP then
			chamsFlag = "AirdropChams"
		end

		updateChams(target, color, visible and target.chamSlot and flag(chamsFlag, true))
		updateBillboard(target, color, distance, visible)
		updateBox(target, color, visible)
		updateTracer(target, color, visible)
		target.hasVisual = visible
	end

	local collectAccumulator = 0
	local visualAccumulator = 0

	local function anyEnabled()
		return flag("PlayerESP", false)
			or flag("DropESP", false)
			or flag("VehicleESP", false)
			or flag("NpcESP", false)
			or flag("PumpkinESP", false)
			or flag("AirdropESP", false)
	end

	function Esp.Update(deltaTime)
		if not anyEnabled() then
			if next(Esp.targets) then
				Esp.Clear()
			end
			return
		end

		collectAccumulator = collectAccumulator + deltaTime
		visualAccumulator = visualAccumulator + deltaTime

		if collectAccumulator >= COLLECT_INTERVAL then
			collectAccumulator = 0
			pcall(collectTargets)
		end
		if visualAccumulator >= VISUAL_INTERVAL then
			visualAccumulator = 0
			for _, target in pairs(Esp.targets) do
				pcall(updateTarget, target)
			end
			local players, objects = 0, 0
			for _, target in pairs(Esp.targets) do
				if target.hasVisual then
					if target.kind == KIND_PLAYER then
						players = players + 1
					else
						objects = objects + 1
					end
				end
			end
			Esp.stats.players = players
			Esp.stats.objects = objects
		end
	end
end

----- Lock-on (souls-like, ported from the Purgatory script) -----

-- Holds the player nearest to the crosshair until they die, leave the range or
-- the lock key is pressed again. Wheel cycles between targets while held.
local lockState = { active = false, target = nil, indicator = nil }

local LOCK_KEYS = {
	["Middle mouse"] = Enum.UserInputType.MouseButton3,
	["Q"] = Enum.KeyCode.Q,
	["Tab"] = Enum.KeyCode.Tab,
	["F"] = Enum.KeyCode.F,
	["G"] = Enum.KeyCode.G,
}

local function lockRange()
	return tonumber(flag("LockRange", 250)) or 250
end

local function lockFocusPart(player)
	local char = player and player.Character
	if not char then
		return nil
	end
	return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function lockTargetAlive(entry)
	if not entry or not entry.player then
		return false
	end
	local char = entry.player.Character
	if not char or not char.Parent then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	return lockFocusPart(entry.player) ~= nil
end

local function aimedAngle(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local offset = position - camera.CFrame.Position
	if offset.Magnitude < 0.5 then
		return nil
	end
	return math.deg(math.acos(math.clamp(camera.CFrame.LookVector:Dot(offset.Unit), -1, 1)))
end

local function lockCandidates()
	local camera = workspace.CurrentCamera
	if not camera then
		return {}
	end
	local origin = camera.CFrame.Position
	local maxDistance = lockRange()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local part = lockFocusPart(player)
			if part then
				local distance = (part.Position - origin).Magnitude
				if distance <= maxDistance then
					local angle = aimedAngle(part.Position)
					if angle then
						list[#list + 1] = { player = player, part = part, angle = angle, distance = distance }
					end
				end
			end
		end
	end
	-- Souls-like order: targets roughly in front win by angle, and when nothing
	-- is in front the nearest one is still lockable. Force mode ignores the
	-- crosshair completely and always grabs the closest body.
	if flag("ForceLock", false) then
		table.sort(list, function(a, b)
			return a.distance < b.distance
		end)
		return list
	end
	table.sort(list, function(a, b)
		local aFront = a.angle <= 60
		local bFront = b.angle <= 60
		if aFront ~= bFront then
			return aFront
		end
		if aFront then
			return a.angle < b.angle
		end
		return a.distance < b.distance
	end)
	return list
end

local function destroyLockIndicator()
	if lockState.indicator then
		pcall(function()
			lockState.indicator:Destroy()
		end)
		lockState.indicator = nil
	end
end

local function buildLockIndicator(part)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RSP_Lock"
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromOffset(56, 56)
	billboard.StudsOffset = Vector3.new(0, 2.2, 0)

	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromOffset(34, 34)
	ring.BackgroundTransparency = 1
	ring.Parent = billboard

	local ringCorner = Instance.new("UICorner")
	ringCorner.CornerRadius = UDim.new(1, 0)
	ringCorner.Parent = ring

	local ringStroke = Instance.new("UIStroke")
	ringStroke.Color = Color3.fromRGB(255, 59, 127)
	ringStroke.Thickness = 2.5
	ringStroke.Transparency = 0.05
	ringStroke.Parent = ring

	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(5, 5)
	dot.BackgroundColor3 = Color3.fromRGB(255, 59, 127)
	dot.BorderSizePixel = 0
	dot.Parent = billboard

	local dotCorner = Instance.new("UICorner")
	dotCorner.CornerRadius = UDim.new(1, 0)
	dotCorner.Parent = dot

	billboard.Adornee = part
	billboard.Parent = part
	return billboard
end

local function releaseLock()
	lockState.active = false
	lockState.target = nil
	destroyLockIndicator()
end

local function engageLock()
	lockState.target = nil
	local list = lockCandidates()
	if #list == 0 then
		releaseLock()
		return false
	end
	lockState.target = list[1]
	lockState.active = true
	destroyLockIndicator()
	lockState.indicator = buildLockIndicator(list[1].part)
	return true
end

local function toggleLock()
	if lockState.active then
		releaseLock()
		return false
	end
	return engageLock()
end

local function cycleLock(direction)
	local list = lockCandidates()
	if #list == 0 then
		releaseLock()
		return
	end
	local index = nil
	for i, entry in ipairs(list) do
		if lockState.target and entry.player == lockState.target.player then
			index = i
			break
		end
	end
	if not index then
		lockState.target = list[1]
		lockState.active = true
		destroyLockIndicator()
		lockState.indicator = buildLockIndicator(list[1].part)
		return
	end
	index = index + (direction or 1)
	if index > #list then
		index = 1
	end
	if index < 1 then
		index = #list
	end
	lockState.target = list[index]
	lockState.active = true
	destroyLockIndicator()
	lockState.indicator = buildLockIndicator(list[index].part)
end

local function updateLock(deltaTime)
	if not lockState.active then
		return
	end
	local force = flag("ForceLock", false)

	-- Force mode never lets go on its own: if the body disappears it grabs the
	-- next closest one instead of dropping the lock.
	if not lockTargetAlive(lockState.target) then
		if force and engageLock() then
			return
		end
		releaseLock()
		return
	end
	local part = lockFocusPart(lockState.target.player)
	local camera = workspace.CurrentCamera
	local _, _, root = character()
	if not part or not camera or not root then
		releaseLock()
		return
	end

	local position = part.Position
	if (position - camera.CFrame.Position).Magnitude > lockRange() * 1.4 then
		if force and engageLock() then
			return
		end
		releaseLock()
		return
	end

	if force then
		-- Hard snap: the camera lands on the target in the same frame.
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, position)
	elseif flag("LockCamera", true) then
		local desired = CFrame.lookAt(camera.CFrame.Position, position)
		local speed = tonumber(flag("LockCameraSpeed", 14)) or 14
		local alpha = 1 - math.exp(-(deltaTime or 0.016) * speed)
		camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	end

	-- Facing the target only matters for melee; during auto cooking it would
	-- fight the walking controller, so it is skipped then.
	if (force or flag("LockTurnCharacter", false)) and not state.auto then
		local flat = Vector3.new(position.X, root.Position.Y, position.Z)
		if force then
			root.CFrame = CFrame.lookAt(root.Position, flat)
		else
			local alpha = 1 - math.exp(-(deltaTime or 0.016) * 12)
			root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), alpha)
		end
	end

	if flag("LockIndicator", true) then
		local indicator = lockState.indicator
		if not indicator or indicator.Adornee ~= part or not indicator.Parent then
			destroyLockIndicator()
			lockState.indicator = buildLockIndicator(part)
		end
	else
		destroyLockIndicator()
	end
end

