-- The game drops a Beacon on the grill you were assigned to.
local function beaconGrill(grills)
	local beacon = workspace:FindFirstChild("Beacon")
	if not beacon then
		return nil
	end
	local ok, frame = pcall(function()
		return beacon:GetBoundingBox()
	end)
	if not ok then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for index, grill in ipairs(grills) do
		local area = grill:FindFirstChild("GrillArea")
		local distance = (area.Position - frame.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = index, distance
		end
	end
	return best
end

local function freeGrill(grills)
	local _, _, root = character()
	local origin = root and root.Position or Vector3.zero
	local best, bestDistance = nil, math.huge
	for index, grill in ipairs(grills) do
		if grillItem(grill) == "" then
			local area = grill:FindFirstChild("GrillArea")
			local distance = (area.Position - origin).Magnitude
			if distance < bestDistance then
				best, bestDistance = index, distance
			end
		end
	end
	return best
end

local function cookableTool()
	local char = LocalPlayer.Character
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("IsCookable") == true then
				return child, "hand"
			end
		end
	end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("IsCookable") == true then
				return child, "backpack"
			end
		end
	end
	return nil
end

