local function categoryOf(itemName)
	if type(itemName) ~= "string" or itemName == "" then
		return "Other"
	end
	return ITEM_CATEGORY[itemName] or "Other"
end

local function itemPosition(model)
	local ok, position = pcall(function()
		return model:GetPivot().Position
	end)
	if ok and typeof(position) == "Vector3" then
		return position
	end
	local part = model:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

local function itemBounds(model)
	local ok, position, size = pcall(function()
		local cframe, bounds = model:GetBoundingBox()
		return cframe.Position, bounds
	end)
	if ok and typeof(position) == "Vector3" and typeof(size) == "Vector3" then
		return position, size
	end
	local part = model:FindFirstChildWhichIsA("BasePart", true)
	if part then
		return part.Position, part.Size
	end
	return nil, nil
end

