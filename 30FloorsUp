--------------------------------------------------------------------------------
-- Loops
--------------------------------------------------------------------------------

local frameAccumulator = 0
local scanAccumulator = 0
local heartbeat = nil

heartbeat = RunService.Heartbeat:Connect(function(dt)
	frameAccumulator = frameAccumulator + dt
	scanAccumulator = scanAccumulator + dt

	if scanAccumulator >= 1 then
		scanAccumulator = 0
		if ESP.Enabled and ESP.drawingOk then
			local ok, err = pcall(function()
				ESP.targets = scanTargets()
			end)
			if not ok then
				reportError("esp scan", err)
			end
		end
	end

	if frameAccumulator >= 0.05 then
		frameAccumulator = 0
		if ESP.Enabled and ESP.drawingOk then
			local ok, err = pcall(updateVisuals)
			if not ok then
				reportError("esp draw", err)
			end
		end

		local ok, err = pcall(function()
			local v = vitals()
			local now = os.clock()

			if Survival.AutoEat and v.food < Survival.WarnFood and now - Survival.lastEat > 3 then
				if FOOD_SET[v.held] then
					Survival.lastEat = now
					if consumeHeld("eat") then
						pushLog("<Success>Ate " .. escapeRich(v.held) .. "</Success>")
					end
				end
			end

			if Survival.AutoDrink and v.thirst < Survival.WarnThirst and now - Survival.lastDrink > 3 then
				if v.held ~= "" and categoryOf(v.held) == "Water" then
					Survival.lastDrink = now
					if consumeHeld("drink") then
						pushLog("<Success>Drank from " .. escapeRich(v.held) .. "</Success>")
					end
				end
			end

			if now - Survival.lastWarning > 25 then
				local warnings = {}
				if v.food < Survival.WarnFood then
					warnings[#warnings + 1] = "food"
				end
				if v.thirst < Survival.WarnThirst then
					warnings[#warnings + 1] = "water"
				end
				if #warnings > 0 then
					Survival.lastWarning = now
					Window:Notify({
						Title = "Survival",
						Content = "Low " .. table.concat(warnings, " and "),
						Type = "Warning",
					})
				end
			end
		end)
		if not ok then
			reportError("survival", err)
		end
	end
end)

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

local function destroy()
	stopLoot()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	clearVisuals()
	pcall(function()
		Window:Destroy()
	end)
	getgenv().RobScript30Floors = nil
end

local api = {}

api.Version = VERSION

api.StartLoot = function()
	if LootToggle and LootToggle.Set then
		LootToggle:Set(true)
	else
		startLoot()
	end
end

api.StopLoot = function()
	if LootToggle and LootToggle.Set then
		LootToggle:Set(false)
	else
		stopLoot()
	end
end

api.ToggleLoot = function()
	if Loot.Running then
		api.StopLoot()
	else
		api.StartLoot()
	end
end

api.SetESP = function(on)
	if ESPToggle and ESPToggle.Set then
		ESPToggle:Set(on and true or false)
	else
		ESP.Enabled = on and true or false
	end
end

api.SelectTab = function(name)
	local tabs = {
		Info = InfoTab,
		ESP = ESPTab,
		Scavenge = ScavengeTab,
		Survival = SurvivalTab,
		Settings = SettingsTab,
	}
	local tab = tabs[name]
	if not tab then
		return
	end
	pcall(function()
		if Window.Minimized then
			Window:Restore()
		end
		Window:SelectTab(tab)
		if Window.Open ~= true then
			Window:Toggle(true)
		end
	end)
end

api.OpenUI = function()
	pcall(function()
		if Window.Minimized then
			Window:Restore()
		end
		if Window.Open ~= true then
			Window:Toggle(true)
		end
	end)
end

api.GetWindow = function()
	return Window
end

api.CloseUI = function()
	pcall(function()
		if Window.Open == true then
			Window:Toggle(false)
		end
	end)
end

api.GetState = stateSnapshot
api.GetVitals = vitals

api.GetLootStats = function()
	return { picked = Loot.Picked, failed = Loot.Failed, last = Loot.lastMessage }
end

api.GetLastError = function()
	return lastError
end

api.Destroy = destroy

getgenv().RobScript30Floors = api

Window:LoadAutoload()

