local function drawingLibrary()
	return rawget(getgenv(), "Drawing") or rawget(getfenv(0), "Drawing")
end

local function drawingAvailable()
	local library = drawingLibrary()
	return type(library) == "table" and type(library.new) == "function"
end

local function newDrawing(kind)
	local library = drawingLibrary()
	if type(library) ~= "table" then
		return nil
	end
	local ok, object = pcall(library.new, kind)
	if ok then
		return object
	end
	return nil
end

local function createVisual()
	local box = newDrawing("Square")
	local label = newDrawing("Text")
	if box then
		box.Thickness = 1
		box.Filled = false
		box.Visible = false
	end
	if label then
		label.Size = 14
		label.Center = false
		label.Outline = true
		label.Visible = false
	end
	return { box = box, label = label }
end

local function destroyVisual(visual)
	if not visual then
		return
	end
	if visual.box then
		pcall(function()
			visual.box:Remove()
		end)
	end
	if visual.label then
		pcall(function()
			visual.label:Remove()
		end)
	end
end

--------------------------------------------------------------------------------
-- ESP
--------------------------------------------------------------------------------

local ESP = {
	Enabled = false,
	MaxDistance = 250,
	ShowInfected = true,
	ShowDistance = true,
	Categories = { Food = true, Water = true, Medical = true, Keys = true, Weapons = true, Notes = true },
	targets = {},
	visuals = {},
	scanAt = 0,
	drawingOk = drawingAvailable(),
}

local INFECTED_COLOR = Color3.fromRGB(255, 70, 70)

local function espCategoryEnabled(category)
	if category == "Infected" then
		return ESP.ShowInfected
	end
	if category == "Other" then
		return ESP.Categories.Other == true
	end
	return ESP.Categories[category] == true
end

local function scanTargets()
	local list = {}
	local origin = characterPart()
	if not origin then
		return list
	end
	local originPos = origin.Position

	local items = itemsFolder()
	if items then
		for _, model in ipairs(items:GetChildren()) do
			if model:IsA("Model") then
				local itemName = model:GetAttribute("Item")
				local uid = model:GetAttribute("Uid")
				if itemName and uid and model:GetAttribute("NoTake") ~= true then
					local category = categoryOf(itemName)
					if espCategoryEnabled(category) then
						local position, size = itemBounds(model)
						if position and (position - originPos).Magnitude <= ESP.MaxDistance then
							list[#list + 1] = {
								object = model,
								position = position,
								size = size or Vector3.new(2, 2, 2),
								category = category,
								label = itemName,
								live = false,
							}
						end
					end
				end
			end
		end
	end

	local npcs = npcFolder()
	if npcs and ESP.ShowInfected then
		for _, model in ipairs(npcs:GetChildren()) do
			if model:IsA("Model") and model:GetAttribute("Infected") == true then
				local position = itemPosition(model)
				if position and (position - originPos).Magnitude <= ESP.MaxDistance then
					list[#list + 1] = {
						object = model,
						position = position,
						size = Vector3.new(3, 5.5, 3),
						category = "Infected",
						label = string.format("%s [%s]", tostring(model:GetAttribute("DisplayName") or model.Name), tostring(model:GetAttribute("InfKind") or "Infected")),
						live = true,
					}
				end
			end
		end
	end

	return list
end

local function projectBounds(camera, position, size)
	local half = size * 0.5
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local visible = false
	for _, x in ipairs({ -1, 1 }) do
		for _, y in ipairs({ -1, 1 }) do
			for _, z in ipairs({ -1, 1 }) do
				local world = position + Vector3.new(half.X * x, half.Y * y, half.Z * z)
				local screen, onScreen = camera:WorldToViewportPoint(world)
				if screen.Z > 0 and onScreen then
					visible = true
					minX = math.min(minX, screen.X)
					minY = math.min(minY, screen.Y)
					maxX = math.max(maxX, screen.X)
					maxY = math.max(maxY, screen.Y)
				end
			end
		end
	end
	if not visible or maxX <= minX or maxY <= minY then
		return nil
	end
	return minX, minY, maxX, maxY
end

local function updateVisuals()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = characterPart()
	local originPos = origin and origin.Position or Vector3.zero
	local seen = {}

	for _, entry in ipairs(ESP.targets) do
		local visual = ESP.visuals[entry.object]
		if not visual then
			visual = createVisual()
			ESP.visuals[entry.object] = visual
		end

		local position = entry.position
		if entry.live then
			local live = itemPosition(entry.object)
			if live then
				position = live
				entry.position = live
			end
		end

		local distance = (position - originPos).Magnitude
		local minX, minY, maxX, maxY = nil, nil, nil, nil
		if distance <= ESP.MaxDistance then
			minX, minY, maxX, maxY = projectBounds(camera, position, entry.size)
		end

		if minX and visual.box and visual.label then
			local color = entry.category == "Infected" and INFECTED_COLOR or CATEGORY_COLORS[entry.category] or CATEGORY_COLORS.Other

			visual.box.Color = color
			visual.box.Position = Vector2.new(minX, minY)
			visual.box.Size = Vector2.new(maxX - minX, maxY - minY)
			visual.box.Visible = true

			visual.label.Text = ESP.ShowDistance and string.format("%s  %.0f", entry.label, distance) or entry.label
			visual.label.Color = color
			visual.label.Position = Vector2.new(minX, minY - 16)
			visual.label.Visible = true

			seen[entry.object] = true
		end
	end

	for object, visual in pairs(ESP.visuals) do
		if not seen[object] then
			if visual.box then
				visual.box.Visible = false
			end
			if visual.label then
				visual.label.Visible = false
			end
		end
	end
end

local function clearVisuals()
	for object, visual in pairs(ESP.visuals) do
		destroyVisual(visual)
		ESP.visuals[object] = nil
	end
	ESP.targets = {}
end

--------------------------------------------------------------------------------
-- Act bridge
--------------------------------------------------------------------------------

local function callAct(payload)
	local act = remoteObject("Act")
	if not act then
		return { ok = false, msg = "Act remote missing" }
	end
	local ok, result = pcall(function()
		return act:InvokeServer(payload)
	end)
	if not ok then
		return { ok = false, msg = tostring(result) }
	end
	if type(result) ~= "table" then
		return { ok = false, msg = "no answer" }
	end
	return result
end

--------------------------------------------------------------------------------
-- Auto loot
--------------------------------------------------------------------------------

local Loot = {
	Running = false,
	Radius = 220,
	Delay = 0.35,
	Categories = { Food = true, Water = true, Medical = true, Keys = true, Tools = true, Weapons = true, Notes = true, Gear = true },
	Picked = 0,
	Failed = 0,
	Blacklist = {},
	lastMessage = "",
}

local function lootCategoryEnabled(category)
	if category == "Other" then
		return Loot.Categories.Other == true
	end
	return Loot.Categories[category] == true
end

local function isBlacklisted(uid)
	local untilTime = Loot.Blacklist[uid]
	if not untilTime then
		return false
	end
	if os.clock() >= untilTime then
		Loot.Blacklist[uid] = nil
		return false
	end
	return true
end

local function blacklist(uid, seconds)
	Loot.Blacklist[uid] = os.clock() + (seconds or 90)
end

local function chooseLootTarget()
	local folder = itemsFolder()
	local origin = characterPart()
	if not (folder and origin) then
		return nil
	end
	local originPos = origin.Position
	local best, bestDistance = nil, math.huge
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local itemName = model:GetAttribute("Item")
			local uid = model:GetAttribute("Uid")
			if itemName and uid and model:GetAttribute("NoTake") ~= true and not model:GetAttribute("LatchedIn") then
				if not isBlacklisted(uid) and lootCategoryEnabled(categoryOf(itemName)) then
					local position = itemPosition(model)
					if position then
						local distance = (position - originPos).Magnitude
						if distance <= Loot.Radius and distance < bestDistance then
							best = { model = model, uid = uid, position = position, itemName = itemName }
							bestDistance = distance
						end
					end
				end
			end
		end
	end
	return best
end

local function teleportNextTo(position)
	local root = characterPart()
	if not root then
		return false
	end
	local current = root.Position
	local horizontal = Vector3.new(current.X - position.X, 0, current.Z - position.Z)
	if horizontal.Magnitude < 0.5 then
		horizontal = Vector3.new(0, 0, 1)
	end
	horizontal = horizontal.Unit
	local stand = position + horizontal * 2.4
	local y = position.Y + 2.6
	if math.abs(current.Y - position.Y) < 5 then
		y = current.Y
	end
	pcall(function()
		root.CFrame = CFrame.new(Vector3.new(stand.X, y, stand.Z))
		root.AssemblyLinearVelocity = Vector3.zero
	end)
	task.wait(0.12)
	return true
end

local function requestPickup(uid)
	local root = characterPart()
	if not root then
		return { ok = false, msg = "no character" }
	end
	return callAct({
		kind = "item",
		action = "pickup",
		uid = uid,
		from = root.Position,
	})
end

local function pickupItem(target)
	local result = requestPickup(target.uid)
	if result and result.ok == true then
		Loot.Picked = Loot.Picked + 1
		Loot.lastMessage = "took " .. tostring(target.itemName)
		return true
	end

	local message = result and tostring(result.msg or "") or "no answer"
	if message:find("Too far", 1, true) then
		teleportNextTo(target.position)
		local retry = requestPickup(target.uid)
		if retry and retry.ok == true then
			Loot.Picked = Loot.Picked + 1
			Loot.lastMessage = "took " .. tostring(target.itemName)
			return true
		end
		message = retry and tostring(retry.msg or message) or message
	end

	Loot.Failed = Loot.Failed + 1
	Loot.lastMessage = message
	blacklist(target.uid, 90)
	return false
end

local lootThread = nil

local function startLoot()
	if Loot.Running then
		return
	end
	Loot.Running = true
	lootThread = task.spawn(function()
		while Loot.Running do
			local ok, err = pcall(function()
				local target = chooseLootTarget()
				if not target then
					task.wait(0.8)
					return
				end
				teleportNextTo(target.position)
				if Loot.Running then
					pickupItem(target)
				end
			end)
			if not ok then
				reportError("auto loot", err)
				task.wait(1)
			end
			task.wait(Loot.Delay)
		end
	end)
end

local function stopLoot()
	Loot.Running = false
end

