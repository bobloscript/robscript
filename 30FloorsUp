local function tfuRoot()
	return ReplicatedStorage:FindFirstChild("TFU")
end

local function remotesFolder()
	local root = tfuRoot()
	return root and root:FindFirstChild("Remotes")
end

local function stateFolder()
	local root = tfuRoot()
	return root and root:FindFirstChild("State")
end

local function remoteObject(name)
	local remotes = remotesFolder()
	if not remotes then
		return nil
	end
	return remotes:FindFirstChild(name)
end

local function playerAttr(name, fallback)
	local value = LocalPlayer:GetAttribute(name)
	if value == nil then
		return fallback
	end
	return value
end

local function stateAttr(name, fallback)
	local folder = stateFolder()
	if not folder then
		return fallback
	end
	local value = folder:GetAttribute(name)
	if value == nil then
		return fallback
	end
	return value
end

local function characterPart()
	local character = LocalPlayer.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function worldRoot()
	return workspace:FindFirstChild("TFU")
end

local function itemsFolder()
	local root = worldRoot()
	return root and root:FindFirstChild("Items")
end

local function npcFolder()
	local root = worldRoot()
	return root and root:FindFirstChild("NPCs")
end

local function clockText(hour)
	local value = tonumber(hour) or 0
	local h = math.floor(value)
	local m = math.floor((value - h) * 60)
	return string.format("%02d:%02d", h % 24, m)
end

local function escapeRich(text)
	local value = tostring(text or "")
	value = value:gsub("&", "&amp;")
	value = value:gsub("<", "&lt;")
	value = value:gsub(">", "&gt;")
	return value
end

local function stateSnapshot()
