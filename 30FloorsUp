local function consumeHeld(action)
	local root = characterPart()
	if not root then
		return false
	end
	local result = callAct({
		kind = "none",
		action = action,
		from = root.Position,
	})
	if result and result.ok == true then
		return true
	end
	if result and result.msg and tostring(result.msg) ~= "" then
		Loot.lastMessage = tostring(result.msg)
	end
	return false
end

local function threatText()
	local snapshot = stateSnapshot()
	local day = snapshot.day
	local hour = snapshot.hour
	local parts = { "Raid on day 3 at 11:00", "Rain on day 6", "Migration on day 15 at 19:00" }

	if day == 3 and hour >= 11 and hour <= 15.5 then
		return "<Error>Raid is running right now</Error>"
	end
	if day == 15 and hour >= 19 and hour <= 23.5 then
		return "<Error>Migration is running right now</Error>"
	end
	if day < 3 then
		parts[1] = string.format("Raid in %d day(s)", 3 - day)
	end
	return table.concat(parts, "  |  ")
end

