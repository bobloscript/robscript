stopFly = function()
	for _, connection in ipairs(flyingConnections) do
		connection:Disconnect()
	end
	flyingConnections = {}
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end
	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
	local humanoid = getHumanoid()
	if humanoid then
		humanoid.PlatformStand = false
	end
end

startFly = function()
	stopFly()
	local humanoid = getHumanoid()
	local root = getRootPart()
	if not humanoid or not root then
		return
	end

	local velocity = Instance.new("BodyVelocity")
	velocity.Name = "RobScriptFlyVelocity"
	velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	velocity.Velocity = Vector3.zero
	velocity.Parent = root
	flyVelocity = velocity

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "RobScriptFlyGyro"
	gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	gyro.P = 4000
	gyro.D = 200
	gyro.Parent = root
	flyGyro = gyro

	humanoid.PlatformStand = true

	table.insert(
		flyingConnections,
		RunService.Heartbeat:Connect(function()
			local camera = getCamera()
			local currentRoot = getRootPart()
			if not flyEnabled or not camera or not currentRoot or not flyGyro or not flyVelocity then
				return
			end
			local direction = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction += camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction -= camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction += camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction -= camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				direction += Vector3.yAxis
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				direction -= Vector3.yAxis
			end
			if direction.Magnitude > 0 then
				direction = direction.Unit
			end
			flyVelocity.Velocity = direction * flySpeed
			flyGyro.CFrame = CFrame.new(currentRoot.Position, currentRoot.Position + camera.CFrame.LookVector)
		end)
	)
end

applyLighting = function()
	if fullBrightEnabled then
		if not lightingBackup.Brightness then
			lightingBackup.Brightness = Lighting.Brightness
			lightingBackup.ClockTime = Lighting.ClockTime
			lightingBackup.FogEnd = Lighting.FogEnd
			lightingBackup.Ambient = Lighting.Ambient
			lightingBackup.OutdoorAmbient = Lighting.OutdoorAmbient
			lightingBackup.GlobalShadows = Lighting.GlobalShadows
		end
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.GlobalShadows = false
	elseif lightingBackup.Brightness then
		Lighting.Brightness = lightingBackup.Brightness
		Lighting.ClockTime = lightingBackup.ClockTime
		Lighting.FogEnd = lightingBackup.FogEnd
		Lighting.Ambient = lightingBackup.Ambient
		Lighting.OutdoorAmbient = lightingBackup.OutdoorAmbient
		Lighting.GlobalShadows = lightingBackup.GlobalShadows
	end
end

applyParticles = function()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Enabled = not noParticlesEnabled
		end
	end
end

local function updateGlow()
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character and Players:GetPlayerFromCharacter(character) then
			local existing = character:FindFirstChild("RobScriptGlow")
			if glowEnabled and not existing then
				local highlight = Instance.new("Highlight")
				highlight.Name = "RobScriptGlow"
				highlight.Adornee = character
				highlight.FillColor = player == LocalPlayer and THEME.Accent or Color3.fromHex("#8FB8FF")
				highlight.FillTransparency = 0.65
				highlight.OutlineTransparency = 0.4
				highlight.DepthMode = Enum.HighlightDepthMode.Occluded
				highlight.Parent = character
			elseif not glowEnabled and existing then
				existing:Destroy()
			end
		end
	end
end

local function updateMovement()
	local humanoid = getHumanoid()
	if not humanoid then
		return
	end
	if walkSpeedEnabled then
		humanoid.WalkSpeed = walkSpeedValue
	end
	if jumpPowerEnabled then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = jumpPowerValue
	end
	if noclipEnabled then
		local character = getCharacter()
		if character then
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant.CanCollide = false
				end
			end
		end
	end
end

----- Automation implementation -----
local lastAntiAfk = 0
local lastAutomationTick = 0
local lastRespawnAttempt = 0

local function automationTick()
	local now = os.clock()

	if antiAfkEnabled and now - lastAntiAfk > 240 then
		lastAntiAfk = now
		pcall(function()
			mousemoverel(2, 0)
			task.wait(0.05)
			mousemoverel(-2, 0)
		end)
	end

	if now - lastAutomationTick < 0.75 then
		return
	end
	lastAutomationTick = now

	if autoKitEnabled then
		for _, prompt in ipairs(findPrompts("Select kit", autoKitName)) do
			if prompt.Enabled and promptInReach(prompt) then
				activatePrompt(prompt)
				break
			end
		end
	end

	if autoDifficultyEnabled then
		for _, prompt in ipairs(findPrompts("Vote", autoDifficultyName)) do
			if prompt.Enabled and promptInReach(prompt) then
				activatePrompt(prompt)
				break
			end
		end
	end

	if autoUpgradeEnabled then
		for _, prompt in ipairs(findPrompts("Upgrade weapon", nil)) do
			if prompt.Enabled and promptInReach(prompt) then
				activatePrompt(prompt)
				break
			end
		end
	end

	local humanoid = getHumanoid()
	if autoRespawnEnabled and (not humanoid or humanoid.Health <= 0) and now - lastRespawnAttempt > 2 then
		lastRespawnAttempt = now
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			for _, gui in ipairs(playerGui:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Enabled then
					local button = findButtonByText(gui, "respawn")
						or findButtonByText(gui, "redeploy")
						or findButtonByText(gui, "reinforce")
					if button then
						fireGuiButton(button)
						break
					end
				end
			end
		end
	end

	if autoDialogsEnabled then
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			for _, name in ipairs({ "CommanderDialogue", "CasualtyReports", "Cutscenes", "LevelUp" }) do
				local gui = playerGui:FindFirstChild(name)
				if gui and gui:IsA("ScreenGui") and gui.Enabled then
					local button = findButtonByText(gui, "continue")
						or findButtonByText(gui, "next")
						or findButtonByText(gui, "skip")
					if button then
						fireGuiButton(button)
					end
				end
			end
		end
	end

	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		local votingGui = playerGui:FindFirstChild("GamemodeVoting")
		if votingGui and votingGui:IsA("ScreenGui") and votingGui.Enabled then
			if autoGamemodeEnabled and not votedGamemodeRound then
				for _, descendant in ipairs(votingGui:GetDescendants()) do
					if descendant:IsA("ImageButton") and string.lower(descendant.Name) == string.lower(autoGamemodeName) then
						votedGamemodeRound = fireGuiButton(descendant)
						Log:Push("Gamemode vote: <Accent>" .. escapeRichText(autoGamemodeName) .. "</Accent>")
						break
					end
				end
			end
		else
			votedGamemodeRound = false
		end

		local mapGui = playerGui:FindFirstChild("MapVoting")
		if mapGui and mapGui:IsA("ScreenGui") and mapGui.Enabled then
			if autoMapEnabled and not votedMapRound and autoMapName ~= "" then
				for _, descendant in ipairs(mapGui:GetDescendants()) do
					if descendant:IsA("TextLabel") and descendant.Name == "MapName" then
						if string.find(string.lower(descendant.Text), string.lower(autoMapName), 1, true) then
							local container = descendant.Parent
							local button = container and container:FindFirstChildWhichIsA("GuiButton")
							if not button and container and container.Parent then
								button = container.Parent:FindFirstChildWhichIsA("GuiButton")
							end
							if button then
								votedMapRound = fireGuiButton(button)
								Log:Push("Map vote: <Accent>" .. escapeRichText(descendant.Text) .. "</Accent>")
								break
							end
						end
					end
				end
			end
		else
			votedMapRound = false
		end
	end
end

