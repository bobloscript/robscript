----- Helpers -----
local function formatNumber(value: number?): string
	if not value then
		return "--"
	end
	if math.abs(value) >= 1e6 then
		return string.format("%.2fM", value / 1e6)
	elseif math.abs(value) >= 1e4 then
		return string.format("%.1fK", value / 1e3)
	end
	return tostring(math.floor(value * 100) / 100)
end

local function formatTime(seconds: number?): string
	if not seconds then
		return "--"
	end
	local total = math.max(0, math.floor(seconds))
	local hours = math.floor(total / 3600)
	local minutes = math.floor((total % 3600) / 60)
	return string.format("%dh %02dm", hours, minutes)
end

local function escapeRichText(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function getCharacter(): Model?
	local character = LocalPlayer.Character
	if character and character:FindFirstChildOfClass("Humanoid") then
		return character
	end
	return nil
end

local function getHumanoid(): Humanoid?
	local character = getCharacter()
	if character then
		return character:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

local function getRootPart(): BasePart?
	local character = getCharacter()
	local humanoid = getHumanoid()
	if character and humanoid and humanoid.RootPart then
		return humanoid.RootPart
	end
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root
		end
	end
	return nil
end

local function getCamera(): Camera?
	return workspace.CurrentCamera
end

local function unitRoot(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return model:FindFirstChildWhichIsA("BasePart")
end

local function averageTransparency(model: Model): number
	local total, count = 0, 0
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			total += descendant.Transparency
			count += 1
		end
	end
	if count == 0 then
		return 0
	end
	return total / count
end

local function rankName(unitType: string, structure: boolean, hazard: boolean): string
	if structure then
		return "Structure"
	elseif hazard then
		return "Hazard"
	elseif BOSS_TYPES[unitType] then
		return "Boss"
	elseif ELITE_TYPES[unitType] then
		return "Elite"
	elseif SPECIAL_TYPES[unitType] then
		return "Special"
	end
	return "Basic"
end

local function scanUnits(): { UnitRecord }
	local result = {}
	local characterRoot = getRootPart()
	local origin = characterRoot and characterRoot.Position or nil

	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and Players:GetPlayerFromCharacter(model) == nil then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = unitRoot(model)
			local unitType = model:GetAttribute("Type")
			if humanoid and root and typeof(unitType) == "string" then
				local structure = STRUCTURE_TYPES[unitType] == true
				local hazard = HAZARD_TYPES[unitType] == true
				local rank = rankName(unitType, structure, hazard)
				local distance = origin and (root.Position - origin).Magnitude or 0
				table.insert(result, {
					model = model,
					humanoid = humanoid,
					root = root,
					name = unitType,
					rank = rank,
					color = RANK_COLORS[rank] or RANK_COLORS.Basic,
					health = humanoid.Health,
					maxHealth = math.max(1, humanoid.MaxHealth),
					distance = distance,
					cloaked = not structure and not hazard and averageTransparency(model) > 0.45,
					structure = structure,
					hazard = hazard,
				})
			end
		end
	end
	return result
end

local function findPrompts(actionText: string, objectName: string?): { ProximityPrompt }
	local result = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") and descendant.ActionText == actionText then
			local parent = descendant.Parent
			if objectName == nil or (parent ~= nil and parent.Name == objectName) then
				table.insert(result, descendant)
			end
		end
	end
	return result
end

local function promptPosition(prompt: ProximityPrompt): Vector3?
	local parent = prompt.Parent
	if not parent then
		return nil
	end
	if parent:IsA("BasePart") then
		return parent.Position
	elseif parent:IsA("Model") then
		local root = unitRoot(parent)
		return root and root.Position or nil
	elseif parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function activatePrompt(prompt: ProximityPrompt): boolean
	if FirePrompt then
		local ok = pcall(FirePrompt, prompt)
		if ok then
			return true
		end
	end
	local began = pcall(function()
		prompt:InputHoldBegin()
	end)
	if began then
		task.delay(0.15, function()
			pcall(function()
				prompt:InputHoldEnd()
			end)
		end)
		return true
	end
	return false
end

local function promptInReach(prompt: ProximityPrompt): boolean
	if ignorePromptDistance then
		return true
	end
	local root = getRootPart()
	if not root then
		return false
	end
	local position = promptPosition(prompt)
	if not position then
		return false
	end
	return (position - root.Position).Magnitude <= math.max(prompt.MaxActivationDistance, 12) + 4
end

local function fireGuiButton(button: GuiButton): boolean
	local fired = false
	if GetConnections then
		pcall(function()
			for _, connection in ipairs(GetConnections(button.MouseButton1Click)) do
				if typeof(connection.Function) == "function" then
					task.spawn(function()
						pcall(connection.Function, button, 0, 0)
					end)
					fired = true
				elseif typeof(connection.Fire) == "function" then
					task.spawn(function()
						pcall(connection.Fire)
					end)
					fired = true
				end
			end
		end)
	end
	if not fired then
		pcall(function()
			button:Activate()
		end)
	end
	return fired
end

local function findButtonByText(root: Instance, keyword: string): GuiButton?
	local lower = string.lower(keyword)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			local text = descendant:IsA("TextButton") and descendant.Text or ""
			if string.find(string.lower(text), lower, 1, true) then
				return descendant
			end
		end
	end
	return nil
end

