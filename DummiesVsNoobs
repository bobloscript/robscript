Environment.UgcHubDestroy = function()
	for _, connection in ipairs(activeConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	activeConnections = {}
	stopFly()
	clearEsp()

	-- Clean up traces left by the visual features.
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("Highlight") and (descendant.Name == "RobScriptHighlight" or descendant.Name == "RobScriptGlow") then
			pcall(function()
				descendant:Destroy()
			end)
		end
		if descendant:IsA("BillboardGui") and descendant.Name == "RobScriptESP" then
			pcall(function()
				descendant:Destroy()
			end)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local glow = character and character:FindFirstChild("RobScriptGlow")
		if glow then
			glow:Destroy()
		end
	end

	if fovCircle then
		pcall(function()
			fovCircle:Remove()
		end)
		fovCircle = nil
	end
end
