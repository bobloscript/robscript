----- Main loop -----
local unitAccumulator = 0
local espAccumulator = 0
local glowAccumulator = 0
local particlesAccumulator = 0
local automationAccumulator = 0

table.insert(
	activeConnections,
	RunService.Heartbeat:Connect(function(deltaTime)
		unitAccumulator += deltaTime
		if unitAccumulator >= 0.15 then
			unitAccumulator = 0
			liveUnits = scanUnits()
		end

		updateMovement()

		if aimbotEnabled or autoShoot then
			updateAim(deltaTime)
		else
			currentAimTarget = nil
		end

		espAccumulator += deltaTime
		if espAccumulator >= 0.15 then
			espAccumulator = 0
			updateEsp()
		end

		if noParticlesEnabled then
			particlesAccumulator += deltaTime
			if particlesAccumulator >= 5 then
				particlesAccumulator = 0
				applyParticles()
			end
		end

		if glowEnabled then
			glowAccumulator += deltaTime
			if glowAccumulator >= 1 then
				glowAccumulator = 0
				updateGlow()
			end
		end

		automationAccumulator += deltaTime
		if automationAccumulator >= 0.25 then
			automationAccumulator = 0
			automationTick()
		end
	end)
)

