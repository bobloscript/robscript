	barFill.BackgroundColor3 = Color3.fromHex("#6EE7B7")
	barFill.BorderSizePixel = 0
	barFill.Parent = barBackground

	return billboard, title, info, barBackground, barFill
end

local function healthColor(ratio: number): Color3
	if ratio > 0.6 then
		return Color3.fromHex("#6EE7B7")
	elseif ratio > 0.3 then
		return Color3.fromHex("#FFD84D")
	end
	return Color3.fromHex("#FF5C5C")
end

clearEspFor = function(model: Model)
	local entry = espCache[model]
	if not entry then
		return
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
	if entry.billboard then
		entry.billboard:Destroy()
	end
	if entry.tracer then
		pcall(function()
			entry.tracer.Visible = false
			entry.tracer:Remove()
		end)
	end
	espCache[model] = nil
end

clearEsp = function()
	local models = {}
	for model in pairs(espCache) do
		table.insert(models, model)
	end
	for _, model in ipairs(models) do
		clearEspFor(model)
	end
end

local function updateTracer(entry: EspEntry, unit: UnitRecord)
	if not espTracers then
		if entry.tracer then
			pcall(function()
				entry.tracer.Visible = false
			end)
		end
		return
	end

	local camera = getCamera()
	if not camera or unit.structure then
		return
	end

	local point, onScreen = camera:WorldToViewportPoint(unit.root.Position)
	if not onScreen then
		if entry.tracer then
			entry.tracer.Visible = false
		end
		return
	end

	if not entry.tracer then
		entry.tracer = Drawing.new("Line")
		entry.tracer.Thickness = 1
		entry.tracer.Transparency = 0.6
	end

	local line = entry.tracer
	line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
	line.To = Vector2.new(point.X, point.Y)
	line.Color = unit.color
	line.Visible = true
end

local function updateEsp()
	local seen: { [Model]: boolean } = {}

	for _, unit in ipairs(liveUnits) do
		local model = unit.model
		local wanted = espEnabled
			and unit.distance <= espMaxDistance
			and (not unit.structure or espStructures)
			and (not unit.hazard or espHazards)
		if wanted then
			seen[model] = true
			local entry = espCache[model]
			if not entry then
				entry = {}
				espCache[model] = entry
			end

			if espHighlights then
				if not entry.highlight or entry.highlight.Parent ~= model then
					if entry.highlight then
						entry.highlight:Destroy()
					end
					local highlight = Instance.new("Highlight")
					highlight.Name = "RobScriptHighlight"
					highlight.Adornee = model
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = model
					entry.highlight = highlight
				end
				entry.highlight.FillColor = unit.color
				entry.highlight.OutlineColor = unit.color
				entry.highlight.FillTransparency = unit.cloaked and 0.92 or 0.72
				entry.highlight.OutlineTransparency = 0.15
			elseif entry.highlight then
				entry.highlight:Destroy()
				entry.highlight = nil
			end

			if espNameplates then
				if not entry.billboard or entry.billboard.Parent ~= model then
					if entry.billboard then
						entry.billboard:Destroy()
					end
					local billboard, title, info, barBackground, barFill = makeBillboard(unit.root)
					billboard.Parent = model
					entry.billboard = billboard
					entry.title = title
					entry.info = info
					entry.barBackground = barBackground
					entry.barFill = barFill
				end
				local billboard = entry.billboard :: BillboardGui
				billboard.Adornee = unit.root
				billboard.MaxDistance = espMaxDistance
				if entry.title then
					local suffix = unit.cloaked and " (cloak)" or (unit.structure and " [build]" or "")
					entry.title.Text = unit.name .. suffix
					entry.title.TextColor3 = unit.color
				end
				if entry.info then
					entry.info.Text = string.format(
						"HP %d/%d · %dm",
						math.floor(unit.health),
						math.floor(unit.maxHealth),
						math.floor(unit.distance)
					)
				end
				if entry.barFill and entry.barBackground then
					local ratio = math.clamp(unit.health / unit.maxHealth, 0, 1)
					entry.barFill.Size = UDim2.fromScale(ratio, 1)
					entry.barFill.BackgroundColor3 = healthColor(ratio)
					entry.barBackground.Visible = not unit.structure
				end
			elseif entry.billboard then
				entry.billboard:Destroy()
				entry.billboard = nil
			end

			updateTracer(entry, unit)
		end
	end

	local stale = {}
	for model in pairs(espCache) do
		if not seen[model] or model.Parent == nil then
			table.insert(stale, model)
		end
	end
	for _, model in ipairs(stale) do
		clearEspFor(model)
	end
end

----- Aim implementation -----
local fovCircle: any = nil
if Drawing then
	local circle = Drawing.new("Circle")
	circle.Thickness = 1
	circle.NumSides = 64
	circle.Color = THEME.Accent
	circle.Transparency = 0.5
	circle.Filled = false
	circle.Visible = false
	fovCircle = circle
end

local function screenDistance(unit: UnitRecord): number?
	local camera = getCamera()
	if not camera then
		return nil
	end
	local position, onScreen = camera:WorldToViewportPoint(unit.root.Position)
	if not onScreen then
		return nil
	end
	return (Vector2.new(position.X, position.Y) - camera.ViewportSize / 2).Magnitude
end

local function isVisible(unit: UnitRecord): boolean
	local camera = getCamera()
	local character = getCharacter()
	if not camera or not character then
		return true
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.IgnoreWater = true
	local result = workspace:Raycast(camera.CFrame.Position, unit.root.Position - camera.CFrame.Position, parameters)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(unit.model)
end

local function findAimTarget(): UnitRecord?
	local best: UnitRecord? = nil
	local bestDistance = math.huge
	for _, unit in ipairs(liveUnits) do
		if not unit.structure and not unit.hazard and unit.health > 0 and unit.distance <= aimbotMaxDistance then
			local distance = screenDistance(unit)
			if distance and distance <= aimbotFov and distance < bestDistance then
				if not aimbotVisibleOnly or isVisible(unit) then
					best = unit
					bestDistance = distance
				end
			end
		end
	end
	return best
end

local function updateAim(deltaTime: number)
	currentAimTarget = findAimTarget()

	local camera = getCamera()
	local shouldAim = aimbotEnabled and currentAimTarget ~= nil and (aiming or aimKeyValue == nil)

	if fovCircle then
		fovCircle.Visible = aimbotEnabled and camera ~= nil
		if camera then
			fovCircle.Position = camera.ViewportSize / 2
			fovCircle.Radius = aimbotFov
		end
	end

	if shouldAim and camera and currentAimTarget then
		local part = currentAimTarget.model:FindFirstChild(aimbotPart)
		local targetPart = part and part:IsA("BasePart") and part or currentAimTarget.root
		local aimPosition = targetPart.Position
		local velocity = targetPart.AssemblyLinearVelocity
		if velocity.Magnitude > 1 then
			local travel = (aimPosition - camera.CFrame.Position).Magnitude / 900
			aimPosition = aimPosition + velocity * travel
		end
		local desired = CFrame.lookAt(camera.CFrame.Position, aimPosition)
		local alpha = math.clamp(deltaTime * aimbotSmoothness, 0, 1)
		camera.CFrame = camera.CFrame:Lerp(desired, alpha)
	end

	if autoShoot and MouseClick and currentAimTarget and camera then
		local targetScreen = screenDistance(currentAimTarget)
		if targetScreen and targetScreen <= aimbotFov and os.clock() - lastShot > 0.06 then
			lastShot = os.clock()
			pcall(MouseClick)
		end
	end
end

