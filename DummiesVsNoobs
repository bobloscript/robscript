-- Airflow does not always remove its ScreenGui, so drop leftovers by name.
local function purgeHubGuis()
	local roots = { game:GetService("CoreGui") }
	local hiddenGui = typeof(gethui) == "function" and gethui() or nil
	if hiddenGui then
		table.insert(roots, hiddenGui)
	end
	for _, root in ipairs(roots) do
		local targets = {}
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:IsA("ScreenGui") then
				local isHubGui = descendant.Name == HUB_NAME
				if not isHubGui then
					for _, legacy in ipairs(LEGACY_GUI_NAMES) do
						if descendant.Name == legacy then
							isHubGui = true
							break
						end
					end
				end
				if isHubGui then
					table.insert(targets, descendant)
				end
			end
		end
		for _, target in ipairs(targets) do
			pcall(function()
				target:Destroy()
			end)
		end
	end
end

