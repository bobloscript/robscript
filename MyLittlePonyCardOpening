----- Runtime -----

local function cleanup()
	if STOP then
		return
	end
	STOP = true
	local waited = 0
	while (packLock or pairsLock) and waited < 2 do
		task.wait(0.1)
		waited = waited + 0.1
	end
	for _, connection in ipairs(CONNECTIONS) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	CONNECTIONS = {}
	pcall(function()
		WINDOW:Destroy()
	end)
	getgenv().RobScriptTS = nil
end

API = {
	Version = VERSION,
	Destroy = cleanup,
	Airflow = Airflow,
	State = S,
	Stats = STATS,
	Profile = PROFILE,
	Actions = {
		OpenOne = function(setId)
			refreshProfile()
			if packCount(setId) <= 0 then
				buyOne(setId)
			end
			if packCount(setId) > 0 then
				return openOne(setId)
			end
			return false
		end,
		SellDuplicates = function()
			refreshProfile()
			return sellDuplicates(true)
		end,
		PlayBoard = function()
			local ok, deal = invoke("Memory", "deal")
			if not (ok and type(deal) == "table" and type(deal.faces) == "table") then
				return nil, "table is busy"
			end
			local wasOn = S.PairsOn
			S.PairsOn = true
			local state = playBoard()
			S.PairsOn = wasOn
			return state
		end,
		Refresh = refreshProfile,
		StartPacks = enablePacks,
		StartPairs = enablePairs,
		Sync = function()
			pushToGame(PROFILE, true)
		end,
		GameStore = function()
			return gameStore()
		end,
	},
}
