local function cardInfo(cardId)
	local card = CardData.ById[cardId]
	if not card then
		return nil, nil, nil
	end
	local rarity = CardData.Rarities[card.rarity]
	return card, card.rarity, rarity
end

local function rarityUnderTier(cardId, tier)
	local _, rarityKey, rarity = cardInfo(cardId)
	if not rarity then
		return false
	end
	return rarity.tier <= tier
end

local function tierName(tier)
	local bestKey, bestTier = nil, -1
	for key, rarity in pairs(CardData.Rarities) do
		if rarity.tier <= tier and rarity.tier > bestTier then
			bestKey, bestTier = key, rarity.tier
		end
	end
	return bestKey or "N"
end

----- Game client bridge -----

-- The game keeps its own copy of the profile in PlayerScripts.Client.Store and repaints the HUD, the binder,
-- the shelf and the desk whenever that copy changes. Calls made from the hub never touch that copy, so a
-- pack opened from here would show up in the hub but not in the game. Every payload is therefore pushed back
-- through Store.applySnapshot - the very function the game itself uses after its own remote calls.

local GameStore = nil
local lastPush = 0
local lastSignature = ""
local pendingProfile = nil
local pendingScheduled = false

local function profileSignature(profile)
	local owned, packs = 0, 0
	for _, count in pairs(profile.owned or {}) do
		owned = owned + count
	end
	for _, count in pairs(profile.packs or {}) do
		packs = packs + count
	end
	return string.format("%d|%d|%d", profile.money or -1, owned, packs)
end

local function gameStore()
	if GameStore ~= nil then
		return GameStore or nil
	end
	local ok, store = pcall(function()
		return require(LocalPlayer.PlayerScripts.Client.Store)
	end)
	if ok and type(store) == "table" and type(store.applySnapshot) == "function" then
		GameStore = store
	else
		GameStore = false
	end
	return GameStore or nil
end

local function pushToGame(profile, force)
	if type(profile) ~= "table" then
		return
	end
	if type(profile.money) ~= "number" or type(profile.owned) ~= "table" or type(profile.packs) ~= "table" then
		return
	end
	local store = gameStore()
	if not store then
		return
	end
	local signature = profileSignature(profile)
	if not force and signature == lastSignature then
		return
	end
	if not force and os.clock() - lastPush < 0.35 then
		-- Too soon after the previous repaint: keep the newest state and flush it once the gap is over,
		-- otherwise a quick buy-then-open would leave a phantom pack in the game's own copy.
		pendingProfile = profile
		if not pendingScheduled then
			pendingScheduled = true
			task.delay(0.4, function()
				pendingScheduled = false
				local queued = pendingProfile
				pendingProfile = nil
				if queued then
					pushToGame(queued, true)
				end
			end)
		end
		return
	end
	lastPush = os.clock()
	lastSignature = signature
	if not pcall(store.applySnapshot, profile) then
		GameStore = false
	end
end

----- Profile -----

local PROFILE = {
	money = 0,
	packs = {},
	owned = {},
	fav = {},
	shelf = {},
	display = { rows = {} },
}

local function applyProfile(profile)
	if type(profile) ~= "table" then
		return
	end
	if type(profile.money) == "number" then
		PROFILE.money = profile.money
	end
	if type(profile.packs) == "table" then
		PROFILE.packs = profile.packs
	end
	if type(profile.owned) == "table" then
		PROFILE.owned = profile.owned
	end
	if type(profile.fav) == "table" then
		PROFILE.fav = profile.fav
	end
	if type(profile.shelf) == "table" then
		PROFILE.shelf = profile.shelf
	end
	if type(profile.display) == "table" then
		PROFILE.display = profile.display
	end
	pushToGame(profile)
end

local function invoke(name, ...)
	local remote = Remotes:FindFirstChild(name)
	if not remote or not remote:IsA("RemoteFunction") then
		return false
	end
	local results = table.pack(pcall(function(...)
		return remote:InvokeServer(...)
	end, ...))
	if not results[1] then
		return false
	end
	for index = 2, results.n do
		local value = results[index]
		if type(value) == "table" then
			return true, value
		end
	end
	return true, nil
end

local function refreshProfile()
	local ok, profile = invoke("GetProfile")
	if ok and type(profile) == "table" then
		applyProfile(profile)
	end
	return PROFILE
end

local function packCount(setId)
	return (PROFILE.packs or {})[setId] or 0
end

local function ownedCount(cardId)
	return (PROFILE.owned or {})[cardId] or 0
end

----- Duplicates -----

local function shelfCopies(cardId)
	local total = 0
	for _, value in pairs(PROFILE.shelf or {}) do
		if value == cardId then
			total = total + 1
		end
	end
	return total
end

local function displayCopies(cardId)
	local total = 0
	local rows = (PROFILE.display or {}).rows or {}
	for _, row in ipairs(rows) do
		for _, slot in ipairs(row.s or {}) do
			if type(slot) == "string" and slot:sub(1, #cardId + 3) == "c:" .. cardId .. ":" then
				total = total + 1
				break
			end
		end
	end
	return total
end

local function keepFor(cardId)
	return math.max(1, S.Keep) + shelfCopies(cardId) + displayCopies(cardId)
end

local function buildSellPlan()
	local plan, total = {}, 0
	for cardId, count in pairs(PROFILE.owned or {}) do
		local keep = keepFor(cardId)
		if count > keep and rarityUnderTier(cardId, S.SellTier) then
			if not (S.ProtectFavorites and (PROFILE.fav or {})[cardId]) then
				plan[cardId] = count - keep
				total = total + plan[cardId]
			end
		end
	end
	return plan, total
end

local function sellableSummary()
	local plan, total = buildSellPlan()
	local coins = 0
	for cardId, count in pairs(plan) do
		local _, _, rarity = cardInfo(cardId)
		if rarity then
			coins = coins + (rarity.sell or 0) * count
		end
	end
	return total, coins
end

local function sendPlan(plan)
	local ids = {}
	for cardId in pairs(plan) do
		table.insert(ids, cardId)
	end
	table.sort(ids)

	local batches, batch, size = {}, {}, 0
	for _, cardId in ipairs(ids) do
		batch[cardId] = plan[cardId]
		size = size + plan[cardId]
		if size >= 40 then
			table.insert(batches, batch)
			batch, size = {}, 0
		end
	end
	if size > 0 then
		table.insert(batches, batch)
	end

	local sold, coins = 0, 0
	for _, group in ipairs(batches) do
		local ok, payload = invoke("SellCards", group)
		if ok and type(payload) == "table" then
			if payload.profile then
				applyProfile(payload.profile)
			end
			sold = sold + (payload.count or 0)
			coins = coins + (payload.gained or 0)
		end
		task.wait(0.12)
	end
	return sold, coins
end

local function sellDuplicates(manual)
	if not PROFILE.owned then
		refreshProfile()
	end
	local plan, total = buildSellPlan()
	if total == 0 then
		if manual then
			RUNTIME.SaleText = "No duplicates to sell"
			RUNTIME.SaleTone = "Muted"
			log("Nothing to sell", "Warning")
		end
		return 0, 0
	end
	local sold, coins = sendPlan(plan)
	if sold > 0 then
		STATS.Sold = STATS.Sold + sold
		STATS.SoldCoins = STATS.SoldCoins + coins
		RUNTIME.SaleText = string.format("Sold %d for %d coins", sold, coins)
		RUNTIME.SaleTone = "Success"
		log(string.format("<Success>Sold %d duplicates</Success> <Muted>+%d coins</Muted>", sold, coins))
	end
	return sold, coins
end

----- Packs -----

local packLock = false

local function buyOne(setId)
	local set = CardData.Sets[setId]
	local price = (set and set.price) or 0
	if S.Reserve > 0 and PROFILE.money - price < S.Reserve then
		return false, "reserve"
	end
	if PROFILE.money < price then
		return false, "money"
	end
	local ok = invoke("BuyPack", setId, 1)
	if not ok then
		return false, "remote"
	end
	refreshProfile()
	if packCount(setId) > 0 then
		return true
	end
	return false, "shop"
end

local function openOne(setId)
	local ok, payload = invoke("OpenPack", setId, S.FastOpen, 1, {})
	if not ok or type(payload) ~= "table" then
		return false
	end
	if payload.profile then
		applyProfile(payload.profile)
	end
	local cards = payload.cards or {}
	local fresh = 0
	local bestTier, bestName = -1, nil
	for _, entry in ipairs(cards) do
		if entry.new then
			fresh = fresh + 1
		end
		local card, _, rarity = cardInfo(entry.id)
		if rarity and rarity.tier > bestTier then
			bestTier = rarity.tier
			bestName = card and card.name or tostring(entry.id)
		end
	end
	STATS.Opens = STATS.Opens + 1
	STATS.Pulls = STATS.Pulls + #cards
	STATS.Fresh = STATS.Fresh + fresh
	if bestTier >= 7 and bestName and notify then
		notify("Rare pull", string.format("%s · %s", bestName, tierName(bestTier)))
	end
	if S.LogPulls and #cards > 0 then
		local names = {}
		for index, entry in ipairs(cards) do
			if index > 4 then
				break
			end
			local card = CardData.ById[entry.id]
			table.insert(names, (card and card.name) or tostring(entry.id))
		end
		log(string.format(
			"<Accent>%s</Accent> <Muted>· %d cards, %d new · %s</Muted>",
			setLabel(setId),
			#cards,
			fresh,
			table.concat(names, ", ")
		))
	end
	return true
end

local function rotationSets()
	local list = {}
	for index = 1, 4 do
		local setId = S.Slots[index]
		if setId and CardData.Sets[setId] then
			table.insert(list, setId)
		end
	end
	return list
end

local function packWorker()
	if packLock then
		return
	end
	packLock = true
	task.spawn(function()
		local lastWarn = 0
		while S.PacksOn and not STOP do
			local sets = rotationSets()
			if #sets == 0 then
				RUNTIME.PackState = "Rotation is empty"
				S.PacksOn = false
				log("Rotation is empty", "Warning")
				break
			end

			local openedAny = false
			for _, setId in ipairs(sets) do
				if not (S.PacksOn and not STOP) then
					break
				end
				for index = 1, S.SlotSize do
					if not (S.PacksOn and not STOP) then
						break
					end
					RUNTIME.PackSet = setLabel(setId)
					RUNTIME.PackQueue = string.format("%s · %d/%d", setLabel(setId), index, S.SlotSize)
					local opened = false

					if packCount(setId) > 0 then
						opened = openOne(setId)
					elseif S.AutoBuy then
						local bought = buyOne(setId)
						if bought then
							opened = openOne(setId)
						end
					end

					if opened then
						openedAny = true
						RUNTIME.PackState = string.format("Opening · %d coins", PROFILE.money)
						if S.AutoSell then
							sellDuplicates(false)
						end
					else
						RUNTIME.PackState = string.format("No pack · %d coins", PROFILE.money)
					end

					task.wait(math.max(0.1, S.OpenDelay))
				end
			end

			if not openedAny then
				local need = math.huge
				for _, setId in ipairs(sets) do
					local set = CardData.Sets[setId]
					if set and type(set.price) == "number" and set.price < need then
						need = set.price
					end
				end
				if need == math.huge then
					RUNTIME.PackState = "Waiting for coins"
				else
					RUNTIME.PackState = string.format("Waiting · %d/%d coins", PROFILE.money, need)
				end
				if os.clock() - lastWarn > 20 then
					lastWarn = os.clock()
					log(string.format(
						"<Warning>No pack and not enough coins</Warning> <Muted>· have %d, cheapest pack %s · turn on Pony Pairs</Muted>",
						PROFILE.money,
						need == math.huge and "?" or tostring(need)
					))
				end
				task.wait(3)
			end
		end
		if not S.PacksOn then
			RUNTIME.PackState = "Idle"
		end
		packLock = false
	end)
end

----- Pony Pairs -----

local pairsLock = false

local function playBoard()
	local state = {
		known = {},
		matched = {},
		first = nil,
		flips = 0,
		matchedCount = 0,
		finished = false,
	}

	local function recount()
		local total = 0
		for index = 1, 12 do
			if state.matched[index] then
				total = total + 1
			end
		end
		state.matchedCount = total
	end

	local function markMatched(a, b)
		if a then
			state.matched[a] = true
		end
		if b then
			state.matched[b] = true
		end
		recount()
	end

	local function knownPartner(cardId, exclude)
		for index = 1, 12 do
			if index ~= exclude and not state.matched[index] and state.known[index] == cardId then
				return index
			end
		end
		return nil
	end

	local function unknownPos(exclude)
		for index = 1, 12 do
			if index ~= exclude and not state.matched[index] and not state.known[index] then
				return index
			end
		end
		return nil
	end

	local function anyPos(exclude)
		for index = 1, 12 do
			if index ~= exclude and not state.matched[index] then
				return index
			end
		end
		return nil
	end

	local function flipAt(index)
		if STOP or not S.PairsOn then
			return nil
		end
		local ok, payload = invoke("Memory", "flip", index)
		state.flips = state.flips + 1
		if S.FlipDelay > 0 then
			task.wait(S.FlipDelay)
		end
		if not ok or type(payload) ~= "table" or not payload.id then
			return nil
		end
		state.known[index] = payload.id
		if payload.match then
			STATS.Matches = STATS.Matches + 1
		end
		if type(payload.pay) == "number" and payload.pay > 0 then
			STATS.PairCoins = STATS.PairCoins + payload.pay
		end
		if type(payload.bonus) == "number" and payload.bonus > 0 then
			STATS.PairCoins = STATS.PairCoins + payload.bonus
		end
		if payload.profile then
			applyProfile(payload.profile)
		end
		if payload.finished then
			state.finished = true
		end
		return payload
	end

	for _ = 1, 30 do
		if STOP or not S.PairsOn or state.finished or state.matchedCount >= 12 then
			break
		end

		if not state.first then
			local first = unknownPos() or anyPos()
			if not first then
				break
			end
			local answer = flipAt(first)
			if not answer then
				markMatched(first, nil)
			else
				state.first = first
				local partner = knownPartner(state.known[first], first)
				if partner then
					local second = flipAt(partner)
					if second and second.match then
						markMatched(first, partner)
						state.first = nil
					elseif second then
						state.first = nil
					else
						markMatched(partner, nil)
					end
				end
			end
		else
			local first = state.first
			local target = knownPartner(state.known[first], first) or unknownPos(first) or anyPos(first)
			if not target then
				state.first = nil
			else
				local answer = flipAt(target)
				if not answer then
					markMatched(target, nil)
					state.first = nil
				elseif answer.match then
					markMatched(first, target)
					state.first = nil
				else
					state.first = nil
				end
			end
		end

		RUNTIME.Board = string.format("%d/6 pairs", math.floor(state.matchedCount / 2))
	end

	RUNTIME.Board = string.format("%d/6 pairs", math.floor(state.matchedCount / 2))
	return state
end

local function pairsWorker()
	if pairsLock then
		return
	end
	pairsLock = true
	task.spawn(function()
		while S.PairsOn and not STOP do
			if S.BoardLimit > 0 and STATS.Boards >= S.BoardLimit then
				S.PairsOn = false
				RUNTIME.Board = "Board limit reached"
				log("Board limit reached", "Warning")
				break
			end

			local ok, deal = invoke("Memory", "deal")
			if not (ok and type(deal) == "table" and type(deal.faces) == "table") then
				RUNTIME.Board = "Waiting for a table"
				task.wait(1.6)
			else
				RUNTIME.Board = "0/6 pairs"
				local state = playBoard()
				if state.finished or state.matchedCount >= 12 then
					STATS.Boards = STATS.Boards + 1
					RUNTIME.Board = string.format("Board %d done", STATS.Boards)
					log(string.format(
						"<Success>Board %d done</Success> <Muted>· %d flips · +%d coins</Muted>",
						STATS.Boards,
						state.flips,
						STATS.PairCoins
					))
				else
					RUNTIME.Board = string.format("Stuck at %d/6", math.floor(state.matchedCount / 2))
				end
				task.wait(1.7)
			end
		end
		if not S.PairsOn then
			RUNTIME.Board = "Idle"
		end
		pairsLock = false
	end)
end

local function enablePacks(value)
	S.PacksOn = value and true or false
	if S.PacksOn then
		refreshProfile()
		packWorker()
		log("Packs on", "Success")
	else
		log("Packs off")
	end
end

local function enablePairs(value)
	S.PairsOn = value and true or false
	if S.PairsOn then
		pairsWorker()
		log("Pony Pairs on", "Success")
	else
		RUNTIME.Board = "Idle"
		log("Pony Pairs off")
	end
end

