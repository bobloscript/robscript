		for key in pairs(Settings.spots) do
			table.insert(names, key)
		end
		table.sort(names)
		UiRefs.spots:SetOptions(names, { KeepSelection = true })
		log("Deleted spot " .. name)
	end,
})

UiRefs.players = TpPlayers:CreateDropdown({
	Name = "Teleport to player",
	Options = {},
	Flag = "PlayerPick",
	Callback = function(value)
		local name = type(value) == "table" and value[1] or value
		if name then
			teleportToPlayer(name)
		end
	end,
})

task.spawn(function()
	while scriptAlive() do
		if UiRefs.players then
			local names = playerNames()
			local current = UiRefs.players:GetOptions()
			if #names ~= #current then
				UiRefs.players:SetOptions(names, { KeepSelection = true })
			end
		end
		task.wait(5)
	end
end)

