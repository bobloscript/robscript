----------------------------------------------------------------------
-- Velocity helpers
----------------------------------------------------------------------

--- The game resets WalkSpeed every frame, so movement is done with a body
--- velocity instead. LinearVelocity did not move the character in this game,
--- BodyVelocity does, so that is what is used.
local velocity = {
	speed = { body = nil },
	fly = { body = nil },
}

local function clearVelocity(slot)
	local entry = velocity[slot]
	if entry.body then
		entry.body:Destroy()
		entry.body = nil
	end
end

local function ensureVelocity(slot)
	local entry = velocity[slot]
	local r = root()
	if not r then
		return nil
	end
	if entry.body and entry.body.Parent == r then
		return entry.body
	end
	clearVelocity(slot)

	local body = Instance.new("BodyVelocity")
	body.Name = "StrafeHub_" .. slot
	body.P = 12500
	body.MaxForce = Vector3.zero
	body.Velocity = Vector3.zero
	body.Parent = r

	entry.body = body
	return body
end

local function applyVelocity(slot, vector, verticalToo)
	local body = ensureVelocity(slot)
	if not body then
		return
	end
	body.Velocity = vector
	if verticalToo then
		body.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	else
		-- Horizontal only, so gravity still works while running.
		body.MaxForce = Vector3.new(1e6, 0, 1e6)
	end
end

local function stopVelocity(slot)
	local entry = velocity[slot]
	if entry.body then
		entry.body.MaxForce = Vector3.zero
	end
end
----------------------------------------------------------------------
-- 1. MOVEMENT
----------------------------------------------------------------------

local movement = { flyInput = Vector3.zero, jumpQueued = false }

local function setSpeed(on)
	Settings.speedOn = on
	if not on then
		clearVelocity("speed")
	end
	if UiRefs.speed then
		UiRefs.speed:Set(on, true)
	end
end

local function setFly(on)
	Settings.flyOn = on
	local hum = humanoid()

	if on then
		ensureVelocity("fly")
		if hum then
			hum.PlatformStand = true
		end
		log("Fly on")
	else
		clearVelocity("fly")
		if hum then
			hum.PlatformStand = false
		end
		log("Fly off")
	end

	if UiRefs.fly then
		UiRefs.fly:Set(on, true)
	end
end

local function setNoclip(on)
	Settings.noclip = on
	local char = character()
	if char and not on then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
	if UiRefs.noclip then
		UiRefs.noclip:Set(on, true)
	end
end

local function setInfiniteJump(on)
	Settings.infiniteJump = on
	if UiRefs.jump then
		UiRefs.jump:Set(on, true)
	end
end

local function setAntiRagdoll(on)
	Settings.antiRagdoll = on
	if UiRefs.antiRagdoll then
		UiRefs.antiRagdoll:Set(on, true)
	end
end

--- Movement tick: applies speed, fly and the small housekeeping modifiers.
local function movementTick(dt)
	local char = character()
	local hum = humanoid()
	local r = root()
	if not (char and hum and r) then
		return
	end

	-- Noclip
	if Settings.noclip then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end

	-- Anti ragdoll / immobile: the framework parks you with these flags.
	if Settings.antiRagdoll then
		local values = char:FindFirstChild("Values")
		if values then
			local ragdolled = values:FindFirstChild("Ragdolled")
			if ragdolled and ragdolled.Value then
				ragdolled.Value = false
			end
			local immobile = values:FindFirstChild("Immobile")
			if immobile and immobile.Value then
				immobile.Value = false
			end
		end
	end

	-- Infinite jump
	if Settings.infiniteJump then
		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Freefall then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			r.AssemblyLinearVelocity = Vector3.new(
				r.AssemblyLinearVelocity.X,
				Settings.jumpPower,
				r.AssemblyLinearVelocity.Z
			)
		end
	end

	-- Fly
	if Settings.flyOn then
		local lv = ensureVelocity("fly")
		if lv then
			local camera = workspace.CurrentCamera
			local direction = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction += camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction -= camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction += camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction -= camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				direction += Vector3.yAxis
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
				direction -= Vector3.yAxis
			end

			if direction.Magnitude > 0 then
				direction = direction.Unit
			end

			applyVelocity("fly", direction * Settings.flySpeed, true)
			hum.PlatformStand = true
		end
	else
		stopVelocity("fly")
	end

	-- Speed
	if Settings.speedOn and not Settings.flyOn then
		if hum.MoveDirection.Magnitude > 0.05 then
			applyVelocity("speed", hum.MoveDirection * Settings.speed, false)
		else
			stopVelocity("speed")
		end
	else
		stopVelocity("speed")
	end
end

----------------------------------------------------------------------
-- 2. TELEPORT
----------------------------------------------------------------------

local function teleportTo(position)
	local r = root()
	if not r then
		return false
	end
	local char = character()
	pcall(function()
		char:PivotTo(CFrame.new(position))
	end)
	return true
end

local function teleportUp(delta)
	local r = root()
	if r then
		teleportTo(r.Position + Vector3.new(0, delta, 0))
	end
end

local function teleportToPlayer(name)
	local target = Players:FindFirstChild(name)
	if target and target.Character then
		teleportTo(target.Character:GetPivot().Position + Vector3.new(0, 3, 0))
		log("Teleported to " .. name)
	end
end

local function playerNames()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(list, player.Name)
		end
	end
	table.sort(list)
	return list
end

----------------------------------------------------------------------
-- 3. VISUAL
----------------------------------------------------------------------

local visualBackup = {}

local function applyFullbright(on)
	if on then
		if not visualBackup.brightness then
			visualBackup.brightness = Lighting.Brightness
			visualBackup.ambient = Lighting.Ambient
			visualBackup.outdoor = Lighting.OutdoorAmbient
			visualBackup.clock = Lighting.ClockTime
		end
		Lighting.Brightness = 3
		Lighting.Ambient = Color3.fromRGB(178, 178, 178)
		Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
		Lighting.ClockTime = 14
	elseif visualBackup.brightness then
		Lighting.Brightness = visualBackup.brightness
		Lighting.Ambient = visualBackup.ambient
		Lighting.OutdoorAmbient = visualBackup.outdoor
		Lighting.ClockTime = visualBackup.clock
		visualBackup.brightness = nil
	end
end

local function applyNoFog(on)
	if on then
		if not visualBackup.fogEnd then
			visualBackup.fogEnd = Lighting.FogEnd
			visualBackup.fogStart = Lighting.FogStart
		end
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e6
	elseif visualBackup.fogEnd then
		Lighting.FogEnd = visualBackup.fogEnd
		Lighting.FogStart = visualBackup.fogStart
		visualBackup.fogEnd = nil
	end
end

local function viewmodel()
	local camera = workspace.CurrentCamera
	return camera and camera:FindFirstChild("Viewmodel")
end

local function applyHideViewmodel(on)
	local model = viewmodel()
	if not model then
		for _, child in ipairs(workspace.CurrentCamera:GetChildren()) do
			if child.Name:lower():find("viewmodel") or child.Name:lower():find("arms") then
				model = child
				break
			end
		end
	end
	if not model then
		return
	end
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = on and 1 or 0
		end
	end
end

----------------------------------------------------------------------
-- 4. COMBAT
----------------------------------------------------------------------

local hitboxes = {}

local function clearHitboxes()
	for part in pairs(hitboxes) do
		if part and part.Parent then
			part:Destroy()
		end
	end
	hitboxes = {}
end

local function updateHitboxes()
	if not Settings.hitbox then
		clearHitboxes()
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local torso = player.Character:FindFirstChild("HumanoidRootPart")
			if torso and not torso:FindFirstChild("StrafeHubHitbox") then
				local part = Instance.new("Part")
				part.Name = "StrafeHubHitbox"
				part.Size = Vector3.new(14, 14, 14)
				part.Transparency = 1
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = true
				part.Massless = true
				part.Parent = torso

				local weld = Instance.new("WeldConstraint")
				weld.Part0 = part
				weld.Part1 = torso
				weld.Parent = part

				hitboxes[part] = true
			end
		end
	end
end

local function aimTarget()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local origin = camera.CFrame.Position
	local best, bestAngle = nil, math.rad(Settings.aimbotFov)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			local head = player.Character:FindFirstChild("Head")
			if hum and hum.Health > 0 and head then
				local direction = (head.Position - origin)
				if direction.Magnitude > 0 then
					local angle = math.acos(math.clamp(camera.CFrame.LookVector:Dot(direction.Unit), -1, 1))
					if angle < bestAngle then
						best, bestAngle = head, angle
					end
				end
			end
		end
	end
	return best
end

----------------------------------------------------------------------
-- Hotkey state
----------------------------------------------------------------------

local aimHeld = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.F then
		setFly(not Settings.flyOn)
	elseif key == Enum.KeyCode.N then
		setNoclip(not Settings.noclip)
	elseif key == Enum.KeyCode.V then
		setSpeed(not Settings.speedOn)
	elseif key == Enum.KeyCode.RightShift then
		aimHeld = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.RightShift then
		aimHeld = false
	end
end)

----------------------------------------------------------------------
-- Main loops
----------------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)
	if not scriptAlive() then
		return
	end
	pcall(movementTick, dt)
end)

RunService.RenderStepped:Connect(function()
	if not scriptAlive() then
		return
	end

	-- FOV: the game rewrites it every frame, so we write it after them.
	if Settings.fov > 0 and workspace.CurrentCamera then
		workspace.CurrentCamera.FieldOfView = Settings.fov
	end

	-- Aimbot
	if Settings.aimbot and (not Settings.aimbotHold or aimHeld) then
		local head = aimTarget()
		local camera = workspace.CurrentCamera
		if head and camera then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
		end
	end
end)

task.spawn(function()
	while scriptAlive() do
		if Settings.hitbox then
			pcall(updateHitboxes)
		end
		task.wait(1)
	end
end)

