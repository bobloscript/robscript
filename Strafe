LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	-- Recreate the velocity constraints on the new character.
	if Settings.speedOn then
		ensureVelocity("speed")
	end
	if Settings.flyOn then
		ensureVelocity("fly")
		local hum = humanoid()
		if hum then
			hum.PlatformStand = true
		end
	end
	if Settings.noclip then
		local char = character()
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
	if Settings.fullbright then
		applyFullbright(true)
	end
	if Settings.noFog then
		applyNoFog(true)
	end
end)

task.spawn(function()
	local names = {}
	for key in pairs(Settings.spots) do
		table.insert(names, key)
	end
	table.sort(names)
	UiRefs.spots:SetOptions(names, { KeepSelection = true })
	UiRefs.players:SetOptions(playerNames(), { KeepSelection = true })

	pcall(function()
		Window:LoadAutoload()
	end)

	local hum = humanoid()
	log("<Success>Loaded</Success> - " .. (hum and ("walk " .. tostring(hum.WalkSpeed)) or "no character"))
end)

print("[Strafe Hub] loaded")
