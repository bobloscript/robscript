----- Runtime -----

local function cleanup()
	if STOP then
		return
	end
	STOP = true
	pcall(function()
		RunService:UnbindFromRenderStep(AIM_BIND)
	end)
	clearEsp()
	stopFly()
	restoreCollision()

	if Config and Config.Movement then
		Config.Movement.BaseSpeed = MOVE_DEFAULTS.BaseSpeed
		Config.Movement.JumpHeight = MOVE_DEFAULTS.JumpHeight
	end
	if Config and Config.Camera then
		Config.Camera.ScopeFov = MOVE_DEFAULTS.ScopeFov
		Config.Camera.HipFov = MOVE_DEFAULTS.HipFov
		Config.Camera.ScopeTransition = MOVE_DEFAULTS.ScopeTransition
	end
	Workspace.Gravity = MOVE_DEFAULTS.Gravity
	restoreVisuals()
	if hudStates and next(hudStates) then
		setHudVisible(true)
	end

	local character = LocalPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
		end
	end

	for _, connection in ipairs(CONNECTIONS) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	CONNECTIONS = {}

	pcall(function()
		WINDOW:Destroy()
	end)
	getgenv().RobScriptTS = nil
end

API = {
	Version = VERSION,
	Destroy = cleanup,
	Config = Config,
	Airflow = Airflow,
}
getgenv().RobScriptTS = API

-- Test helper: what the aimbot currently locks on.
API.TestAim = function(fov)
	local entry = bestTarget(fov or S.AimFov)
	if not entry then
		return nil, "no target"
	end
	return {
		model = entry.model.Name,
		kind = entry.kind,
		part = entry.part.Name,
		angle = math.floor(entry.angle),
		distance = math.floor(entry.distance),
	}
end

API.State = S
API.Runtime = RUNTIME

-- Fast loop: movement enforcement.
track(RunService.Heartbeat:Connect(function()
	if STOP then
		return
	end
	local ok, err = pcall(applyMovement)
	if not ok then
		log("Movement error: " .. tostring(err), "Error")
	end
end))

-- Fast loop: trigger bot.
local lastTrigger = 0
track(RunService.Heartbeat:Connect(function()
	if STOP or not S.TriggerOn then
		return
	end
	if os.clock() - lastTrigger < S.TriggerDelay then
		return
	end
	local entry = bestTarget(S.TriggerFov)
	if not entry then
		return
	end
	lastTrigger = os.clock()
	local ok, weapon = pcall(function()
		return require(LocalPlayer.PlayerScripts.Client.WeaponController)
	end)
	if ok and type(weapon) == "table" and type(weapon.fire) == "function" then
		pcall(weapon.fire)
	end
end))

-- Infinite jump and auto hop.
track(UserInputService.JumpRequest:Connect(function()
	if STOP then
		return
	end
	if S.InfJump then
		local _, humanoid = getCharacter()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end))

-- Slow loop: ESP refresh plus config re-apply.
task.spawn(function()
	local timer = 0
	while not STOP do
		local ok, err = pcall(function()
			if S.EspPlayers or S.EspBots then
				refreshEsp()
			elseif next(espEntries) then
				clearEsp()
			end

			if S.AutoHop then
				local _, humanoid = getCharacter()
				if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
					local move = humanoid.MoveDirection
					if move.Magnitude > 0.1 then
						humanoid.Jump = true
					end
				end
			end

			if S.Fullbright or S.NoFog then
				applyVisuals()
				visualsApplied = true
			elseif visualsApplied then
				restoreVisuals()
				visualsApplied = false
			end

			if S.InstantScope or S.ScopeFov ~= MOVE_DEFAULTS.ScopeFov or S.HipFov ~= MOVE_DEFAULTS.HipFov then
				applyWeaponConfig()
			end
		end)
		if not ok then
			log("Loop error: " .. tostring(err), "Error")
		end
		task.wait(0.15)
	end
end)

