----- Helpers -----

local function escapeText(text)
	return (tostring(text):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function shortNumber(value)
	value = tonumber(value) or 0
	if value >= 1e6 then
		return string.format("%.1fM", value / 1e6)
	elseif value >= 1e3 then
		return string.format("%.1fk", value / 1e3)
	end
	return tostring(math.floor(value))
end

local function getCharacter()
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return nil, nil, nil
	end
	if humanoid.Health <= 0 then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function combatantsFolder()
	return Workspace:FindFirstChild("Combatants")
end

local function kindOf(model)
	local kind = model:GetAttribute("CombatantKind")
	if type(kind) == "string" then
		return kind
	end
	return "Human"
end

local function isLocalModel(model)
	local character = LocalPlayer.Character
	return model == character or model.Name == LocalPlayer.Name
end

local function aimPartOf(model, wanted)
	if wanted == "Torso" then
		local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") then
			return torso
		end
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function blocked(from, to)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { LocalPlayer.Character }
	local folder = combatantsFolder()
	if folder then
		table.insert(ignore, folder)
	end
	local effects = Workspace:FindFirstChild("Effects")
	if effects then
		table.insert(ignore, effects)
	end
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local result = Workspace:Raycast(from, to - from, params)
	if not result then
		return false
	end
	return result.Distance < (to - from).Magnitude - 1
end

local function aimKeyHeld()
	local key = S.AimKey
	if key == nil then
		return true
	end
	if typeof(key) ~= "EnumItem" then
		return true
	end
	return UserInputService:IsKeyDown(key)
end

local function aimActive()
	return S.AimOn and aimKeyHeld()
end

----- Target picking -----

local function collectTargets(fov, wantKinds)
	local folder = combatantsFolder()
	local camera = Workspace.CurrentCamera
	local character = LocalPlayer.Character
	if not folder or not camera then
		return {}
	end

	local camPos = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local team = character and character:GetAttribute("Team")
	local list = {}

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and not isLocalModel(model) then
			local kind = kindOf(model)
			local allowed = (kind == "Bot" and S.AimBots) or (kind == "Human" and S.AimPlayers)
			if wantKinds and wantKinds[kind] ~= nil then
				allowed = wantKinds[kind]
			end
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local part = aimPartOf(model, S.AimPart)
			if allowed and humanoid and humanoid.Health > 0 and part then
				local delta = part.Position - camPos
				local distance = delta.Magnitude
				if distance > 1 and distance <= S.AimMaxDistance then
					local angle = math.deg(math.acos(math.clamp(look:Dot(delta.Unit), -1, 1)))
					if angle <= fov then
						local ok = true
						if S.AimIgnoreProtected and model:GetAttribute("Protected") == true then
							ok = false
						end
						if ok and S.AimTeam and team ~= nil and model:GetAttribute("Team") == team then
							ok = false
						end
						if ok and S.AimVisibleOnly then
							ok = not blocked(camPos, part.Position)
						end
						if ok then
							list[#list + 1] = {
								model = model,
								part = part,
								pos = part.Position,
								angle = angle,
								distance = distance,
								kind = kind,
							}
						end
					end
				end
			end
		end
	end

	if S.AimPriority == "Distance" then
		table.sort(list, function(a, b)
			return a.distance < b.distance
		end)
	else
		table.sort(list, function(a, b)
			return a.angle < b.angle
		end)
	end

	return list
end

local function bestTarget(fov)
	local list = collectTargets(fov or S.AimFov)
	return list[1], list
end

----- Aimbot -----

-- The game ships its own look module: LookRotation(dx, dy) rotates the camera by degrees.
-- The shot ray is taken straight from the camera, so turning the camera is all an aimbot needs.
local lookRotation = nil
do
	local ok, module = pcall(function()
		return require(LocalPlayer.PlayerScripts.Client.LookRotation)
	end)
	if ok and type(module) == "function" then
		lookRotation = module
	end
end

local AIM_BIND = "TS_Aimbot"

local function aimStep()
	if STOP or not (S.AimOn and aimKeyHeld()) then
		return
	end
	local entry = bestTarget(S.AimFov)
	if not entry then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	local origin = camera.CFrame.Position
	local direction = entry.pos - origin
	if direction.Magnitude < 1 then
		return
	end
	direction = direction.Unit

	local look = camera.CFrame.LookVector
	local currentYaw = math.atan2(-look.X, -look.Z)
	local wantedYaw = math.atan2(-direction.X, -direction.Z)
	local deltaYaw = math.deg(currentYaw - wantedYaw)
	if deltaYaw > 180 then
		deltaYaw = deltaYaw - 360
	elseif deltaYaw < -180 then
		deltaYaw = deltaYaw + 360
	end
	local currentPitch = math.asin(math.clamp(look.Y, -1, 1))
	local wantedPitch = math.asin(math.clamp(direction.Y, -1, 1))
	local deltaPitch = math.deg(wantedPitch - currentPitch)

	local strength = math.clamp(1 - S.AimSmooth, 0.05, 1)
	deltaYaw = deltaYaw * strength
	deltaPitch = deltaPitch * strength

	if lookRotation then
		pcall(lookRotation, deltaYaw, deltaPitch)
	else
		pcall(function()
			camera.CFrame = CFrame.lookAt(origin, entry.pos)
		end)
	end

	RUNTIME.TargetName = entry.model.Name
	RUNTIME.TargetDistance = math.floor(entry.distance)
end

track(RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 2, function()
	pcall(aimStep)
end))

