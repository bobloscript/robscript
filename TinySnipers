local function makeEntry(model, color)
	local highlight = nil
	local billboard = nil
	local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
	if not head or not head:IsA("BasePart") then
		-- Lobby copies of the bots live in Workspace.LobbyPlayers; combatants without parts
		-- cannot be shot and have nothing to attach a nameplate to.
		return nil
	end

	if S.EspHighlight then
		highlight = Instance.new("Highlight")
		highlight.Name = ESP_TAG
		highlight.Adornee = model
		highlight.FillColor = color
		highlight.OutlineColor = color
		highlight.FillTransparency = 0.72
		highlight.OutlineTransparency = 0
		highlight.DepthMode = S.EspThrough and Enum.HighlightDepthMode.AlwaysOnTop
			or Enum.HighlightDepthMode.Occluded
		highlight.Parent = model
	end

	if head and (S.EspNames or S.EspHealth or S.EspDistance) then
		billboard = Instance.new("BillboardGui")
		billboard.Name = ESP_TAG
		billboard.Size = UDim2.fromOffset(200, 52)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
		billboard.AlwaysOnTop = S.EspThrough
		billboard.MaxDistance = 600
		billboard.Adornee = head
		billboard.Parent = head

		local label = Instance.new("TextLabel")
		label.Name = "Info"
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0.6, 0)
		label.Position = UDim2.fromScale(0, 0)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextColor3 = Color3.fromRGB(245, 245, 247)
		label.TextStrokeTransparency = 0.35
		label.RichText = true
		label.Text = ""
		label.Parent = billboard

		if S.EspHealth then
			local back = Instance.new("Frame")
			back.Name = "HpBack"
			back.Size = UDim2.fromOffset(90, 6)
			back.Position = UDim2.new(0.5, -45, 0.72, 0)
			back.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
			back.BorderSizePixel = 0
			back.Parent = billboard

			local fill = Instance.new("Frame")
			fill.Name = "HpFill"
			fill.Size = UDim2.fromScale(1, 1)
			fill.BackgroundColor3 = color
			fill.BorderSizePixel = 0
			fill.Parent = back
		end
	end

	return {
		highlight = highlight,
		billboard = billboard,
		color = color,
	}
end

local function updateEspEntry(model, entry)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not head then
		return
	end

	local distance = root and math.floor((head.Position - root.Position).Magnitude) or 0
	local health = math.clamp(humanoid.Health, 0, humanoid.MaxHealth > 0 and humanoid.MaxHealth or 100)
	local ratio = humanoid.MaxHealth > 0 and (health / humanoid.MaxHealth) or 1
	local hpColor = ratio > 0.5 and "#5BF07A" or (ratio > 0.25 and "#FFDE00" or "#FF4D5E")

	local text = ""
	if S.EspNames then
		text = string.format("<b>%s</b>", escapeText(model.Name))
	end
	if S.EspDistance then
		local chunk = string.format("<font color='#8D8D99'>%dm</font>", distance)
		text = text == "" and chunk or (text .. " " .. chunk)
	end
	if S.EspHealth then
		local chunk = string.format("<font color='%s'>%d</font>", hpColor, math.floor(health))
		text = text == "" and chunk or (text .. "\n" .. chunk)
	end

	if entry.billboard then
		if entry.billboard.MaxDistance ~= S.EspDistance then
			entry.billboard.MaxDistance = S.EspDistance
		end
		local label = entry.billboard:FindFirstChild("Info")
		if label and label.Text ~= text then
			label.Text = text
		end
		local back = entry.billboard:FindFirstChild("HpBack")
		local fill = back and back:FindFirstChild("HpFill")
		if fill then
			fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
		end
	end
end

local function refreshEsp()
	local folder = combatantsFolder()
	if not folder then
		if next(espEntries) then
			clearEsp()
		end
		RUNTIME.EspCount = 0
		return
	end

	local wanted = {}
	local bots = 0
	local humans = 0

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and not isLocalModel(model) then
			local kind = kindOf(model)
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local enabled = (kind == "Bot" and S.EspBots) or (kind == "Human" and S.EspPlayers)
			if kind == "Bot" then
				bots = bots + 1
			elseif kind == "Human" then
				humans = humans + 1
			end
			if enabled and humanoid and humanoid.Health > 0 then
				wanted[model] = true
				local entry = espEntries[model]
				local color = kind == "Bot" and S.BotColor or S.PlayerColor
				if not entry then
					entry = makeEntry(model, color)
					if entry then
						espEntries[model] = entry
					else
						wanted[model] = nil
					end
				end
				if entry then
					if entry.color ~= color then
						entry.color = color
						if entry.highlight then
							entry.highlight.FillColor = color
							entry.highlight.OutlineColor = color
						end
						if entry.billboard then
							local back = entry.billboard:FindFirstChild("HpBack")
							local fill = back and back:FindFirstChild("HpFill")
							if fill then
								fill.BackgroundColor3 = color
							end
						end
					end
					if entry.highlight then
						local mode = S.EspThrough and Enum.HighlightDepthMode.AlwaysOnTop
							or Enum.HighlightDepthMode.Occluded
						if entry.highlight.DepthMode ~= mode then
							entry.highlight.DepthMode = mode
						end
					end
					if entry.billboard and entry.billboard.AlwaysOnTop ~= S.EspThrough then
						entry.billboard.AlwaysOnTop = S.EspThrough
					end
				end
				local active = espEntries[model]
				if active then
					updateEspEntry(model, active)
					local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
					local wantsBoard = head and (S.EspNames or S.EspHealth or S.EspDistance)
					if not wantsBoard and active.billboard then
						active.billboard:Destroy()
						active.billboard = nil
					elseif wantsBoard and not active.billboard and head then
						local fresh = makeEntry(model, active.color)
						if fresh then
							active.billboard = fresh.billboard
							if not active.highlight then
								active.highlight = fresh.highlight
							elseif fresh.highlight then
								fresh.highlight:Destroy()
							end
						end
					end
				end
			end
		end
	end

	for model, entry in pairs(espEntries) do
		if not wanted[model] or not model.Parent then
			removeEspEntry(entry)
			espEntries[model] = nil
		end
	end

	RUNTIME.BotCount = bots
	RUNTIME.PlayerCount = humans
	local count = 0
	for _ in pairs(espEntries) do
		count = count + 1
	end
	RUNTIME.EspCount = count
end

local function applyEspVisibility()
	for model, entry in pairs(espEntries) do
		removeEspEntry(entry)
		espEntries[model] = nil
	end
	if S.EspPlayers or S.EspBots then
		refreshEsp()
	end
end

----- Movement -----

local flyVelocity = nil
local lightingDefaults = nil
local hudStates = {}
local speedApplied = false
local jumpApplied = false
local jumpBase = nil
local visualsApplied = false

local function stopFly()
	if flyVelocity then
		pcall(function()
			flyVelocity:Destroy()
		end)
		flyVelocity = nil
	end
end

local function stepFly(humanoid, root)
	if not flyVelocity or flyVelocity.Parent ~= root then
		stopFly()
		flyVelocity = Instance.new("BodyVelocity")
		flyVelocity.Name = "RT_Fly"
		flyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyVelocity.Parent = root
	end

	local camera = Workspace.CurrentCamera
	local direction = Vector3.zero
	if camera then
		local look = camera.CFrame.LookVector
		local right = camera.CFrame.RightVector
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction = direction + look
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction = direction - look
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction = direction + right
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction = direction - right
		end
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction = direction + Vector3.new(0, 1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction = direction - Vector3.new(0, 1, 0)
	end

	if direction.Magnitude > 0.05 then
		flyVelocity.Velocity = direction.Unit * S.FlySpeed
	else
		flyVelocity.Velocity = Vector3.zero
	end
end

local cliplessParts = {}

local function restoreCollision()
	for part in pairs(cliplessParts) do
		if part.Parent then
			pcall(function()
				part.CanCollide = true
			end)
		end
		cliplessParts[part] = nil
	end
end

local function applyMovement()
	local _, humanoid, root = getCharacter()

	if Config then
		if Config.Movement then
			Config.Movement.BaseSpeed = S.SpeedOn and S.SpeedValue or MOVE_DEFAULTS.BaseSpeed
			Config.Movement.JumpHeight = S.JumpOn and S.JumpValue or MOVE_DEFAULTS.JumpHeight
		end
	end

	if humanoid then
		if S.SpeedOn then
			humanoid.WalkSpeed = S.SpeedValue
			speedApplied = true
		elseif speedApplied then
			humanoid.WalkSpeed = MOVE_DEFAULTS.BaseSpeed
			speedApplied = false
		end
		if S.JumpOn then
			if not jumpApplied then
				jumpBase = humanoid.JumpHeight
			end
			pcall(function()
				humanoid.UseJumpPower = false
				humanoid.JumpHeight = S.JumpValue
			end)
			jumpApplied = true
		elseif jumpApplied then
			pcall(function()
				humanoid.JumpHeight = jumpBase or MOVE_DEFAULTS.JumpHeight
			end)
			jumpApplied = false
			jumpBase = nil
		end
	end

	Workspace.Gravity = S.GravityOn and S.GravityValue or MOVE_DEFAULTS.Gravity

	if not root then
		stopFly()
		return
	end

	if S.FlyOn and humanoid then
		stepFly(humanoid, root)
	elseif flyVelocity then
		stopFly()
	end

	if S.Noclip then
		local character = LocalPlayer.Character
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
					cliplessParts[part] = true
				end
			end
		end
	elseif next(cliplessParts) then
		restoreCollision()
	end

	if S.AntiFall and root.Position.Y < -40 then
		local target = S.SavedPosition
		if target then
			root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
		else
			root.CFrame = CFrame.new(Vector3.new(0, 220, 0))
		end
	end
end

local function applyWeaponConfig()
	if not Config or not Config.Camera then
		return
	end
	Config.Camera.ScopeFov = S.ScopeFov
	Config.Camera.HipFov = S.HipFov
	Config.Camera.ScopeTransition = S.InstantScope and 0.001 or MOVE_DEFAULTS.ScopeTransition
end

----- Visuals -----

local function storeLighting()
	if lightingDefaults then
		return
	end
	lightingDefaults = {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		GlobalShadows = Lighting.GlobalShadows,
	}
end

local function applyVisuals()
	if not (S.Fullbright or S.NoFog) then
		return
	end
	storeLighting()
	if S.Fullbright then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.Ambient = Color3.fromRGB(160, 160, 170)
		Lighting.OutdoorAmbient = Color3.fromRGB(160, 160, 170)
		Lighting.GlobalShadows = false
	end
	if S.NoFog then
		Lighting.FogStart = 0
		Lighting.FogEnd = 1e6
	end
end

local function restoreVisuals()
	if not lightingDefaults then
		return
	end
	Lighting.Brightness = lightingDefaults.Brightness
	Lighting.ClockTime = lightingDefaults.ClockTime
	Lighting.FogEnd = lightingDefaults.FogEnd
	Lighting.FogStart = lightingDefaults.FogStart
	Lighting.Ambient = lightingDefaults.Ambient
	Lighting.OutdoorAmbient = lightingDefaults.OutdoorAmbient
	Lighting.GlobalShadows = lightingDefaults.GlobalShadows
end

