----- Runtime -----

local lastError = nil
local hudAccumulator = 0

local function safeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		local message = tostring(result)
		if lastError ~= message then
			lastError = message
			warn("[RobScript RoofLine] " .. message)
		end
	end
	return ok
end

-- The game's own stamina controller writes WalkSpeed every frame, so the override has to
-- be written every frame as well, and this connection is made last, which makes it win.
local walkStepper = RunService.RenderStepped:Connect(function()
	applyFallGuard()
	if not (running and (Movement.walkEnabled or Movement.jumpEnabled)) then
		return
	end
	local humanoid = humanoidOf()
	if not humanoid then
		return
	end
	if Movement.walkEnabled then
		humanoid.WalkSpeed = Movement.walkSpeed
	end
	if Movement.jumpEnabled then
		if humanoid.UseJumpPower then
			humanoid.JumpPower = Movement.jumpPower
		else
			humanoid.JumpHeight = desiredJumpHeight(Movement.jumpPower)
		end
	end
end)

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	hudAccumulator = hudAccumulator + deltaTime
	if hudAccumulator >= HUD_INTERVAL then
		hudAccumulator = 0
		if Movement.fly and not flyState.velocity then
			-- The rig changed or the constraint was destroyed: rebuild it.
			stopFly()
			startFly()
		end
	end
end)

local jumpRequest = UserInputService.JumpRequest:Connect(function()
	if not (running and Movement.infJump) then
		return
	end
	local humanoid = humanoidOf()
	if humanoid and humanoid.Health > 0 then
		-- Humanoid.Jump is swallowed by this game's controller; forcing the state is what
		-- actually launches the character, and it works in mid air too.
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end)
	end
end)

local keyInput = UserInputService.InputBegan:Connect(function(input, processed)
	if not running or processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			restoreAll()
			Camera.noFall = false
			for _, name in ipairs({ "MovementWalk", "MovementJump", "InfiniteJump", "Fly", "NoFallDamage" }) do
				setFlag(name, false)
			end
			Window:Toggle(false)
		end)
		return
	end
	local binding = flag("FlyKey", Enum.KeyCode.F)
	if input.KeyCode == binding then
		local nextState = not Movement.fly
		setFlag("Fly", nextState)
		if nextState then
			local ok = startFly()
			if not ok then
				setFlag("Fly", false)
			end
		else
			stopFly()
		end
	end
end)

----- API -----

local function destroy()
	if not running then
		return
	end
	running = false
	restoreAll()
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		walkStepper:Disconnect()
	end)
	pcall(function()
		jumpRequest:Disconnect()
	end)
	pcall(function()
		keyInput:Disconnect()
	end)
	pcall(function()
		Window:Destroy()
	end)
	local env = getgenv()
	if type(env) == "table" then
		env.RobScriptRoofLine = nil
	end
end

getgenv().RobScriptRoofLine = {
	Version = "1.3",
	Get = function(name)
		return flag(name, nil)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	SetWalkSpeed = function(value)
		Movement.walkSpeed = tonumber(value) or Movement.walkSpeed
		Movement.walkEnabled = true
		setFlag("MovementWalk", true)
		setFlag("WalkSpeed", Movement.walkSpeed)
		applyWalk(humanoidOf())
		return Movement.walkSpeed
	end,
	SetJumpPower = function(value)
		Movement.jumpPower = tonumber(value) or Movement.jumpPower
		Movement.jumpEnabled = true
		setFlag("MovementJump", true)
		setFlag("JumpPower", Movement.jumpPower)
		applyJump(humanoidOf())
		return Movement.jumpPower
	end,
	SetInfiniteJump = function(on)
		Movement.infJump = on ~= false
		setFlag("InfiniteJump", Movement.infJump)
		return Movement.infJump
	end,
	SetFly = function(on)
		if on == nil then
			on = not Movement.fly
		end
		setFlag("Fly", on)
		if on then
			local ok, reason = startFly()
			if not ok then
				setFlag("Fly", false)
				return false, reason
			end
		else
			stopFly()
		end
		return Movement.fly
	end,
	SetNoFallDamage = function(on)
		Camera.noFall = on ~= false
		setFlag("NoFallDamage", Camera.noFall)
		return Camera.noFall
	end,
	TeleportToRoof = function(id)
		return teleportToRoof(id)
	end,
	NextRoof = function()
		local options = Roofs.options
		if #options == 0 then
			return false, "no roofs"
		end
		local current = flag("RoofTarget", nil)
		local index = table.find(options, current) or 0
		local nextId = options[index % #options + 1]
		setFlag("RoofTarget", nextId)
		return teleportToRoof(nextId)
	end,
	GetRoofs = function()
		local done = roofsDone()
		local list = {}
		for _, entry in ipairs(Roofs.entries) do
			list[#list + 1] = {
				id = entry.id,
				name = entry.name,
				tier = entry.tier,
				reward = entry.reward,
				done = done[entry.id] ~= nil,
			}
		end
		return list
	end,
	GetState = function()
		local humanoid = humanoidOf()
		return {
			fly = Movement.fly,
			walkEnabled = Movement.walkEnabled,
			walkSpeed = humanoid and humanoid.WalkSpeed or nil,
			jumpEnabled = Movement.jumpEnabled,
			jumpPower = humanoid and humanoid.JumpPower or nil,
			infiniteJump = Movement.infJump,
			noFallDamage = Camera.noFall,
			baseWalk = Movement.baseWalk,
			baseJumpPower = Movement.baseJumpPower,
		}
	end,
	Reset = function()
		restoreAll()
	end,
	GetLastError = function()
		return lastError
	end,
	Destroy = destroy,
}

-- Configs restore flags without firing callbacks, so the state is read back once after
-- autoload; otherwise a saved "walk speed" toggle would look on but do nothing.
local function syncFromFlags()
	Movement.walkSpeed = tonumber(flag("WalkSpeed", Movement.walkSpeed)) or Movement.walkSpeed
	Movement.jumpPower = tonumber(flag("JumpPower", Movement.jumpPower)) or Movement.jumpPower
	Movement.flySpeed = tonumber(flag("FlySpeed", Movement.flySpeed)) or Movement.flySpeed
	Movement.walkEnabled = flag("MovementWalk", false) == true
	Movement.jumpEnabled = flag("MovementJump", false) == true
	Movement.infJump = flag("InfiniteJump", false) == true
	Camera.noFall = flag("NoFallDamage", true) ~= false
	-- Fly is never restored silently: it needs a live rig to attach to.
	if flag("Fly", false) then
		setFlag("Fly", false)
	end
	local humanoid = humanoidOf()
	applyWalk(humanoid)
	if Movement.jumpEnabled then
		applyJump(humanoid)
	end
end

