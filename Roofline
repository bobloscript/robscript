----- Helpers -----

local function character()
	local current = LocalPlayer.Character
	if current and current.Parent then
		return current
	end
	return nil
end

local function humanoidOf()
	local current = character()
	return current and current:FindFirstChildOfClass("Humanoid") or nil
end

local function rootOf()
	local current = character()
	return current and current:FindFirstChild("HumanoidRootPart") or nil
end

-- Not every control stores its handle in handles; the library keeps every flag in
-- Airflow.Flags, and a Dropdown only answers through Get().
local function handleFor(name)
	local handle = handles[name]
	if handle then
		return handle
	end
	local container = Airflow.Flags
	local entry = container and container[name]
	if type(entry) == "table" then
		return entry
	end
	return nil
end

local function flag(name, fallback)
	local handle = handleFor(name)
	if not handle then
		return fallback
	end
	local ok, value = pcall(function()
		if type(handle.Get) == "function" then
			return handle:Get()
		end
		return handle.Value
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local handle = handleFor(name)
	if not handle then
		return false
	end
	return (pcall(function()
		handle:Set(value, true)
	end))
end

----- Jump -----

local function desiredJumpHeight(power)
	return JUMP_POWER_TO_HEIGHT * (power / 50) ^ 2
end

-- The game rewrites the humanoid speed from its own stamina controller, so the vanilla
-- values are captured once, before the first override, and restored from here.
local function ensureBase(humanoid)
	if not humanoid then
		return
	end
	if Movement.baseWalk == nil then
		Movement.baseWalk = humanoid.WalkSpeed
	end
	if Movement.baseUseJumpPower == nil then
		Movement.baseUseJumpPower = humanoid.UseJumpPower
		Movement.baseJumpPower = humanoid.JumpPower
		Movement.baseJumpHeight = humanoid.JumpHeight
	end
end

local function applyJump(humanoid)
	if not humanoid then
		return
	end
	ensureBase(humanoid)
	if humanoid.UseJumpPower then
		humanoid.JumpPower = Movement.jumpPower
	else
		humanoid.JumpHeight = desiredJumpHeight(Movement.jumpPower)
	end
end

local function restoreJump(humanoid)
	if not humanoid then
		return
	end
	if Movement.baseUseJumpPower ~= nil then
		humanoid.UseJumpPower = Movement.baseUseJumpPower
	end
	if Movement.baseJumpPower then
		humanoid.JumpPower = Movement.baseJumpPower
	end
	if Movement.baseJumpHeight then
		humanoid.JumpHeight = Movement.baseJumpHeight
	end
end

local function applyWalk(humanoid)
	if humanoid and Movement.walkEnabled then
		ensureBase(humanoid)
		humanoid.WalkSpeed = Movement.walkSpeed
	end
end

----- Fly -----

local function stopFly()
	if flyState.connection then
		pcall(function()
			flyState.connection:Disconnect()
		end)
		flyState.connection = nil
	end
	if flyState.velocity then
		pcall(function()
			flyState.velocity:Destroy()
		end)
		flyState.velocity = nil
	end
	if flyState.attachment then
		pcall(function()
			flyState.attachment:Destroy()
		end)
		flyState.attachment = nil
	end
	local humanoid = humanoidOf()
	if humanoid then
		pcall(function()
			humanoid.PlatformStand = false
		end)
	end
	local root = rootOf()
	if root then
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	end
	Movement.fly = false
end

local function startFly()
	local humanoid, root = humanoidOf(), rootOf()
	if not (humanoid and root) then
		return false, "Waiting for character"
	end
	if Movement.fly and flyState.velocity then
		return true
	end
	Movement.fly = true
	humanoid.PlatformStand = true

	local attachment = Instance.new("Attachment")
	attachment.Name = "RSFlyAttachment"
	attachment.Parent = root

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "RSFlyVelocity"
	velocity.Attachment0 = attachment
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root

	flyState.attachment = attachment
	flyState.velocity = velocity
	flyState.connection = RunService.RenderStepped:Connect(function()
		if not (running and Movement.fly and flyState.velocity) then
			return
		end
		local currentRoot = rootOf()
		local camera = workspace.CurrentCamera
		if not (currentRoot and camera) then
			return
		end
		local direction = Vector3.zero
		if not UserInputService:GetFocusedTextBox() then
			local look = camera.CFrame.LookVector
			local right = camera.CFrame.RightVector
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction = direction + look
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction = direction - look
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction = direction + right
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction = direction - right
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				direction = direction + Vector3.yAxis
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
				direction = direction - Vector3.yAxis
			end
		end
		if direction.Magnitude > 0 then
			direction = direction.Unit
		end
		flyState.velocity.VectorVelocity = direction * Movement.flySpeed
	end)
	return true
end

local function restoreAll()
	Movement.walkEnabled = false
	Movement.jumpEnabled = false
	Movement.infJump = false
	stopFly()
	local humanoid = humanoidOf()
	if humanoid then
		if Movement.baseWalk then
			humanoid.WalkSpeed = Movement.baseWalk
		end
		restoreJump(humanoid)
	end
end

----- Falls -----

-- Fall damage in this game is decided from the impact speed the server sees, so capping
-- the downward speed while airborne removes both the health loss and the injuries.
local function applyFallGuard()
	if not (running and Camera.noFall) then
		return
	end
	local humanoid, root = humanoidOf(), rootOf()
	if not (humanoid and root) then
		return
	end
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		return
	end
	local velocity = root.AssemblyLinearVelocity
	if velocity.Y < FALL_SPEED_LIMIT then
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, FALL_SPEED_LIMIT, velocity.Z)
	end
end

----- Roof index -----

-- The phone index lists every roof with its reward and the map publishes an anchor for
-- each one, so this tab is a picker that simply moves the character onto the roof.
local Roofs = {
	entries = {},
	options = {},
	stamp = 0,
}

local roofPoints = nil

local function roofEntries()
	local list = {}
	for line in string.gmatch(workspace:GetAttribute("RoofList") or "", "[^\n]+") do
		local id, name, sub, tier, reward = line:match("^(.-)|(.-)|(.-)|(%d+)|(%d+)$")
		if id then
			list[#list + 1] = {
				id = id,
				name = name,
				tier = tonumber(tier) or 1,
				reward = tonumber(reward) or 0,
			}
		end
	end
	return list
end

local function roofsDone()
	local ok, decoded = pcall(function()
		return game:GetService("HttpService"):JSONDecode(LocalPlayer:GetAttribute("RoofsDone") or "{}")
	end)
	if ok and type(decoded) == "table" then
		return decoded
	end
	return {}
end

local function roofPositions()
	if roofPoints then
		return roofPoints
	end
	local points = {}
	for line in string.gmatch(workspace:GetAttribute("RoofPos") or "", "[^\n]+") do
		local id, x, z = line:match("^(.-)|(-?[%d%.]+)|(-?[%d%.]+)|")
		if id then
			points[id] = { x = tonumber(x), z = tonumber(z) }
		end
	end
	roofPoints = points
	return points
end

-- A house model includes its yard, so its bounding box top is a booth or a chimney rather
-- than the roof. The anchor is therefore the largest horizontal part named like a roof,
-- with the highest clean part as a fallback for maps that name them differently.
local function roofPoint(id)
	local model = workspace:FindFirstChild(id)
	if model then
		local best, bestArea, fallback, fallbackY
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part.CFrame.UpVector.Y > 0.7 then
				local name = string.lower(part.Name)
				local area = part.Size.X * part.Size.Z
				if string.find(name, "roof", 1, true) then
					if not bestArea or area > bestArea then
						best, bestArea = part, area
					end
				end
				local ground = string.find(name, "otmostka", 1, true)
					or string.find(name, "grass", 1, true)
					or string.find(name, "asphalt", 1, true)
					or string.find(name, "ground", 1, true)
					or string.find(name, "road", 1, true)
					or string.find(name, "pavement", 1, true)
				if not ground and part.Position.Y > 8 and area >= 50 then
					if not fallbackY or part.Position.Y > fallbackY then
						fallback, fallbackY = part, part.Position.Y
					end
				end
			end
		end
		local chosen = best or fallback
		if chosen then
			return chosen.Position + Vector3.new(0, chosen.Size.Y * 0.5, 0)
		end
		return nil
	end
	local point = roofPositions()[id]
	if not point then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	local hit = workspace:Raycast(Vector3.new(point.x, 800, point.z), Vector3.new(0, -2000, 0), params)
	-- A hit at ground level means the roof is not actually placed in this map.
	if not hit or hit.Position.Y < 5 then
		return nil
	end
	return hit.Position
end

local function teleportToRoof(id)
	local center = roofPoint(id)
	if not center then
		return false, "No anchor for " .. tostring(id)
	end
	local current = character()
	if not current then
		return false, "No character"
	end
	current:PivotTo(CFrame.new(center + Vector3.new(0, 4, 0)))
	local root = rootOf()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	recordEvent(string.format("<Success>Teleported to %s</Success>", tostring(id)))
	return true
end

local function refreshRoofs(force)
	local now = os.clock()
	if not force and Roofs.stamp > 0 and now - Roofs.stamp < 5 then
		return Roofs.options
	end
	local entries = roofEntries()
	local options, points = {}, {}
	for _, entry in ipairs(entries) do
		local point = roofPoint(entry.id)
		if point then
			points[entry.id] = point
			options[#options + 1] = entry.id
		end
	end
	Roofs.entries = entries
	Roofs.options = options
	Roofs.points = points
	Roofs.stamp = now
	if handles.RoofSelect then
		pcall(function()
			handles.RoofSelect:SetOptions(options, { KeepSelection = true, Silent = true })
		end)
	end
	return options
end

----- Character -----

local function onCharacter(added)
	-- typeof, not type: type() answers "userdata" for every Instance.
	if typeof(added) ~= "Instance" then
		return
	end
	Movement.character = added
	local humanoid = added:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	Movement.baseWalk = humanoid.WalkSpeed
	Movement.baseJumpPower = humanoid.JumpPower
	Movement.baseJumpHeight = humanoid.JumpHeight
	Movement.baseUseJumpPower = humanoid.UseJumpPower

	if Movement.fly then
		-- The old rig is gone; fly has to be attached to the new one.
		stopFly()
		task.defer(startFly)
	else
		applyWalk(humanoid)
		if Movement.jumpEnabled then
			applyJump(humanoid)
		end
	end
end

LocalPlayer.CharacterAdded:Connect(onCharacter)
if LocalPlayer.Character then
	task.spawn(onCharacter, LocalPlayer.Character)
end
LocalPlayer.CharacterRemoving:Connect(function()
	stopFly()
end)

