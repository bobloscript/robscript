-- 3. РЕШАТЕЛЬ
----------------------------------------------------------------------

local function pickWord(letter)
	local key = firstChar(letter)
	-- Выученные слова надёжнее всего, но если мы подключились к матчу, который
	-- уже давно идёт, они в основном уже сыграны.
	local sources
	if Game.midMatch then
		sources = { Dictionary.freq, Dictionary.nouns, Dictionary.learned, Dictionary.fallback }
	else
		sources = { Dictionary.learned, Dictionary.freq, Dictionary.nouns, Dictionary.fallback }
	end

	local fallback = nil
	for _, pool in ipairs(sources) do
		local bucket = pool[key]
		if bucket then
			for _, word in ipairs(bucket) do
				if not Solver.used[word] and not Solver.bad[word] then
					if Settings.safeEndings and BAD_ENDINGS[lastChar(word)] then
						fallback = fallback or word
					else
						return word
					end
				end
			end
		end
	end
	return fallback
end

local function bestChoice(choices)
	local best, bestCount = nil, -1
	for _, letter in ipairs(choices) do
		local lowered = string.lower(tostring(letter))
		local key = firstChar(lowered)
		local count = #(Dictionary.freq[key] or {}) + #(Dictionary.nouns[key] or {}) + #(Dictionary.learned[key] or {})
		if count > bestCount then
			best, bestCount = lowered, count
		end
	end
	return best
end

local function submitWord(word, snapshot)
	local letter = string.lower(tostring(snapshot.letter or ""))
	local rest = restOfWord(word)

	Solver.requestId += 1
	local payload = {
		requestId = Solver.requestId,
		tableId = snapshot.tableId,
		round = snapshot.round,
		generation = snapshot.generation or 0,
	}

	if Settings.showTyping then
		local box = typingBox()
		if box then
			pcall(function()
				box.Text = rest
			end)
		end
	end

	Solver.pending = {
		word = word,
		tableId = snapshot.tableId,
		round = snapshot.round,
		generation = snapshot.generation or 0,
		requestId = payload.requestId,
		at = os.clock(),
	}

	Action:FireServer("word", letter .. rest, payload)
	Solver.lastWord = word
	log(string.format("Ответ: <Accent>%s</Accent> (%d)", word, charCount(word)))
end

--- Один ход: выбрать букву или ответить.
local function solverTick()
	if not (Settings.solve and (os.clock() - Game.at) < 20) then
		return
	end

	local now = os.clock()

	if Game.phase == "choosing" and Game.chooser == Game.you and Game.choices then
		if not Settings.autoChoose then
			return
		end
		local key = table.concat({ Game.tableId, Game.round, Game.generation }, ":")
		if Solver.chooseKey ~= key then
			local letter = bestChoice(Game.choices)
			if letter then
				Solver.chooseKey = key
				Action:FireServer("choose", letter)
				log("Выбрана буква: <Accent>" .. string.upper(letter) .. "</Accent>")
			end
		end
		return
	end

	if Game.phase ~= "playing" or Game.turn ~= Game.you then
		return
	end
	-- Экран матча скрывается сразу после стола: в закрытый стол не отвечаем.
	local frame = matchFrame()
	if frame and not frame.Visible then
		return
	end
	if not Dictionary.loaded then
		return
	end

	-- Ждём ответ на уже отправленное слово: второе подряд сервер считает
	-- ходом другого игрока. Если ответа нет три секунды - пробуем снова.
	if Solver.pending then
		if now - (Solver.pending.at or 0) < 3 then
			return
		end
		Solver.pending = nil
	end

	local key = table.concat({ Game.tableId, Game.round, Game.generation }, ":")
	if Solver.turnKey ~= key then
		Solver.turnKey = key
		Solver.attempts = 0
		Solver.turnStarted = now
		Solver.pending = nil
	end

	if Solver.attempts >= Settings.attempts or now < Solver.nextTry then
		return
	end
	if now - Solver.turnStarted < Settings.delay then
		return
	end
	if Game.deadline > 0 and timeLeft() < 0.6 then
		return
	end

	local word = pickWord(Game.letter)
	if not word then
		Solver.attempts = Settings.attempts
		log("<Warning>Нет слов на «" .. string.upper(Game.letter) .. "»</Warning>")
		return
	end

	Solver.used[word] = true
	Solver.attempts += 1
	Solver.nextTry = now + 0.25
	submitWord(word, Game.snapshot)
end

--- Один ответ прямо сейчас: кнопка и горячая клавиша.
local function answerOnce()
	if Game.phase ~= "playing" or Game.turn ~= Game.you then
		log("<Warning>Сейчас не твой ход</Warning>")
		return
	end
	if not Dictionary.loaded then
		log("<Warning>Словарь ещё загружается</Warning>")
		return
	end
	local word = pickWord(Game.letter)
	if not word then
		log("<Warning>Нет слов на «" .. string.upper(Game.letter) .. "»</Warning>")
		return
	end
	Solver.used[word] = true
	submitWord(word, Game.snapshot or Game)
end

