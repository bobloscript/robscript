	Style = "Row",
	Update = function()
		if not Dictionary.loaded then
			return "<Muted>загрузка…</Muted>"
		end
		return string.format("%d слов", Dictionary.total)
	end,
})

----------------------------------------------------------------------
-- ВКЛАДКА «СЛОВА»
----------------------------------------------------------------------

local WordsTab = Window:CreateTab({ Name = "Слова", Icon = "book-open" })
local DataBox = WordsTab:CreateGroupbox({ Name = "Словарь", Side = "Left" })
local NotesBox = WordsTab:CreateGroupbox({ Name = "Запас", Side = "Right" })

DataBox:CreateLabel({
	Text = "Загрузка…",
	Update = function()
		if not Dictionary.loaded then
			return "Слова ещё загружаются…"
		end
		return string.format("%d слов (%s)", Dictionary.total, Dictionary.source)
	end,
})

DataBox:CreateButton({
	Name = "Обновить словарь",
	Icon = "refresh-cw",
	Callback = function()
		task.spawn(reloadDictionaries)
	end,
})

DataBox:CreateInput({
	Name = "Добавить своё слово",
	PlaceholderText = "слово",
	Callback = function(text)
		local word = cleanWord(string.lower(tostring(text)))
		if not word then
			log("<Warning>Нужно русское слово из 3–29 букв</Warning>")
			return
		end
		if learnWord(word) then
			log("Добавлено: <Accent>" .. word .. "</Accent>")
		else
			log("<Muted>Уже есть: " .. word .. "</Muted>")
		end
	end,
})

NotesBox:CreateStatus({
	Name = "Выучено",
	Style = "Row",
	Update = function()
		return tostring(countPool(Dictionary.learned))
	end,
})

NotesBox:CreateButton({
	Name = "Сохранить слова",
	Icon = "save",
	Callback = function()
		Dictionary.learnedDirty = true
		saveLearned()
		log("Слова сохранены")
	end,
})

----------------------------------------------------------------------
-- ВКЛАДКА «НАСТРОЙКИ»
----------------------------------------------------------------------

local SettingsTab = Window:CreateTab({ Name = "Настройки", Icon = "settings" })
SettingsTab:CreateConfigManager({ Name = "Конфиги", Side = "Left" })
SettingsTab:CreateThemeManager({ Name = "Тема", Side = "Right" })

local HelpBox = SettingsTab:CreateGroupbox({ Name = "Горячие клавиши", Side = "Right" })
HelpBox:CreateParagraph({
	Title = "Управление",
	Content = "RightShift — ответить один раз\nRightControl — показать или скрыть окно",
})

----------------------------------------------------------------------
-- Старт
----------------------------------------------------------------------

task.spawn(function()
	buildDictionary(false, function(ok)
		if ok then
			log(string.format("<Success>Словарь готов</Success> — %d слов", Dictionary.total))
		else
			log("<Warning>Словарь не загрузился, работает встроенный список</Warning>")
		end
	end)
end)

task.spawn(function()
	Action:FireServer("sync")
	task.wait(2)
	pcall(function()
		Window:LoadAutoload()
	end)
end)

--- Пригодится в консоли и для отладки из другого скрипта.
getgenv().__WordSolver = {
	window = Window,
	log = Log,
	game = Game,
	solver = Solver,
	settings = Settings,
	dictionary = Dictionary,
	reload = reloadDictionaries,
}

print("[RobScript.com] Решатель слов загружен")
