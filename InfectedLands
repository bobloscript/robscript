local function readMapConfig()
	local ok, cfg = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.common.config.mapConfig)
	end)
	if ok and type(cfg) == "table" and type(cfg.bounds) == "table" and type(cfg.image) == "string" then
		local bounds = cfg.bounds
		local minX = tonumber(bounds.minX)
		local spanX = tonumber(bounds.spanX)
		local minZ = tonumber(bounds.minZ)
		local spanZ = tonumber(bounds.spanZ)
		if minX and spanX and minZ and spanZ and spanX > 0 and spanZ > 0 then
			return {
				image = cfg.image,
				minX = minX,
				spanX = spanX,
				minZ = minZ,
				spanZ = spanZ,
				northIsNegativeZ = cfg.northIsNegativeZ ~= false,
			}
		end
	end
	return MAP_FALLBACK
end

local MAP = readMapConfig()

local function worldToUV(x, z)
	local u = (x - MAP.minX) / MAP.spanX
	local v = (z - MAP.minZ) / MAP.spanZ
	if not MAP.northIsNegativeZ then
		v = 1 - v
	end
	return u, v
end

local function uvToWorld(u, v)
	if not MAP.northIsNegativeZ then
		v = 1 - v
	end
	return MAP.minX + u * MAP.spanX, MAP.minZ + v * MAP.spanZ
end

