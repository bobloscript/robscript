local function setHudCorner()
	if not hud.frame then
		return
	end
	local corner = flag("HudCorner", "Top Left")
	if corner == "Top Right" then
		hud.frame.AnchorPoint = Vector2.new(1, 0)
		hud.frame.Position = UDim2.new(1, -18, 0, 18)
	elseif corner == "Bottom Left" then
		hud.frame.AnchorPoint = Vector2.new(0, 1)
		hud.frame.Position = UDim2.new(0, 18, 1, -18)
	elseif corner == "Bottom Right" then
		hud.frame.AnchorPoint = Vector2.new(1, 1)
		hud.frame.Position = UDim2.new(1, -18, 1, -18)
