		hud.frame.AnchorPoint = Vector2.new(0, 0)
		hud.frame.Position = UDim2.fromOffset(18, 18)
	end
	if hud.scale then
		hud.scale.Scale = number(flag("HudScale", 1), 1)
	end
end

local function refreshHud()
	if not flag("HudEnabled", true) then
		if hud.gui then
			hud.gui.Enabled = false
		end
		return
	end
	if not hud.gui then
		local ok = pcall(buildHud)
		if not ok then
			return
		end
		pcall(setHudCorner)
	end
	if not hud.gui.Parent then
		attachHud(hud.gui)
	end
	hud.gui.Enabled = true

	local stamina = number(LocalPlayer:GetAttribute("Stamina"), 0)
	local maxStamina = math.max(number(LocalPlayer:GetAttribute("MaxStamina"), 100), 1)
	local hunger = number(LocalPlayer:GetAttribute("Hunger"), 0)
	local maxHunger = math.max(number(LocalPlayer:GetAttribute("MaxHunger"), 100), 1)
	local thirst = number(LocalPlayer:GetAttribute("Thirst"), 0)
	local maxThirst = math.max(number(LocalPlayer:GetAttribute("MaxThirst"), 100), 1)
	local infection = number(LocalPlayer:GetAttribute("InfectionPercent"), 0)
	local stage = number(LocalPlayer:GetAttribute("InfectionStage"), 0)

	local rows = hud.rows
	if rows.Stamina then
		rows.Stamina.fill.Size = UDim2.fromScale(percent(stamina, maxStamina), 1)
		rows.Stamina.fill.BackgroundColor3 = Color3.fromRGB(255, 59, 127)
		rows.Stamina.value.Text = string.format("%d", math.floor(stamina))
	end
	if rows.Hunger then
		local value = percent(hunger, maxHunger)
		rows.Hunger.fill.Size = UDim2.fromScale(value, 1)
		rows.Hunger.fill.BackgroundColor3 = value > 0.5 and Color3.fromRGB(120, 220, 140)
			or (value > 0.25 and Color3.fromRGB(255, 200, 90) or Color3.fromRGB(255, 90, 90))
		rows.Hunger.value.Text = string.format("%d", math.floor(hunger))
	end
	if rows.Thirst then
		local value = percent(thirst, maxThirst)
		rows.Thirst.fill.Size = UDim2.fromScale(value, 1)
		rows.Thirst.fill.BackgroundColor3 = value > 0.5 and Color3.fromRGB(110, 190, 255)
			or (value > 0.25 and Color3.fromRGB(255, 200, 90) or Color3.fromRGB(255, 90, 90))
		rows.Thirst.value.Text = string.format("%d", math.floor(thirst))
	end
	if rows.Infection then
		rows.Infection.fill.Size = UDim2.fromScale(math.clamp(infection / 100, 0, 1), 1)
		rows.Infection.fill.BackgroundColor3 = stage > 0 and Color3.fromRGB(214, 78, 214) or Color3.fromRGB(120, 220, 140)
		rows.Infection.value.Text = stage > 0 and ("S" .. tostring(math.floor(stage))) or T("clean")
	end
	if hud.title then
		hud.title.Text = stage > 0 and ("INFECTED LANDS · " .. T("STAGE %d", math.floor(stage))) or "INFECTED LANDS"
	end

	if hud.waypoint then
		local waypoint = mapState.waypoint
		local character = LocalPlayer.Character
		local part = character and rootOf(character)
		if waypoint and part then
			local dx = waypoint.x - part.Position.X
			local dz = waypoint.z - part.Position.Z
			local camera = workspace.CurrentCamera
			local look = camera and camera.CFrame.LookVector or part.CFrame.LookVector
			local bearing = math.deg(math.atan2(dx, -dz) - math.atan2(look.X, -look.Z))
			hud.waypoint.arrow.Visible = true
			hud.waypoint.arrow.Rotation = bearing
			hud.waypoint.value.Text = formatDistance(math.sqrt(dx * dx + dz * dz))
		else
			hud.waypoint.arrow.Visible = false
			hud.waypoint.value.Text = T("no waypoint")
		end
	end
end

----- Markers on the game map -----

local function mapColorFor(kind, player)
	if kind == KIND_PLAYER then
		if player and player:GetAttribute("Infected") == true then
			return flag("InfectedColor", COLOR_INFECTED)
		end
		return flag("PlayerColor", COLOR_PLAYER)
	elseif kind == KIND_ZOMBIE then
		return flag("ZombieColor", COLOR_ZOMBIE)
	elseif kind == KIND_LOOT then
		return flag("LootColor", COLOR_LOOT)
	elseif kind == KIND_VEHICLE then
		return flag("VehicleColor", COLOR_VEHICLE)
	elseif kind == KIND_AIRDROP then
		return flag("AirdropColor", COLOR_AIRDROP)
	end
	return flag("CorpseColor", COLOR_CORPSE)
end

local function setWaypoint(x, z)
	if not x or not z then
		mapState.waypoint = nil
	else
		mapState.waypoint = { x = x, z = z }
	end
	if mapState.waypointMarker then
		local waypoint = mapState.waypoint
		mapState.waypointMarker.Visible = waypoint ~= nil
		if waypoint then
			local u, v = worldToUV(waypoint.x, waypoint.z)
			mapState.waypointMarker.Position = UDim2.fromScale(u, v)
		end
	end
	return mapState.waypoint
end

local function clearWaypoint()
	return setWaypoint(nil, nil)
end

local function destroyMapLayer()
	if mapState.clickConnection then
		pcall(function()
			mapState.clickConnection:Disconnect()
		end)
		mapState.clickConnection = nil
	end
	mapState.clickParent = nil
	if mapState.folder then
		pcall(function()
			mapState.folder:Destroy()
		end)
	end
	mapState.folder = nil
	mapState.parent = nil
	mapState.self = nil
	mapState.waypointMarker = nil
	mapState.pool = setmetatable({}, { __mode = "k" })
end

-- The layer is a Folder, not a Frame: a full size Frame would swallow clicks
-- meant for the game's own teleport picker on the map.
local function ensureMapLayer(parent)
	if mapState.folder and mapState.folder.Parent == parent and mapState.self then
		return mapState.folder
	end
	destroyMapLayer()

	local folder = Instance.new("Folder")
	folder.Name = "RobScriptIL_Markers"

	local selfArrow = Instance.new("TextLabel")
	selfArrow.Name = "Self"
	selfArrow.AnchorPoint = Vector2.new(0.5, 0.5)
	selfArrow.BackgroundTransparency = 1
	selfArrow.Size = UDim2.fromOffset(18, 18)
	selfArrow.Font = Enum.Font.GothamBold
	selfArrow.TextSize = 14
	selfArrow.Text = "▲"
	selfArrow.TextColor3 = flag("PlayerColor", COLOR_PLAYER)
	selfArrow.ZIndex = 6
	selfArrow.Parent = folder

	local waypoint = Instance.new("TextLabel")
	waypoint.Name = "Waypoint"
	waypoint.AnchorPoint = Vector2.new(0.5, 0.5)
	waypoint.BackgroundTransparency = 1
	waypoint.Size = UDim2.fromOffset(18, 18)
	waypoint.Font = Enum.Font.GothamBold
	waypoint.TextSize = 14
	waypoint.Text = "◆"
	waypoint.TextColor3 = Color3.fromRGB(245, 245, 247)
	waypoint.Visible = false
	waypoint.ZIndex = 7
	waypoint.Parent = folder

	folder.Parent = parent
	mapState.folder = folder
	mapState.parent = parent
	mapState.self = selfArrow
	mapState.waypointMarker = waypoint

	-- Left click stays with the game (teleport picker), so the waypoint is set
	-- with a right click on the map.
	mapState.clickParent = parent
	mapState.clickConnection = parent.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton2 then
			return
		end
		local size = parent.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local u = (input.Position.X - parent.AbsolutePosition.X) / size.X
		local v = (input.Position.Y - parent.AbsolutePosition.Y) / size.Y
		if u >= 0 and u <= 1 and v >= 0 and v <= 1 then
			local x, z = uvToWorld(u, v)
			setWaypoint(x, z)
		end
	end)

	if mapState.waypoint then
		local u, v = worldToUV(mapState.waypoint.x, mapState.waypoint.z)
		waypoint.Position = UDim2.fromScale(u, v)
		waypoint.Visible = true
	end

	return folder
end

local function resolveMap()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local ui = playerGui and playerGui:FindFirstChild("MapUI")
	local map = ui and ui:FindFirstChild("Map")
	if map and map:IsA("GuiObject") and map.Visible and map.AbsoluteSize.X > 0 then
		return map
	end
	return nil
end

local function hostPosition(host)
	if host:IsA("BasePart") then
		return host.Position
	end
	local sum, count = Vector3.zero, 0
	for _, child in ipairs(host:GetChildren()) do
		if child:IsA("BasePart") then
			sum = sum + child.Position
			count = count + 1
		end
	end
	if count > 0 then
		return sum / count
	end
	local part = host:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

local function placeDot(instance, kind, world, size, player)
	local u, v = worldToUV(world.X, world.Z)
	if u < 0 or u > 1 or v < 0 or v > 1 then
		return
	end
	local dot = mapState.pool[instance]
	if not dot or not dot.Parent then
		dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BorderSizePixel = 0
		dot.ZIndex = 5
		local dotCorner = Instance.new("UICorner")
		dotCorner.CornerRadius = UDim.new(1, 0)
		dotCorner.Parent = dot
		dot.Parent = mapState.folder
		mapState.pool[instance] = dot
	end
	dot.Visible = true
	dot.Position = UDim2.fromScale(u, v)
	dot.Size = UDim2.fromOffset(size, size)
	dot.BackgroundColor3 = mapColorFor(kind, player)
end

local function refreshMapMarkers()
	if not flag("MapMarkers", true) then
		if mapState.folder then
			destroyMapLayer()
		end
		return
	end

	local parent = resolveMap()
	if not parent then
		return
	end
	ensureMapLayer(parent)

	local character = LocalPlayer.Character
	local originPart = character and rootOf(character)
	if not originPart then
		return
	end
	local position = originPart.Position
	local seen = {}

	if flag("MapPlayers", true) then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local otherCharacter = player.Character
				local root = otherCharacter and rootOf(otherCharacter)
				if root then
					seen[otherCharacter] = true
					placeDot(otherCharacter, KIND_PLAYER, root.Position, 7, player)
				end
			end
		end
	end

	if flag("MapZombies", true) then
		local folder = workspace:FindFirstChild("Zombies")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				local root = rootOf(model)
				if root and model:GetAttribute("Dead") ~= true then
					seen[model] = true
					placeDot(model, KIND_ZOMBIE, root.Position, 6)
				end
			end
		end
	end

	if flag("MapLoot", true) then
		for _, host in ipairs(lootHosts) do
			if host.Parent and not isLooted(host) then
				local hostPos = hostPosition(host)
				if hostPos then
					seen[host] = true
					placeDot(host, KIND_LOOT, hostPos, 4)
				end
			end
		end
	end

	if flag("MapVehicles", false) then
		local folder = workspace:FindFirstChild("Vehicles")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				local root = firstBasePart(model)
				if root then
					seen[model] = true
					placeDot(model, KIND_VEHICLE, root.Position, 6)
				end
			end
		end
	end

	if flag("MapAirdrops", true) then
		local folder = workspace:FindFirstChild("Airdrops")
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				local root = firstBasePart(model)
				if root then
					seen[model] = true
					placeDot(model, KIND_AIRDROP, root.Position, 8)
				end
			end
		end
	end

	for instance, dot in pairs(mapState.pool) do
		if not seen[instance] and dot.Parent then
			dot.Visible = false
		end
	end

	local u, v = worldToUV(position.X, position.Z)
	if mapState.self then
		mapState.self.Position = UDim2.fromScale(u, v)
		mapState.self.TextColor3 = flag("PlayerColor", COLOR_PLAYER)
		local look = originPart.CFrame.LookVector
		mapState.self.Rotation = math.deg(math.atan2(look.X, -look.Z))
	end
end


----- Aim -----

-- Two lock implementations behind one switch:
--   Camera FOV     - this hub's own: picks the target closest to the crosshair
--                    in screen pixels, keeps it while it stays near, smooths.
--   BlockSpin lock - ported from BlockSpin: sorts by angle to the camera, has a
--                    hard snap mode and re-grabs the nearest body on loss.
-- Both are written in RenderStepped: the game's camera script runs first and
-- would overwrite a lock written in Heartbeat.

local AIM_METHOD_FOV = "Camera FOV"
local AIM_METHOD_BLOCKSPIN = "BlockSpin lock"

local AIM_BONES = {
	["Head"] = "Head",
	["Torso"] = "Torso",
	["Root part"] = "HumanoidRootPart",
}

local aimState = {
	holding = false,
	toggled = false,
	player = nil,
	part = nil,
	indicator = nil,
	circle = nil,
	circleFrame = nil,
}

local function aimKeyName()
	local value = flag("AimKey", "Q")
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		return Enum.KeyCode[value] or Enum.KeyCode.Q
	end
	return Enum.KeyCode.Q
end

local function aimEngaged()
	if not flag("Aimlock", false) then
		return false
	end
	if flag("AimActivation", "Hold") == "Toggle" then
		return aimState.toggled
	end
	return aimState.holding
end

local function aimBoneName()
	return AIM_BONES[flag("AimBone", "Head")] or "Head"
end

local function aimRange()
	return number(flag("AimRange", 500), 500)
end

local function aimFovPixels()
	return number(flag("AimFov", 120), 120)
end

local function aimFocusPart(player)
	local character = player and player.Character
	if not character then
		return nil
	end
	local part = character:FindFirstChild(aimBoneName())
		or character:FindFirstChild("Head")
		or character:FindFirstChild("HumanoidRootPart")
	return part
end

local function aimFilterAllows(player)
	local filter = flag("AimFilter", "Everyone")
	if filter == "Everyone" then
		return true
	end
	local infected = player:GetAttribute("Infected") == true
	if filter == "Infected only" then
		return infected
	end
	return not infected
end

-- Raycast between the camera and the target; a wall or a car cancels the lock.
local function aimVisible(part)
	if not flag("AimWallCheck", false) then
		return true
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	local params = RaycastParams.new()
	local ok = pcall(function()
		params.FilterType = Enum.RaycastFilterType.Exclude
	end)
	if not ok then
		pcall(function()
			params.FilterType = Enum.RaycastFilterType.Blacklist
		end)
	end
	local ignored = { part.Parent }
	local character = LocalPlayer.Character
	if character then
		ignored[#ignored + 1] = character
	end
	params.FilterDescendantsInstances = ignored
	local result = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, params)
	return result == nil
end

local function aimedAngle(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local offset = position - camera.CFrame.Position
	if offset.Magnitude < 0.5 then
		return nil
	end
	return math.deg(math.acos(math.clamp(camera.CFrame.LookVector:Dot(offset.Unit), -1, 1)))
end

-- Own method: candidates scored by pixels from the crosshair, not by angle.
local function fovCandidates()
	local camera = workspace.CurrentCamera
	if not camera then
		return {}
	end
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local fov = aimFovPixels()
	local range = aimRange()
	local origin = camera.CFrame.Position
	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and aimFilterAllows(player) then
			local part = aimFocusPart(player)
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if part and humanoid and humanoid.Health > 0 then
				local distance = (part.Position - origin).Magnitude
				if distance <= range and aimVisible(part) then
					local point = camera:WorldToViewportPoint(part.Position)
					if point.Z > 0 then
						local offset = Vector2.new(point.X, point.Y) - center
						local screen = offset.Magnitude
						if screen <= fov then
							list[#list + 1] = { player = player, part = part, distance = distance, screen = screen }
						end
					end
				end
			end
		end
	end
	return list
end

-- BlockSpin method: front-first sort by angle, distance as the tiebreak.
local function angleCandidates()
	local camera = workspace.CurrentCamera
	if not camera then
		return {}
	end
	local origin = camera.CFrame.Position
	local range = aimRange()
	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and aimFilterAllows(player) then
			local part = aimFocusPart(player)
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if part and humanoid and humanoid.Health > 0 then
				local distance = (part.Position - origin).Magnitude
				if distance <= range then
					local angle = aimedAngle(part.Position)
					if angle then
						list[#list + 1] = { player = player, part = part, angle = angle, distance = distance }
					end
				end
			end
		end
	end

	if flag("AimForceLock", false) then
		table.sort(list, function(a, b)
			return a.distance < b.distance
		end)
		return list
	end

	table.sort(list, function(a, b)
		local aFront = a.angle <= 60
		local bFront = b.angle <= 60
		if aFront ~= bFront then
			return aFront
		end
		if aFront then
			return a.angle < b.angle
		end
		return a.distance < b.distance
	end)
	return list
end

