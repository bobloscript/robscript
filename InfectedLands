-- Translation helper: works even if the library build has no T, and keeps the
-- raw string when the key is missing.
local unpackArgs = table.unpack or unpack

local translationCache = {}

local function T(text, ...)
	local count = select("#", ...)
	if count == 0 then
		local cached = translationCache[text]
		if cached then
			return cached
		end
	end
	local args = { ... }
	local ok, translated = pcall(function()
		return Airflow:T(text, unpackArgs(args, 1, count))
	end)
	if ok and type(translated) == "string" then
		-- Only real translations are cached: caching the source string would
		-- poison the cache once the player switches language.
		if count == 0 and translated ~= text then
			translationCache[text] = translated
		end
		return translated
	end
	if count > 0 then
		local formatted, value = pcall(string.format, text, unpackArgs(args, 1, count))
		if formatted then
			return value
		end
	end
	return text
end

