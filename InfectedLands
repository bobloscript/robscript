local function buildBillboard(part)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromOffset(240, 34)
	billboard.StudsOffset = Vector3.new(0, math.max(part.Size.Y * 0.8, 0.5) + 0.5, 0)
	billboard.Enabled = false

	local label = Instance.new("TextLabel")
	label.Name = "ESP_Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.RichText = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Bottom
	label.TextStrokeTransparency = 0.35
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = ""
	label.Parent = billboard

	billboard.Adornee = part
	billboard.Parent = part
	return billboard, label
end

local function buildHighlight(model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_Chams"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0.1
	highlight.Parent = model
	return highlight
end

local function destroyVisual(visual)
	if visual.highlight then
		pcall(function()
			visual.highlight:Destroy()
		end)
		visual.highlight = nil
	end
	if visual.billboard then
		pcall(function()
			visual.billboard:Destroy()
		end)
		visual.billboard = nil
		visual.label = nil
	end
end

local function ensureVisual(adornee)
	local visual = visuals[adornee]
	if visual and visual.billboard and visual.billboard.Parent == adornee then
		return visual
	end
	if visual then
		destroyVisual(visual)
	end
	local billboard, label = buildBillboard(adornee)
	visual = { billboard = billboard, label = label }
	visuals[adornee] = visual
	return visual
end

local function clearVisuals()
	for adornee, visual in pairs(visuals) do
		destroyVisual(visual)
		visuals[adornee] = nil
	end
	for _, key in pairs({ "players", "zombies", "loot", "vehicles", "corpses", "airdrops", "markers" }) do
		stats[key] = 0
	end
end

