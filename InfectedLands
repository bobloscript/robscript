-- Flags are cached after the interface is built, so a config load cannot
-- desync the runtime: every tick reads the same objects the user sees.
local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

local function number(value, fallback)
	local parsed = tonumber(value)
	if parsed == nil then
		return fallback
	end
	return parsed
end

----- Helpers -----

local function escapeRichText(text)
	local value = tostring(text)
	value = value:gsub("&", "&amp;")
	value = value:gsub("<", "&lt;")
	value = value:gsub(">", "&gt;")
	return value
end

-- Turns "gun_crate_Normal" and "Zombie_01_S1_P1" into readable words without
-- destroying names that already carry their own capitals.
local function prettify(text)
	local spaced = tostring(text):gsub("_", " ")
	spaced = spaced:gsub("(%l)(%u)", "%1 %2")
	spaced = spaced:gsub("(%u)(%u%l)", "%1 %2")
	spaced = spaced:gsub("^%l", string.upper)
	return spaced
end

-- Distance is measured from the camera: in this game the character can be in a
-- vehicle seat while the camera is somewhere else entirely.
local function distanceOrigin()
	if flag("DistanceFrom", "Camera") == "Character" then
		local character = LocalPlayer.Character
		if character then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then
				return root.Position
			end
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function firstBasePart(model)
	local primary = model.PrimaryPart
	if primary then
		return primary
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			return child
		end
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function rootOf(model)
	if not model then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return firstBasePart(model)
end

local function percent(value, maximum)
	if not maximum or maximum <= 0 then
		return 0
	end
	return math.clamp(value / maximum, 0, 1)
end

