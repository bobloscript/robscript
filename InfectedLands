local function collectLoot(origin)
	if not flag("LootESP", true) then
		return
	end
	if os.clock() - lootHostsScannedAt > LOOT_SCAN_INTERVAL or #lootHosts == 0 then
		scanLootHosts()
	end

	local showNames = flag("LootNames", true)
	local showDistance = flag("LootDistanceTag", true)
	local chams = flag("LootChams", true)
	local hideLooted = flag("LootHideLooted", true)
	local range = number(flag("LootRenderDistance", 225), 225)
	local allowed = flag("LootTypes", LOOT_CATEGORIES)
	if type(allowed) ~= "table" or #allowed == 0 then
		allowed = LOOT_CATEGORIES
	end
	local color = flag("LootColor", COLOR_LOOT)
	local rareColor = flag("RareColor", COLOR_RARE)

	-- A host is a folder of proxy parts, and the prompt hangs off the proxy, so
	-- both shapes are accepted: a prompt child or a proxy with a prompt inside.
	for _, host in ipairs(lootHosts) do
		if host.Parent then
			for _, node in ipairs(host:GetChildren()) do
				local prompt = nil
				local adornee = nil
				if node:IsA("ProximityPrompt") then
					prompt = node
					adornee = node.Parent
				else
					prompt = node:FindFirstChildOfClass("ProximityPrompt")
					adornee = node
				end
				if prompt and adornee and adornee:IsA("BasePart") then
					local distance = (adornee.Position - origin).Magnitude
					if distance <= range then
						local title = lootTitle(prompt)
						local category = lootCategory(title)
						local allowedCategory = table.find(allowed, category) ~= nil
						local looted = hideLooted and isLooted(adornee)
						if allowedCategory and not looted then
							local lines = {}
							if showNames then
								lines[#lines + 1] = escapeRichText(title)
							else
								lines[#lines + 1] = "Loot"
							end
							if showDistance then
								lines[#lines + 1] = "<Muted>" .. formatDistance(distance) .. "</Muted>"
							end
							local tint = category == "Guns" and rareColor or color
							pushCandidate(KIND_LOOT, adornee, node, distance, table.concat(lines, " "), tint, chams)
						end
					end
				end
			end
		end
	end
end

----- Render -----

local function renderCandidate(item, textSize, chamBudget)
	local visual = ensureVisual(item.adornee)
	if not visual or not visual.label then
		return
	end

	visual.label.TextSize = textSize
	visual.label.Text = item.text
	visual.label.TextColor3 = item.color
	visual.billboard.Size = UDim2.fromOffset(math.max(160, math.floor(190 * textSize / 14)), math.floor(textSize * 2.5))
	visual.billboard.Enabled = true

	if item.chams and item.model and chamBudget.left > 0 then
		if not visual.highlight or visual.highlight.Parent ~= item.model then
			if visual.highlight then
				pcall(function()
					visual.highlight:Destroy()
				end)
			end
			local ok, highlight = pcall(buildHighlight, item.model)
			visual.highlight = ok and highlight or nil
		end
		if visual.highlight then
			visual.highlight.FillColor = item.color
			visual.highlight.OutlineColor = item.color
			chamBudget.left = chamBudget.left - 1
		end
	elseif visual.highlight then
		pcall(function()
			visual.highlight:Destroy()
		end)
		visual.highlight = nil
	end
end

local function renderList(list)
	local textSize = number(flag("TextSize", 14), 14)
	local chamBudget = { left = CHAM_BUDGET }
	local seen = {}

	for _, item in ipairs(list) do
		seen[item.adornee] = true
		pcall(renderCandidate, item, textSize, chamBudget)
	end

	for adornee, visual in pairs(visuals) do
		if not seen[adornee] then
			destroyVisual(visual)
			visuals[adornee] = nil
		end
	end
end

local function countStats(list)
	stats.players = 0
	stats.zombies = 0
	stats.loot = 0
	stats.vehicles = 0
	stats.corpses = 0
	stats.airdrops = 0
	stats.markers = #list

	for _, item in ipairs(list) do
		if item.kind == KIND_PLAYER then
			stats.players = stats.players + 1
		elseif item.kind == KIND_ZOMBIE then
			stats.zombies = stats.zombies + 1
		elseif item.kind == KIND_LOOT then
			stats.loot = stats.loot + 1
		elseif item.kind == KIND_VEHICLE then
			stats.vehicles = stats.vehicles + 1
		elseif item.kind == KIND_CORPSE then
			stats.corpses = stats.corpses + 1
		elseif item.kind == KIND_AIRDROP then
			stats.airdrops = stats.airdrops + 1
		end
	end
end

local function sortByDistance(a, b)
	return a.distance < b.distance
end

local function collect()
	candidates = {}

	local origin = distanceOrigin()
	pcall(collectPlayers, origin)
	pcall(collectZombies, origin)
	pcall(collectVehicles, origin)
	pcall(collectCorpses, origin)
	pcall(collectAirdrops, origin)
	pcall(collectLoot, origin)

	table.sort(candidates, sortByDistance)

	local cap = number(flag("MaxMarkers", MAX_MARKERS), MAX_MARKERS)
	if cap > 0 and #candidates > cap then
		local trimmed = {}
		for index = 1, cap do
			trimmed[index] = candidates[index]
		end
		candidates = trimmed
	end

	countStats(candidates)
	return candidates
end

----- On-screen HUD -----

local function hudParent()
	local ok, hui = pcall(function()
		return gethui()
	end)
	if ok and typeof(hui) == "Instance" then
		return hui
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

-- PlayerGui is rebuilt on every respawn, so a HUD that survived can end up
-- parentless. Reattaching on each refresh keeps it on screen after deaths.
local function attachHud(gui)
	local ok = pcall(function()
		gui.Parent = hudParent()
	end)
	if ok and gui.Parent then
		return true
	end
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if playerGui then
		pcall(function()
			gui.Parent = playerGui
		end)
	end
	return gui.Parent ~= nil
end

