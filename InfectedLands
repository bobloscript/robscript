local LOOT_HOST_NAMES = {
	["_LootProxies"] = true,
	["_ClientPrefabLootPrompts"] = true,
}

local lootHosts = {}
local lootHostsScannedAt = 0

-- Loot is stored under two proxy hosts that the game streams in with houses, so
-- the world is walked on a slow timer instead of every frame.
local function scanLootHosts()
	local hosts = {}
	local stack = { workspace }
	while #stack > 0 do
		local current = table.remove(stack)
		for _, child in ipairs(current:GetChildren()) do
			if LOOT_HOST_NAMES[child.Name] then
				hosts[#hosts + 1] = child
			elseif child ~= workspace.CurrentCamera then
				stack[#stack + 1] = child
			end
		end
	end
	lootHosts = hosts
	lootHostsScannedAt = os.clock()
	return hosts
end

local function isLooted(instance)
	local node = instance
	for _ = 1, 3 do
		if not node then
			break
		end
		if node:GetAttribute("Looted") == true then
			return true
		end
		node = node.Parent
	end
	return false
end

local function lootTitle(prompt)
	local text = prompt.ObjectText
	if type(text) ~= "string" or text == "" or string.find(string.lower(text), "loot available", 1, true) then
		local parent = prompt.Parent
		if parent then
			local cleaned = parent.Name
			cleaned = cleaned:gsub("_Normal$", ""):gsub("_Rare$", ""):gsub("_Common$", "")
			return prettify(cleaned)
		end
		return "Container"
	end
	return text
end

local function lootCategory(title)
	local low = string.lower(title)
	if string.find(low, "gun", 1, true)
		or string.find(low, "display case", 1, true)
		or string.find(low, "military", 1, true)
		or string.find(low, "armory", 1, true)
		or string.find(low, "police", 1, true)
	then
		return "Guns"
	end
	if string.find(low, "medical", 1, true)
		or string.find(low, "ambulance", 1, true)
		or string.find(low, "clinic", 1, true)
		or string.find(low, "pharmacy", 1, true)
		or string.find(low, "medbag", 1, true)
		or string.find(low, "hospital", 1, true)
	then
		return "Medical"
	end
	if string.find(low, "refriger", 1, true)
		or string.find(low, "fridge", 1, true)
		or string.find(low, "kitchen", 1, true)
		or string.find(low, "food", 1, true)
		or string.find(low, "ice box", 1, true)
		or string.find(low, "vending", 1, true)
		or string.find(low, "microwave", 1, true)
		or string.find(low, "stove", 1, true)
		or string.find(low, "freezer", 1, true)
		or string.find(low, "pantry", 1, true)
		or string.find(low, "soda", 1, true)
		or string.find(low, "beer", 1, true)
	then
		return "Food"
	end
	if string.find(low, "vehicle", 1, true)
		or string.find(low, "wreck", 1, true)
		or string.find(low, "truck", 1, true)
		or string.find(low, "sedan", 1, true)
		or string.find(low, "trunk", 1, true)
	then
		return "Vehicles"
	end
	return "Other"
end

----- Collection -----

local candidates = {}

local function pushCandidate(kind, adornee, model, distance, text, color, chams)
	if not adornee or not adornee.Parent then
		return
	end
	candidates[#candidates + 1] = {
		kind = kind,
		adornee = adornee,
		model = model,
		distance = distance,
		text = text,
		color = color,
		chams = chams,
	}
end

local function collectPlayers(origin)
	if not flag("PlayerESP", true) then
		return
	end
	local filter = flag("PlayerFilter", "Everyone")
	local limit = number(flag("PlayerRenderDistance", 1500), 1500)
	local showName = flag("PlayerName", true)
	local showFaction = flag("PlayerFaction", true)
	local showHealth = flag("PlayerHealth", true)
	local showDistance = flag("PlayerDistance", true)
	local showInfected = flag("PlayerInfectedTag", true)
	local chams = flag("PlayerChams", true)
	local colorClean = flag("PlayerColor", COLOR_PLAYER)
	local colorInfected = flag("InfectedColor", COLOR_INFECTED)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			local adornee = character and rootOf(character)
			if adornee then
				local infected = player:GetAttribute("Infected") == true
				local stage = number(player:GetAttribute("InfectionStage"), 0)
				local allowed = filter == "Everyone"
					or (filter == "Infected only" and infected)
					or (filter == "Clean only" and not infected)
				if allowed then
					local distance = (adornee.Position - origin).Magnitude
					if distance <= limit or limit == 0 then
						local humanoid = character:FindFirstChildOfClass("Humanoid")
						local health = humanoid and humanoid.Health or 0
						local maxHealth = humanoid and humanoid.MaxHealth or 100
						local faction = player:GetAttribute("DeployFaction")
						local lines = {}

						if showName then
							lines[#lines + 1] = escapeRichText(player.Name)
						end
						if showFaction and type(faction) == "string" then
							local tag = FACTION_TAG[faction] or string.upper(faction)
							lines[#lines + 1] = "<Muted>[" .. escapeRichText(tag) .. "]</Muted>"
						end
						if showInfected and infected then
							lines[#lines + 1] = "<Error>" .. T("INFECTED") .. " " .. tostring(stage) .. "</Error>"
						end

						local meta = {}
						if showHealth and humanoid then
							local bar = percent(health, maxHealth)
							local tone = bar > 0.6 and "Success" or (bar > 0.3 and "Warning" or "Error")
							meta[#meta + 1] = "<" .. tone .. ">" .. tostring(math.floor(health)) .. "</" .. tone .. ">"
						end
						if showDistance then
							meta[#meta + 1] = "<Muted>" .. formatDistance(distance) .. "</Muted>"
						end
						if #meta > 0 then
							lines[#lines + 1] = table.concat(meta, " <Muted>·</Muted> ")
						end

						pushCandidate(
							KIND_PLAYER,
							adornee,
							character,
							distance,
							table.concat(lines, " "),
							infected and colorInfected or colorClean,
							chams
						)
					end
				end
			end
		end
	end
end

local function collectZombies(origin)
	if not flag("ZombieESP", true) then
		return
	end
	local folder = workspace:FindFirstChild("Zombies")
	if not folder then
		return
	end
	local limit = number(flag("ZombieRenderDistance", 1200), 1200)
	local showName = flag("ZombieName", true)
	local showHealth = flag("ZombieHealth", true)
	local showDistance = flag("ZombieDistance", true)
	local showArchetype = flag("ZombieArchetype", true)
	local showType = flag("ZombieType", false)
	local chams = flag("ZombieChams", true)
	local baseColor = flag("ZombieColor", COLOR_ZOMBIE)

	for _, model in ipairs(folder:GetChildren()) do
		local adornee = rootOf(model)
		if adornee and model:GetAttribute("Dead") ~= true then
			local distance = (adornee.Position - origin).Magnitude
			if distance <= limit then
				local health = number(model:GetAttribute("Health"), 0)
				local maxHealth = number(model:GetAttribute("MaxHealth"), 100)
				local archetype = model:GetAttribute("ZombieArchetype") or "Default"
				local zombieType = tostring(model:GetAttribute("ZombieType") or model.Name)
				local bloodMoon = model:GetAttribute("BloodMoonZombie") == true

				local lines = {}
				if showName then
					local label = archetype ~= "Default" and (archetype .. " zombie") or "Zombie"
					lines[#lines + 1] = escapeRichText(T(label))
				end
				if showArchetype and bloodMoon then
					lines[#lines + 1] = "<Error>" .. T("BLOOD MOON") .. "</Error>"
				end
				if showType then
					local tier = zombieType:match("S(%d)_P(%d)")
					if tier then
						lines[#lines + 1] = "<Muted>S" .. tier .. "·P" .. (zombieType:match("S%d_P(%d)") or "?") .. "</Muted>"
					end
				end

				local meta = {}
				if showHealth then
					local bar = percent(health, maxHealth)
					local tone = bar > 0.6 and "Success" or (bar > 0.3 and "Warning" or "Error")
					meta[#meta + 1] = "<" .. tone .. ">" .. tostring(math.floor(health)) .. "</" .. tone .. ">"
				end
				if showDistance then
					meta[#meta + 1] = "<Muted>" .. formatDistance(distance) .. "</Muted>"
				end
				if #meta > 0 then
					lines[#lines + 1] = table.concat(meta, " <Muted>·</Muted> ")
				end

				local color = baseColor
				if archetype == "Tanky" then
					color = Color3.fromRGB(255, 106, 106)
				elseif archetype == "Speedy" then
					color = Color3.fromRGB(255, 220, 110)
				elseif bloodMoon then
					color = Color3.fromRGB(255, 62, 92)
				end

				pushCandidate(KIND_ZOMBIE, adornee, model, distance, table.concat(lines, " "), color, chams)
			end
		end
	end
end

local function collectVehicles(origin)
	if not flag("VehicleESP", false) then
		return
	end
	local folder = workspace:FindFirstChild("Vehicles")
	if not folder then
		return
	end
	local limit = number(flag("VehicleRenderDistance", 1200), 1200)
	local showName = flag("VehicleName", true)
	local showHealth = flag("VehicleHealth", true)
	local showFuel = flag("VehicleFuel", true)
	local showDistance = flag("VehicleDistance", true)
	local chams = flag("VehicleChams", true)
	local color = flag("VehicleColor", COLOR_VEHICLE)

	for _, model in ipairs(folder:GetChildren()) do
		local adornee = firstBasePart(model)
		if adornee then
			local distance = (adornee.Position - origin).Magnitude
			if distance <= limit then
				local hp = number(model:GetAttribute("Vehicle_HealthPercent"), number(model:GetAttribute("Vehicle_HP"), 100))
				local destroyed = model:GetAttribute("Vehicle_Destroyed") == true
				local fuel = number(model:GetAttribute("Fuel_Current"), 0)
				local fuelMax = number(model:GetAttribute("Fuel_Max"), 1)
				local fuelPercent = math.floor(percent(fuel, fuelMax) * 100 + 0.5)
				local flat = number(model:GetAttribute("Tire_FlatCount"), 0)

				local lines = {}
				if showName then
					local name = model:GetAttribute("Vehicle_Name") or prettify(model.Name)
					lines[#lines + 1] = escapeRichText(tostring(name))
				end
				if destroyed then
					lines[#lines + 1] = "<Error>" .. T("WRECK") .. "</Error>"
				end

				local meta = {}
				if showHealth then
					local tone = hp > 60 and "Success" or (hp > 30 and "Warning" or "Error")
					meta[#meta + 1] = "<" .. tone .. ">" .. tostring(math.floor(hp)) .. "%</" .. tone .. ">"
				end
				if showFuel then
					meta[#meta + 1] = "<Muted>" .. tostring(fuelPercent) .. "% " .. T("fuel") .. "</Muted>"
				end
				if flat > 0 then
					meta[#meta + 1] = "<Warning>" .. tostring(flat) .. " " .. T("flat") .. "</Warning>"
				end
				if showDistance then
					meta[#meta + 1] = "<Muted>" .. formatDistance(distance) .. "</Muted>"
				end
				if #meta > 0 then
					lines[#lines + 1] = table.concat(meta, " <Muted>·</Muted> ")
				end

				pushCandidate(KIND_VEHICLE, adornee, model, distance, table.concat(lines, " "), color, chams)
			end
		end
	end
end

