----- Runtime -----

resetFlagCache()

local visualAccumulator = 0
local collectAccumulator = 0
local hudAccumulator = 0
local mapAccumulator = 0
local mapErrorShown = false

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	collectAccumulator = collectAccumulator + deltaTime
	visualAccumulator = visualAccumulator + deltaTime
	hudAccumulator = hudAccumulator + deltaTime
	mapAccumulator = mapAccumulator + deltaTime

	if collectAccumulator >= COLLECT_INTERVAL then
		collectAccumulator = 0
		collect()
	end

	if visualAccumulator >= VISUAL_INTERVAL then
		visualAccumulator = 0
		renderList(candidates)
	end

	if hudAccumulator >= HUD_INTERVAL then
		hudAccumulator = 0
		pcall(refreshHud)
	end

	if mapAccumulator >= MAP_INTERVAL then
		mapAccumulator = 0
		local mapOk, mapErr = pcall(refreshMapMarkers)
		if not mapOk and not mapErrorShown then
			mapErrorShown = true
			print("[RobScript IL] map markers error: " .. tostring(mapErr))
		end
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("PlayerESP", false)
			setFlag("ZombieESP", false)
			setFlag("LootESP", false)
			setFlag("VehicleESP", false)
			setFlag("CorpseESP", false)
			setFlag("AirdropESP", false)
			setFlag("HudEnabled", false)
			setFlag("Aimlock", false)
			clearVisuals()
			releaseAim()
			updateAimCircle(false)
			if hud.gui then
				hud.gui.Enabled = false
			end
		end)
	elseif input.KeyCode == aimKeyName() then
		pcall(function()
			if not flag("Aimlock", false) then
				return
			end
			if flag("AimActivation", "Hold") == "Toggle" then
				aimState.toggled = not aimState.toggled
			else
				aimState.holding = true
			end
		end)
	end
end)

local aimReleaseConnection = UserInputService.InputEnded:Connect(function(input)
	if not running then
		return
	end
	if input.KeyCode == aimKeyName() and flag("AimActivation", "Hold") == "Hold" then
		aimState.holding = false
	end
end)

local aimWheelConnection = UserInputService.InputChanged:Connect(function(input)
	if not running or not flag("AimWheel", true) then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseWheel then
		return
	end
	if not aimEngaged() then
		return
	end
	pcall(aimCycle, input.Position.Z > 0 and 1 or -1)
end)

-- RenderStepped, not Heartbeat: the camera has to be written after the default
-- camera script, otherwise the game overwrites the lock every frame.
local aimConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not running then
		return
	end
	local ok, err = pcall(updateAim, deltaTime)
	if not ok then
		releaseAim()
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	pcall(function()
		aimReleaseConnection:Disconnect()
	end)
	pcall(function()
		aimWheelConnection:Disconnect()
	end)
	pcall(function()
		aimConnection:Disconnect()
	end)
	clearVisuals()
	destroyHud()
	destroyMapLayer()
	pcall(releaseAim)
	if aimState.circle then
		pcall(function()
			aimState.circle:Destroy()
		end)
		aimState.circle = nil
		aimState.circleFrame = nil
	end
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptIL then
		getgenv().RobScriptIL = nil
	end
end

----- Public interface -----

getgenv().RobScriptIL = {
	Version = "1.2",
	Actions = {
		Refresh = collect,
		Clear = clearVisuals,
		Destroy = destroy,
		ScanLoot = scanLootHosts,
	},
	GetStats = function()
		local snapshot = {}
		for key, value in pairs(stats) do
			snapshot[key] = value
		end
		return snapshot
	end,
	GetProfiles = function()
		return {
			profession = LocalPlayer:GetAttribute("SelectedProfession"),
			infectionStage = LocalPlayer:GetAttribute("InfectionStage"),
			infectionPercent = LocalPlayer:GetAttribute("InfectionPercent"),
			hunger = LocalPlayer:GetAttribute("Hunger"),
			thirst = LocalPlayer:GetAttribute("Thirst"),
			stamina = LocalPlayer:GetAttribute("Stamina"),
		}
	end,
	-- Both api.Get("Flag") and api:Get("Flag") work: the colon form passes the
	-- API table as the first argument.
	Get = function(first, second)
		if type(first) == "table" then
			return flag(second, nil)
		end
		return flag(first, second)
	end,
	Set = function(first, second, third)
		if type(first) == "table" then
			return setFlag(second, third)
		end
		return setFlag(first, second)
	end,
	SelectTab = function(first, second)
		local target = type(first) == "table" and second or first
		local tab = type(target) == "table" and target or tabs[target]
		if not tab then
			return false
		end
		return (pcall(function()
			Window:SelectTab(tab)
		end))
	end,
	ListTabs = function()
		local names = {}
		for name in pairs(tabs) do
			names[#names + 1] = name
		end
		table.sort(names)
		return names
	end,
	GetMarkers = function()
		local list = {}
		for _, item in ipairs(candidates) do
			list[#list + 1] = {
				kind = item.kind,
				name = item.adornee.Name,
				distance = math.floor(item.distance),
				text = item.text,
			}
		end
		return list
	end,
	GetHud = function()
		return {
			enabled = hud.gui ~= nil and hud.gui.Enabled,
			parent = hud.gui and hud.gui.Parent and hud.gui.Parent:GetFullName() or nil,
			corner = flag("HudCorner", "Top Left"),
			scale = number(flag("HudScale", 1), 1),
		}
	end,
	MapMarkers = function()
		return {
			attached = mapState.folder ~= nil and mapState.folder.Parent ~= nil,
			parent = mapState.folder and mapState.folder.Parent and mapState.folder.Parent:GetFullName() or nil,
			dots = mapState.folder ~= nil and #mapState.folder:GetChildren() or 0,
		}
	end,
	SetWaypoint = function(x, z)
		return setWaypoint(tonumber(x), tonumber(z))
	end,
	ClearWaypoint = function()
		return clearWaypoint()
	end,
	GetWaypoint = function()
		local waypoint = mapState.waypoint
		if not waypoint then
			return nil
		end
		local character = LocalPlayer.Character
		local part = character and rootOf(character)
		local distance = nil
		if part then
			local dx = waypoint.x - part.Position.X
			local dz = waypoint.z - part.Position.Z
			distance = math.sqrt(dx * dx + dz * dz)
		end
		return { x = waypoint.x, z = waypoint.z, distance = distance }
	end,
	MapBounds = function()
		return {
			image = MAP.image,
			minX = MAP.minX,
			spanX = MAP.spanX,
			minZ = MAP.minZ,
			spanZ = MAP.spanZ,
			northIsNegativeZ = MAP.northIsNegativeZ,
		}
	end,
	GetAim = function()
		local name, distance = aimStatus()
		return {
			enabled = flag("Aimlock", false),
			engaged = aimEngaged(),
			method = flag("AimMethod", AIM_METHOD_FOV),
			activation = flag("AimActivation", "Hold"),
			bone = flag("AimBone", "Head"),
			target = name,
			distance = distance,
			part = aimState.part and aimState.part:GetFullName() or nil,
		}
	end,
	SetAimPressed = function(pressed)
		if flag("AimActivation", "Hold") == "Toggle" then
			aimState.toggled = pressed == true
		else
			aimState.holding = pressed == true
		end
		return true
	end,
	ReleaseAim = function()
		aimState.holding = false
		aimState.toggled = false
		pcall(releaseAim)
		pcall(updateAimCircle, false)
	end,
	Uptime = function()
		return os.clock() - sessionStart
	end,
	GetLanguage = function()
		local ok, code = pcall(function()
			return Airflow:GetLanguage()
		end)
		return ok and code or nil
	end,
	SetLanguage = function(code)
		local ok = pcall(function()
			Airflow:SetLanguage(code)
		end)
		if ok then
			pcall(applyHudLanguage)
		end
		return ok
	end,
	Translate = function(first, ...)
		if type(first) == "table" then
			return T(...)
		end
		return T(first, ...)
	end,
	Destroy = destroy,
}

