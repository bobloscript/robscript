local function applyCameraLock(deltaTime, part, snap)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local desired = CFrame.lookAt(camera.CFrame.Position, part.Position)
	if snap then
		camera.CFrame = desired
		return
	end
	local speed = number(flag("AimSmoothing", 12), 12)
	if speed >= 20 then
		camera.CFrame = desired
		return
	end
	local alpha = 1 - math.exp(-(deltaTime or 0.016) * speed)
	camera.CFrame = camera.CFrame:Lerp(desired, alpha)
end

local function applyBodyTurn(deltaTime, part)
	if not flag("AimTurnBody", false) then
		return
	end
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local flat = Vector3.new(part.Position.X, root.Position.Y, part.Position.Z)
	local alpha = 1 - math.exp(-(deltaTime or 0.016) * 12)
	root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), alpha)
end

-- The lock is kept by angle, not by pixels: with slow smoothing the camera lags
-- behind the target, and a pixel test would drop the lock mid-turn.
local function keepAimTarget()
	local player = aimState.player
	if not player or not aimFilterAllows(player) then
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local part = aimFocusPart(player)
	if not character or not humanoid or humanoid.Health <= 0 or not part then
		return nil
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local offset = part.Position - camera.CFrame.Position
	if offset.Magnitude > aimRange() or not aimVisible(part) then
		return nil
	end
	local angle = math.deg(math.acos(math.clamp(camera.CFrame.LookVector:Dot(offset.Unit), -1, 1)))
	if angle > 45 then
		return nil
	end
	return part
end

local function updateFovAim(deltaTime)
	local kept = keepAimTarget()
	if kept then
		aimState.part = kept
		applyCameraLock(deltaTime, kept, false)
		updateAimIndicator(kept)
		return
	end

	local list = fovCandidates()
	if #list == 0 then
		releaseAim()
		return
	end

	table.sort(list, function(a, b)
		return a.screen < b.screen
	end)
	local best = list[1]
	aimState.player = best.player
	aimState.part = best.part
	applyCameraLock(deltaTime, best.part, false)
	updateAimIndicator(best.part)
end

local function updateBlockSpinAim(deltaTime)
	local force = flag("AimForceLock", false)
	local list = angleCandidates()
	if #list == 0 then
		releaseAim()
		return
	end

	local chosen = nil
	if aimState.player then
		for _, entry in ipairs(list) do
			if entry.player == aimState.player then
				chosen = entry
				break
			end
		end
	end

	-- Force mode never lets go on its own: if the body disappears or runs off,
	-- the next closest one is grabbed instead of dropping the lock.
	if not chosen then
		if aimState.player and not force then
			releaseAim()
		end
		chosen = list[1]
	end

	if chosen.distance > aimRange() * 1.4 then
		if force then
			chosen = list[1]
		else
			releaseAim()
			return
		end
	end

	aimState.player = chosen.player
	aimState.part = chosen.part
	applyCameraLock(deltaTime, chosen.part, force)
	applyBodyTurn(deltaTime, chosen.part)
	updateAimIndicator(chosen.part)
end

local function updateAim(deltaTime)
	if not running then
		return
	end
	if not aimEngaged() then
		if aimState.part then
			releaseAim()
		end
		updateAimCircle(false)
		return
	end
	updateAimCircle(true)
	if flag("AimMethod", AIM_METHOD_FOV) == AIM_METHOD_BLOCKSPIN then
		updateBlockSpinAim(deltaTime)
	else
		updateFovAim(deltaTime)
	end
end

local function aimCycle(direction)
	local method = flag("AimMethod", AIM_METHOD_FOV)
	local list = method == AIM_METHOD_BLOCKSPIN and angleCandidates() or fovCandidates()
	if #list == 0 then
		return
	end
	local index = 1
	for i, entry in ipairs(list) do
		if entry.player == aimState.player then
			index = i
			break
		end
	end
	index = index + (direction or 1)
	if index > #list then
		index = 1
	end
	if index < 1 then
		index = #list
	end
	aimState.player = list[index].player
	aimState.part = list[index].part
end

local function aimStatus()
	if not flag("Aimlock", false) then
		return nil
	end
	if not aimState.part or not aimState.player then
		return nil
	end
	local camera = workspace.CurrentCamera
	local distance = camera and (aimState.part.Position - camera.CFrame.Position).Magnitude or 0
	return aimState.player.Name, distance
end

