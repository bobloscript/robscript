            Size = UDim2.fromOffset(10, 10),
            BackgroundColor3 = entry.Color,
            BorderSizePixel = 0,
            ZIndex = 51,
        }, frame)

        make("TextLabel", {
            Position = UDim2.fromOffset(x + 16, ly),
            Size = UDim2.fromOffset(100, 16),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = C_TEXT,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = entry.Label,
            ZIndex = 51,
        }, frame)
    end

    -- Small caption: what the overlay can and cannot do.
    make("TextLabel", {
        Position = UDim2.fromOffset(12, 344),
        Size = UDim2.new(1, -24, 0, 42),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        TextSize = 10,
        TextColor3 = C_MUTED,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Text = "Boxes show only players the game sends.\n\"hidden\" = the game parked them away.\nThat is how Kontra works, not a bug.",
        ZIndex = 51,
    }, frame)

    make("TextLabel", {
        Position = UDim2.fromOffset(12, 388),
        Size = UDim2.new(1, -24, 0, 14),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = 10,
        TextColor3 = C_MUTED,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "RShift on/off  \u{00b7}  RCtrl panel",
        ZIndex = 51,
    }, frame)

    -- Drag by the header.
    local dragging = false
    local dragStart = Vector2.zero
    local startPosition = UDim2.fromOffset(0, 0)

    table.insert(panelConnections, header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
        end
    end))

    table.insert(panelConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))

    table.insert(panelConnections, UserInputService.InputChanged:Connect(function(input)
        if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end))

    return frame
end

----- Target collection -----
type Target = {
    character: Model,
    player: Player?,
    team: any,
    root: BasePart,
    head: BasePart,
    distance: number,
    isTeammate: boolean,
}

-- Every replicated character worth drawing, nearest first. Sorting matters:
-- with a small slot pool the closest targets must win the slots.
local function collectTargets(camera: Camera): { Target }
    local origin = camera.CFrame.Position
    local localTeam = LocalPlayer:GetAttribute("Team")
    local candidates: { Target } = {}
    local seenPlayers: { [Player]: boolean } = {}

    for _, character in ipairs(getCharacters()) do
        local player = resolvePlayer(character)
        if player == LocalPlayer then
            state.skippedSelf += 1
            continue
        end
        if player and seenPlayers[player] then
            continue
        end

        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        if not (root and root:IsA("BasePart") and head and head:IsA("BasePart")) then
            continue
        end

        local rootPart: BasePart = root
        local headPart: BasePart = head
        local distance = (rootPart.Position - origin).Magnitude

        if CONFIG.LastSeen and player and distance < 50000 then
            lastSeen[player] = {
                position = rootPart.Position,
                time = os.clock(),
                team = player:GetAttribute("Team"),
            }
        end

        if distance > 50000 then
            -- Kontra parks characters it hides about a million studs away.
            state.parked += 1
            continue
        end

        local team = player and player:GetAttribute("Team")
        local isTeammate = team ~= nil and team == localTeam and team ~= "Spectator"
        if CONFIG.TeamCheck and isTeammate then
            state.skippedTeam += 1
            continue
        end

        if distance > CONFIG.MaxDistance then
            state.outOfRange += 1
            continue
        end

        if player then
            seenPlayers[player] = true
        end

        table.insert(candidates, {
            character = character,
            player = player,
            team = team,
            root = rootPart,
            head = headPart,
            distance = distance,
            isTeammate = isTeammate,
        })
    end

    table.sort(candidates, function(a, b)
        return a.distance < b.distance
    end)

    return candidates
end

----- Drawing -----
local function drawTarget(slot: Slot, camera: Camera, target: Target): boolean
    local headPoint = camera:WorldToViewportPoint(target.head.Position + Vector3.new(0, 0.4, 0))
    local feetPoint = camera:WorldToViewportPoint(target.root.Position - Vector3.new(0, 2.6, 0))

    -- The second return value of WorldToViewportPoint is "on screen"; depth
    -- lives in .Z. Depth is what we want here: a target whose feet are just
    -- below the screen edge still deserves a box.
    if headPoint.Z <= 0 or feetPoint.Z <= 0 then
        state.offscreen += 1
        return false
    end

    local topY = headPoint.Y
    local height = math.abs(feetPoint.Y - topY)
    if height <= 6 then
        state.offscreen += 1
        return false
    end

    local width = height * 0.44
    local centerX = (headPoint.X + feetPoint.X) * 0.5
    local color = colorFor(target.team, target.isTeammate, target.player)

    if CONFIG.ShowBoxes then
        slot:drawBox(centerX - width * 0.5, topY, width, height, color, CONFIG.BoxThickness)
    end

    if CONFIG.ShowNames then
        local label = readName(target.character)
        if target.isTeammate then
            label = label .. " (team)"
        end
        slot:drawName(label, centerX, math.max(topY - 12, 8), color)
    end

    if CONFIG.ShowDistance then
        slot:drawDistance(
            string.format("%d m", math.floor(target.distance * CONFIG.StudsPerMeter)),
            centerX,
            topY + height + 8,
            color
        )
    end

    if CONFIG.ShowHealth then
        local maxHealth = (target.player and target.player:GetAttribute("MaxHealth")) or 100
        slot:drawHealth(readHealth(target.character) / math.max(maxHealth, 1), centerX - width * 0.5 - 6, topY, height)
    end

    return true
end

local function drawGhost(slot: Slot, camera: Camera, position: Vector3, color: Color3, age: number, name: string): boolean
    local top = camera:WorldToViewportPoint(position + Vector3.new(0, 2.2, 0))
    local bottom = camera:WorldToViewportPoint(position - Vector3.new(0, 2.6, 0))

    if top.Z <= 0 or bottom.Z <= 0 then
        return false
    end

    local height = math.abs(bottom.Y - top.Y)
    if height <= 6 then
        return false
    end

    local width = height * 0.44
    local centerX = (top.X + bottom.X) * 0.5

    if CONFIG.ShowBoxes then
        slot:drawBox(centerX - width * 0.5, top.Y, width, height, color, CONFIG.BoxThickness)
    end

    if CONFIG.ShowNames then
        slot:drawName(name, centerX, math.max(top.Y - 12, 8), color)
    end

    if CONFIG.ShowDistance then
        slot:drawDistance(string.format("%.0fs ago", age), centerX, top.Y + height + 8, color)
    end

    return true
end

local function update()
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    state.characters = #getCharacters()
    state.skippedSelf = 0
    state.skippedTeam = 0
    state.outOfRange = 0
    state.offscreen = 0
    state.parked = 0
    state.ghosts = 0
    state.targets = 0

    if not CONFIG.Enabled then
        for _, slot in ipairs(slots) do
            slot:hide()
        end
        return
    end

    local used = 0
    local drawnPlayers: { [Player]: boolean } = {}

    for _, target in ipairs(collectTargets(camera)) do
        if used >= #slots then
            break
        end
        used += 1
        local slot = slots[used]
        slot:hide()
        if drawTarget(slot, camera, target) then
            if target.player then
                drawnPlayers[target.player] = true
            end
            state.targets += 1
        else
            used -= 1
        end
    end

    -- Ghost pass: whatever the game stopped replicating keeps a dim marker at
    -- its last known position for a few seconds.
    if CONFIG.LastSeen then
        local now = os.clock()
        local localTeam = LocalPlayer:GetAttribute("Team")
        local origin = camera.CFrame.Position

        for player, record in pairs(lastSeen) do
            if player.Parent == nil or now - record.time > CONFIG.LastSeenDuration then
                lastSeen[player] = nil
            end
        end

        for player, record in pairs(lastSeen) do
            if used >= #slots then
                break
            end

            local age = now - record.time
            local hidden = not drawnPlayers[player]
            local teamAllowed = not CONFIG.TeamCheck
                or record.team == nil
                or record.team ~= localTeam
                or record.team == "Spectator"

            if hidden and age > 0.15 and teamAllowed and (record.position - origin).Magnitude <= CONFIG.MaxDistance then
                used += 1
                local slot = slots[used]
                slot:hide()
                if drawGhost(slot, camera, record.position, CONFIG.GhostColor, age, player.Name) then
                    state.ghosts += 1
                else
                    used -= 1
                end
            end
        end
    end

    for index = used + 1, #slots do
        slots[index]:hide()
    end
end

