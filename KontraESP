----- Small helpers -----
local function randomName(): string
    local alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
    local pieces = {}
    for _ = 1, 12 do
        local index = math.random(1, #alphabet)
        table.insert(pieces, string.sub(alphabet, index, index))
    end
    return table.concat(pieces)
end

local function make(class: string, props: { [string]: any }, parent: Instance?): any
    local instance = Instance.new(class)
    for key, value in pairs(props) do
        instance[key] = value
    end
    if parent then
        instance.Parent = parent
    end
    return instance
end

----- Settings persistence -----
local function saveSettings()
    if type(writefile) ~= "function" then
        return
    end
    local lines = {}
    for _, key in ipairs(SAVE_KEYS) do
        local value = CONFIG[key]
        local kind = type(value)
        if kind == "boolean" or kind == "number" then
            table.insert(lines, key .. "=" .. tostring(value))
        end
    end
    pcall(writefile, CONFIG.SettingsFile, table.concat(lines, "\n"))
end

local function loadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return
    end
    local ok, data = pcall(function()
        if isfile(CONFIG.SettingsFile) then
            return readfile(CONFIG.SettingsFile)
        end
        return nil
    end)
    if not ok or type(data) ~= "string" then
        return
    end
    for line in string.gmatch(data, "[^\n]+") do
        local key, raw = string.match(line, "^(%w+)=(.-)%s*$")
        if key and CONFIG[key] ~= nil then
            if raw == "true" then
                CONFIG[key] = true
            elseif raw == "false" then
                CONFIG[key] = false
            else
                local number = tonumber(raw)
                if number then
                    CONFIG[key] = number
                end
            end
        end
    end
end

loadSettings()

----- GUI plumbing -----
local uiRoot: ScreenGui? = nil

local function attachGui(gui: Instance): boolean
    local syn = rawget(Environment, "syn")
    if type(syn) == "table" and type(syn.protect_gui) == "function" then
        if pcall(syn.protect_gui, gui) and gui.Parent ~= nil then
            return true
        end
    end

    local protect = rawget(Environment, "protect_gui")
    if type(protect) == "function" then
        if pcall(protect, gui) and gui.Parent ~= nil then
            return true
        end
    end

    local okHidden, hidden = pcall(function()
        return gethui()
    end)
    if okHidden and typeof(hidden) == "Instance" then
        pcall(function()
            gui.Parent = hidden
        end)
        if gui.Parent ~= nil then
            return true
        end
    end

    local okCore, core = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and core then
        pcall(function()
            gui.Parent = core
        end)
        if gui.Parent ~= nil then
            return true
        end
    end

    return false
end

local function ensureGui(): ScreenGui
    if uiRoot then
        if uiRoot.Parent == nil then
            attachGui(uiRoot)
        end
        return uiRoot
    end

    local gui = make("ScreenGui", {
        Name = randomName(),
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    attachGui(gui)
    uiRoot = gui
    return gui
end

----- Game readers -----
local function getCharacters(): { Model }
    local list: { Model } = {}
    local folder = Workspace:FindFirstChild("Characters")
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and child:FindFirstChild("HumanoidRootPart") then
                table.insert(list, child)
            end
        end
        return list
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, character)
        end
    end
    return list
end

local function resolvePlayer(character: Model): Player?
    local tag = character:FindFirstChild("NameTag")
    local label = tag and (tag :: Instance):FindFirstChild("PlayerName", true)
    if label and label:IsA("TextLabel") then
        local player = Players:FindFirstChild(label.Text)
        if player then
            return player
        end
    end
    return Players:FindFirstChild(character.Name)
end

local function readName(character: Model): string
    local tag = character:FindFirstChild("NameTag")
    local label = tag and (tag :: Instance):FindFirstChild("PlayerName", true)
    if label and label:IsA("TextLabel") then
        return label.Text
    end
    local player = resolvePlayer(character)
    return player and player.Name or character.Name
end

local function readHealth(character: Model): number
    local tag = character:FindFirstChild("NameTag")
    if tag then
        local label = (tag :: Instance):FindFirstChild("Health", true)
        if label and label:IsA("TextLabel") then
            local digits = string.match(label.Text, "%d+")
            if digits then
                return tonumber(digits) or 100
            end
        end
    end
    return 100
end

local function colorFor(team: any, isTeammate: boolean, player: Player?): Color3
    if player == nil then
        return CONFIG.CustomColor
    end
    if isTeammate then
        return CONFIG.TeamColor
    end
    return TEAM_COLORS[team] or TEAM_COLORS.Spectator
end

----- Slot backends -----
-- Five methods, two implementations: Drawing (preferred) and ScreenGui.
type Slot = {
    hide: (self: Slot) -> (),
    drawBox: (self: Slot, x: number, y: number, width: number, height: number, color: Color3, thickness: number) -> (),
    drawName: (self: Slot, text: string, x: number, y: number, color: Color3) -> (),
    drawDistance: (self: Slot, text: string, x: number, y: number, color: Color3) -> (),
    drawHealth: (self: Slot, fraction: number, x: number, y: number, height: number) -> (),
}

local DrawingLib = rawget(Environment, "Drawing")
if type(DrawingLib) ~= "table" then
    local ok, value = pcall(function()
        return Drawing
    end)
    if ok and type(value) == "table" then
        DrawingLib = value
    end
end

-- Probe the API: some executors expose a Drawing table that renders nothing.
local function drawingUsable(): boolean
    if type(DrawingLib) ~= "table" or type(DrawingLib.new) ~= "function" then
        return false
    end
    local ok, probe = pcall(DrawingLib.new, "Square")
    if not ok or probe == nil then
        return false
    end
    pcall(function()
        probe:Remove()
    end)
    return true
end

local useDrawing = if CONFIG.Backend == "gui" then false else drawingUsable()
local backendName: string = if useDrawing then "drawing" else "gui"
local createSlot: () -> Slot
local destroyBackend: () -> ()

if useDrawing then
    local drawingNew = DrawingLib.new
    local madeObjects = {}

    local function object(class: string): any
        local instance = drawingNew(class)
        table.insert(madeObjects, instance)
        return instance
    end

    createSlot = function(): Slot
        local box = object("Square")
        box.Thickness = CONFIG.BoxThickness
        box.Filled = false
        box.Visible = false

        local nameText = object("Text")
        nameText.Center = true
        nameText.Outline = true
        nameText.OutlineColor = Color3.new(0, 0, 0)
        nameText.Size = 13
        nameText.Visible = false

        local distanceText = object("Text")
        distanceText.Center = true
        distanceText.Outline = true
        distanceText.OutlineColor = Color3.new(0, 0, 0)
        distanceText.Size = 11
        distanceText.Color = Color3.fromRGB(220, 220, 226)
        distanceText.Visible = false

        local healthBack = object("Square")
        healthBack.Filled = true
        healthBack.Color = Color3.fromRGB(18, 18, 22)
        healthBack.Visible = false

        local healthFill = object("Square")
        healthFill.Filled = true
        healthFill.Visible = false

        local slot = {}

        function slot.hide(_self)
            box.Visible = false
            nameText.Visible = false
            distanceText.Visible = false
            healthBack.Visible = false
            healthFill.Visible = false
        end

        function slot.drawBox(_self, x, y, width, height, color, thickness)
            box.Position = Vector2.new(x, y)
            box.Size = Vector2.new(width, height)
            box.Color = color
            box.Thickness = thickness
            box.Visible = true
        end

        function slot.drawName(_self, text, x, y, color)
            nameText.Text = text
            nameText.Position = Vector2.new(x, y)
            nameText.Color = color
            nameText.Visible = true
        end

        function slot.drawDistance(_self, text, x, y, color)
            distanceText.Text = text
            distanceText.Position = Vector2.new(x, y)
            distanceText.Color = color
            distanceText.Visible = true
        end

        function slot.drawHealth(_self, fraction, x, y, height)
            healthBack.Position = Vector2.new(x, y)
            healthBack.Size = Vector2.new(3, height)
            healthBack.Visible = true

            local clamped = math.clamp(fraction, 0, 1)
            local fillHeight = math.max(height * clamped, 1)
            healthFill.Position = Vector2.new(x, y + height - fillHeight)
            healthFill.Size = Vector2.new(3, fillHeight)
            healthFill.Color = Color3.fromRGB(70, 220, 110):Lerp(Color3.fromRGB(235, 70, 70), 1 - clamped)
            healthFill.Visible = true
        end

        return (slot :: any) :: Slot
    end

    destroyBackend = function()
        for _, entry in ipairs(madeObjects) do
            pcall(function()
                entry:Remove()
            end)
        end
        madeObjects = {}
    end
else
    local function makeFrame(parent: Instance): Frame
        return make("Frame", {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Visible = false,
        }, parent)
    end

    createSlot = function(): Slot
        local gui = ensureGui()

        local box = makeFrame(gui)
        local stroke = make("UIStroke", {
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Thickness = CONFIG.BoxThickness,
        }, box)

        local nameHolder = makeFrame(gui)
        local nameLabel = make("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextStrokeTransparency = 0.4,
            TextStrokeColor3 = Color3.new(0, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            Text = "",
        }, nameHolder)

        local distanceHolder = makeFrame(gui)
        local distanceLabel = make("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(220, 220, 226),
            TextStrokeTransparency = 0.4,
            TextStrokeColor3 = Color3.new(0, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            Text = "",
        }, distanceHolder)

        local healthBack = makeFrame(gui)
        healthBack.BackgroundTransparency = 0
        healthBack.BackgroundColor3 = Color3.fromRGB(18, 18, 22)

        local healthFill = make("Frame", {
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.fromScale(0, 1),
            Size = UDim2.fromScale(1, 1),
        }, healthBack)

        local slot = {}

        function slot.hide(_self)
            box.Visible = false
            nameHolder.Visible = false
            distanceHolder.Visible = false
            healthBack.Visible = false
        end

        function slot.drawBox(_self, x, y, width, height, color, thickness)
            box.Position = UDim2.fromOffset(x, y)
            box.Size = UDim2.fromOffset(width, height)
            stroke.Color = color
            stroke.Thickness = thickness
            box.Visible = true
        end

        function slot.drawName(_self, text, x, y, color)
            nameHolder.Position = UDim2.fromOffset(x - 100, y - 9)
            nameHolder.Size = UDim2.fromOffset(200, 18)
            nameHolder.Visible = true
            nameLabel.Text = text
            nameLabel.TextColor3 = color
        end

        function slot.drawDistance(_self, text, x, y, color)
            distanceHolder.Position = UDim2.fromOffset(x - 100, y - 7)
            distanceHolder.Size = UDim2.fromOffset(200, 14)
            distanceHolder.Visible = true
            distanceLabel.Text = text
            distanceLabel.TextColor3 = color
        end

        function slot.drawHealth(_self, fraction, x, y, height)
            healthBack.Position = UDim2.fromOffset(x, y)
            healthBack.Size = UDim2.fromOffset(3, height)
            healthBack.Visible = true

            local clamped = math.clamp(fraction, 0, 1)
            healthFill.Size = UDim2.fromScale(1, math.max(clamped, 0.01))
            healthFill.BackgroundColor3 = Color3.fromRGB(70, 220, 110):Lerp(Color3.fromRGB(235, 70, 70), 1 - clamped)
        end

        return (slot :: any) :: Slot
    end

    destroyBackend = function()
        if uiRoot then
            pcall(function()
                uiRoot:Destroy()
            end)
            uiRoot = nil
        end
    end
end

