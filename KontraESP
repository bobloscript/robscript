    make("UIStroke", { Color = C_STROKE }, frame)
    panelFrame = frame

    local header = make("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        ZIndex = 51,
    }, frame)

    make("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -46, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = C_TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "kontra esp",
        ZIndex = 51,
    }, header)

    local close = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = C_MUTED,
        Text = "\u{00d7}",
        AutoButtonColor = false,
        ZIndex = 51,
    }, header)

    close.MouseEnter:Connect(function()
        close.TextColor3 = C_TEXT
    end)
    close.MouseLeave:Connect(function()
        close.TextColor3 = C_MUTED
    end)
    close.MouseButton1Click:Connect(function()
        state.panelVisible = false
        frame.Visible = false
    end)

    local status = make("TextLabel", {
        Position = UDim2.fromOffset(12, 32),
        Size = UDim2.new(1, -24, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextColor3 = C_MUTED,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "starting...",
        ZIndex = 51,
    }, frame)
    statusLabel = status

    local y = 56

    local function section(text: string)
        make("TextLabel", {
            Position = UDim2.fromOffset(12, y),
            Size = UDim2.new(1, -24, 0, 14),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = C_MUTED,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text,
            ZIndex = 51,
        }, frame)
        y += 16
    end

    -- Clickable row: title on the left, value chip on the right.
    local function row(title: string, getValue: () -> string, isOn: () -> boolean, onClick: () -> ())
        local button = make("TextButton", {
            Position = UDim2.fromOffset(8, y),
            Size = UDim2.new(1, -16, 0, ROW_HEIGHT - 2),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 51,
        }, frame)

        local label = make("TextLabel", {
            Size = UDim2.new(1, -70, 1, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = C_TEXT,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = title,
            ZIndex = 51,
        }, button)

        local value = make("TextLabel", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.fromScale(1, 0),
            Size = UDim2.fromOffset(60, ROW_HEIGHT - 2),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            Text = getValue(),
            ZIndex = 51,
        }, button)

        local function refresh()
            value.Text = getValue()
            local on = isOn()
            value.TextColor3 = if on then C_ACCENT else C_MUTED
            label.TextColor3 = if on then C_TEXT else C_MUTED
        end

        button.MouseEnter:Connect(function()
            label.TextColor3 = C_ACCENT
        end)
        button.MouseLeave:Connect(function()
            label.TextColor3 = if isOn() then C_TEXT else C_MUTED
        end)
        button.MouseButton1Click:Connect(function()
            onClick()
            refresh()
        end)

        refresh()
        y += ROW_HEIGHT
        return refresh
    end

    section("MAIN")
    for _, entry in ipairs(TOGGLE_ROWS) do
        row(
            entry.Label,
            function()
                return if CONFIG[entry.Key] == true then "on" else "off"
            end,
            function()
                return CONFIG[entry.Key] == true
            end,
            function()
                CONFIG[entry.Key] = not CONFIG[entry.Key]
                if not CONFIG.Enabled then
                    for _, slot in ipairs(slots) do
                        slot:hide()
                    end
                end
                saveSettings()
            end
        )
    end

    section("RANGE")
    for _, entry in ipairs(NUMBER_ROWS) do
        row(
            entry.Label,
            function()
                return tostring(math.floor(CONFIG[entry.Key])) .. entry.Suffix
            end,
            function()
                return true
            end,
            function()
                -- Click cycles up; keeps the panel free of drag sliders.
                local nextValue = CONFIG[entry.Key] + entry.Step
                if nextValue > entry.Max then
                    nextValue = entry.Min
                end
                CONFIG[entry.Key] = nextValue
                saveSettings()
