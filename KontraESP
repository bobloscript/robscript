----- Render loop -----
local renderName = randomName()

RunService:BindToRenderStep(renderName, CONFIG.RenderPriority, function()
    if not state.running then
        return
    end

    local ok, err = pcall(update)
    if not ok then
        state.errors += 1
        state.lastError = tostring(err)
        if state.errors == 3 then
            warn("[overlay] render error: " .. tostring(err))
        elseif state.errors > 20 then
            state.running = false
            pcall(function()
                RunService:UnbindFromRenderStep(renderName)
            end)
        end
    end
end)

----- Hotkeys -----
local hotkeyConnection = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == CONFIG.ToggleKey then
        CONFIG.Enabled = not CONFIG.Enabled
        if not CONFIG.Enabled then
            for _, slot in ipairs(slots) do
                slot:hide()
            end
        end
    elseif input.KeyCode == CONFIG.PanelKey and panelFrame then
        state.panelVisible = not state.panelVisible
        panelFrame.Visible = state.panelVisible
    end
end)

----- Status loop -----
task.spawn(function()
    while state.running do
        if statusLabel then
            local parts = { backendName }
            table.insert(parts, string.format("%d live", state.targets))
            if state.ghosts > 0 then
                table.insert(parts, string.format("%d ghost", state.ghosts))
            end
            if state.parked > 0 then
                table.insert(parts, string.format("%d hidden", state.parked))
            end
            if state.errors > 0 then
                table.insert(parts, string.format("err %d", state.errors))
            end
            statusLabel.Text = table.concat(parts, "  \u{00b7}  ")
            statusLabel.TextColor3 = if state.errors > 0 then C_ACCENT else C_MUTED
        end

        if CONFIG.Debug then
            print(string.format(
                "[overlay] %s: chars=%d live=%d ghost=%d hidden=%d team=%d range=%d off=%d err=%d",
                backendName,
                state.characters,
                state.targets,
                state.ghosts,
                state.parked,
                state.skippedTeam,
                state.outOfRange,
                state.offscreen,
                state.errors
            ))
        end

        task.wait(1)
    end
end)

----- Public API -----
local api = {}

function api.SetEnabled(value: boolean)
    CONFIG.Enabled = value
    if not value then
        for _, slot in ipairs(slots) do
            slot:hide()
        end
    end
end

function api.Toggle()
    api.SetEnabled(not CONFIG.Enabled)
end

function api.SetConfig(key: string, value: any)
    if CONFIG[key] ~= nil then
        CONFIG[key] = value
        saveSettings()
    end
end

function api.GetConfig(): { [string]: any }
    return CONFIG
end

function api.GetStatus(): { [string]: any }
    return {
        backend = backendName,
        characters = state.characters,
        targets = state.targets,
        ghosts = state.ghosts,
        parked = state.parked,
        skippedSelf = state.skippedSelf,
        skippedTeam = state.skippedTeam,
        outOfRange = state.outOfRange,
        offscreen = state.offscreen,
        errors = state.errors,
        lastError = state.lastError,
        guiParent = uiRoot and uiRoot.Parent and uiRoot.Parent:GetFullName() or "none",
    }
end

function api.Destroy()
    state.running = false
    Environment.KontraESP = nil

    pcall(function()
        RunService:UnbindFromRenderStep(renderName)
    end)
    pcall(function()
        hotkeyConnection:Disconnect()
    end)
    for _, connection in ipairs(panelConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    panelConnections = {}

    for _, slot in ipairs(slots) do
        pcall(function()
            slot:hide()
        end)
    end
    pcall(destroyBackend)

    if uiRoot then
        pcall(function()
            uiRoot:Destroy()
        end)
        uiRoot = nil
    end
    slots = {}
end

Environment.KontraESP = api

