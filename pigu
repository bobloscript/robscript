local function destroyEspEntry(userId)
	local entry = espEntries[userId]
	if not entry then
		return
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
	if entry.billboard then
		entry.billboard:Destroy()
	end
	if entry.tracer then
		entry.tracer:Remove()
	end
	espEntries[userId] = nil
end

local function ensureEspEntry(target)
	local entry = espEntries[target.userId]
	if entry and entry.model ~= target.model then
		destroyEspEntry(target.userId)
		entry = nil
	end

	if not entry then
		entry = { model = target.model }
		espEntries[target.userId] = entry
	end

	if not entry.billboard then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PIGU_Tag"
		billboard.Size = UDim2.fromOffset(150, 38)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
		billboard.AlwaysOnTop = true
		billboard.Adornee = target.root
		billboard.Parent = espFolder

		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 13
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0.3
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextWrapped = true
		label.Parent = billboard

		entry.billboard = billboard
		entry.label = label
	end

	entry.billboard.Adornee = target.root
	return entry
end

local function updateEsp()
	local enabled = flag("EspEnabled")
	local root = getRoot()
	local color = state.EspColor or THEME.Accent
	local maxDistance = num("EspDistance", 300)
	local showName = flag("EspName") ~= false
	local showHealth = flag("EspHealth") ~= false
	local showTracer = flag("EspTracer") == true
	local showHighlight = flag("EspHighlight") ~= false

	if not enabled then
		for userId in pairs(espEntries) do
			destroyEspEntry(userId)
		end
		return
	end

	local seen = {}
	local targets = collectTargets()

	for _, target in ipairs(targets) do
		local distance = root and (target.root.Position - root.Position).Magnitude or 0
		if target.alive and distance <= maxDistance then
			seen[target.userId] = true
			local entry = ensureEspEntry(target)

			if showHighlight then
				if not entry.highlight then
					local highlight = Instance.new("Highlight")
					highlight.Name = "PIGU_Highlight"
					highlight.FillTransparency = 0.65
					highlight.OutlineTransparency = 0
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Adornee = target.model
					highlight.Parent = espFolder
					entry.highlight = highlight
				end
				entry.highlight.FillColor = color
				entry.highlight.OutlineColor = color
			elseif entry.highlight then
				entry.highlight:Destroy()
				entry.highlight = nil
			end

			local lines = {}
			if showName then
				table.insert(lines, target.name)
			end
			if showHealth then
				table.insert(lines, ("%d HP · %d m"):format(math.floor(target.hp), math.floor(distance)))
			end
			if entry.label then
				entry.label.Text = table.concat(lines, "\n")
				entry.label.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35)
				entry.label.Visible = #lines > 0
			end

			if showTracer and root then
				if not entry.tracer then
					entry.tracer = Drawing.new("Line")
					entry.tracer.Thickness = 1
					entry.tracer.Transparency = 0.7
				end
				local screenPoint, onScreen = workspace.CurrentCamera:WorldToViewportPoint(target.root.Position)
				if onScreen then
					entry.tracer.From = Vector2.new(
						workspace.CurrentCamera.ViewportSize.X / 2,
						workspace.CurrentCamera.ViewportSize.Y
					)
					entry.tracer.To = Vector2.new(screenPoint.X, screenPoint.Y)
					entry.tracer.Color = color
					entry.tracer.Visible = true
				else
					entry.tracer.Visible = false
				end
			elseif entry.tracer then
				entry.tracer:Remove()
				entry.tracer = nil
			end
		else
			destroyEspEntry(target.userId)
		end
	end

	for userId in pairs(espEntries) do
		if not seen[userId] then
			destroyEspEntry(userId)
		end
	end
end

-- Ball ESP
local ballHighlight, ballBillboard, ballLabel

local function updateBallEsp()
	local enabled = flag("BallEsp")
	local ball = workspace:FindFirstChild("DodgeBall")

	if not enabled or not ball then
		if ballHighlight then
			ballHighlight:Destroy()
			ballHighlight = nil
		end
		if ballBillboard then
			ballBillboard:Destroy()
			ballBillboard = nil
			ballLabel = nil
		end
		return
	end

	if not ballHighlight then
		ballHighlight = Instance.new("Highlight")
		ballHighlight.Name = "PIGU_Ball"
		ballHighlight.FillColor = Color3.fromHex("#FFD166")
		ballHighlight.OutlineColor = Color3.fromHex("#FFFFFF")
		ballHighlight.FillTransparency = 0.4
		ballHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		ballHighlight.Parent = espFolder
	end
	ballHighlight.Adornee = ball

	if not ballBillboard then
		ballBillboard = Instance.new("BillboardGui")
		ballBillboard.Name = "PIGU_BallTag"
		ballBillboard.Size = UDim2.fromOffset(140, 26)
		ballBillboard.StudsOffsetWorldSpace = Vector3.new(0, 1.6, 0)
		ballBillboard.AlwaysOnTop = true
		ballBillboard.Parent = espFolder

		ballLabel = Instance.new("TextLabel")
		ballLabel.BackgroundTransparency = 1
		ballLabel.Size = UDim2.fromScale(1, 1)
		ballLabel.Font = Enum.Font.GothamMedium
		ballLabel.TextSize = 12
		ballLabel.TextColor3 = Color3.fromHex("#FFD166")
		ballLabel.TextStrokeTransparency = 0.3
		ballLabel.Parent = ballBillboard
	end

	ballBillboard.Adornee = ball

	local eta = ballEta()
	local text
	if eta then
		text = ("incoming · %0.2fs"):format(eta)
		if state.BallWarn ~= false then
			ballLabel.TextColor3 = Color3.fromHex("#FF4D4D")
		end
	else
		local distance = ballDistance()
		text = distance and ("%d m"):format(math.floor(distance)) or "?"
		ballLabel.TextColor3 = Color3.fromHex("#FFD166")
	end
	ballLabel.Text = text
end

