-- 5. Flag helper: read values through Airflow.Flags
----------------------------------------------------------------------
local state = {}

local function flag(name)
	local handle = Airflow.Flags and Airflow.Flags[name]
	if handle then
		local ok, value = pcall(function()
			return handle:Get()
		end)
		if ok and value ~= nil then
			return value
		end
	end
	return state[name]
end

local function num(name, fallback)
	local value = flag(name)
	if type(value) == "number" then
		return value
	end
	return fallback
end

