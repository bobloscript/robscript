local function bindGame()
	if Game.attack and Game.attack.Parent then
		return true
	end
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local modules = shared and shared:FindFirstChild("Modules")
	if not modules then
		return false
	end
	local attack = modules:FindFirstChild("AnomalyAttackEvent")
	local sellMass = modules:FindFirstChild("SellMassEvent")
	local upgrade = modules:FindFirstChild("UpgradeEvent")
	if not (attack and sellMass) then
		return false
	end
	local okStats, statsModule = pcall(function()
		return require(modules:WaitForChild("AnomalyStats", 5))
	end)
	local okUpgrades, upgradesModule = pcall(function()
		return require(modules:WaitForChild("Upgrades", 5))
	end)
	local okMilestones, milestonesModule = pcall(function()
		return require(modules:WaitForChild("Milestones", 5))
	end)
	local okSpin, spinModule = pcall(function()
		return require(modules:WaitForChild("DailySpin", 5))
	end)
	Game.attack = attack
	Game.sellMass = sellMass
	Game.upgrade = upgrade
	Game.milestoneClaim = modules:FindFirstChild("MilestoneClaimEvent")
	Game.dailySpinEvent = modules:FindFirstChild("DailySpinEvent")
	Game.stats = okStats and statsModule or nil
	Game.upgrades = okUpgrades and upgradesModule or nil
	Game.milestones = okMilestones and milestonesModule or nil
	Game.dailySpin = okSpin and spinModule or nil
	return true
end

