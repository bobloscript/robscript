-- Not every control stores its handle in handles; the library keeps every flag in
-- Airflow.Flags, so the API can read and write the rest of them too.
local function handleFor(name)
	local handle = handles[name]
	if handle then
		return handle
	end
	local container = Airflow.Flags
	local entry = container and container[name]
	if type(entry) == "table" then
		return entry
	end
	return nil
end

local function flag(name, fallback)
	local handle = handleFor(name)
	if not handle then
		return fallback
	end
	local ok, value = pcall(function()
		return handle.Value
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local handle = handleFor(name)
	if not handle then
		return false
	end
	return (pcall(function()
		handle:Set(value)
	end))
end

local function swingInterval()
	local percent = tonumber(flag("SwingDelay", 102)) or 102
	return attackCooldown() * (percent / 100)
end

local function standOffset()
	return tonumber(flag("StandOffset", 2)) or 2
end

local function sellThreshold()
	local percent = tonumber(flag("SellAt", 90)) or 90
	return math.floor(maxMass() * percent / 100)
end

----- Blocks -----

local function targetMode()
	return flag("FarmTargets", "Valuable")
end

-- Distance to the surface of the part: a wall counts as close as its face is, not as
-- its centre is, which keeps the character from picking a block across the street.
local function surfaceDistance(part, position)
	local localPosition = part.CFrame:PointToObjectSpace(position)
	local half = part.Size * 0.5
	local clamped = Vector3.new(
		math.clamp(localPosition.X, -half.X, half.X),
		math.clamp(localPosition.Y, -half.Y, half.Y),
		math.clamp(localPosition.Z, -half.Z, half.Z)
	)
	return (localPosition - clamped).Magnitude
end

local function isBlocked(part, blocked)
	for _, node in ipairs(blocked) do
		if part:IsDescendantOf(node) then
			return true
		end
	end
	return false
end

local function scanTarget()
	local container = mapContainer()
	local root = rootOf()
	if not (container and root) then
		return nil, 0
	end
	local now = os.clock()
	Farm.lastScan = now
	local radius = tonumber(flag("FarmRadius", 300)) or 300
	local mode = targetMode()
	local position = root.Position
	local blocked = CollectionService:GetTagged("Indestructible")
	local best, bestScore, bestDistance
	for _, part in ipairs(container:GetDescendants()) do
		if part:IsA("BasePart") and part.Parent then
			local valuable = part:GetAttribute("MoreMass") ~= nil
			local wanted = valuable or mode ~= "Valuable"
			if wanted and not isBlocked(part, blocked) then
				local expiry = Farm.blacklist[part]
				if not expiry or expiry < now then
					local distance = surfaceDistance(part, position)
					if distance <= radius then
						local score
						if mode == "Nearest" then
							score = distance
						else
							score = valuable and (distance / VALUABLE_WEIGHT) or distance
						end
						if not bestScore or score < bestScore then
							best, bestScore, bestDistance = part, score, distance
						end
					end
				end
			end
		end
	end
	return best, bestDistance or 0
end

-- Where to put the character so its chest-height swing lands inside the block: right
-- next to the nearest face, on the ground under that spot when there is any.
local function stanceFor(target, root)
	local position = root.Position
	local localPosition = target.CFrame:PointToObjectSpace(position)
	local half = target.Size * 0.5
	local facePoint = target.CFrame:PointToWorldSpace(Vector3.new(
		math.clamp(localPosition.X, -half.X, half.X),
		0,
		math.clamp(localPosition.Z, -half.Z, half.Z)
	))
	local away = Vector3.new(position.X - target.Position.X, 0, position.Z - target.Position.Z)
	if away.Magnitude < 0.1 then
		local look = target.CFrame.LookVector
		away = Vector3.new(look.X, 0, look.Z)
	end
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end
	local stand = facePoint + away.Unit * standOffset()
	local ground = workspace:Raycast(
		Vector3.new(stand.X, stand.Y + 8, stand.Z),
		Vector3.new(0, -40, 0)
	)
	if ground then
		stand = Vector3.new(stand.X, ground.Position.Y + STANCE_HEIGHT, stand.Z)
	else
		stand = Vector3.new(stand.X, target.Position.Y + 1, stand.Z)
	end
	local lookAt = Vector3.new(target.Position.X, stand.Y, target.Position.Z)
	return stand, lookAt
end

local function blacklist(part)
	if part then
		Farm.blacklist[part] = os.clock() + BLACKLIST_TIME
	end
	Farm.target = nil
	Farm.targetSwings = 0
end

local function pruneBlacklist()
	local now = os.clock()
	for part, expiry in pairs(Farm.blacklist) do
		if expiry < now or not part.Parent then
			Farm.blacklist[part] = nil
		end
	end
end

----- Actions -----

local function swingOnce()
	if not bindGame() then
		return false
	end
	Farm.lastAttack = os.clock()
	Farm.attacks = Farm.attacks + 1
	local before = currentMass()
	Game.attack:FireServer()
	task.delay(0.7, function()
		local gained = currentMass() - before
		if gained > 0 then
			Farm.massGained = Farm.massGained + gained
		end
	end)
	return true
end

local function holdAttacksForSale()
	if not flag("AutoSell", true) then
		return false
	end
	return currentMass() >= sellThreshold()
end

local function sellStep()
	if not flag("AutoSell", true) or not bindGame() then
		return
	end
	if currentMass() < sellThreshold() then
		return
	end
	local now = os.clock()
	if now - Farm.lastAttack < SELL_LOCK or now - Farm.lastSell < SELL_COOLDOWN then
		return
	end
	Farm.lastSell = now
	local before = currentMass()
	Game.sellMass:FireServer()
	task.delay(0.8, function()
		local after = currentMass()
		if after < before then
			recordEvent(string.format("<Success>Sold %d mass</Success>", before - after))
		end
	end)
end

-- Cheapest first: every stat the game sells has its own price ladder, and the loop
-- always buys whatever level is affordable right now instead of saving up for one.
local function cheapestUpgrade()
	if not Game.upgrades then
		return nil
	end
	local tokens = tokenCount()
	local bestKey, bestPrice
	for _, key in ipairs(Game.upgrades.Order) do
		local rung = upgradeRung(key)
		if rung and rung.Price <= tokens and (not bestPrice or rung.Price < bestPrice) then
			bestKey, bestPrice = key, rung.Price
		end
	end
	return bestKey, bestPrice
end

local function upgradeStep()
	if not flag("AutoUpgrade", false) then
		return
	end
	if not bindGame() then
		return
	end
	if not (Game.upgrades and Game.upgrade) then
		return
	end
	local now = os.clock()
	if now - Farm.lastUpgrade < 1.5 then
		return
	end
	local mode = flag("UpgradeStat", "Cheapest")
	local key, price
	if mode == "Cheapest" then
		key, price = cheapestUpgrade()
	else
		local rung = upgradeRung(mode)
		if rung and rung.Price <= tokenCount() then
			key, price = mode, rung.Price
		end
	end
	if not key then
		return
	end
	Farm.lastUpgrade = now
	Game.upgrade:FireServer(key)
	recordEvent(string.format("<Success>%s upgraded</Success> <Muted>- %d tokens</Muted>", key, price or 0))
end

-- Milestones pay tokens, cores and potions for progress that already happened, so they
-- are claimed as soon as Milestones.Claimable says the next rung is reached.
local function milestoneCandidates()
	local list = {}
	if not Game.milestones then
		return list
	end
	for _, id in ipairs(Game.milestones.Order) do
		if Game.milestones.Claimable(LocalPlayer, id) then
			table.insert(list, id)
		end
	end
	return list
end

local function milestoneStep()
	if not flag("AutoMilestones", true) then
		return
	end
	if not bindGame() then
		return
	end
	if not (Game.milestones and Game.milestoneClaim) then
		return
	end
	local now = os.clock()
	if now - Farm.lastMilestone < 2 then
		return
	end
	local list = milestoneCandidates()
	if #list == 0 then
		return
	end
	Farm.lastMilestone = now
	Game.milestoneClaim:FireServer(list[1])
	recordEvent(string.format("<Success>Milestone %s claimed</Success>", list[1]))
end

-- The daily spin is server-side gated on group membership and on one spin per day.
local function spinBlockedReason()
	if not bindGame() then
		return "Waiting for the game"
	end
	if not (Game.dailySpin and Game.dailySpinEvent) then
		return "Waiting for the game"
	end
	local stat = hiddenStat(Game.dailySpin.StatName)
	if not stat then
		return "Waiting for the game"
	end
	if Game.dailySpin.SpunToday(stat.Value) then
		return "Done today"
	end
	if LocalPlayer:GetAttribute(Game.dailySpin.GroupAttribute) ~= true then
		return "Join the group"
	end
	return nil
end

local function spinStep()
	if not flag("AutoSpin", true) then
		return
	end
	if spinBlockedReason() then
		return
	end
	local now = os.clock()
	if now - Farm.lastSpin < 8 then
		return
	end
	Farm.lastSpin = now
	Game.dailySpinEvent:FireServer()
	recordEvent("<Success>Daily spin used</Success>")
end

local function joinSpinGroup()
	local groupId = Game.dailySpin and Game.dailySpin.GroupId or 9019804
	task.spawn(function()
		local ok, result = pcall(function()
			return game:GetService("GroupService"):PromptJoinAsync(groupId)
		end)
		if ok then
			recordEvent(string.format("<Success>Group prompt: %s</Success>", tostring(result)))
		else
			recordEvent(string.format("<Error>Group prompt failed</Error> <Muted>%s</Muted>", tostring(result)))
		end
	end)
end

-- Session average instead of a rolling window: selling resets the bar, and a window
-- would read zero right after every sale even though the farm never stopped.
local function massRate()
	local elapsed = os.clock() - Farm.sessionStart
	if Farm.sessionStart <= 0 or elapsed < 5 then
		return 0
	end
	return math.floor(Farm.massGained / elapsed * 60 + 0.5)
end

----- Farm loop -----

local function farmLoop(token)
	while running and Farm.enabled and token == farmToken do
		if not bindGame() then
			Farm.state = "Waiting for the game"
			task.wait(0.5)
			continue
		end
		local humanoid = humanoidOf()
		local root = rootOf()
		if not (humanoid and root) then
			Farm.state = "Waiting for character"
			task.wait(0.5)
			continue
		end
		if humanoid.Health <= 0 then
			Farm.state = "Dead"
			task.wait(0.5)
			continue
		end
		if holdAttacksForSale() then
			Farm.state = "Selling"
			task.wait(0.2)
			continue
		end
		if currentMass() >= maxMass() then
			Farm.state = "Mass full"
			task.wait(0.3)
			continue
		end
		local now = os.clock()
		if now - Farm.lastScan >= SCAN_INTERVAL then
			pruneBlacklist()
		end
		local target, distance = scanTarget()
		if not target then
			Farm.state = "No blocks nearby"
			Farm.target = nil
			task.wait(0.4)
			continue
		end
		Farm.target, Farm.targetDistance = target, distance
		local stand, lookAt = stanceFor(target, root)
		Farm.state = "Attacking"
		root.CFrame = CFrame.lookAt(stand, lookAt)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		task.wait(PLACE_DELAY)
		if not (running and Farm.enabled and token == farmToken) then
			break
		end
		local before = currentMass()
		if not swingOnce() then
			break
		end
		Farm.targetSwings = Farm.targetSwings + 1
		task.wait(swingInterval() - PLACE_DELAY)
		if currentMass() <= before then
			-- Nothing was carved: either the block is out of reach or it is a floor tile.
			Farm.misses = Farm.misses + 1
			blacklist(target)
		else
			Farm.targetSwings = 0
		end
	end
	Farm.state = "Idle"
	Farm.target = nil
end

local function startFarm()
	if Farm.enabled then
		return
	end
	Farm.enabled = true
	Farm.state = "Starting"
	Farm.sessionStart = os.clock()
	Farm.massGained = 0
	Farm.blacklist = {}
	Farm.misses = 0
	farmToken = farmToken + 1
	recordEvent("<Success>Farm enabled</Success>")
	task.spawn(farmLoop, farmToken)
end

local function stopFarm()
	if not Farm.enabled then
		return
	end
	Farm.enabled = false
	farmToken = farmToken + 1
	Farm.state = "Idle"
	Farm.target = nil
	recordEvent("<Muted>Farm disabled</Muted>")
end

----- HUD -----

local hud = nil
local hudLabel = nil

local function hudParent()
	-- PlayerGui is a normal container, so the panel can be read and written from any
	-- of the script's threads. Roblox refuses property access on some of the executor
	-- CoreGui parents from those threads.
	return LocalPlayer:FindFirstChild("PlayerGui")
end

local function createHud()
	if hud then
		return
	end
	local parent = hudParent()
	if not parent then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "RSGrowAnomalyHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.Position = UDim2.new(0, 16, 0, 90)
	frame.Size = UDim2.fromOffset(230, 64)
	frame.BackgroundColor3 = THEME.Background
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = THEME.Stroke
	stroke.Thickness = 1
	stroke.Parent = frame

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0, 3, 1, -16)
	accent.Position = UDim2.new(0, 6, 0, 8)
	accent.BackgroundColor3 = THEME.Accent
	accent.BorderSizePixel = 0
	accent.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 16, 0, 6)
	label.Size = UDim2.new(1, -24, 1, -12)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
