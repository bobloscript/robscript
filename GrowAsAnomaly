	hud = gui
	hudLabel = label
end

local function destroyHud()
	if hud then
		pcall(function()
			hud:Destroy()
		end)
	end
	hud, hudLabel = nil, nil
end

local function updateHud()
	if not flag("Hud", true) then
		destroyHud()
		return
	end
	createHud()
	if not hudLabel then
		return
	end
	hudLabel.Text = string.format(
		"<font color=\"#FF3B7F\">Mass</font> %d / %d\n<font color=\"#8D8D99\">Rate</font> %d / min · <font color=\"#8D8D99\">Tokens</font> %d\n<font color=\"#8D8D99\">%s</font>",
		currentMass(),
		maxMass(),
		massRate(),
		tokenCount(),
		Farm.state
	)
end

