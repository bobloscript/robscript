----- Runtime -----

local upgradeAccumulator = 0
local hudAccumulator = 0
local lastError = nil

local function safeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		local message = tostring(result)
		if lastError ~= message then
			lastError = message
			warn("[RobScript GrowAnomaly] " .. message)
		end
	end
	return ok
end

-- Reward pickups run even when the farm is off: they cost nothing and only fire when
-- the game itself reports something claimable.
local rewardAccumulator = 0

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	upgradeAccumulator = upgradeAccumulator + deltaTime
	rewardAccumulator = rewardAccumulator + deltaTime
	hudAccumulator = hudAccumulator + deltaTime

	if Farm.enabled then
		if upgradeAccumulator >= 2 then
			upgradeAccumulator = 0
			safeCall(upgradeStep)
		end
		safeCall(sellStep)
	end

	if rewardAccumulator >= 1 then
		rewardAccumulator = 0
		safeCall(milestoneStep)
		safeCall(spinStep)
	end

	if hudAccumulator >= HUD_INTERVAL then
		hudAccumulator = 0
		local cap = maxMass()
		local mass = currentMass()
		if handles.MassBar then
			pcall(function()
				handles.MassBar:Set(cap > 0 and math.clamp(mass / cap, 0, 1) or 0)
			end)
		end
		safeCall(updateHud)
	end
end)

local panicInput = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			stopFarm()
			setFlag("AutoFarm", false)
			destroyHud()
			Window:Toggle(false)
		end)
	end
end)

----- API -----

local function destroy()
	if not running then
		return
	end
	running = false
	Farm.enabled = false
	farmToken = farmToken + 1
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		panicInput:Disconnect()
	end)
	pcall(destroyHud)
	pcall(function()
		Window:Destroy()
	end)
	local env = getgenv()
	if type(env) == "table" then
		env.RobScriptGrowAnomaly = nil
	end
end

getgenv().RobScriptGrowAnomaly = {
	Version = "1.2",
	Get = function(name)
		return flag(name, nil)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	StartFarm = function()
		setFlag("AutoFarm", true)
		startFarm()
	end,
	StopFarm = function()
		setFlag("AutoFarm", false)
		stopFarm()
	end,
	ToggleFarm = function(on)
		if on == nil then
			on = not Farm.enabled
		end
		setFlag("AutoFarm", on)
		if on then
			startFarm()
		else
			stopFarm()
		end
		return on
	end,
	GetFarm = function()
		return {
			enabled = Farm.enabled,
			state = Farm.state,
			attacks = Farm.attacks,
			misses = Farm.misses,
			mass = currentMass(),
			maxMass = maxMass(),
			rate = massRate(),
			tokens = tokenCount(),
			target = Farm.target and Farm.target:GetFullName() or nil,
			distance = Farm.targetDistance,
		}
	end,
	GetRewards = function()
		bindGame()
		local milestones = {}
		if Game.milestones then
			for _, id in ipairs(Game.milestones.Order) do
				milestones[id] = {
					progress = Game.milestones.Progress(LocalPlayer, id),
					claimed = Game.milestones.Claimed(LocalPlayer, id),
					claimable = Game.milestones.Claimable(LocalPlayer, id),
				}
			end
		end
		return {
			milestones = milestones,
			spin = spinBlockedReason() or "ready",
			group = LocalPlayer:GetAttribute("InSpinGroup") == true,
			upgrades = (function()
				local list = {}
				if Game.upgrades then
					for _, key in ipairs(Game.upgrades.Order) do
						local rung = upgradeRung(key)
						list[key] = {
							level = upgradeLevel(key),
							price = rung and rung.Price or nil,
						}
					end
				end
				return list
			end)(),
		}
	end,
	ClaimMilestones = function()
		if not bindGame() then
			return 0
		end
		local list = milestoneCandidates()
		for _, id in ipairs(list) do
			Game.milestoneClaim:FireServer(id)
		end
		return #list
	end,
	SpinNow = function()
		if not bindGame() then
			return false
		end
		local reason = spinBlockedReason()
		if reason then
			return false, reason
		end
		Game.dailySpinEvent:FireServer()
		return true
	end,
	JoinGroup = function()
		if not bindGame() then
			return false
		end
		joinSpinGroup()
		return true
	end,
	SelectTab = function(name)
		if type(name) ~= "string" then
			return false
		end
		for _, tab in ipairs({ FarmTab, RewardsTab, SettingsTab }) do
			if tab and tab.Name == name then
				Window:SelectTab(tab)
				return true
			end
		end
		return false
	end,
	GetLastError = function()
		return lastError
	end,
	Destroy = destroy,
}

